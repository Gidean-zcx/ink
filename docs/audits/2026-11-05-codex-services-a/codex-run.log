diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/reset_probe.c b/docs/audits/2026-11-05-codex-services-a/experiments/reset_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..1069ad71b633c52e2336b9ee8572f68054a30ec0
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/reset_probe.c
@@ -0,0 +1,26 @@
+#include "product_probe.h"
+static void audit_task(void *arg) {
+    (void)arg;delay_ms(1800);
+    if(getenv("AUDIT_RESET_SEED")) {
+        CHECK(ink_fs_write_atomic("/me/private.txt","SYNTHETIC",9)==0,"private card file");
+        CHECK(ink_storage_write_atomic("/user/m/owner/private.txt","SYNTHETIC",9)==0,"private flash file");
+        CHECK(ink_storage_write_atomic("/user/sys/reset.pending","",0)==0,"durable reset marker");
+        CHECK(WAIT_FOR(!ink_storage_pending(),5000),"seed durable");
+    } else {
+        ink_fs_stat_t s;
+        int card=ink_fs_stat("/me/private.txt",&s);
+        int64_t flash=ink_storage_size("/user/m/owner/private.txt");
+        int64_t pending=ink_storage_size("/user/sys/reset.pending"),mark=ink_storage_size("/user/sys/reset.card");
+        printf("AUDIT reset card=%d flash=%lld pending=%lld card_mark=%lld done=%g card_done=%g\n",card,(long long)flash,(long long)pending,(long long)mark,sim_metric_value("system.factory_reset_done"),sim_metric_value("system.factory_reset_card_at_boot"));
+        CHECK(pending<0 && mark<0,"reset reports no pending work");
+        if(getenv("AUDIT_FAIL_CARD_ROOT")) CHECK(card==0 && flash<0,"reproduced: card data survives completed reset");
+        else if(getenv("AUDIT_FAIL_USER_READDIR")) CHECK(flash==9 && card==INK_FS_ERR_NOT_FOUND,"reproduced: flash data survives completed reset");
+        else CHECK(card==INK_FS_ERR_NOT_FOUND && flash<0,"control reset cleaned both");
+    }
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t cfg={.name="audit-reset",.fn=audit_task,.stack_bytes=16384,.priority=OSAL_PRIO_NORMAL,.core=-1,.flags=OSAL_TASK_STACK_EXTERNAL};
+    CHECK(osal_task_create(&cfg,NULL)==OSAL_OK,"audit task");
+}
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/run_update_matrix.py b/docs/audits/2026-11-05-codex-services-a/experiments/run_update_matrix.py
new file mode 100644
index 0000000000000000000000000000000000000000..264a6f3f670cdfbae582f07952e7bf692b761fb1
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/run_update_matrix.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Synthetic packages, real product boots and HAL. No existing fixtures are modified."""
+import hashlib, hmac, importlib.util, json, os, pathlib, struct, subprocess, sys, tempfile
+ROOT=pathlib.Path(__file__).resolve().parents[4]
+HERE=pathlib.Path(__file__).resolve().parent
+BUILD=ROOT/os.environ.get('AUDIT_BUILD','build-audit')
+spec=importlib.util.spec_from_file_location('inkfw',ROOT/'tools/inkfw/make_inkfw.py')
+fw=importlib.util.module_from_spec(spec);spec.loader.exec_module(fw)
+work=pathlib.Path(tempfile.mkdtemp(prefix='update-matrix-',dir=BUILD/'audit-probes'))
+results=[]
+def pkg(code=200,**kw):return fw.build(f'{code//100}.0.0',code,app_size=8192,**kw)[0]
+def resign(b):
+    hs=struct.unpack_from('<I',b,12)[0]
+    b[hs-64:hs]=bytes(64)
+    b[hs-64:hs-32]=hmac.new(fw.KEY,hashlib.sha256(b[:hs]).digest(),hashlib.sha256).digest()
+    return b
+def chain(name):
+    p=work/name;(p/'sd/content/update').mkdir(parents=True);return p
+def run(p,phase,label,**env):
+    out=p/label
+    cmd=[str(BUILD/'audit-probes/update_probe/probe'),'--profile',str(ROOT/'simulator/profiles/metalio-plus.json'),'--quiet','--no-random-outages','--assets',str(BUILD/'assets'),'--content',str(BUILD/'test-content'),'--sd-dir',str(p/'sd'),'--flash-image',str(p/'user.img'),'--out',str(out),'--script',str(HERE/'network.script')]
+    e=os.environ.copy();e.update(AUDIT_PHASE=phase);e.update({k:str(v) for k,v in env.items()})
+    r=subprocess.run(cmd,cwd=ROOT,env=e,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=120)
+    print('\nCASE',p.name,label,'exit',r.returncode,flush=True)
+    print(r.stdout,flush=True)
+    if r.returncode:print(r.stderr[-4000:],flush=True)
+    m=json.loads((out/'metrics.json').read_text())
+    mm=m['metrics']
+    summary={k:v for k,v in mm.items() if k.startswith(('update.','ota.','power.reboot','test.'))}
+    results.append(dict(chain=p.name,phase=label,exit=r.returncode,metrics=summary,stdout=r.stdout,warnings=m.get('warnings',[])))
+    assert r.returncode==0 and mm.get('test.fail',0)==0,(label,m.get('warnings',[]))
+    if phase=='install' or env.get('AUDIT_SELF_FAIL'):assert mm.get('power.reboot')==1,label
+    else:assert mm.get('test.finished')==1,label
+    return mm
+def install(p,code=200,**kw):
+    (p/'sd/content/update/next.inkfw').write_bytes(pkg(code,**kw))
+    return run(p,'install',f'install-{code}')
+
+# Each state transition still uses the actual storage service, except this one refused enqueue.
+p=chain('state-control');install(p,font=4096,resources=8192);m=run(p,'inspect','valid')
+assert m.get('ota.resource_bytes')==12288
+p=chain('state-refused');(p/'sd/content/update/next.inkfw').write_bytes(pkg(font=4096,resources=8192))
+run(p,'install','install-200',AUDIT_FAIL_STATE=1);m=run(p,'inspect','valid-without-state')
+assert m.get('ota.marked_valid')==1 and m.get('ota.resource_bytes',0)==0
+
+# A real resource-write failure, then an ordinary newer package containing only an app.
+p=chain('resources-replaced');install(p,font=4096,resources=8192)
+m=run(p,'inspect','half-resources',INK_SIM_OTA_RESOURCE_FAILS=8192)
+assert m.get('update.resources_failed')==1
+(p/'sd/content/update/new.inkfw').write_bytes(pkg(300))
+run(p,'install','install-300',INK_SIM_OTA_RESOURCE_FAILS=0,AUDIT_INSTALL_FILE='new.inkfw')
+m=run(p,'inspect','new-version-without-resources')
+assert m.get('ota.marked_valid')==1 and m.get('ota.resource_bytes',0)==0
+
+# Two failed upgrades: the first failed version is offered again after the second rollback.
+p=chain('blocked-history')
+for code in (200,300):
+    install(p,code)
+    run(p,'inspect',f'fails-{code}',AUDIT_SELF_FAIL=1)
+    (p/'sd/content/prior.inkfw').write_bytes(pkg(200))
+    run(p,'inspect',f'rollback-{code}',AUDIT_PRIOR=1)
+
+# Signed-but-ill-formed tables. These test publisher/format validation, not signature bypass.
+p=chain('package-table');d=p/'sd/content/cases';d.mkdir()
+normal=pkg(font=4096)
+cases={'normal':normal}
+b=bytearray(normal);b[88+56+8:88+56+56]=b[88+8:88+56];cases['overlap']=resign(b)
+b=bytearray(normal);struct.pack_into('<I',b,88+56,0);cases['duplicate']=resign(b)
+b=bytearray(normal);struct.pack_into('<I',b,88+56,99);cases['unknown']=resign(b)
+b=bytearray(normal);struct.pack_into('<QQ',b,88+8,0,0);b[88+24:88+56]=hashlib.sha256(b'').digest();cases['zero']=resign(b)
+b=bytearray(normal);struct.pack_into('<Q',b,88+8,len(b)+4096);cases['past_eof']=resign(b)
+cases['truncated']=normal[:-2048]
+b=bytearray(normal);struct.pack_into('<QQ',b,88+8,2**64-8,32);cases['overflow']=resign(b)
+b=bytearray(normal);b[88+8]^=0x20;cases['unsigned_damage']=b
+for name,b in cases.items():(d/(name+'.inkfw')).write_bytes(b)
+run(p,'packages','check-tables')
+
+# Update/check publishes a new package while update/fetch is in progress.
+p=chain('download-offer-changed')
+old=fw.build('2.0.0',200,app_size=131072)[0]
+new=fw.build('3.0.0',300,app_size=196608)[0]
+(p/'old.inkfw').write_bytes(old);(p/'new.inkfw').write_bytes(new)
+run(p,'download','changing-offer',INK_SIM_UPDATE_PKG=p/'old.inkfw',AUDIT_NEXT_PACKAGE=p/'new.inkfw')
+(HERE/'update-results.json').write_text(json.dumps(dict(work=str(work),runs=results),ensure_ascii=False,indent=2)+'\n')
+print('MATRIX complete',len(results),'boots; artifacts',work)
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/storage_boundary.c b/docs/audits/2026-11-05-codex-services-a/experiments/storage_boundary.c
new file mode 100644
index 0000000000000000000000000000000000000000..02b3bf890e06772a57f3921e9ee9599f3af30bb6
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/storage_boundary.c
@@ -0,0 +1,19 @@
+/* Original storage TU; a directory read failure only while wipe_dir walks /user. */
+#include <stdlib.h>
+#include <string.h>
+#include "ink/hal_storage.h"
+static hal_dir_t *target;
+static hal_dir_t *audit_storage_open(const char *path) {
+    hal_dir_t *d=hal_fs_opendir(path);
+    if(getenv("AUDIT_FAIL_USER_READDIR") && !strcmp(path,"/user")) target=d;
+    return d;
+}
+static int audit_storage_next(hal_dir_t *d,hal_dirent_t *e) {
+    if(target && d==target) { target=NULL;return -1; }
+    return hal_fs_readdir(d,e);
+}
+#define hal_fs_opendir audit_storage_open
+#define hal_fs_readdir audit_storage_next
+#include "../../../../system/services/storage/storage_service.c"
+#undef hal_fs_opendir
+#undef hal_fs_readdir
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/storage_probe.c b/docs/audits/2026-11-05-codex-services-a/experiments/storage_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..8e4009b09987e02899f699cc4ccfbb83d082eade
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/storage_probe.c
@@ -0,0 +1,50 @@
+#include "product_probe.h"
+#include "ink/sys/svc.h"
+static volatile int done, sentinel;
+static void appended(void *ctx,int result) { (void)ctx; done=result==0?1:-1; }
+static void tick(void *ctx) { (void)ctx; sentinel++; }
+static ink_svc_deadline_t deadline;
+static const ink_db_def_t DEF={.name="audit.lazy",.scope=INK_DB_MEMBER,.schema=1,.json=true,.ai_read=true,.ai_write=true};
+static void audit_task(void *arg) {
+    (void)arg; delay_ms(1800);
+    const char *path="/user/sys/append-cache";
+    CHECK(ink_storage_write_atomic(path,"A",1)==0,"write initial");
+    CHECK(WAIT_FOR(!ink_storage_pending(),3000),"initial durable");
+    ink_storage_hold_writes(true);
+    CHECK(ink_storage_append(path,"B",1,appended,NULL)==0,"enqueue append");
+    char value[32]={0};
+    int before=ink_storage_read(path,value,sizeof value-1);
+    ink_storage_hold_writes(false);
+    CHECK(WAIT_FOR(done,3000) && done==1,"append completed");
+    memset(value,0,sizeof value);
+    int after=ink_storage_read(path,value,sizeof value-1);
+    int64_t disk=ink_storage_size(path);
+    printf("AUDIT append_cache before=%d after=%d disk=%lld value=%s\n",before,after,(long long)disk,value);
+    CHECK(after==2 && disk==2 && !strcmp(value,"AB"),"queued append prevents caching an old read");
+
+    CHECK(ink_db_register(&DEF)==0,"register");
+    ink_db_t *owner=ink_db_open(&DEF,"owner"),*kid=ink_db_open(&DEF,"kid");
+    CHECK(owner && kid,"collections");
+    ink_db_write_t w={.data="{\"v\":1}",.len=7,.flags=INK_DB_LAZY};
+    uint32_t id=0;
+    CHECK(ink_db_put(owner,&w,&id)==0,"owner lazy record");
+    ink_svc_at(&deadline,osal_now_us()+1000000,tick,NULL);
+    CHECK(ink_db_put(kid,&w,NULL)==0,"kid lazy record");
+    ink_db_close(kid);
+    bool forget=getenv("AUDIT_KEEP_MEMBER")==NULL;
+    if(forget) ink_db_forget_member("kid");
+    delay_ms(1500);
+    printf("AUDIT forget_member sentinel=%d owner_last=%u owner_durable=%u\n",sentinel,ink_db_last_ver(owner),ink_db_durable_ver(owner));
+    CHECK(sentinel==(forget?0:1),"forget versus control deadline");
+    /* Keep device active so the independent power/lock flush does not mask the lost 60 s data timer. */
+    ink_power_hold(INK_NEED_NO_LOCK);
+    delay_ms(61000);
+    printf("AUDIT forget_member_after_lazy_timeout owner_last=%u owner_durable=%u\n",ink_db_last_ver(owner),ink_db_durable_ver(owner));
+    CHECK(ink_db_durable_ver(owner)==(forget?0u:1u),"forget versus control lazy durability");
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t cfg={.name="audit-storage",.fn=audit_task,.stack_bytes=16384,.priority=OSAL_PRIO_NORMAL,.core=-1,.flags=OSAL_TASK_STACK_EXTERNAL};
+    CHECK(osal_task_create(&cfg,NULL)==OSAL_OK,"audit task");
+}
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/update_boundary.c b/docs/audits/2026-11-05-codex-services-a/experiments/update_boundary.c
new file mode 100644
index 0000000000000000000000000000000000000000..6192d9cad8f8ec4bfd1b0be26e5bae2bc5ec9399
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/update_boundary.c
@@ -0,0 +1,27 @@
+/* Original product TU. State-write failure models a full storage queue; no state machine edits. */
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include "ink/sys/storage.h"
+static int audit_state_write(const char *path, const void *data, size_t len) {
+    if (getenv("AUDIT_FAIL_STATE") && !strcmp(path, "/user/sys/update.json")) {
+        printf("AUDIT refused_state_write bytes=%zu\n", len);
+        return -1;
+    }
+    return ink_storage_write_atomic(path, data, len);
+}
+#define ink_storage_write_atomic audit_state_write
+#include "../../../../system/services/update/update_service.c"
+#undef ink_storage_write_atomic
+int audit_package(const char *path) {
+    pkg_t p;
+    return (int)check_package(path, &p);
+}
+int audit_dl_offset(void) { return (int)U.dl_off; }
+int audit_dl_job(void) { return U.job; }
+int audit_dl_task(void) { return U.task; }
+int audit_dl_waiting(void) { return U.dl_waiting; }
+void audit_update_dump(void) {
+    printf("AUDIT update runtime_code=%u state=%s code=%u res=%u path=%s blocked=%u offer=%u dl_off=%u job=%d\n",
+           U.me.version_code, U.st.state, U.st.code, U.st.res_done_section, U.st.path, U.st.blocked_code, U.offer_code, U.dl_off, U.job);
+}
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/update_probe.c b/docs/audits/2026-11-05-codex-services-a/experiments/update_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..e744366fbb92e69c24a4f121cce47a4dc3548a8f
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/update_probe.c
@@ -0,0 +1,70 @@
+#include "product_probe.h"
+#include "ink/hal_ota.h"
+extern int audit_package(const char *);
+extern int audit_dl_offset(void), audit_dl_job(void), audit_dl_task(void), audit_dl_waiting(void);
+extern void audit_update_dump(void);
+static void change_offer(void *arg) {
+    (void)arg;
+    setenv("INK_SIM_UPDATE_PKG", getenv("AUDIT_NEXT_PACKAGE"), 1);
+}
+static void audit_task(void *arg) {
+    (void)arg;
+    const char *phase = getenv("AUDIT_PHASE");
+    delay_ms(1500);
+    if (phase && !strcmp(phase, "install")) {
+        char install_args[128];
+        snprintf(install_args,sizeof install_args,"{\"file\":\"%s\"}",getenv("AUDIT_INSTALL_FILE")?getenv("AUDIT_INSTALL_FILE"):"next.inkfw");
+        CHECK(BY_HAND("system.upgrade_from_card", install_args) && g_rc.status == INK_RC_PENDING_CONFIRMATION, "installation asks");
+        unsigned token = 0;
+        sscanf(g_rc.object, "confirm:%u", &token);
+        ink_probe_count("test.finished"); /* this run's expected end is reboot */
+        CHECK(ink_confirm_decide(token, true, INK_SRC_TOUCH) == 0, "accept installation");
+        delay_ms(30000);
+        CHECK(0, "installation should reboot");
+        return;
+    }
+    if (phase && !strcmp(phase, "packages")) {
+        const char *names[] = {"normal", "overlap", "duplicate", "unknown", "zero", "past_eof", "truncated", "overflow", "unsigned_damage"};
+        for (unsigned i=0; i<sizeof names/sizeof names[0]; i++) {
+            char p[128];
+            snprintf(p,sizeof p,"/content/cases/%s.inkfw",names[i]);
+            printf("AUDIT package %s result=%d\n",names[i],audit_package(p));
+        }
+    } else if (phase && !strcmp(phase, "download")) {
+        ink_hub_demand();
+        CHECK(WAIT_FOR(ink_hub_online(),30000),"online");
+        CHECK(AI("update.check",NULL) && g_rc.status==INK_RC_DONE,"offer");
+        CHECK(AI("update.download",NULL) && g_rc.status==INK_RC_DONE,"start");
+        CHECK(WAIT_FOR(audit_dl_offset()>0,10000),"some original data");
+        printf("AUDIT download_before_change off=%d\n",audit_dl_offset());
+        vtk_event_at(vtk_now()+SIM_MS(1),change_offer,NULL);
+        delay_ms(10);
+        CHECK(AI("update.check",NULL) && g_rc.status==INK_RC_DONE,"new offer during download");
+        audit_update_dump();
+        CHECK(WAIT_FOR(!audit_dl_job(),60000),"download ends");
+        char state[32];
+        ink_state_get_str(ink_state_find("update.state"),state,sizeof state);
+        printf("AUDIT download_after_change state=%s bad=%g partial=%lld\n",state,sim_metric_value("update.download_bad"),(long long)hal_fs_size("/content/.update/2.0.0.inkfw.part"));
+        hal_file_t *f=hal_fs_open("/content/.update/2.0.0.inkfw",HAL_O_READ);
+        unsigned char h[76]; uint32_t actual=0;
+        if(f && hal_fs_read(f,h,sizeof h)==sizeof h) memcpy(&actual,h+72,4);
+        if(f) hal_fs_close(f);
+        printf("AUDIT downloaded_package header_code=%u size=%lld\n",actual,(long long)hal_fs_size("/content/.update/2.0.0.inkfw"));
+    } else {
+        delay_ms(6000);
+        audit_update_dump();
+        char saved[512]="";
+        int n=ink_storage_read("/user/sys/update.json",saved,sizeof saved-1);
+        if(n>=0) saved[n]=0;
+        printf("AUDIT persisted_state len=%d json=%s marked_valid=%g resource_bytes=%g resource_failed=%g\n",n,saved,sim_metric_value("ota.marked_valid"),sim_metric_value("ota.resource_bytes"),sim_metric_value("update.resources_failed"));
+        if (getenv("AUDIT_PRIOR")) printf("AUDIT prior_failed_package result=%d\n",audit_package("/content/prior.inkfw"));
+    }
+    ink_probe_count("test.finished");
+}
+static bool audit_self_fails(void) { return false; }
+void ink_main(void) {
+    if(getenv("AUDIT_SELF_FAIL")) ink_update_self_check_add(audit_self_fails);
+    product_main();
+    osal_task_cfg_t cfg={.name="audit-update",.fn=audit_task,.stack_bytes=16384,.priority=OSAL_PRIO_NORMAL,.core=-1,.flags=OSAL_TASK_STACK_EXTERNAL};
+    CHECK(osal_task_create(&cfg,NULL)==OSAL_OK,"audit task");
+}

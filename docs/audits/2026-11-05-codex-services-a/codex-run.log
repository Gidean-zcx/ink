index 0000000000000000000000000000000000000000..b551879931375571b52f36a6008685af346a81ab
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/compile_probe.py
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+"""Compile only, using the existing target's exact compile/link flags. Root owns all edits."""
+import argparse,pathlib,shlex,subprocess
+p=argparse.ArgumentParser();p.add_argument('source');p.add_argument('--template',default='sim-update');p.add_argument('--build',default='build-audit');p.add_argument('--name');p.add_argument('--extra',action='append',default=[]);a=p.parse_args()
+root=pathlib.Path(__file__).resolve().parents[4];build=root/a.build;source=root/a.source
+dest=build/'audit-probes'/(a.name or source.stem);dest.mkdir(parents=True,exist_ok=True)
+flags={}
+for line in (build/'CMakeFiles'/(a.template+'.dir')/'flags.make').read_text().splitlines():
+    if ' = ' in line:
+        k,v=line.split(' = ',1);flags[k]=shlex.split(v)
+link=shlex.split((build/'CMakeFiles'/(a.template+'.dir')/'link.txt').read_text())
+objects=[]
+for i,f in enumerate([str(source),*[str(root/x) for x in a.extra]]):
+    obj=dest/f'part-{i}.o'
+    subprocess.run([link[0],*flags['C_DEFINES'],*flags['C_INCLUDES'],*flags['C_FLAGS'],'-Wno-unused-function','-c',f,'-o',str(obj)],cwd=build,check=True)
+    objects.append(str(obj))
+for i,x in enumerate(link):
+    if '/tests/integration/' in x and x.endswith('.o'):link[i]=objects[0];break
+link[link.index('-o')+1]=str(dest/'probe')
+at=next(i for i,x in enumerate(link) if x.endswith('.a'));link[at:at]=objects[1:]
+subprocess.run(link,cwd=build,check=True)
+print(dest/'probe')
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/file_boundary.c b/docs/audits/2026-11-05-codex-services-a/experiments/file_boundary.c
new file mode 100644
index 0000000000000000000000000000000000000000..a05251fdc4968f7fe11bbdc7a328c64b5aaf9c4c
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/file_boundary.c
@@ -0,0 +1,33 @@
+/* Product source unchanged. One HAL open failure; one scheduling boundary after job submission. */
+#include <string.h>
+#include <stdlib.h>
+#include "ink/hal_storage.h"
+#include "ink/sys/res.h"
+#include "ink/sys/file.h"
+#include "ink/osal.h"
+int audit_fail_root;
+int audit_pause_submit;
+static hal_dir_t *audit_opendir(const char *path) {
+    static int env_used;
+    if ((audit_fail_root || (!env_used && getenv("AUDIT_FAIL_CARD_ROOT"))) && !strcmp(path, "/content/.m")) {
+        audit_fail_root = 0;
+        env_used = 1;
+        return NULL;
+    }
+    return hal_fs_opendir(path);
+}
+static int audit_submit(const ink_job_t *job) {
+    int r = ink_job_submit(job);
+    if (audit_pause_submit && r > 0) {
+        audit_pause_submit = 0;
+        osal_task_delay_us(500000);
+    }
+    return r;
+}
+#define hal_fs_opendir audit_opendir
+#define ink_job_submit audit_submit
+#include "../../../../system/services/file/file_service.c"
+#undef hal_fs_opendir
+#undef ink_job_submit
+int audit_nopen(void) { return FS.nopen; }
+int audit_file_task(void) { return FS.job.task; }
diff --git a/docs/audits/2026-11-05-codex-services-a/experiments/file_probe.c b/docs/audits/2026-11-05-codex-services-a/experiments/file_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..e179711ccd333e0c28d80e6ecd6665b370eb462c
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-a/experiments/file_probe.c
@@ -0,0 +1,51 @@
+#include "product_probe.h"
+extern int audit_fail_root, audit_pause_submit;
+extern int audit_nopen(void);
+extern int audit_file_task(void);
+static void audit_task(void *arg) {
+    (void)arg;
+    delay_ms(1800);
+    const char *deep = "/me/a/b/c/d/e/f/g/h/i/private.txt";
+    CHECK(ink_fs_write_atomic(deep, "SYNTHETIC", 9) == 0, "create deep file");
+    int wipe = ink_fs_wipe_personal();
+    ink_fs_stat_t st;
+    int exists = ink_fs_stat(deep, &st);
+    printf("AUDIT deep_wipe result=%d remaining=%d\n", wipe, exists);
+    CHECK(wipe == 0 && exists == INK_FS_ERR_NOT_FOUND, "AUD17-002 original depth case fixed");
+
+    CHECK(ink_fs_write_atomic("/me/read-failure.txt", "SYNTHETIC", 9) == 0, "create private file");
+    audit_fail_root = 1;
+    wipe = ink_fs_wipe_personal();
+    exists = ink_fs_stat("/me/read-failure.txt", &st);
+    printf("AUDIT failed_root_open wipe=%d remaining=%d\n", wipe, exists);
+    CHECK(wipe == 0 && exists == 0, "reproduced: failed root open treated as empty");
+
+    ink_fs_dir_t *dir = NULL;
+    CHECK(ink_fs_dir_open("/me", &dir) == 0, "open directory");
+    int before = audit_nopen();
+    hw(HW_USB_ON, 0, 0);
+    int lent = ink_usb_disk_start();
+    int next = ink_fs_dir_next(dir, &st);
+    printf("AUDIT directory_vs_usb nopen=%d lend=%d active=%d next=%d\n", before, lent, ink_usb_disk_active(), next);
+    CHECK(before == 0 && lent == 0 && next == 1, "reproduced: directory live while card lent");
+    ink_fs_dir_close(dir);
+    CHECK(ink_usb_disk_stop() == 0, "return card");
+
+    CHECK(ink_fs_write_atomic("/me/source.txt", "COPY", 4) == 0, "source");
+    audit_pause_submit = 1;
+    int id = ink_fs_copy_start("/me/source.txt", "/me/copy.txt");
+    CHECK(id > 0, "copy submitted");
+    delay_ms(100);
+    ink_fs_job_status_t status;
+    CHECK(ink_fs_job_status(id, &status) == 0, "file status");
+    CHECK(AI("job.list", NULL), "list");
+    printf("AUDIT submit_vs_end file_state=%d task=%d list=%s\n", status.state, audit_file_task(), g_result);
+    CHECK(status.state == INK_FS_JOB_DONE && strstr(g_result, "\"state\":\"running\"") != NULL,
+          "reproduced: completed copy reported running");
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t cfg = {.name="audit-files", .fn=audit_task, .stack_bytes=16384, .priority=OSAL_PRIO_NORMAL, .core=-1, .flags=OSAL_TASK_STACK_EXTERNAL};
+    CHECK(osal_task_create(&cfg, NULL) == OSAL_OK, "audit task");
+}

@@ -0,0 +1,12 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ink/hal_storage.h"
+#include "ink/sys/data.h"
+#include "ink/sys/file.h"
+#include "ink/sys/storage.h"

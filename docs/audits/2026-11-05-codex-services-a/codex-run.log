static bool writes_held(void) {
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    bool h = ST.holds > 0;
    osal_mutex_unlock(ST.lock);
    return h;
}

static void storage_task(void *arg) {
    (void)arg;
    for (;;) {
        /* sleep until there is work; only waiting prefetches (they need a quiet panel) look again now and then */
        osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
        bool waiting = false;
        for (int i = 0; i < PREFETCH_MAX && !waiting; i++) waiting = ST.prefetch[i] != NULL;
        osal_mutex_unlock(ST.lock);
        osal_sem_take(ST.kick, waiting ? IDLE_POLL_US * 4 : OSAL_WAIT_FOREVER);
        for (;;) {
            serve_read();
            prefetch_one();
            job_t job;
            int slot = take_job(&job);
            if (slot < 0) break;
            /* wait for a quiet panel and no write hold (reads are still served meanwhile) */
            uint64_t t_wait = osal_now_us();
            bool forced = false;
            for (;;) {
                serve_read();
                bool held = writes_held();
                if (!held && ink_display_busy() <= 0) break;
                if (!held && ST.panel_async && osal_now_us() - t_wait >= ASYNC_PANEL_WAIT_US) {
                    ink_probe_count("storage.writes_pausing_panel");
                    break;
                }
                if (held && osal_now_us() - job.queued_us > MAX_DEFER_US) {
                    forced = true;
                    break;
                }
                osal_sem_take(ST.kick, IDLE_POLL_US); /* a new read wakes us early */
            }
            if (forced) ink_probe_count("storage.forced_writes");
            ink_display_flash_guard(true);
            uint64_t t0 = osal_now_us();
            int r = run_job(&job);
            if (r == NO_PARENT) {
                make_parents(job.path);
                r = run_job(&job);
                if (r == NO_PARENT) r = -1;
            }
            ink_display_flash_guard(false);
            ink_probe_value("storage.write_ms", (double)(osal_now_us() - t0) / 1000.0);
            ink_probe_value("storage.wait_for_idle_ms", (double)(t0 - t_wait) / 1000.0);
            if (r != 0) {
                /* not stored: reads of this path must show what the flash holds, not the lost content */
                ink_probe_count("storage.write_errors");
                osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
                ST.failed++;
                cache_drop(job.path);
                osal_mutex_unlock(ST.lock);
            }
            finish_job(slot);
            if (job.done) job.done(job.ctx, r);
        }
    }
}

int ink_storage_init(void) {
    hal_panel_info_t pi;
    hal_display_get_info(&pi);
    ST.panel_async = pi.async_updates;
    const char *prev = osal_mem_tag("storage");
    ST.lock = osal_mutex_create();
    ST.read_lock = osal_mutex_create();
    ST.kick = osal_sem_create(0, 1);
    ST.read_done = osal_sem_create(0, 1);
    ST.jobs = osal_malloc(sizeof(job_t) * MAX_JOBS, OSAL_MEM_EXTERNAL);
    ST.cache = osal_calloc(CACHE_MAX, sizeof(centry_t), OSAL_MEM_EXTERNAL);
    ST.scratch = osal_malloc(CACHE_FILE_MAX + 1, OSAL_MEM_EXTERNAL);
    ST.path_buf = osal_malloc(PATH_BUF, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!ST.lock || !ST.read_lock || !ST.kick || !ST.read_done || !ST.jobs || !ST.cache || !ST.scratch || !ST.path_buf) return -1;
    memset(ST.jobs, 0, sizeof(job_t) * MAX_JOBS);
    osal_task_cfg_t cfg = {.name = "storage", .fn = storage_task, .stack_bytes = ST_STACK, .priority = ST_PRIO, .core = -1};
    return osal_task_create(&cfg, &ST.task) == OSAL_OK ? 0 : -1;
}

/* A slot for a new job, under the lock; -1 when the queue is full. */
static int free_slot(void) {
    for (int i = 0; i < MAX_JOBS; i++)
        if (!ST.jobs[i].used) return i;
    ink_probe_count("storage.queue_full");
    return -1;
}

int ink_storage_write_atomic(const char *path, const void *data, size_t len) {
    size_t plen = strlen(path) + 1;
    const char *prev = osal_mem_tag("storage");
    char *block = osal_malloc(plen + (len ? len : 1), OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!block) return -1;
    memcpy(block, path, plen);
    memcpy(block + plen, data, len);
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    int last = -1;
    for (int i = 0; i < MAX_JOBS; i++) /* the last job of this path */
        if (ST.jobs[i].used && !strcmp(ST.jobs[i].path, path) && (last < 0 || ST.jobs[i].order > ST.jobs[last].order)) last = i;
    /* coalesce into a queued (not in-flight) replace, when nothing follows it: newest content wins */
    int slot = last >= 0 && ST.jobs[last].kind == J_WRITE && !ST.jobs[last].inflight && !ST.jobs[last].done ? last : -1;
    char *old = NULL;
    uint64_t queued = osal_now_us();
    uint32_t order = 0;
    if (slot >= 0) {
        old = ST.jobs[slot].path;
        queued = ST.jobs[slot].queued_us; /* keeps its place in line */
        order = ST.jobs[slot].order;
    } else {
        slot = free_slot();
        if (slot >= 0) {
            ST.pending++;
            order = ++ST.order;
        }
    }
    if (slot < 0) {
        osal_mutex_unlock(ST.lock);
        osal_free(block);
        return -1;
    }
    ST.jobs[slot] = (job_t){.path = block, .data = (uint8_t *)block + plen, .len = len, .queued_us = queued,
                            .seq = ++ST.seq, .order = order, .kind = J_WRITE, .used = true};
    cache_put(path, data, (int)len); /* reads after this write never need the flash */
    osal_mutex_unlock(ST.lock);
    osal_free(old);
    osal_sem_give(ST.kick);
    return 0;
}

static int submit(job_kind_t kind, const char *path, const void *data, size_t len, ink_storage_done_fn done, void *ctx) {
    size_t plen = strlen(path) + 1;
    const char *prev = osal_mem_tag("storage");
    char *block = osal_malloc(plen, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!block) return -1;
    memcpy(block, path, plen);
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    int slot = free_slot();
    if (slot < 0) {
        osal_mutex_unlock(ST.lock);
        osal_free(block);
        return -1;
    }
    ST.pending++;
    ST.jobs[slot] = (job_t){.path = block, .data = data, .len = len, .queued_us = osal_now_us(), .seq = ++ST.seq, .order = ++ST.order,
                            .kind = (uint8_t)kind, .used = true, .done = done, .ctx = ctx};
    if (kind == J_WRITE) cache_put(path, data, (int)len);
    else if (kind == J_REMOVE) cache_put(path, NULL, -1);
    else cache_drop(path);
    osal_mutex_unlock(ST.lock);
    osal_sem_give(ST.kick);
    return 0;
}

int ink_storage_write_borrow(const char *path, const void *data, size_t len, ink_storage_done_fn done, void *ctx) {
    return submit(J_WRITE, path, data, len, done, ctx);
}

int ink_storage_append(const char *path, const void *data, size_t len, ink_storage_done_fn done, void *ctx) {
    return submit(J_APPEND, path, data, len, done, ctx);
}

int ink_storage_remove(const char *path, ink_storage_done_fn done, void *ctx) { return submit(J_REMOVE, path, NULL, 0, done, ctx); }

/* Hand a request to the storage task and wait for it. */
static void request(read_req_t *req) {
    osal_mutex_lock(ST.read_lock, OSAL_WAIT_FOREVER);
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    ST.rreq = req;
    osal_mutex_unlock(ST.lock);
    osal_sem_give(ST.kick);
    osal_sem_take(ST.read_done, OSAL_WAIT_FOREVER);
    osal_mutex_unlock(ST.read_lock);
}

void ink_storage_run(void (*fn)(void *arg), void *arg, bool guarded) {
    if (osal_task_self() == ST.task) {
        if (guarded) ink_display_flash_guard(true);
        fn(arg);
        if (guarded) ink_display_flash_guard(false);
        return;
    }
    read_req_t req = {.fn = fn, .arg = arg, .guarded = guarded};
    request(&req);
}

typedef struct {
    const char *path;
    int64_t size;
} size_req_t;

static void size_fn(void *arg) {
    size_req_t *q = arg;
    q->size = hal_fs_size(q->path);
}

int64_t ink_storage_size(const char *path) {
    size_req_t q = {.path = path};
    ink_storage_run(size_fn, &q, true);
    return q.size;
}

#define LOAD_CHUNK 2048 /* the flash guard is let go between pieces: the panel may scan */

typedef struct {
    const char *path;
    uint8_t *buf;
    size_t cap;
    int64_t got;
} load_req_t;

static void load_fn(void *arg) { /* no guard from the caller: taken per piece */
    load_req_t *q = arg;
    q->got = -1;
    ink_display_flash_guard(true);
    hal_file_t *f = hal_fs_open(q->path, HAL_O_READ);
    ink_display_flash_guard(false);
    if (!f) return;
    size_t done = 0;
    bool ok = true;
    while (done < q->cap) {
        size_t n = q->cap - done < LOAD_CHUNK ? q->cap - done : LOAD_CHUNK;
        ink_display_flash_guard(true);
        ssize_t r = hal_fs_read(f, q->buf + done, n);
        ink_display_flash_guard(false);
        if (r <= 0) {
            ok = r == 0;
            break;
        }
        done += (size_t)r;
    }
    ink_display_flash_guard(true);
    hal_fs_close(f);
    ink_display_flash_guard(false);
    if (ok) q->got = (int64_t)done;
}

int ink_storage_load(const char *path, void **out, size_t *len) {
    *out = NULL;
    *len = 0;
    int64_t size = ink_storage_size(path);
    if (size < 0) return INK_STORAGE_NO_FILE;
    if (size == 0) return 0;
    const char *prev = osal_mem_tag("storage");
    uint8_t *buf = osal_malloc((size_t)size, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!buf) return INK_STORAGE_LOAD_FAILED;
    load_req_t q = {.path = path, .buf = buf, .cap = (size_t)size};
    ink_storage_run(load_fn, &q, false);
    if (q.got != size) {
        osal_free(buf);
        return INK_STORAGE_LOAD_FAILED;
    }
    *out = buf;
    *len = (size_t)size;
    return 0;
}

void ink_storage_free(void *block) { osal_free(block); }

typedef struct {
    uint64_t total, free;
    int r;
} volume_req_t;

static void volume_fn(void *arg) {
    volume_req_t *q = arg;
    hal_fs_volume_info_t vi;
    q->r = hal_fs_volume_info("/user", &vi);
    if (q->r == 0) {
        q->total = vi.total_bytes;
        q->free = vi.free_bytes;
    }
}

int ink_storage_volume(uint64_t *total_bytes, uint64_t *free_bytes) {
    volume_req_t q = {0};
    ink_storage_run(volume_fn, &q, true);
    if (q.r != 0) return -1;
    if (total_bytes) *total_bytes = q.total;
    if (free_bytes) *free_bytes = q.free;
    return 0;
}

int ink_storage_read(const char *path, void *buf, size_t cap) {
    if (osal_task_self() == ST.task) return read_guarded(path, buf, cap);
    read_req_t req = {.path = path, .buf = buf, .cap = cap, .result = -1};
    request(&req);
    return req.result;
}

void ink_storage_prefetch(const char *path) {
    size_t n = strlen(path) + 1;
    const char *prev = osal_mem_tag("storage");
    char *copy = osal_malloc(n, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!copy) return;
    memcpy(copy, path, n);
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    int slot = -1;
    for (int i = 0; i < PREFETCH_MAX; i++) {
        if (ST.prefetch[i] && !strcmp(ST.prefetch[i], path)) slot = -2;
        if (slot == -1 && !ST.prefetch[i]) slot = i;
    }
    if (slot >= 0) ST.prefetch[slot] = copy;
    osal_mutex_unlock(ST.lock);
    if (slot < 0) osal_free(copy);
    else osal_sem_give(ST.kick);
}

void ink_storage_hold_writes(bool hold) {
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    ST.holds += hold ? 1 : -1;
    if (ST.holds < 0) ST.holds = 0;
    osal_mutex_unlock(ST.lock);
    if (!hold) osal_sem_give(ST.kick);
}

int ink_storage_pending(void) {
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    int n = ST.pending;
    osal_mutex_unlock(ST.lock);
    return n;
}

int ink_storage_failed(void) {
    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
    int n = ST.failed;
    osal_mutex_unlock(ST.lock);
    return n;
}
/*
 * The data store on the soft bus: collections that say so are readable and
 * writable by the AI, the hub and other apps through capabilities, always those
 * of the current member. Credentials and the like never say so.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/sys/cap.h"
#include "ink/sys/data.h"
#include "ink/sys/json.h"

#define VALUE_CAP (INK_DB_RECORD_MAX + 1)
#define RESULT_CAP (2 * INK_DB_RECORD_MAX + 512) /* a record goes in as it is: a page has room for at least one, whole */
#define UNDO_MS 10000

static const char *const SRC_NAME[] = {"touch", "key", "ai", "system", "app", "remote", "confirmed"};

static const ink_db_def_t *open_def(ink_call_t *c, bool write, ink_db_t **out) {
    char name[INK_DB_NAME_MAX];
    ink_args_get_str(&c->args, "collection", name, sizeof name);
    const ink_db_def_t *d = ink_db_find_def(name);
    if (!d || !d->json || !(write ? d->ai_write : d->ai_read)) {
        c->rc.status = d ? INK_RC_REJECTED : INK_RC_INVALID;
        snprintf(c->rc.detail, sizeof c->rc.detail, "%s", d ? "this collection is not open to this" : "no such collection");
        return NULL;
    }
    *out = ink_db_open(d, NULL);
    if (!*out) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "cannot open the collection");
        return NULL;
    }
    return d;
}

static void rec_json(ink_jw_t *w, const ink_rec_t *r, const char *value) {
    ink_jw_raw(w, "{\"id\":");
    ink_jw_int(w, r->id);
    ink_jw_raw(w, ",\"sort\":");
    ink_jw_int(w, r->sort);
    ink_jw_raw(w, ",\"updated_s\":");
    ink_jw_int(w, r->updated_s);
    ink_jw_raw(w, ",\"by\":");
    ink_jw_str(w, r->src < sizeof SRC_NAME / sizeof SRC_NAME[0] ? SRC_NAME[r->src] : "?");
    ink_jw_raw(w, ",\"value\":");
    ink_jw_raw(w, value[0] ? value : "null");
    ink_jw_raw(w, "}");
}

static void cap_collections(ink_call_t *c) { /* exec.bg: opening one may wait for the flash */
    char *out = osal_malloc(RESULT_CAP, OSAL_MEM_EXTERNAL);
    if (!out) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "out of memory");
        return;
    }
    ink_jw_t w;
    ink_jw_init(&w, out, RESULT_CAP);
    ink_jw_raw(&w, "[");
    bool first = true;
    for (int i = 0;; i++) {
        const ink_db_def_t *d = ink_db_def_at(i);
        if (!d) break;
        if (!d->json || !d->ai_read) continue;
        ink_db_t *db = ink_db_open(d, NULL);
        ink_jw_raw(&w, first ? "{\"name\":" : ",{\"name\":");
        first = false;
        ink_jw_str(&w, d->name);
        ink_jw_raw(&w, ",\"title\":");
        ink_jw_str(&w, d->title ? d->title : d->name);
        ink_jw_raw(&w, ",\"count\":");
        ink_jw_int(&w, db ? ink_db_count(db) : 0);
        ink_jw_raw(&w, d->ai_write ? ",\"writable\":true}" : "}");
        ink_db_close(db);
    }
    ink_jw_raw(&w, "]");
    if (w.overflow) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "too long");
    } else ink_cap_result(c, out);
    osal_free(out);
}

/* Cursor as text: "<sort>:<id>". */
static bool parse_cursor(const char *s, ink_db_cursor_t *cur) {
    char *end;
    long long sort = strtoll(s, &end, 10);
    if (end == s || *end != ':') return false;
    cur->sort = sort;
    cur->id = (uint32_t)strtoul(end + 1, &end, 10);
    cur->started = true;
    return !*end;
}

static void cap_list(ink_call_t *c) {
    ink_db_t *db;
    if (!open_def(c, false, &db)) return;
    char *out = osal_malloc(RESULT_CAP + VALUE_CAP, OSAL_MEM_EXTERNAL);
    if (!out) {
        ink_db_close(db);
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "out of memory");
        return;
    }
    char *value = out + RESULT_CAP;
    int64_t limit = 20;
    ink_args_get_int(&c->args, "limit", &limit);
    bool oldest = false;
    ink_args_get_bool(&c->args, "oldest_first", &oldest);
    ink_db_cursor_t cur = {.desc = !oldest};
    char cursor[40];
    if (ink_args_get_str(&c->args, "cursor", cursor, sizeof cursor) > 0 && !parse_cursor(cursor, &cur)) {
        c->rc.status = INK_RC_INVALID;
        snprintf(c->rc.detail, sizeof c->rc.detail, "bad cursor");
        osal_free(out);
        ink_db_close(db);
        return;
    }
    ink_jw_t w;
    ink_jw_init(&w, out, RESULT_CAP - 64);
    ink_jw_raw(&w, "{\"records\":[");
    bool more = false, first = true;
    ink_db_cursor_t last = cur;
    for (int n = 0;; n++) {
        ink_rec_t r;
        ink_db_cursor_t try_cur = last;
        int got = ink_db_next(db, &try_cur, &r, value, VALUE_CAP - 1);
        if (got <= 0) break;
        if (n >= limit) {
            more = true;
            break;
        }
        size_t before = w.len;
        if (!first) ink_jw_raw(&w, ",");
        value[r.len < VALUE_CAP - 1 ? r.len : VALUE_CAP - 1] = 0;
        rec_json(&w, &r, value);
        if (w.overflow) { /* the next page starts with this one */
            w.overflow = false;
            w.len = before;
            out[w.len] = 0;
            more = true;
            break;
        }
        first = false;
        last = try_cur;
    }
    ink_jw_raw(&w, "]");
    if (more && last.started) snprintf(out + w.len, 64, ",\"next\":\"%lld:%u\"}", (long long)last.sort, (unsigned)last.id);
    else snprintf(out + w.len, 64, "}");
    ink_cap_result(c, out);
    osal_free(out);
    ink_db_close(db);
}

static void cap_get(ink_call_t *c) {
    ink_db_t *db;
    if (!open_def(c, false, &db)) return;
    int64_t id = 0;
    ink_args_get_int(&c->args, "id", &id);
    char *out = osal_malloc(RESULT_CAP, OSAL_MEM_EXTERNAL);
    char *value = out ? osal_malloc(VALUE_CAP, OSAL_MEM_EXTERNAL) : NULL;
    ink_rec_t r;
    if (!value) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "out of memory");
    } else if (ink_db_get(db, (uint32_t)id, &r, value, VALUE_CAP - 1) != INK_DB_OK) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "no such record");
    } else {
        value[r.len < VALUE_CAP - 1 ? r.len : VALUE_CAP - 1] = 0;
        ink_jw_t w;
        ink_jw_init(&w, out, RESULT_CAP);
        rec_json(&w, &r, value);
        if (!w.overflow) ink_cap_result(c, out);
        else {
            c->rc.status = INK_RC_FAILED;
            snprintf(c->rc.detail, sizeof c->rc.detail, "too long");
        }
    }
    osal_free(value);
    osal_free(out);
    ink_db_close(db);
}

static void put_result(ink_call_t *c, const ink_db_def_t *d, int r, uint32_t id) {
    if (r != INK_DB_OK) {
        c->rc.status = r == INK_DB_ERR_FULL ? INK_RC_REJECTED : INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "%s", r == INK_DB_ERR_FULL ? "the collection is full" : "not written");
        return;
    }
    snprintf(c->rc.object, sizeof c->rc.object, "%.32s#%u", d->name, (unsigned)id);
}

static void cap_put(ink_call_t *c) {
    ink_db_t *db;
    const ink_db_def_t *d = open_def(c, true, &db);
    if (!d) return;
    const ink_arg_t *v = ink_args_find(&c->args, "value");
    int64_t id = 0, sort = 0;
    ink_args_get_int(&c->args, "id", &id);
    bool has_sort = ink_args_get_int(&c->args, "sort", &sort);
    if (!has_sort) {
        int64_t wall = osal_wall_us();
        sort = wall > 0 ? wall / 1000000 : 0;
    }
    bool existed = id && ink_db_get(db, (uint32_t)id, NULL, NULL, 0) == INK_DB_OK;
    ink_db_write_t wr = {.id = (uint32_t)id, .sort = sort, .data = c->args.text + v->off, .len = v->len, .src = (uint8_t)c->src};
    uint32_t got = 0;
    int r = ink_db_put(db, &wr, &got);
    put_result(c, d, r, got);
    if (r == INK_DB_OK) {
        c->rc.revision = ink_db_last_ver(db);
        if (!existed) { /* a new record can be taken back; an overwrite could not be restored from here */
            ink_args_t undo;
            ink_args_init(&undo);
            ink_args_str(&undo, "collection", d->name);
            ink_args_int(&undo, "id", got);
            ink_cap_undoable(c, "data.delete", &undo, UNDO_MS);
        }
    }
    ink_db_close(db);
}

/* How far something got: on its way to the flash, on the flash, at the hub. By revision (from data.put) or by record. */
static void cap_status(ink_call_t *c) {
    ink_db_t *db;
    const ink_db_def_t *d = open_def(c, false, &db);
    if (!d) return;
    int64_t id = 0, revision = 0;
    uint32_t ver = ink_db_last_ver(db);
    if (ink_args_get_int(&c->args, "id", &id)) {
        ink_rec_t r;
        if (ink_db_get(db, (uint32_t)id, &r, NULL, 0) != INK_DB_OK) {
            c->rc.status = INK_RC_FAILED;
            snprintf(c->rc.detail, sizeof c->rc.detail, "no such record");
            ink_db_close(db);
            return;
        }
        ver = r.ver;
    } else if (ink_args_get_int(&c->args, "revision", &revision)) ver = (uint32_t)revision;
    const char *stage = ver <= ink_db_acked_ver(db) ? "at_hub" : ver <= ink_db_durable_ver(db) ? "on_device" : ink_db_error(db) ? "failed" : "saving";
    char out[64];
    snprintf(out, sizeof out, "{\"revision\":%u,\"stage\":\"%s\"}", (unsigned)ver, stage);
    ink_cap_result(c, out);
    ink_db_close(db);
}

static void cap_delete(ink_call_t *c) {
    ink_db_t *db;
    const ink_db_def_t *d = open_def(c, true, &db);
    if (!d) return;
    int64_t id = 0;
    ink_args_get_int(&c->args, "id", &id);
    int r = ink_db_del(db, (uint32_t)id, (uint8_t)c->src);
    if (r == INK_DB_OK) snprintf(c->rc.object, sizeof c->rc.object, "%.32s#%u", d->name, (unsigned)id);
    else {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "no such record");
    }
    ink_db_close(db);
}

#define COLL "\"collection\":{\"type\":\"string\",\"maxLength\":39}"

static const ink_cap_t DATA_CAPS[] = {
    {.id = "data.collections",
     .title = "有哪些数据集合",
     .output = "{\"type\":\"array\"}",
     .effect = INK_FX_READ,
     .child_ok = true,
     .exec = INK_EXEC_BG,
     .run = cap_collections},
    {.id = "data.list",
     .title = "分页读一个数据集合（默认最新的在前）",
     .input = "{\"type\":\"object\",\"properties\":{" COLL ",\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":50},"
              "\"cursor\":{\"type\":\"string\",\"maxLength\":39},\"oldest_first\":{\"type\":\"boolean\"}},\"required\":[\"collection\"]}",
     .output = "{\"type\":\"object\",\"properties\":{\"records\":{\"type\":\"array\"},\"next\":{\"type\":\"string\"}}}",
     .effect = INK_FX_READ,
     .child_ok = true,
     .exec = INK_EXEC_BG,
     .run = cap_list},
    {.id = "data.get",
     .title = "读一条数据",
     .input = "{\"type\":\"object\",\"properties\":{" COLL ",\"id\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"collection\",\"id\"]}",
     .output = "{\"type\":\"object\"}",
     .effect = INK_FX_READ,
     .child_ok = true,
     .exec = INK_EXEC_BG,
     .run = cap_get},
    {.id = "data.put",
     .title = "写一条数据（新的可以撤销）",
     .input = "{\"type\":\"object\",\"properties\":{" COLL ",\"id\":{\"type\":\"integer\",\"minimum\":1},\"sort\":{\"type\":\"integer\"},"
              "\"value\":{\"type\":\"object\"}},\"required\":[\"collection\",\"value\"]}",
     .effect = INK_FX_LOCAL_WRITE,

@@ -0,0 +1,177 @@
+[
+  {
+    "id": "AUD18-101",
+    "severity": "高",
+    "area": "factory reset / file",
+    "title": "个人目录打开失败被当成不存在，清理返回成功并失去重试标记",
+    "evidence_type": [
+      "复现",
+      "代码核查"
+    ],
+    "locations": [
+      "system/services/file/file_service.c:451",
+      "system/services/file/file_service.c:479",
+      "system/policy/system_actions.c:155"
+    ],
+    "impact": "在真实个人文件存在时，仅令 /content/.m 的一次 hal_fs_opendir 返回 NULL，ink_fs_wipe_personal 仍返回 0，文件可完整访问。开机恢复据此删除 reset.card；原身份清除后默认 owner 可继承遗留文件。标记删除链为代码核查，完整重启链待补充。",
+    "recommendation": "区分不存在与无法打开，不能确定目标不存在时保留清理标记；全部范围确实清空后再确认完成。",
+    "reproduce": "见 experiments/file_probe.c + file_boundary.c 和 file-probe.log：failed_root_open wipe=0 remaining=0；同一探针深目录对照为 result=0 remaining=-3。"
+  },
+  {
+    "id": "AUD18-102",
+    "severity": "高",
+    "area": "file / USB / card ownership",
+    "title": "目录句柄和短文件操作未计入持卡，U 盘独占可在卡仍被使用时成功",
+    "evidence_type": [
+      "复现",
+      "代码核查",
+      "推断"
+    ],
+    "locations": [
+      "system/services/file/file_service.c:346",
+      "system/services/file/file_service.c:401",
+      "system/services/file/file_service.c:488",
+      "system/services/file/file_service.c:969"

   111	/** Allocate the call pool (PSRAM). Before the first call. */
   112	int ink_cap_init(void);
   113	/** Register a static table (it must outlive the program). 0, or -1 when the registry is full. */
   114	int ink_cap_register(const ink_cap_t *table, int n);
   115	const ink_cap_t *ink_cap_find(const char *id);
   116	/** All of them, in the order registered: NULL past the last. */
   117	const ink_cap_t *ink_cap_at(int i);
   118	/** Registered and usable now (a page-bound capability only while its page is on top). */
   119	bool ink_cap_available(const char *id);
   120	
   121	/**
   122	 * Invoke and wait (UI task). `args` may be NULL. `page_gen`, if not 0, is the content version the
   123	 * caller saw (ink_ui_content_version): page-bound capabilities on newer content are refused as
   124	 * stale. Returns rc->status.
   125	 * A capability that runs elsewhere or completes later answers INK_RC_QUEUED here; use
   126	 * ink_cap_call to hear its receipt.
   127	 */
   128	ink_rc_t ink_cap_invoke(const char *id, const ink_args_t *args, ink_source_t src, uint32_t page_gen, ink_receipt_t *rc);
   129	/** The same with JSON arguments (the AI's, the hub's): converted and checked against the schema. */
   130	ink_rc_t ink_cap_invoke_json(const char *id, const char *args_json, ink_source_t src, uint32_t page_gen, ink_receipt_t *rc);
   131	
   132	/*
   133	 * The soft bus (architecture §5.1, detailed design §3): one way to call a capability wherever it
   134	 * is. An address without a node ("reader.next_page") is this device; "hub/<id>" is a capability
   135	 * of the family hub, reached through the remote proxy (JSON-RPC "tools/call"). The handler runs
   136	 * on the capability's executor; the receipt comes back on the caller's.
   137	 */
   138	typedef void (*ink_cap_done_fn)(void *ctx, const ink_receipt_t *rc);
   139	typedef struct {
   140	    ink_source_t src;
   141	    uint32_t page_gen;      /* the content version the caller saw (AI, hub); 0 = not page-bound */
   142	    const char *request_id; /* a repeated id does not run twice: the first receipt again, or "queued" while it runs; NULL = none.
   143	                             * A read that gave a result runs again: it has no effect to repeat, and the result is not kept. */
   144	    const char *args_json;  /* JSON arguments instead of a table (the AI's, the hub's): checked after the gate */
   145	    const char *member;     /* only for this member: another using the device by the time it starts, and it does not run; NULL = whoever */
   146	    ink_exec_t reply_exec;  /* where `done` runs */
   147	    ink_cap_done_fn done;   /* may be NULL */
   148	    void *ctx;
   149	} ink_call_opts_t;
   150	
   151	/**
   152	 * Call a capability (any task). 0: accepted, `done` will run exactly once on reply_exec (at once,
   153	 * if the handler may run here and finishes). -1: not accepted (the call pool is full, an executor
   154	 * it needs cannot run, a request id longer than 39 bytes): `done` is not called.
   155	 * The deadline counts from here. A call that is still waiting to start when it passes is answered
   156	 * "failed" and never runs; one already running is answered "failed", "it may still finish".
   157	 * A request id remembers the last 32 final receipts.
   158	 */
   159	int ink_cap_call(const char *addr, const ink_args_t *args, const ink_call_opts_t *o);
   160	/** In a handler: the receipt comes later, from ink_cap_done (any task, once; it may come before the
   161	 *  handler returns). The call object stays valid until then. A call not done by its deadline is
   162	 *  answered "failed: timed out"; its late ink_cap_done is then ignored. */
   163	void ink_cap_defer(ink_call_t *call);
   164	void ink_cap_done(ink_call_t *call);
   165	/** In a handler that blocks: how long until its deadline (0: past it). What it may still wait for. */
   166	uint32_t ink_cap_time_left_ms(const ink_call_t *call);
   167	/** In a handler: what it found, as JSON text (copied), for the AI, the hub and other apps: rc.result. */

   575	/* ------------------------------------------------------------ remote proxy (device -> hub) */
  1150	static void on_tools(void *ctx, int64_t id, const char *method, const ink_json_t *j, int params) { /* hub task */
  1151	    (void)ctx;
  1152	    bool list = !strcmp(method, "tools/list");
  1153	    if (!list && strcmp(method, "tools/call")) {
  1154	        ink_hub_respond_error(id, -32601, "unknown tools method");
  1155	        return;
  1156	    }
  1157	    /* a request id is compared whole: one that does not fit, or is not a string, could run a retry again */
  1158	    int rid_t = list ? -1 : ink_json_find(j, params, "_meta.request_id");
  1159	    if (rid_t >= 0 && (j->tok[rid_t].type != 4 || j->tok[rid_t].end - j->tok[rid_t].start >= RID_CAP)) {
  1160	        ink_hub_respond_error(id, -32602, "request_id must be a short string");
  1161	        return;
  1162	    }
  1163	    int args_t = list ? -1 : ink_json_find(j, params, "arguments");
  1164	    size_t alen = args_t >= 0 ? (size_t)(j->tok[args_t].end - j->tok[args_t].start) : 0;
  1165	    const char *prev = osal_mem_tag("tools");
  1166	    tool_job_t *t = osal_calloc(1, sizeof *t + alen + 1, OSAL_MEM_EXTERNAL);
  1167	    osal_mem_tag(prev);
  1168	    if (!t) {
  1169	        ink_hub_respond_error(id, -32603, "out of memory");
  1170	        return;
  1171	    }
  1172	    t->id = id;
  1173	    t->list = list;
  1174	    t->received_us = osal_now_us();
  1175	    if (list) {
  1176	        char cursor[16];
  1177	        if (ink_json_str(j, ink_json_find(j, params, "cursor"), cursor, sizeof cursor) > 0) t->cursor = atoi(cursor);
  1178	        ink_json_str(j, ink_json_find(j, params, "domain"), t->domain, sizeof t->domain);
  1179	    }
  1180	    if (!list) {
  1181	        if (ink_json_str(j, ink_json_find(j, params, "name"), t->name, sizeof t->name) < 0) {
  1182	            osal_free(t);
  1183	            ink_hub_respond_error(id, -32602, "tools/call needs a name");
  1184	            return;
  1185	        }
  1186	        int64_t pg = 0;
  1187	        if (ink_json_int(j, ink_json_find(j, params, "page_gen"), &pg) || ink_json_int(j, ink_json_find(j, params, "_meta.page_gen"), &pg))
  1188	            t->page_gen = (uint32_t)pg;
  1189	        ink_json_str(j, ink_json_find(j, params, "_meta.request_id"), t->rid, sizeof t->rid);
  1190	        if (alen) memcpy(t->args, j->text + j->tok[args_t].start, alen);
  1191	        t->args[alen] = 0;
  1192	    }
  1193	    ink_exec_post(INK_EXEC_UI, &t->job, tool_run, t);
  1194	}

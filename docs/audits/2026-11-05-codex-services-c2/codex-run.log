   120	static hal_rect_t native_rect(const lv_area_t *a) {
   121	    int x0, y0, x1, y1;
   122	    ink_logical_to_native(UI.nw, UI.nh, UI.rot, a->x1, a->y1, &x0, &y0);
   123	    ink_logical_to_native(UI.nw, UI.nh, UI.rot, a->x2, a->y2, &x1, &y1);
   124	    int nx0 = x0 < x1 ? x0 : x1, nx1 = x0 < x1 ? x1 : x0;
   125	    int ny0 = y0 < y1 ? y0 : y1, ny1 = y0 < y1 ? y1 : y0;
   126	    return (hal_rect_t){nx0, ny0, nx1 - nx0 + 1, ny1 - ny0 + 1};
   127	}
   128	
   129	static bool touches(hal_rect_t a, hal_rect_t b) {
   130	    return a.x <= b.x + b.w && b.x <= a.x + a.w && a.y <= b.y + b.h && b.y <= a.y + a.h;
   131	}
   132	
   133	static void add_dirty(hal_rect_t r, ink_refresh_t intent) {
   134	    for (int i = 0; i < UI.ndirty; i++) {
   135	        ink_region_t *d = &UI.dirty[i];
   136	        if (d->intent != intent || !touches(d->rect, r)) continue;
   137	        int x0 = d->rect.x < r.x ? d->rect.x : r.x, y0 = d->rect.y < r.y ? d->rect.y : r.y;
   138	        int x1 = d->rect.x + d->rect.w > r.x + r.w ? d->rect.x + d->rect.w : r.x + r.w;
   139	        int y1 = d->rect.y + d->rect.h > r.y + r.h ? d->rect.y + d->rect.h : r.y + r.h;
   140	        d->rect = (hal_rect_t){x0, y0, x1 - x0, y1 - y0};
   141	        return;
   142	    }
   143	    if (UI.ndirty < MAX_DIRTY) {
   144	        UI.dirty[UI.ndirty++] = (ink_region_t){r, intent};
   145	    } else { /* fold into the last region */
   146	        ink_region_t *d = &UI.dirty[MAX_DIRTY - 1];
   147	        int x0 = d->rect.x < r.x ? d->rect.x : r.x, y0 = d->rect.y < r.y ? d->rect.y : r.y;
   148	        int x1 = d->rect.x + d->rect.w > r.x + r.w ? d->rect.x + d->rect.w : r.x + r.w;
   149	        int y1 = d->rect.y + d->rect.h > r.y + r.h ? d->rect.y + d->rect.h : r.y + r.h;
   150	        d->rect = (hal_rect_t){x0, y0, x1 - x0, y1 - y0};
   151	        if (intent > d->intent) d->intent = intent;
   152	    }
   153	}

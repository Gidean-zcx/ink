    62	static void cap_insert(ink_call_t *c) { /* UI task */
    63	    if (!ink_text_focused()) {
    64	        fail(c, INK_RC_FAILED, "no text field has the focus");
    65	        return;
    66	    }
    67	    if (ink_text_type() == INK_TEXT_PASSWORD || ink_text_ai_hidden()) {
    68	        fail(c, INK_RC_REJECTED, "this field is the person's to fill in");
    69	        return;
    70	    }
    71	    char *text = osal_malloc(INK_ARGS_TEXT, OSAL_MEM_EXTERNAL);
    72	    if (!text) {
    73	        fail(c, INK_RC_FAILED, "out of memory");
    74	        return;
    75	    }
    76	    ink_args_get_str(&c->args, "text", text, INK_ARGS_TEXT);
    77	    ink_text_commit_utf8(text);
    78	    osal_free(text);
    79	    snprintf(c->rc.object, sizeof c->rc.object, "text:focused");
    80	}

   155	static bool area_overlap(const lv_area_t *a, const lv_area_t *b) {
   156	    return a->x1 <= b->x2 && b->x1 <= a->x2 && a->y1 <= b->y2 && b->y1 <= a->y2;
   157	}
   158	
   159	static ink_refresh_t intent_for(const lv_area_t *a) {
   160	    bool hit = false;
   161	    ink_refresh_t best = INK_REFRESH_A2;
   162	    for (int i = 0; i < UI.nhints; i++) {
   163	        if (!area_overlap(a, &UI.hints[i].a)) continue;
   164	        if (!hit || UI.hints[i].intent > best) best = UI.hints[i].intent;
   165	        hit = true;
   166	    }
   167	    return hit ? best : UI.frame_intent;
   168	}

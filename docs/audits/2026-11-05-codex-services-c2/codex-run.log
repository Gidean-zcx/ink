     1	# Mechanism stays out of the UI (D-62): a system service draws nothing and knows no page. Only the system shell, the app
     2	# framework and apps touch LVGL. Run: cmake -DSRC=<source dir> -P tests/layering.cmake
     3	# Files that are allowed, and why. Each is a debt with an owner, not a pattern to copy.
     4	set(EXCEPTIONS
     5	  services/ai/ai_service.c # the AI's panel is drawn here until the system shell has its own (system services design §13)
     6	  services/res/exec.c      # only asks the UI task to run a job (ink_ui_kick)
     7	)
     8	file(GLOB_RECURSE SOURCES "${SRC}/system/services/*.c" "${SRC}/system/services/*.h")
     9	set(bad 0)
    10	foreach(f ${SOURCES})
    11	  file(RELATIVE_PATH rel "${SRC}/system" "${f}")
    12	  list(FIND EXCEPTIONS "${rel}" known)
    13	  if(known GREATER -1)
    14	    continue()
    15	  endif()
    16	  file(STRINGS "${f}" lines)
    17	  set(n 0)
    18	  foreach(l IN LISTS lines)
    19	    math(EXPR n "${n} + 1")
    20	    if(l MATCHES "^[ \t]*#[ \t]*include[ \t]*\"(lvgl\\.h|ink/sys/ui\\.h|ink/sys/font\\.h)\"")
    21	      message(SEND_ERROR "${f}:${n}: a system service includes ${CMAKE_MATCH_1}: what it shows belongs to the system shell")
    22	      set(bad 1)
    23	    elseif(l MATCHES "(^|[^a-zA-Z0-9_])(lv_[a-z]+_|ink_ui_[a-z_]+\\()")
    24	      message(SEND_ERROR "${f}:${n}: a system service uses the UI: ${l}")
    25	      set(bad 1)
    26	    endif()
    27	  endforeach()
    28	endforeach()
    29	if(bad)
    30	  message(FATAL_ERROR "mechanism reaches into the UI")
    31	endif()
     1	# Apps use the app framework only (architecture v1.0 §7.3, D-48): no HAL, no OSAL, no driver or board
     2	# header, no HAL or OSAL call. Run: cmake -DSRC=<source dir> -P tests/sdk_boundary.cmake
     3	set(ALLOWED app appreg ai cap clipboard crc data file font layout media members notify settings state storage text textfield textinput time ui)
     4	file(GLOB_RECURSE SOURCES "${SRC}/apps/*.c" "${SRC}/apps/*.h")
     5	set(bad 0)
     6	foreach(f ${SOURCES})
     7	  file(STRINGS "${f}" lines)
     8	  set(n 0)
     9	  foreach(l IN LISTS lines)
    10	    math(EXPR n "${n} + 1")
    11	    if(l MATCHES "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\"")
    12	      set(h "${CMAKE_MATCH_1}")
    13	      if(h MATCHES "^ink/sys/([a-z_]+)\\.h$")
    14	        list(FIND ALLOWED "${CMAKE_MATCH_1}" i)
    15	        if(i LESS 0)
    16	          message(SEND_ERROR "${f}:${n}: ink/sys/${CMAKE_MATCH_1}.h is not part of the app framework")
    17	          set(bad 1)
    18	        endif()
    19	      elseif(NOT h STREQUAL "ink/probe.h")
    20	        message(SEND_ERROR "${f}:${n}: apps include only the framework (ink/sys/...), ink/probe.h and LVGL: ${h}")
    21	        set(bad 1)
    22	      endif()
    23	    elseif(l MATCHES "(^|[^a-zA-Z0-9_])(hal|osal)_[a-z]" OR l MATCHES "(^|[^a-zA-Z0-9_])(HAL|OSAL)_[A-Z]")
    24	      message(SEND_ERROR "${f}:${n}: an app uses the HAL or the OSAL directly: ${l}")
    25	      set(bad 1)
    26	    endif()
    27	  endforeach()
    28	endforeach()
    29	if(bad)
    30	  message(FATAL_ERROR "apps reach below the app framework")
    31	endif()
    32	list(LENGTH SOURCES count)
    33	message(STATUS "sdk-boundary: ${count} app sources use the framework only")


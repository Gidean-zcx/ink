   142	void ink_text_blur(int session) {
   143	    if (!TS.session || (session && session != TS.session)) return;
   144	    text_voice_on_blur();
   145	    const ink_text_client_t *c = TS.client;
   146	    void *ctx = TS.ctx;
   147	    TS.session = 0;
   148	    TS.client = NULL;
   149	    ink_db_close(TS.freq);
   150	    TS.freq = NULL;
   151	    forget_snaps(TS.undo, &TS.nundo);
   152	    forget_snaps(TS.redo, &TS.nredo);
   153	    osal_free(TS.value);
   154	    TS.value = NULL;
   155	    TS.composing[0] = 0;
   156	    ink_state_set_bool(TS.h_focused, false);
   157	    if (c && c->ended) c->ended(ctx);
   158	    if (TS.presenter) TS.presenter();
   159	}

   505	            lv_area_t a;
   506	            lv_obj_update_layout(c);
   507	            lv_obj_get_coords(lv_obj_get_parent(c), &a);
   508	            g_found_x = (a.x1 + a.x2) / 2;
   509	            g_found_y = (a.y1 + a.y2) / 2;
   510	            g_found = true;


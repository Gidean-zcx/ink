   812	static void cap_upgrade(ink_call_t *c) { /* exec.bg: what was downloaded */
   813	    int held = ink_fs_card_hold();
   814	    if (held != INK_FS_OK) {
   815	        fail(c, INK_RC_FAILED, held == INK_FS_ERR_USB ? "the card is lent to a computer" : "no card");
   816	        return;
   817	    }
   818	    char *path = osal_malloc(PKG_PATH_MAX, OSAL_MEM_EXTERNAL);
   819	    pkg_t *p = osal_malloc(sizeof *p, OSAL_MEM_EXTERNAL);
   820	    if (path && p && newest_in(UPDATE_DIR, path, PKG_PATH_MAX, p)) install_cap(c, path);
   821	    else fail(c, INK_RC_FAILED, "nothing downloaded");
   822	    osal_free(p);
   823	    osal_free(path);
   824	    ink_fs_card_release();
   825	}

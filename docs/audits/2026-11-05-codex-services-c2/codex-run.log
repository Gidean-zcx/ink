   702	/* Events to the AI (system services design §1.2 rule 3): what is registered and offered goes to the hub through the
   703	 * hub task, the latest 8 wait for it to be online. */
   704	#define EVENTS_KEPT 8
   705	static struct {
   706	    uint32_t seq;
   707	    int64_t at_s;
   708	    char id[48];
   709	    char member[INK_MEMBER_ID_MAX]; /* whose it is: who it says, or who was there when it happened */
   710	    ink_args_t args;
   711	} EV[EVENTS_KEPT] INK_PSRAM_BSS;
   712	static uint32_t ev_next, ev_sent; /* sequence numbers, under CB.lock */
   713	
   714	static void keep_event(const char *id, const ink_args_t *payload, const char *whose) {
   715	    const ink_cap_t *c = ink_cap_find(id);
   716	    if (!CB.lock || !c || c->form != INK_FORM_EVENT || !exposed(c, INK_SRC_AI)) return;
   717	    int64_t wall = osal_wall_us();
   718	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   719	    uint32_t seq = ++ev_next;
   720	    typeof(EV[0]) *e = &EV[seq % EVENTS_KEPT];
   721	    e->seq = seq;
   722	    e->at_s = wall > 0 ? wall / 1000000 : 0;
   723	    snprintf(e->id, sizeof e->id, "%s", id);
   724	    snprintf(e->member, sizeof e->member, "%s", whose);
   725	    if (payload) e->args = *payload;
   726	    else ink_args_init(&e->args);
   727	    if (ev_next - ev_sent > EVENTS_KEPT) {
   728	        ev_sent = ev_next - EVENTS_KEPT; /* the oldest was just written over */
   729	        ink_probe_count("cap.events_lost_offline");
   730	    }
   731	    osal_mutex_unlock(CB.lock);
   732	    if (ink_hub_online()) ink_hub_wake();
   733	}
   734	
   735	#define EVENT_JSON_CAP 1024
   736	
   737	static void send_events(void) { /* hub task */
   738	    for (;;) {
   739	        osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   740	        bool any = ev_sent != ev_next;
   741	        osal_mutex_unlock(CB.lock);
   742	        if (!any) return;
   743	        char *out = osal_malloc(EVENT_JSON_CAP + sizeof(ink_args_t), OSAL_MEM_EXTERNAL);
   744	        if (!out) return;
   745	        ink_args_t *args = (ink_args_t *)(out + EVENT_JSON_CAP);
   746	        char id[48] = "", whose[INK_MEMBER_ID_MAX] = "";
   747	        int64_t at = 0;
   748	        osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   749	        uint32_t seq = ev_sent + 1;
   750	        const typeof(EV[0]) *e = &EV[seq % EVENTS_KEPT];
   751	        snprintf(id, sizeof id, "%s", e->id);
   752	        snprintf(whose, sizeof whose, "%s", e->member);
   753	        at = e->at_s;
   754	        *args = e->args;
   755	        osal_mutex_unlock(CB.lock);
   756	        /* it goes only while it is theirs who is here: the next one's AI does not hear about it */
   757	        bool theirs = !strcmp(whose, ink_member_current()->id);
   758	        int head = snprintf(out, EVENT_JSON_CAP, "{\"event\":\"%s\",\"at_s\":%lld,\"member\":\"%s\",\"args\":", id, (long long)at, whose);
   759	        int body = ink_args_to_json(args, out + head, EVENT_JSON_CAP - (size_t)head - 2);
   760	        int r = 0;
   761	        if (!theirs) ink_probe_count("cap.event_for_another_member");
   762	        else if (body >= 0) {
   763	            out[head + body] = '}';
   764	            out[head + body + 1] = 0;
   765	            r = ink_hub_notify("device/event", out);
   766	        } else ink_probe_count("cap.event_too_long");
   767	        osal_free(out);
   768	        if (r != 0) return; /* the queue is full: the next time round */
   769	        osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   770	        if (ev_sent + 1 == seq) ev_sent = seq; /* still the oldest: nothing wrote over it */
   771	        osal_mutex_unlock(CB.lock);
   772	    }
   773	}

   375	static void timeout_cb(void *arg) { /* timer task: answer the overdue, re-arm for the rest */
   376	    (void)arg;
   377	    pending_t *due[POOL_N];
   378	    int n = 0;
   379	    uint64_t now = osal_now_us(), next = 0;
   380	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   381	    for (int i = 0; i < POOL_N; i++) {
   382	        pending_t *p = &CB.pool[i];
   383	        if (!p->used || !p->accepted || p->remote || p->replied) continue;
   384	        if (p->deadline_us <= now) {
   385	            ink_receipt_t rc = {.status = INK_RC_FAILED};
   386	            snprintf(rc.detail, sizeof rc.detail, "%s", p->started ? "timed out, it may still finish" : "timed out before it started");
   387	            settle(p, &rc);
   388	            due[n++] = p;
   389	        } else if (!next || p->deadline_us < next) next = p->deadline_us;
   390	    }
   391	    CB.timer_due = next;
   392	    if (next) osal_timer_start(CB.timer, next - now, 0);
   393	    osal_mutex_unlock(CB.lock);
   394	    for (int i = 0; i < n; i++) {
   395	        ink_probe_count("cap.timeouts");
   396	        answer(due[i]);
   397	    }
   398	}

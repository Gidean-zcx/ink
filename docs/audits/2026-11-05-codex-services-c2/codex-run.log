    88	/* The tool list, as the hub gets it: every page parsed, every entry kept. */
    89	static cJSON *g_tools;
    90	static const char *g_method;
    91	static char g_params[128];
    92	
    93	static void ask_event(void *arg) {
    94	    (void)arg;
    95	    sim_hub_request_device(g_method, g_params);
    96	}
    97	
    98	static const char *ask_device(const char *method, const char *params) {
    99	    g_method = method;
   100	    snprintf(g_params, sizeof g_params, "%s", params);
   101	    vtk_event_at(vtk_now() + SIM_MS(1), ask_event, NULL);
   102	    delay_ms(5); /* it has forgotten the last answer by now */
   103	    for (int i = 0; i < 500 && !sim_hub_device_reply(); i++) delay_ms(10);
   104	    return sim_hub_device_reply();
   105	}
   106	
   107	static void fetch_tools(void) {
   108	    g_tools = cJSON_CreateObject();
   109	    char cursor[64] = "{}";
   110	    int pages = 0;
   111	    for (;;) {
   112	        const char *reply = ask_device("tools/list", cursor);
   113	        CHECK(reply != NULL, "the device answers tools/list");
   114	        if (!reply) return;
   115	        cJSON *page = cJSON_Parse(reply);
   116	        const cJSON *result = cJSON_GetObjectItem(page, "result"), *tool;
   117	        CHECK(cJSON_IsArray(cJSON_GetObjectItem(result, "tools")), "page %d is whole JSON with its tools", pages);
   118	        cJSON_ArrayForEach(tool, cJSON_GetObjectItem(result, "tools")) {
   119	            const cJSON *name = cJSON_GetObjectItem(tool, "name");
   120	            CHECK(cJSON_IsString(name) && !cJSON_GetObjectItem(g_tools, name->valuestring), "a tool once, with a name");
   121	            cJSON_AddItemToObject(g_tools, cJSON_IsString(name) ? name->valuestring : "?", cJSON_Duplicate(tool, 1));
   122	        }
   123	        const cJSON *next = cJSON_GetObjectItem(result, "nextCursor");
   124	        pages++;
   125	        if (cJSON_IsString(next)) snprintf(cursor, sizeof cursor, "{\"cursor\":\"%s\"}", next->valuestring);
   126	        cJSON_Delete(page);
   127	        if (!next) break;
   128	    }
   129	    CHECK(pages >= 2, "more than fits one page, so it comes in pages (%d)", pages);
   130	}
   131	
   132	/* What it says it takes against what the table says it must be given (audit AUD15-009: without this a capability could lose
   133	 * its description and the test would not notice). */
   134	static void takes(const char *id, const cJSON *schema, const char *args) {
   135	    CHECK(cJSON_IsObject(schema), "%s: there is a schema", id);
   136	    CHECK(cJSON_IsString(cJSON_GetObjectItem(schema, "type")) && !strcmp(cJSON_GetObjectItem(schema, "type")->valuestring, "object"), "%s: its arguments are an object", id);
   137	    const cJSON *props = cJSON_GetObjectItem(schema, "properties"), *req = cJSON_GetObjectItem(schema, "required"), *r;
   138	    if (!args) {
   139	        CHECK(!cJSON_GetArraySize(props), "%s takes nothing: it says nothing else", id);
   140	        return;
   141	    }
   142	    CHECK(cJSON_GetArraySize(props) > 0, "%s takes something: it says what", id);
   143	    int want = 0;
   144	    char name[32];
   145	    for (const char *p = args; *p; want++) {
   146	        const char *e = strchr(p, ',');
   147	        size_t n = e ? (size_t)(e - p) : strlen(p);
   148	        snprintf(name, sizeof name, "%.*s", (int)n, p);
   149	        bool listed = false;
   150	        cJSON_ArrayForEach(r, req) listed = listed || !strcmp(r->valuestring, name);
   151	        CHECK(listed && cJSON_GetObjectItem(props, name), "%s cannot do without %s: it says so", id, name);
   152	        p += n + (e != NULL);
   153	    }
   154	    CHECK(cJSON_GetArraySize(req) == want, "%s: nothing else is required (%d, %d)", id, cJSON_GetArraySize(req), want);
   155	}
   156	
   157	static void the_tools(void) {
   158	    fetch_tools();
   159	    /* every capability is accounted for */
   160	    int callable = 0;
   161	    for (int i = 0; ink_cap_at(i); i++) {
   162	        const ink_cap_t *c = ink_cap_at(i);
   163	        if (c->form == INK_FORM_EVENT) continue;
   164	        int yes = for_ai(c->id), no = not_for_ai(c->id);
   165	        CHECK((yes >= 0) != (no >= 0), "%s must be in exactly one table: for the AI, or not with the reason", c->id);
   166	        CHECK(c->title && c->title[0], "%s has a title", c->id);
   167	        const cJSON *tool = cJSON_GetObjectItem(g_tools, c->id);
   168	        bool here = !c->activity; /* what belongs to a page is listed on that page */
   169	        if (yes >= 0 && here) {
   170	            CHECK(tool != NULL, "%s is in the tool list the hub gets", c->id);
   171	            const cJSON *title = cJSON_GetObjectItem(tool, "title");
   172	            CHECK(cJSON_IsString(title) && title->valuestring[0], "%s: with a title there", c->id);
   173	            takes(c->id, cJSON_GetObjectItem(tool, "inputSchema"), FOR_AI[yes].args);
   174	        } else {
   175	            if (no >= 0) CHECK(!tool, "%s must not be in it (%s)", c->id, NOT_FOR_AI[no].why);
   176	            cJSON *own = cJSON_Parse(c->input ? c->input : "{\"type\":\"object\"}"); /* not listed from here: what it declares */
   177	            takes(c->id, own, yes >= 0 ? FOR_AI[yes].args : no >= 0 ? NOT_FOR_AI[no].args : NULL);
   178	            cJSON_Delete(own);
   179	        }
   180	        if (yes >= 0) callable++;
   181	    }
   182	    /* nothing in the tables that is not there */
   183	    for (int i = 0; FOR_AI[i].id; i++) CHECK(ink_cap_find(FOR_AI[i].id) != NULL, "%s is in the table but not registered", FOR_AI[i].id);
   184	    for (int i = 0; NOT_FOR_AI[i].id; i++) CHECK(ink_cap_find(NOT_FOR_AI[i].id) != NULL, "%s is in the table but not registered", NOT_FOR_AI[i].id);
   185	    CHECK(callable > 50, "the table is not empty (%d)", callable);
   186	    /* what the design promises for finding things */
   187	    CHECK(AI("caps.domains", NULL) && strstr(g_result, "notify") && strstr(g_result, "file") && strstr(g_result, "app"), "a directory of domains (%s)", g_result);
   188	    CHECK(AI("caps.find", "{\"query\":\"通知\"}") && strstr(g_result, "notify.list"), "and a search (%s)", g_result);
   189	    cJSON_Delete(g_tools);
   190	    g_tools = NULL;
   191	}

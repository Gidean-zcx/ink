   118	static void cap_clip_read(ink_call_t *c) {
   119	    char *text = osal_malloc(INK_CLIP_MAX + 1, OSAL_MEM_EXTERNAL);
   120	    char *out = osal_malloc(INK_CLIP_MAX * 2 + 64, OSAL_MEM_EXTERNAL);
   121	    if (!text || !out) fail(c, INK_RC_FAILED, "out of memory");
   122	    else if (ink_clip_get(text, INK_CLIP_MAX + 1, (uint8_t)c->src, NULL) < 0) fail(c, INK_RC_REJECTED, "the clipboard is not open to this caller (setting ai.read_clipboard)");
   123	    else {
   124	        ink_jw_t w;
   125	        ink_jw_init(&w, out, INK_CLIP_MAX * 2 + 64);
   126	        ink_jw_raw(&w, "{\"text\":");
   127	        ink_jw_str(&w, text);
   128	        ink_jw_raw(&w, "}");
   129	        if (w.overflow) fail(c, INK_RC_FAILED, "too long");
   130	        else ink_cap_result(c, out);
   131	    }
   132	    osal_free(out);
   133	    osal_free(text);
   134	}

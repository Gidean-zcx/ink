    87	/* Cursor as text: "<sort>:<id>". */
    88	static bool parse_cursor(const char *s, ink_db_cursor_t *cur) {
    89	    char *end;
    90	    long long sort = strtoll(s, &end, 10);
    91	    if (end == s || *end != ':') return false;
    92	    cur->sort = sort;
    93	    cur->id = (uint32_t)strtoul(end + 1, &end, 10);
    94	    cur->started = true;
    95	    return !*end;
    96	}

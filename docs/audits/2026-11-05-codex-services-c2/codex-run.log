   228	    lv_obj_set_style_text_font(K.heard, font(), 0);
   229	    lv_obj_set_width(K.heard, LV_PCT(100));
   230	    lv_obj_set_flex_grow(K.heard, 1);
   231	    lv_label_set_long_mode(K.heard, LV_LABEL_LONG_WRAP);
   232	    lv_label_set_text(K.heard, "");
   233	    lv_obj_t *row = lv_obj_create(K.panel);
   234	    lv_obj_remove_style_all(row);
   235	    lv_obj_set_size(row, LV_PCT(100), LV_SIZE_CONTENT);
   236	    lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);
   237	    lv_obj_set_style_pad_column(row, ink_dp(2), 0);
   238	    for (int i = 0; i < 2; i++) {
   239	        lv_obj_t *b = lv_button_create(row);
   240	        ink_ui_style_button(b);
   241	        lv_obj_set_height(b, ink_dp(44));
   242	        lv_obj_set_flex_grow(b, 1);
   243	        lv_obj_add_event_cb(b, i ? on_use_keys : on_said, LV_EVENT_CLICKED, NULL);
   244	        lv_obj_t *l = lv_label_create(b);
   245	        lv_obj_set_style_text_font(l, font(), 0);
   246	        lv_label_set_text(l, i ? "用键盘" : "说完了");
   247	        lv_obj_center(l);
   248	    }
   249	    lv_obj_add_flag(K.panel, LV_OBJ_FLAG_HIDDEN);
   250	    ink_ui_hint_obj(K.root, INK_REFRESH_FAST);
   251	}

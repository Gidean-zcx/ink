   129	/* Before a change: keys in a row, soon after each other and in the same place, are undone together. Nothing of a password is kept. */
   130	static void before_edit(int kind) {
   131	    if (TS.type == INK_TEXT_PASSWORD) return;
   132	    uint64_t now = osal_now_us();
   133	    if (kind != EDIT_OTHER && kind == TS.edit_kind && now - TS.edit_at_us < UNDO_GROUP_US) {
   134	        TS.edit_at_us = now;
   135	        return;
   136	    }
   137	    if (push_snap(TS.undo, &TS.nundo)) forget_snaps(TS.redo, &TS.nredo);
   138	    TS.edit_kind = kind;
   139	    TS.edit_at_us = now;
   140	}

    14	
    15	#define KEY_BACKSPACE '\b'
    16	#define KEY_ENTER '\n'
    17	#define KEY_SWITCH '\1'
    18	#define KEY_SHIFT '\2'
    19	
    20	static struct {
    21	    lv_obj_t *root, *keys, *cands, *composing;
    22	    lv_obj_t *cand_btn[INK_TEXT_PAGE], *cand_label[INK_TEXT_PAGE], *more, *mic;
    23	    lv_obj_t *panel, *status, *heard; /* the voice panel: where the keys were, the same size */
    24	    int first;
    25	    int shown;
    26	    bool symbols, shift;
    27	    int built_for; /* 1 letters, 2 symbols, 3 digits */
    28	} K;
    29	
    30	static const lv_font_t *font(void) {
    31	    hal_panel_info_t pi;
    32	    hal_display_get_info(&pi);
    33	    ink_font_t *cjk = ink_font_for_pt(10, pi.dpi);
    34	    return cjk ? ink_font_lvgl(cjk) : ink_ui_font(0);
    35	}
    36	
    37	static void sync(void);
    38	
    39	static void on_key(lv_event_t *e) {
    40	    char c = (char)(intptr_t)lv_event_get_user_data(e);
    41	    switch (c) {
    42	    case KEY_BACKSPACE: ink_text_backspace(); break;
    43	    case KEY_ENTER: ink_text_enter(); break;
    44	    case KEY_SWITCH:
    45	        K.symbols = !K.symbols;
    46	        sync();
    47	        return;
    48	    case KEY_SHIFT: K.shift = !K.shift; return;
    49	    default:
    50	        if (K.shift && c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
    51	        K.shift = false;
    52	        ink_text_key(c);
    53	        break;
    54	    }
    55	    K.first = 0;
    56	    ink_ui_cause(osal_now_us(), "text.key_to_visible_ms");
    57	}
    58	
    59	static void on_cand(lv_event_t *e) {
    60	    int i = (int)(intptr_t)lv_event_get_user_data(e);
    61	    int first = K.first;
    62	    K.first = 0;
    63	    ink_text_pick(first + i);
    64	    ink_ui_cause(osal_now_us(), "text.key_to_visible_ms");
    65	}
    66	
    67	static void on_more(lv_event_t *e) {
    68	    (void)e;
    69	    K.first += INK_TEXT_PAGE;
    70	    sync();
    71	}
    72	
    73	static lv_obj_t *key(lv_obj_t *row, const char *label, char code, int grow) {
    74	    lv_obj_t *b = lv_button_create(row);
    75	    ink_ui_style_button(b);
    76	    lv_obj_set_style_pad_all(b, ink_dp(2), 0);
    77	    lv_obj_set_height(b, ink_dp(44));
    78	    lv_obj_set_flex_grow(b, (uint8_t)grow);
    79	    lv_obj_add_event_cb(b, on_key, LV_EVENT_CLICKED, (void *)(intptr_t)code);
    80	    lv_obj_t *l = lv_label_create(b);
    81	    lv_obj_set_style_text_font(l, font(), 0);
    82	    lv_label_set_text(l, label);
    83	    lv_obj_center(l);
    84	    return b;
    85	}
    86	
    87	static void on_mic(lv_event_t *e) {
    88	    (void)e;

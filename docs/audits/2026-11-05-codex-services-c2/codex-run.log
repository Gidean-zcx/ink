    98	static void cap_list(ink_call_t *c) {
    99	    ink_db_t *db;
   100	    if (!open_def(c, false, &db)) return;
   101	    char *out = osal_malloc(RESULT_CAP + VALUE_CAP, OSAL_MEM_EXTERNAL);
   102	    if (!out) {
   103	        ink_db_close(db);
   104	        c->rc.status = INK_RC_FAILED;
   105	        snprintf(c->rc.detail, sizeof c->rc.detail, "out of memory");
   106	        return;
   107	    }
   108	    char *value = out + RESULT_CAP;
   109	    int64_t limit = 20;
   110	    ink_args_get_int(&c->args, "limit", &limit);
   111	    bool oldest = false;
   112	    ink_args_get_bool(&c->args, "oldest_first", &oldest);
   113	    ink_db_cursor_t cur = {.desc = !oldest};
   114	    char cursor[40];
   115	    if (ink_args_get_str(&c->args, "cursor", cursor, sizeof cursor) > 0 && !parse_cursor(cursor, &cur)) {
   116	        c->rc.status = INK_RC_INVALID;
   117	        snprintf(c->rc.detail, sizeof c->rc.detail, "bad cursor");
   118	        osal_free(out);
   119	        ink_db_close(db);
   120	        return;
   121	    }
   122	    ink_jw_t w;
   123	    ink_jw_init(&w, out, RESULT_CAP - 64);
   124	    ink_jw_raw(&w, "{\"records\":[");
   125	    bool more = false, first = true;
   126	    ink_db_cursor_t last = cur;
   127	    for (int n = 0;; n++) {
   128	        ink_rec_t r;
   129	        ink_db_cursor_t try_cur = last;
   130	        int got = ink_db_next(db, &try_cur, &r, value, VALUE_CAP - 1);
   131	        if (got <= 0) break;
   132	        if (n >= limit) {
   133	            more = true;
   134	            break;
   135	        }
   136	        size_t before = w.len;
   137	        if (!first) ink_jw_raw(&w, ",");
   138	        value[r.len < VALUE_CAP - 1 ? r.len : VALUE_CAP - 1] = 0;
   139	        rec_json(&w, &r, value);
   140	        if (w.overflow) { /* the next page starts with this one */
   141	            w.overflow = false;
   142	            w.len = before;
   143	            out[w.len] = 0;
   144	            more = true;
   145	            break;
   146	        }
   147	        first = false;
   148	        last = try_cur;
   149	    }
   150	    ink_jw_raw(&w, "]");
   151	    if (more && last.started) snprintf(out + w.len, 64, ",\"next\":\"%lld:%u\"}", (long long)last.sort, (unsigned)last.id);
   152	    else snprintf(out + w.len, 64, "}");
   153	    ink_cap_result(c, out);
   154	    osal_free(out);
   155	    ink_db_close(db);
   156	}

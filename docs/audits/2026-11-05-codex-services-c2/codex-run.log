   853	        unlock();
   854	        return INK_DB_ERR_NOMEM;
   855	    }
   856	    int64_t wall = osal_wall_us();
   857	    *t = (rec_t){.id = id, .ver = db->last_ver + 1, .sort = old->sort, .updated_s = wall > 0 ? wall / 1000000 : 0, .src = src, .schema = old->schema, .dead = true};
   858	    if (!frame_add(db, OP_DEL, t, NULL)) {

   951	void ink_cap_undoable(ink_call_t *call, const char *cap, const ink_args_t *args, uint32_t ms) {
   952	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   953	    undo_t *u = &UNDO[undo_next];
   954	    undo_next = (undo_next + 1) % UNDO_MAX;
   955	    snprintf(u->object, sizeof u->object, "%s", call->rc.object);
   956	    snprintf(u->cap, sizeof u->cap, "%s", cap);
   957	    snprintf(u->member, sizeof u->member, "%s", ink_member_current()->id);
   958	    if (args) u->args = *args;
   959	    else ink_args_init(&u->args);
   960	    u->until_us = osal_now_us() + (uint64_t)ms * 1000u;
   961	    osal_mutex_unlock(CB.lock);
   962	    call->rc.undo_ms = ms;
   963	}
   964	
   965	static void undo_done(void *ctx, const ink_receipt_t *rc) {
   966	    ink_call_t *c = ctx;
   967	    if (rc->status == INK_RC_DONE) {
   968	        c->rc.status = INK_RC_UNDONE;
   969	        snprintf(c->rc.say, sizeof c->rc.say, "撤销了");
   970	    } else {
   971	        c->rc.status = rc->status;
   972	        snprintf(c->rc.detail, sizeof c->rc.detail, "%s", rc->detail);
   973	    }
   974	    ink_cap_done(c);
   975	}
   976	
   977	static void cap_undo(ink_call_t *c) {
   978	    char object[48];
   979	    ink_args_get_str(&c->args, "object", object, sizeof object);
   980	    undo_t u = {0};
   981	    bool found = false;
   982	    uint64_t now = osal_now_us();
   983	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   984	    for (int i = 0; i < UNDO_MAX && !found; i++) {
   985	        undo_t *e = &UNDO[i];
   986	        if (e->until_us > now && !strcmp(e->object, object) && !strcmp(e->member, ink_member_current()->id)) {
   987	            u = *e;
   988	            e->until_us = 0; /* once */
   989	            found = true;
   990	        }
   991	    }
   992	    osal_mutex_unlock(CB.lock);
   993	    if (!found) {
   994	        reject(&c->rc, INK_RC_FAILED, "nothing to undo, or too late");
   995	        return;
   996	    }
   997	    snprintf(c->rc.object, sizeof c->rc.object, "%s", object);
   998	    ink_cap_defer(c); /* the inverse may run on another executor: the member's own undo, no second confirmation */
   999	    ink_call_opts_t o = {.src = INK_SRC_SYSTEM, .reply_exec = INK_EXEC_DIRECT, .done = undo_done, .ctx = c};
  1000	    if (ink_cap_call(u.cap, &u.args, &o) != 0) {
  1001	        reject(&c->rc, INK_RC_FAILED, "busy");
  1002	        ink_cap_done(c);
  1003	    }
  1004	}

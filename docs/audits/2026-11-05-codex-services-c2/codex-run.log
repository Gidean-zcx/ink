    64	/* Who may see it: the AI and the hub only what is exposed to them; touch, keys and the system
    65	 * are the owner's own controls. */
    66	static bool exposed(const ink_cap_t *c, ink_source_t src) {
    67	    if (!c->expose) return true;
    68	    switch (src) {
    69	    case INK_SRC_AI: return c->expose & INK_EXPOSE_AI;
    70	    case INK_SRC_REMOTE: return c->expose & INK_EXPOSE_REMOTE;
    71	    case INK_SRC_APP: return c->expose & INK_EXPOSE_APP;
    72	    default: return true;
    73	    }
    74	}
    75	
    76	/* Default confirmation by side effect (foundation §6.2). Direct manipulation (touch, keys) is the
    77	 * member's own confirmation except where a PIN is required. */
    78	static ink_confirm_t confirm_for(const ink_cap_t *c, ink_source_t src) {
    79	    ink_confirm_t k = INK_CONFIRM_NONE;
    80	    switch (c->effect) {
    81	    case INK_FX_LOCAL_DESTRUCTIVE:
    82	    case INK_FX_EXTERNAL:
    83	    case INK_FX_SYSTEM: k = INK_CONFIRM_DEVICE; break;
    84	    default: break;
    85	    }
    86	    if (src == INK_SRC_CONFIRMED) return INK_CONFIRM_NONE;
    87	    if (c->parent_pin && ink_member_any_pin()) return INK_CONFIRM_PARENT;
    88	    if (c->ask_by_hand) return INK_CONFIRM_DEVICE;
    89	    if (src == INK_SRC_TOUCH || src == INK_SRC_KEY || src == INK_SRC_SYSTEM) return INK_CONFIRM_NONE;
    90	    return k;
    91	}

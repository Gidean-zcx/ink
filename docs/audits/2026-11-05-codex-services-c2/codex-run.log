    76	int ink_text_focus(const ink_text_cfg_t *cfg, const ink_text_client_t *client, void *ctx) {
    77	    if (!cfg) return -1;
    78	    if (TS.session) ink_text_blur(TS.session);
    79	    text_voice_clear_notice();
    80	    size_t cap = cfg->max ? (cfg->max < VALUE_MAX ? cfg->max : VALUE_MAX) : VALUE_DEFAULT;
    81	    char *v = osal_malloc(cap + 1, OSAL_MEM_EXTERNAL);
    82	    if (!v) return -1;
    83	    snprintf(v, cap + 1, "%s", cfg->initial ? cfg->initial : "");
    84	    TS.value = v;
    85	    TS.cap = cap;
    86	    TS.cursor = TS.anchor = strlen(v);
    87	    TS.edit_kind = EDIT_NONE;
    88	    TS.type = cfg->type;
    89	    TS.enter = cfg->enter;
    90	    TS.ai_hidden = cfg->ai_hidden;
    91	    snprintf(TS.hint, sizeof TS.hint, "%s", cfg->hint ? cfg->hint : "");
    92	    TS.composing[0] = 0;
    93	    TS.client = client;
    94	    TS.ctx = ctx;
    95	    TS.session = ++TS.next_session;
    96	    TS.cands_valid = false;
    97	    if (cfg->type == INK_TEXT_PLAIN) {
    98	        TS.freq = ink_db_open(&USER_FREQ, NULL);
    99	        py_want_dict(on_dict_ready);
   100	    }
   101	    ink_state_set_bool(TS.h_focused, true);
   102	    ink_probe_count("text.sessions");
   103	    if (TS.presenter) TS.presenter();
   104	    return TS.session;
   105	}

  1104	} tool_job_t;
  1105	
  1106	static void tool_done(void *ctx, const ink_receipt_t *rc) { /* where the capability finished */
  1107	    tool_job_t *t = ctx;
  1108	    char key[48];
  1109	    snprintf(key, sizeof key, "tools.calls.%s", ink_rc_name(rc->status));
  1110	    ink_probe_count(key);
  1111	    const char *prev = osal_mem_tag("tools");
  1112	    size_t cap = 768 + (rc->result ? strlen(rc->result) : 0);
  1113	    char *out = osal_malloc(cap, OSAL_MEM_EXTERNAL);
  1114	    osal_mem_tag(prev);
  1115	    if (!out || ink_receipt_json(rc, out, cap) < 0) ink_hub_respond_error(t->id, -32603, out ? "receipt too long" : "out of memory");
  1116	    else ink_hub_respond(t->id, out);
  1117	    osal_free(out);
  1118	    osal_free(t);
  1119	}
  1120	
  1121	#define TOOLS_PAGE 6144
  1122	
  1123	static void tool_run(void *arg) { /* UI task */
  1124	    tool_job_t *t = arg;
  1125	    if (t->list) { /* paged (architecture: progressive disclosure): caps.domains and caps.find say what there is */
  1126	        const char *prev = osal_mem_tag("tools");
  1127	        char *out = osal_malloc(TOOLS_PAGE, OSAL_MEM_EXTERNAL);
  1128	        osal_mem_tag(prev);
  1129	        int next = -1, n = out ? ink_cap_manifest_page(t->cursor, t->domain[0] ? t->domain : NULL, out + 9, TOOLS_PAGE - 48, &next) : -1;
  1130	        if (n < 0) ink_hub_respond_error(t->id, -32603, "out of memory");
  1131	        else {
  1132	            memcpy(out, "{\"tools\":", 9);
  1133	            if (next >= 0) snprintf(out + 9 + n, 48, ",\"nextCursor\":\"%d\"}", next);
  1134	            else snprintf(out + 9 + n, 48, "}");
  1135	            ink_hub_respond(t->id, out);
  1136	        }
  1137	        osal_free(out);
  1138	        osal_free(t);
  1139	        return;
  1140	    }
  1141	    ink_ui_cause(t->received_us, "ai.tool_to_visible_ms"); /* what the capability changes on screen */
  1142	    ink_call_opts_t o = {.src = INK_SRC_AI, .page_gen = t->page_gen, .request_id = t->rid[0] ? t->rid : NULL, .args_json = t->args,
  1143	                         .reply_exec = INK_EXEC_DIRECT, .done = tool_done, .ctx = t};
  1144	    if (ink_cap_call(t->name, NULL, &o) != 0) {
  1145	        ink_hub_respond_error(t->id, -32603, "busy");
  1146	        osal_free(t);
  1147	    }
  1148	}

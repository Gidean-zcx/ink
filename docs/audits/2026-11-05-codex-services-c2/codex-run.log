   193	/* A record as large as there can be, all the way to the hub: a tool's answer as the model gets it (audit AUD15-004). */
   194	static const ink_db_def_t BIG = {.name = "test.big", .title = "大记录", .scope = INK_DB_DEVICE, .schema = 1, .json = true, .ai_read = true};
   195	
   196	static void a_large_answer(void) {
   197	    CHECK(ink_db_register(&BIG) == 0, "registered");
   198	    ink_db_t *db = ink_db_open(&BIG, NULL);
   199	    static char v[INK_DB_RECORD_MAX];
   200	    size_t n = (size_t)snprintf(v, sizeof v, "{\"text\":\"");
   201	    while (n + 3 < sizeof v) v[n++] = 'x';
   202	    v[n++] = '"';
   203	    v[n++] = '}';
   204	    uint32_t id = 0;
   205	    ink_db_write_t w = {.data = v, .len = n};
   206	    CHECK(db && ink_db_put(db, &w, &id) == INK_DB_OK, "the largest there can be");
   207	    ink_db_close(db);
   208	    char params[96];
   209	    snprintf(params, sizeof params, "{\"name\":\"data.get\",\"arguments\":{\"collection\":\"test.big\",\"id\":%u}}", (unsigned)id);
   210	    const char *reply = ask_device("tools/call", params);


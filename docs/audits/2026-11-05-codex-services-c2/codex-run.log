    57	static void put_text(char *out, size_t cap, size_t *n, const char *s) {
    58	    size_t have = strlen(s);
    59	    if (*n + have >= cap) have = cap - *n - 1;
    60	    while (have && (s[have] & 0xC0) == 0x80) have--; /* not in the middle of a character */
    61	    memcpy(out + *n, s, have);
    62	    *n += have;
   172	/* Out of the table, whole: whoever got it is the only one who decides it. */
   173	static bool take(uint32_t token, held_t *out) {
   174	    bool hit = false;
   175	    ink_svc_lock();
   176	    for (int i = 0; i < MAX_HELD && !hit; i++)
   177	        if (CF.held[i].used && CF.held[i].token == token) {
   178	            *out = CF.held[i];
   179	            CF.held[i].used = false;
   180	            hit = true;
   181	        }
   182	    ink_svc_unlock();
   183	    return hit;
   184	}
   185	
   186	static void expiry_cb(void *arg) { /* the timer task */
   187	    (void)arg;
   188	    uint64_t now = osal_now_us();
   189	    for (;;) {
   190	        uint32_t token = 0;
   191	        const char *cap = NULL;
   192	        char who[INK_MEMBER_ID_MAX] = "";
   193	        ink_svc_lock();
   194	        for (int i = 0; i < MAX_HELD && !token; i++)
   195	            if (CF.held[i].used && CF.held[i].expires_us <= now) {
   196	                CF.held[i].used = false;
   197	                token = CF.held[i].token;
   198	                cap = CF.held[i].cap->id;
   199	                snprintf(who, sizeof who, "%s", CF.held[i].member);
   200	            }
   201	        ink_svc_unlock();
   202	        if (!token) break;
   203	        tell(token, cap, "expired", NULL, who);
   204	    }
   205	    changed();
   206	}

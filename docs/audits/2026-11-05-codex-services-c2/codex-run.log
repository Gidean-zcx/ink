   430	void ink_text_select_word(size_t at) {
   431	    if (!TS.session) return;
   432	    flush_composing();
   433	    size_t i = to_bytes(at);
   434	    if (!TS.value[i] && i) i = prev_char(i); /* past the end: the last one */
   435	    size_t lo = i, hi = next_char(i);
   436	    if (ascii_word((unsigned char)TS.value[i])) {
   437	        while (lo && ascii_word((unsigned char)TS.value[lo - 1])) lo--;
   438	        while (ascii_word((unsigned char)TS.value[hi])) hi++;
   439	    } else if (han_at(i)) { /* no word list to go by yet: two characters, the commonest length; the arrows do the rest */
   440	        if (han_at(hi)) hi = next_char(hi);
   441	        else if (lo && han_at(prev_char(lo))) lo = prev_char(lo);
   442	    }
   443	    TS.anchor = lo;
   444	    TS.cursor = hi;
   445	    moved();
   446	}
   447	
   448	void ink_text_move(int chars, bool end) {
   449	    if (!TS.session) return;
   450	    flush_composing();
   451	    bool selected = TS.cursor != TS.anchor;
   452	    size_t lo = TS.cursor < TS.anchor ? TS.cursor : TS.anchor, hi = TS.cursor < TS.anchor ? TS.anchor : TS.cursor;
   453	    size_t p = selected ? (end ? hi : lo) : TS.cursor;
   454	    for (; chars > 0; chars--) p = next_char(p);
   455	    for (; chars < 0; chars++) p = prev_char(p);
   456	    if (!selected) TS.cursor = TS.anchor = p;
   457	    else if (end) {
   458	        TS.anchor = lo;
   459	        TS.cursor = p < lo ? lo : p;
   460	    } else {
   461	        TS.anchor = p > hi ? hi : p;
   462	        TS.cursor = hi;
   463	    }
   464	    moved();
   465	}
   466	
   467	int ink_text_selected(char *out, size_t cap) {
   468	    if (!TS.session || TS.type == INK_TEXT_PASSWORD || !cap) return -1;
   469	    size_t lo = TS.cursor < TS.anchor ? TS.cursor : TS.anchor, hi = TS.cursor < TS.anchor ? TS.anchor : TS.cursor;
   470	    size_t n = hi - lo;
   471	    if (n >= cap) n = cap - 1;
   472	    while (n && (TS.value[lo + n] & 0xC0) == 0x80) n--;
   473	    memcpy(out, TS.value + lo, n);
   474	    out[n] = 0;
   475	    return (int)n;
   476	}
   477	
   478	static void restore(const snap_t *s) {
   479	    strcpy(TS.value, s->text);
   480	    TS.cursor = s->cursor;
   481	    TS.anchor = s->anchor;
   482	    TS.composing[0] = 0;
   483	    TS.edit_kind = EDIT_NONE;
   484	    memset(s->text, 0, strlen(s->text));
   485	    osal_free(s->text);
   486	    changed();
   487	}
   488	
   489	bool ink_text_can_undo(void) { return TS.session && TS.nundo > 0; }
   490	bool ink_text_can_redo(void) { return TS.session && TS.nredo > 0; }
   491	
   492	bool ink_text_undo(void) {
   493	    if (!ink_text_can_undo() || !push_snap(TS.redo, &TS.nredo)) return false;
   494	    restore(&TS.undo[--TS.nundo]);
   495	    return true;
   496	}
   497	
   498	bool ink_text_redo(void) {
   499	    if (!ink_text_can_redo() || !push_snap(TS.undo, &TS.nundo)) return false;
   500	    restore(&TS.redo[--TS.nredo]);
   501	    return true;
   502	}

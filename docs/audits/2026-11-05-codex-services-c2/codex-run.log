    69	    if (ink_crc32(0, b + sizeof h, n - sizeof h) != h.crc) return false;
    70	    const dict_key_t *keys = (const dict_key_t *)(b + h.keys_off);
    71	    const dict_entry_t *entries = (const dict_entry_t *)(b + h.entries_off);
    72	    for (uint32_t i = 0; i < h.nkeys; i++) {
    73	        if ((uint64_t)keys[i].text_off + keys[i].key_len > h.text_len || (uint64_t)keys[i].first + keys[i].count > h.nentries) return false;
    74	    }
    75	    for (uint32_t i = 0; i < h.nentries; i++)
    76	        if ((uint64_t)entries[i].text_off + entries[i].word_len > h.text_len) return false;
    77	    return true;
    78	}
    79	
    80	static void ready_job(void *arg) { /* UI task */
    81	    (void)arg;
    82	    void (*fn)(void) = PY.ready;
    83	    if (fn) fn();
    84	}
    85	
    86	static void load_job(void *arg) { /* exec.bg */
    87	    (void)arg;
    88	    uint8_t *b = NULL;
    89	    bool held = ink_fs_card_hold() == INK_FS_OK; /* on a computer now: the small table until next time */
    90	    int64_t size = held ? hal_fs_size(PY_DICT_PATH) : -1;
    91	    if (size > 0 && size <= DICT_MAX) {
    92	        hal_file_t *f = hal_fs_open(PY_DICT_PATH, HAL_O_READ);
    93	        b = f ? ink_mem_alloc("ime", INK_MEM_PSRAM, (size_t)size) : NULL;
    94	        size_t got = 0;
    95	        while (b && got < (size_t)size) {
    96	            ssize_t r = hal_fs_read(f, b + got, (size_t)size - got);
    97	            if (r <= 0) break;
    98	            got += (size_t)r;
    99	        }
   100	        if (f) hal_fs_close(f);
   101	        ink_fs_card_release();
   102	        held = false;
   103	        if (b && (got != (size_t)size || !dict_ok(b, got))) {
   104	            ink_probe_count("text.dict_bad");
   105	            ink_mem_free(b);
   106	            b = NULL;
   107	        }
   108	    }
   109	    if (held) ink_fs_card_release();
   110	    dict_head_t h = {0};
   111	    if (b) memcpy(&h, b, sizeof h);
   112	    ink_svc_lock();
   113	    PY.loading = false;
   114	    if (b) {
   115	        PY.block = b;
   116	        PY.nkeys = h.nkeys;
   117	        PY.keys = (const dict_key_t *)(b + h.keys_off);
   118	        PY.entries = (const dict_entry_t *)(b + h.entries_off);
   119	        PY.text = (const char *)(b + h.text_off);
   120	    }
   121	    ink_svc_unlock();
   122	    if (b) {
   123	        ink_probe_count("text.dict_loaded");
   124	        ink_exec_post(INK_EXEC_UI, &PY.ready_job, ready_job, NULL);
   125	    }
   126	}
   127	
   128	void py_want_dict(void (*ready)(void)) {
   129	    ink_svc_lock();
   130	    bool go = !PY.block && !PY.loading;
   131	    if (go) PY.loading = true;
   132	    PY.ready = ready;
   133	    ink_svc_unlock();
   134	    if (go && ink_exec_post(INK_EXEC_BG, &PY.load_job, load_job, NULL) != 0) {
   135	        ink_svc_lock();
   136	        PY.loading = false;
   137	        ink_svc_unlock();
   138	    }
   139	}
   140	
   141	bool py_dict_loaded(void) {
   142	    ink_svc_lock();
   143	    bool b = PY.block != NULL;
   144	    ink_svc_unlock();
   145	    return b;
   146	}

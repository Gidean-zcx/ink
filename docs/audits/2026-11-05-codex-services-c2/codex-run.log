   313	int ink_app_open(const char *id, void *from, void *arg) {
   314	    app_t *a = find(id);
   315	    if (!a || !a->def->entry) return -1;
   316	    if (!ink_app_visible(a->def)) return -2;
   317	    if (ink_ui_bring_up(id)) return 0;
   318	    if (ink_ui_full()) ink_ui_home();
   319	    if (from) ink_ui_open(from, a->def->entry, arg);
   320	    else ink_ui_push(a->def->entry, arg);
   321	    return 0;
   322	}
   323	
   324	int ink_app_close(const char *id) {
   325	    app_t *a = find(id);
   326	    if (!a || a->def->keep) return -1;
   327	    ink_ui_drop_app(id); /* its pages off the stack: the foreground moves on by itself */
   328	    if (a->state != INK_APP_STOPPED && a->state != INK_APP_FROZEN && !save(a)) { /* the only copy of what it keeps is in it: it stays */
   329	        plan_freeze();
   330	        return -2;
   331	    }
   332	    stop_saved(a);
   333	    plan_freeze();
   334	    return 0;
   335	}

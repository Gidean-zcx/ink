   301	static void what_goes_with_a_question(void) {
   302	    ink_hub_demand();
   303	    CHECK(WAIT_FOR(ink_hub_online(), 30000), "online");
   304	    ink_exec_post(INK_EXEC_UI, &g_key_job, key_job, (void *)1);
   305	    delay_ms(1200);
   306	    ink_exec_post(INK_EXEC_UI, &g_key_job, key_job, NULL);
   307	    CHECK(WAIT_FOR(sim_hub_last_ask() != NULL, 5000), "a question");
   308	    const char *ask = sim_hub_last_ask();
   309	    CHECK(ask && strstr(ask, "\"state\":{") && strstr(ask, "\"battery.level\":") && strstr(ask, "\"power.state\":") && strstr(ask, "\"app.foreground\":"), "the system's state goes with it (%.400s)", ask ? ask : "");
   310	    CHECK(ask && strstr(ask, "\"page\":{"), "and the page");
   311	    delay_ms(6000);
   312	}


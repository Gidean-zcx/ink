   456	static void scan_job(void *arg) { /* exec.bg: the card, once the file service is up */
   457	    (void)arg;
   458	    if (ink_fs_card_hold() != INK_FS_OK) return;
   459	    pkg_t *p = osal_malloc(sizeof *p, OSAL_MEM_EXTERNAL);
   460	    char *path = osal_malloc(PKG_PATH_MAX, OSAL_MEM_EXTERNAL);
   461	    bool found = p && path && newest_in(CARD_DIR, path, PKG_PATH_MAX, p);
   462	    ink_fs_card_release();
   463	    if (found && p->code != U.card_told_code) {
   464	        U.card_told_code = p->code;
   465	        offer_notification(p->version, "system.upgrade_from_card");
   466	        ink_args_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
   467	        if (a) {
   468	            ink_args_init(a);
   469	            ink_args_str(a, "version", p->version);
   470	            ink_args_str(a, "from", "card");
   471	            ink_cap_emit("update.available", a);
   472	            osal_free(a);
   473	        }
   474	    }
   475	    osal_free(path);
   476	    osal_free(p);
   477	}
   478	
   479	static void on_card_changed(void *ctx, const char *id, const ink_args_t *a) { /* exec.bg */
   480	    (void)ctx;
   481	    (void)id;
   482	    bool lent = true;
   483	    ink_args_get_bool(a, "lent", &lent);
   484	    if (!lent) ink_exec_post(INK_EXEC_BG, &U.scan_job, scan_job, NULL);
   485	}
   700	        osal_task_delay_us(WAIT_FOR_NET_US);
   701	        return INK_JOB_MORE;
   702	    }
   703	    char params[64 + BLOB_MAX];
   704	    uint32_t left = U.offer_size - U.dl_off;
   705	    snprintf(params, sizeof params, "{\"blob\":\"%s\",\"offset\":%u,\"len\":%u}", U.offer_blob, (unsigned)U.dl_off, (unsigned)(left < DOWNLOAD_CHUNK * 3 / 4 ? left : DOWNLOAD_CHUNK * 3 / 4));
   706	    __atomic_store_n(&U.dl_waiting, 1, __ATOMIC_RELEASE);
   707	    __atomic_add_fetch(&U.dl_piece->refs, 1, __ATOMIC_ACQ_REL); /* the answer writes into it, whatever happens here meanwhile */
   708	    if (ink_hub_call("update/fetch", params, 20000000, on_chunk, U.dl_piece) < 0) {
   709	        piece_release(U.dl_piece);
   710	        __atomic_store_n(&U.dl_waiting, 0, __ATOMIC_RELEASE);
   711	    }
   712	    return INK_JOB_MORE;
   713	}
   714	
   715	static void dl_finish(void *ctx, ink_job_step_t how, bool cancelled) { /* exec.bg */
   716	    (void)ctx;
   717	    ink_power_release(INK_NEED_NET);
   718	    ink_svc_lock();
   719	    dl_piece_t *piece = U.dl_piece;
   720	    U.dl_piece = NULL;
   721	    ink_svc_unlock();
   722	    piece_release(piece);
   723	    U.job = 0;
   724	    if (how != INK_JOB_DONE || cancelled) {
   725	        set_state(cancelled ? "available" : "failed");
   726	        ink_probe_count("update.download_failed");
   727	        ink_task_end(U.task, cancelled ? INK_TASK_CANCELLED : INK_TASK_FAILED, cancelled ? "停下了，下次接着下载" : "没下载成", NULL);
   728	        return;
   729	    }
   730	    ink_task_end(U.task, INK_TASK_DONE, "下载好了，可以安装", NULL);
   731	    set_state("ready");
   732	    ink_probe_count("update.downloaded");
   733	    char body[64];
   734	    snprintf(body, sizeof body, "%s 下载好了，可以安装", U.offer_version);
   735	    ink_notify_t n = {.channel = "download", .title = "系统更新", .body = body, .tag = "update", .action = "system.upgrade", .prio = INK_NOTIFY_NORMAL, .src = INK_SRC_SYSTEM};
   736	    ink_notify_post(&n, NULL);
   737	}
   738	
   739	static void dl_cancel(void *ctx) {
   740	    (void)ctx;
   741	    if (U.job) ink_job_cancel(U.job);
   742	}

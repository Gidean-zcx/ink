   450	/* Build the request params: page snapshot plus either the stream description or the question. */
   451	static int request(const char *method, bool voice) {
   452	    AI.answer_len = 0;
   453	    AI.answer_text[0] = 0;
   454	    AI.first_text_seen = false;
   455	    AI.asking = true;
   456	    osal_mutex_lock(AI.lock, OSAL_WAIT_FOREVER);
   457	    AI.seq++;
   458	    if (voice) AI.session_seq = AI.seq;
   459	    osal_mutex_unlock(AI.lock);
   460	    const char *prev = osal_mem_tag("ai");
   461	    char *snap = osal_malloc(SNAPSHOT_CAP, OSAL_MEM_EXTERNAL);
   462	    char *params = osal_malloc(SNAPSHOT_CAP * 2 + STATE_CAP + 256, OSAL_MEM_EXTERNAL);
   463	    osal_mem_tag(prev);
   464	    if (!snap || !params) {
   465	        osal_free(snap);
   466	        osal_free(params);
   467	        post(AI.seq, 2, INK_HUB_ERR_NOMEM, NULL);
   468	        return -1;
   469	    }
   470	    const char *app = "";
   471	    int n = ink_ui_snapshot(snap, SNAPSHOT_CAP, &app);
   472	    ink_jw_t w;
   473	    ink_jw_init(&w, params, SNAPSHOT_CAP * 2 + STATE_CAP + 256);
   474	    if (voice) {
   475	        char head[96];
   476	        snprintf(head, sizeof head, "{\"stream\":%d,\"format\":\"opus\",\"rate\":16000,\"frame_ms\":60", AI.stream);
   477	        ink_jw_raw(&w, head);
   478	    } else {
   479	        ink_jw_raw(&w, "{\"question\":");
   480	        ink_jw_str(&w, g_typed[0] ? g_typed : SIM_TRANSCRIPT);
   481	    }
   482	    char gen[48];
   483	    snprintf(gen, sizeof gen, ",\"page_gen\":%u", (unsigned)ink_ui_content_version());
   484	    ink_jw_raw(&w, gen);
   485	    ink_jw_raw(&w, ",\"page\":{\"app\":");
   486	    ink_jw_str(&w, app);
   487	    ink_jw_raw(&w, ",\"text\":");
   488	    ink_jw_strn(&w, snap, n > 0 ? (size_t)n : 0);
   489	    ink_jw_raw(&w, ",\"actions\":");
   490	    {
   491	        char ids[768];
   492	        int k = ink_cap_ids_json(ids, sizeof ids);
   493	        ink_jw_raw(&w, k > 0 ? ids : "[]");
   494	    }
   495	    ink_jw_raw(&w, "},\"state\":");
   496	    {
   497	        int k = ink_state_json(snap, STATE_CAP, INK_EXPOSE_AI); /* the page's text is in params already: its buffer is free */
   498	        ink_jw_raw(&w, k > 0 ? snap : "{}");
   499	    }
   500	    ink_jw_raw(&w, "}");
   501	    ink_power_hold(INK_NEED_NET); /* no sleep while the answer is on its way */
   502	    int id = ink_hub_call(method, w.overflow ? "{}" : params, ASK_TIMEOUT_US, on_reply, (void *)(intptr_t)AI.seq);
   503	    if (id < 0) { /* no reply will come: the turn ends here */
   504	        ink_power_release(INK_NEED_NET);
   505	        post(AI.seq, 2, id, NULL);
   506	    }
   507	    osal_free(snap);
   508	    osal_free(params);
   509	    return id;
   510	}


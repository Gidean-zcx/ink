   148	/* -1, 0, 1: the key at i against these letters. */
   149	static int key_cmp(uint32_t i, const char *s, size_t n) {
   150	    const dict_key_t *k = &PY.keys[i];
   151	    size_t m = k->key_len < n ? k->key_len : n;
   152	    int c = memcmp(PY.text + k->text_off, s, m);
   153	    return c ? c : k->key_len < n ? -1 : k->key_len > n ? 1 : 0;
   154	}

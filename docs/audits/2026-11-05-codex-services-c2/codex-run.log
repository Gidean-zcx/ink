   455	static pending_t *prepare(const char *id, const ink_cap_t *c, const ink_args_t *args, const ink_call_opts_t *o, bool remote, bool *repeat) {
   456	    char *json = NULL;
   457	    *repeat = false;
   458	    if (!args && o->args_json && *o->args_json) {
   459	        size_t n = strlen(o->args_json);
   460	        json = osal_malloc(n + 1, OSAL_MEM_EXTERNAL);
   461	        if (!json) return NULL;
   462	        memcpy(json, o->args_json, n + 1);
   463	    }
   464	    pending_t *p = claim(o->request_id, repeat);
   465	    if (!p || *repeat) {
   466	        osal_free(json);
   467	        if (p) { /* the first receipt again, or "queued": told like any other */
   468	            ink_probe_count("cap.replayed");
   469	            p->o = *o;
   470	            p->o.request_id = p->o.args_json = NULL;
   471	            answer(p);

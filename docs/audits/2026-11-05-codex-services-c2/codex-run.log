   298	    const ink_activity_t *top = UI.depth ? UI.stack[UI.depth - 1].a : NULL;
   299	    if (activity_name) *activity_name = top ? top->name : "";
   300	    if (!top || !top->snapshot || !cap) {
   301	        if (cap) buf[0] = 0;
   302	        return 0;
   303	    }
   304	    return top->snapshot(buf, cap);
   305	}

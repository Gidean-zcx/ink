   142	/* ------------------------------------------------------------ calls (the soft bus, detailed design §3) */
   143	
   144	#define POOL_N 16 /* calls in flight */
   145	#define SEEN_N 32 /* request ids remembered for retries */
   146	#define RID_CAP 40
   147	
   148	/*
   149	 * One call, from acceptance to the slot's return. Its deadline counts from acceptance, whatever it
   150	 * waits for (detailed design §3.3). Three things must have happened before the slot can be used
   151	 * again, in any order: the provider is through with it (finished: the handler returned without
   152	 * deferring, ink_cap_done came, or it was never run), the caller has been told (answered), and
   153	 * no task still looks at it (refs: the one running its handler, a waiting ink_cap_invoke). The last
   154	 * of them frees it, in unlock_retire().
   155	 */
   156	typedef struct {
   157	    ink_call_t call; /* what the handler sees: first, so an ink_call_t * is its pending_t * */
   158	    ink_call_opts_t o;
   159	    ink_receipt_t out; /* the first final receipt, what the caller gets (a late handler may still write call.rc) */
   160	    char id[48];
   161	    char rid[RID_CAP];
   162	    char *json; /* JSON arguments until the gate passed */
   163	    char *result; /* what the handler found (rc.result points here until the slot goes) */
   164	    uint64_t deadline_us;
   165	    ink_exec_job_t start_job, answer_job;
   166	    uint8_t refs;
   167	    bool used;
   168	    bool accepted; /* fully prepared: the deadline applies */
   169	    bool remote;   /* the hub link's own timeout is its deadline */
   170	    bool repeat_safe; /* rid is the caller's: the receipt is kept for retries */
   171	    bool started, deferred, replied, finished, answered;
   172	    char member[INK_MEMBER_ID_MAX]; /* ink_call_opts_t.member */
   173	} pending_t;
   174	
   175	typedef struct {
   176	    char rid[RID_CAP];
   177	    ink_receipt_t rc;
   178	} seen_t;
   179	
   180	#define DIR_MAX 32 /* server capabilities the hub offers (architecture §5.3) */
   181	
   182	typedef struct {
   183	    char id[40];
   184	    uint8_t form;
   185	} remote_cap_t;
   186	
   187	static struct {
   188	    osal_mutex_t *lock;
   189	    pending_t *pool;
   190	    seen_t *seen;
   191	    remote_cap_t *dir; /* DIR_MAX, PSRAM: the hub's directory as last fetched */
   192	    int ndir;
   193	    int seen_next;
   194	    osal_timer_t *timer;
   195	    uint64_t timer_due;
   196	    uint32_t boot_tag, next_rid;
   197	} CB;
   198	
   199	static void timeout_cb(void *arg);
   200	
   201	static bool in_directory(const char *id) {
   202	    if (!CB.lock) return false;
   203	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   204	    bool hit = false;
   205	    for (int i = 0; i < CB.ndir && !hit; i++) hit = !strcmp(CB.dir[i].id, id);
   206	    osal_mutex_unlock(CB.lock);
   207	    return hit;
   208	}
   209	
   210	static int register_bus_caps(void);
   211	
   212	int ink_cap_init(void) {
   213	    if (CB.pool) return 0;
   214	    if (register_bus_caps() != 0) return -1;
   215	    const char *prev = osal_mem_tag("cap");
   216	    CB.lock = osal_mutex_create();
   217	    CB.pool = osal_calloc(POOL_N, sizeof(pending_t), OSAL_MEM_EXTERNAL);
   218	    CB.seen = osal_calloc(SEEN_N, sizeof(seen_t), OSAL_MEM_EXTERNAL);
   219	    CB.dir = osal_calloc(DIR_MAX, sizeof(remote_cap_t), OSAL_MEM_EXTERNAL);
   220	    CB.timer = osal_timer_create("cap", timeout_cb, NULL);
   221	    osal_mem_tag(prev);
   222	    CB.boot_tag = (uint32_t)(osal_wall_us() / 1000000);
   223	    return CB.lock && CB.pool && CB.seen && CB.dir && CB.timer ? 0 : -1;
   224	}
   225	
   226	static const seen_t *seen_find(const char *rid) { /* under the lock */
   227	    for (int i = 0; i < SEEN_N; i++)
   228	        if (CB.seen[i].rid[0] && !strcmp(CB.seen[i].rid, rid)) return &CB.seen[i];
   229	    return NULL;
   230	}
   231	
   232	static bool in_flight(const char *rid) { /* under the lock */
   233	    for (int i = 0; i < POOL_N; i++)
   234	        if (CB.pool[i].used && !CB.pool[i].replied && !strcmp(CB.pool[i].rid, rid)) return true;
   235	    return false;
     1	/*
     2	 * Capabilities (architecture v1.0 §4.3, detailed design §2): what a person or
     3	 * the AI asks for to get something done. Every one is registered once with a
     4	 * description (arguments as JSON Schema, side-effect class, who may use it,
     5	 * service class, where its handler runs) and invoked the same way from a
     6	 * button, a key, another app, the AI or the hub, so "doing it by hand" and
     7	 * "asking the AI" give the same result by construction (foundation §6.1).
     8	 * The policy gate here, not a prompt, decides confirmation and refusal
     9	 * (§6.2, §8). Every invocation returns a receipt with one status from a
    10	 * single enumeration (§6.4).
    11	 *
    12	 * The description table is the only source: the tool list the hub and the
    13	 * model see is generated from it.
    14	 */
    15	#ifndef INK_SYS_CAP_H
    16	#define INK_SYS_CAP_H
    17	
    18	#include <stdbool.h>
    19	#include <stddef.h>
    20	#include <stdint.h>
    21	
    22	#include "ink/sys/args.h"
    23	#include "ink/sys/exec.h"
    24	
    25	#ifdef __cplusplus
    26	extern "C" {
    27	#endif
    28	
    29	typedef enum {
    30	    INK_FX_READ = 0,          /* read the current page, list the shelf */
    31	    INK_FX_NAVIGATE,          /* open a book, go to a page (can go back) */
    32	    INK_FX_LOCAL_WRITE,       /* add a word, note something (undo window in the receipt) */
    33	    INK_FX_LOCAL_DESTRUCTIVE, /* delete, bulk replace: confirm on the device */
    34	    INK_FX_EXTERNAL,          /* message, call, share: confirm on the device by the current member */
    35	    INK_FX_SYSTEM,            /* reset, upgrade, system settings: confirm (PIN when needed), never children */
    36	} ink_effect_t;
    37	
    38	typedef enum { INK_CONFIRM_NONE = 0, INK_CONFIRM_DEVICE, INK_CONFIRM_PARENT } ink_confirm_t;
    39	
    40	/* The one receipt status enumeration (shared with the hub and the docs). */
    41	typedef enum {
    42	    INK_RC_DONE = 0,
    43	    INK_RC_PARTIAL,
    44	    INK_RC_QUEUED,
    45	    INK_RC_PENDING_CONFIRMATION,
    46	    INK_RC_REJECTED, /* refused by the policy gate */
    47	    INK_RC_STALE,    /* aimed at a page that is no longer on screen */
    48	    INK_RC_INVALID,  /* bad arguments, unknown capability, not available here */
    49	    INK_RC_FAILED,
    50	    INK_RC_CANCELLED,
    51	    INK_RC_UNDONE,
    52	} ink_rc_t;
    53	
    54	/* Who asks. Touch, keys and the system are the member's own direct manipulation. CONFIRMED: someone else
    55	 * asked and the member accepted the confirmation card. */
    56	typedef enum { INK_SRC_TOUCH = 0, INK_SRC_KEY, INK_SRC_AI, INK_SRC_SYSTEM, INK_SRC_APP, INK_SRC_REMOTE, INK_SRC_CONFIRMED } ink_source_t;
    57	
    58	typedef enum { INK_FORM_CALL = 0, INK_FORM_STREAM, INK_FORM_EVENT, INK_FORM_SESSION } ink_form_t;
    59	typedef enum { INK_QOS_INTERACTIVE = 0, INK_QOS_REALTIME, INK_QOS_MEDIA, INK_QOS_NETWORK, INK_QOS_BACKGROUND } ink_qos_t;
    60	typedef enum { INK_OFFLINE_FAIL = 0, INK_OFFLINE_QUEUE, INK_OFFLINE_LOCAL } ink_offline_t;
    61	enum { INK_EXPOSE_APP = 1, INK_EXPOSE_AI = 2, INK_EXPOSE_REMOTE = 4, INK_EXPOSE_OWNER = 8 }; /* 0 = everyone; OWNER: only the member's own touch and keys */
    62	
    63	typedef struct {
    64	    ink_rc_t status;
    65	    char object[48];   /* affected object, e.g. "book:星星邮差#page=12" */
    66	    uint32_t revision; /* new state version of that object */
    67	    uint32_t undo_ms;  /* how long it can be undone (0 = not undoable) */
    68	    char say[160];     /* one sentence the AI may speak without another model call */
    69	    char detail[96];   /* why it was rejected / invalid / failed */
    70	    uint32_t page_gen; /* the content version when it finished (ink_ui_content_version): what the next
    71	                        * tool call of the same turn is prepared against */
    72	    const char *result; /* what was found, as JSON (ink_cap_result), for the done callback only: it does not
    73	                         * outlive it. NULL = only the fields above. Not kept for repeats of a request id. */
    74	} ink_receipt_t;
    75	
    76	typedef struct ink_cap ink_cap_t;
    77	
    78	/* One invocation, as the handler sees it. The handler fills `rc` (status is DONE on entry). */
    79	typedef struct {
    80	    const ink_cap_t *cap;
    81	    ink_args_t args;
    82	    ink_source_t src;
    83	    uint32_t page_gen; /* the content version the caller saw (AI, hub), 0 = not page-bound */
    84	    ink_receipt_t rc;
    85	} ink_call_t;
    86	
    87	struct ink_cap {
    88	    const char *id;         /* "reader.next_page": named after what it does, never after a chip */
    89	    uint16_t version;       /* 0 means 1 */
    90	    ink_form_t form;
    91	    const char *title;      /* shown to people and to the model: "下一页" */
    92	    const char *input;      /* JSON Schema (object) of the arguments; NULL = none */
    93	    const char *output;     /* JSON Schema of the result; NULL = the receipt only */
    94	    ink_effect_t effect;
    95	    bool child_ok;          /* children may use it (their whitelist can still narrow this) */
    96	    const char *permission; /* what the calling app needs (app manifests, step 9); NULL = nothing */
    97	    ink_qos_t qos;
    98	    uint32_t timeout_ms;    /* 0 = the service class default */
    99	    bool retry_ok;
   100	    ink_offline_t offline;
   101	    uint8_t expose;         /* INK_EXPOSE_* bits; 0 = everyone */
   102	    const char *activity;   /* only meaningful while this activity is on top; NULL = anywhere */
   103	    ink_exec_t exec;        /* where the handler runs (UI task by default) */
   104	    bool while_locked;      /* can be used while an adult's space is locked: stopping an alarm, answering a call */
   105	    bool parent_pin;        /* whoever asks, an adult's PIN (if one is set) goes with the yes: removing a member, factory reset */
   106	    bool ask_by_hand;       /* a person is asked too: a tap on a notification should not take the device away for minutes */
   107	    const char *ask;        /* what the confirmation card says, with {argument}s: "发短信给 {to}：{text}"; NULL = title and arguments */
   108	    void (*run)(ink_call_t *call);
   109	};

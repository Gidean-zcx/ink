   453	/* What was aimed at the old content is dropped, as for a new screen. A touch in progress too: the next move of that
   454	 * finger would press what is under it now, and lifting it would be a tap (a finger down when a call came in, on the
   455	 * spot where "hang up" appears). The content version stays: the page under it has not changed, and what is prepared
   456	 * for it is still right when the overlay goes (while it is up, the gate refuses what belongs to the page). */
   457	static void overlays_changed(void) {
   458	    UI.generation++;
   459	    lv_indev_reset(UI.indev, NULL);
   460	    UI.pn = 0;
   461	    if (UI.last_pressed) UI.skip_touch = true;
   462	    UI.last_pressed = false;
   463	}
   464	
   465	void ink_ui_overlay_add(const ink_ui_overlay_t *o, lv_obj_t *root) {
   466	    for (int i = 0; i < UI.noverlays; i++)
   467	        if (UI.overlays[i] == o) return;
   468	    if (UI.noverlays >= MAX_OVERLAYS) return;
   469	    int at = UI.noverlays++;
   470	    while (at > 0 && UI.overlays[at - 1]->level > o->level) {
   471	        UI.overlays[at] = UI.overlays[at - 1];
   472	        UI.overlay_root[at] = UI.overlay_root[at - 1];
   473	        at--;
   474	    }
   475	    UI.overlays[at] = o;
   476	    UI.overlay_root[at] = root;
   477	    for (int i = at + 1; i < UI.noverlays; i++) lv_obj_move_foreground(UI.overlay_root[i]);
   478	    overlays_changed();
   479	}
   480	
   481	bool ink_ui_overlay_up(void) { return UI.noverlays > 0; }
   482	
   483	void ink_ui_overlay_remove(const ink_ui_overlay_t *o) {
   484	    for (int i = 0; i < UI.noverlays; i++)
   485	        if (UI.overlays[i] == o) {
   486	            memmove(&UI.overlays[i], &UI.overlays[i + 1], sizeof UI.overlays[0] * (size_t)(UI.noverlays - i - 1));
   487	            memmove(&UI.overlay_root[i], &UI.overlay_root[i + 1], sizeof UI.overlay_root[0] * (size_t)(UI.noverlays - i - 1));
   488	            UI.noverlays--;
   489	            overlays_changed();
   490	            return;
   491	        }
   492	}

    99	/* The policy gate (detailed design §2.4), before anything runs. INK_RC_DONE = may run. */
   100	static ink_rc_t gate(const ink_cap_t *c, ink_source_t src, uint32_t page_gen, ink_receipt_t *rc) {
   101	    if (!c) return reject(rc, INK_RC_INVALID, "unknown action");
   102	    /* the card the member just answered is still over the page it was asked about */
   103	    if (src == INK_SRC_CONFIRMED ? c->activity && strcmp(ink_ui_page_name(), c->activity) : !on_its_page(c)) return reject(rc, INK_RC_INVALID, "not available on this page");
   104	    if (c->form == INK_FORM_EVENT || !c->run) return reject(rc, INK_RC_INVALID, "an event: subscribe to it");
   105	    if (!exposed(c, src)) return reject(rc, INK_RC_INVALID, "not offered to this caller");
   106	    const ink_member_t *m = ink_member_current();
   107	    if (m->role == INK_ROLE_CHILD) {
   108	        if (c->effect == INK_FX_SYSTEM && !(c->child_ok && (src == INK_SRC_TOUCH || src == INK_SRC_KEY))) { /* turning it off is anyone's who holds it */
   109	            ink_probe_count("policy.rejected");
   110	            return reject(rc, INK_RC_REJECTED, "children cannot run system actions");
   111	        }
   112	        if (!ink_member_allows(c->id, c->child_ok)) {
   113	            ink_probe_count("policy.rejected");
   114	            return reject(rc, INK_RC_REJECTED, "not on this child's whitelist");
   115	        }
   116	    }
   117	    if (!ink_member_space_open() && src != INK_SRC_SYSTEM) { /* an adult's space, closed: what comes through is what cannot wait, and from a person */
   118	        if (src == INK_SRC_AI || src == INK_SRC_REMOTE || src == INK_SRC_APP || !c->while_locked) {
   119	            ink_probe_count("policy.rejected");
   120	            return reject(rc, INK_RC_REJECTED, "this member's space is locked");
   121	        }
   122	    }
   123	    if (src == INK_SRC_APP && c->permission && !ink_app_foreground_may(c->permission)) {
   124	        ink_probe_count("policy.rejected");
   125	        return reject(rc, INK_RC_REJECTED, "the app did not declare this permission");
   126	    }
   127	    bool remote = src == INK_SRC_AI || src == INK_SRC_REMOTE;
   128	    if (remote && strstr(c->id, "upgrade")) { /* the AI never starts an upgrade */
   129	        ink_probe_count("policy.rejected");
   130	        return reject(rc, INK_RC_REJECTED, "upgrades are started by people only");
   131	    }
   132	    /* a tool call prepared for an older page must not act on the new one */
   133	    if ((remote || src == INK_SRC_CONFIRMED) && page_gen && c->activity && page_gen != ink_ui_content_version())
   134	        return reject(rc, INK_RC_STALE, "the page changed since the request was made");
   135	    if (confirm_for(c, src) != INK_CONFIRM_NONE) {
   136	        ink_probe_count("policy.pending_confirmation");
   137	        return reject(rc, INK_RC_PENDING_CONFIRMATION, "needs confirmation on the device");
   138	    }
   139	    return INK_RC_DONE;
   140	}

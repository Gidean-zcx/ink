     1	/*
     2	 * The keyboard panel (placeholder look until the system UI, D-64): a system panel at the bottom of the screen, under the
     3	 * cards, over the page. It shows what the input session says and feeds in what is pressed; the page above it stays usable.
     4	 * What changes is driven with the fast waveform (foundation §4.8).
     5	 */
     6	#include <stdio.h>
     7	#include <string.h>

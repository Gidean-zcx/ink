  1238	int ink_tools_init(void) {
  1239	    if (ink_hub_on_online(dir_fetch, NULL) || ink_hub_subscribe("caps/", on_caps_changed, NULL)) return -1;
  1240	    ink_hub_set_tick(send_events);
  1241	    return ink_hub_on_request("tools/", on_tools, NULL);
  1242	}

   449	static void offer_notification(const char *version, const char *action) {
   450	    char body[64];
   451	    snprintf(body, sizeof body, "可以升级到 %s", version);
   452	    ink_notify_t n = {.channel = "system", .title = "发现系统更新", .body = body, .tag = "update", .action = action, .prio = INK_NOTIFY_NORMAL, .src = INK_SRC_SYSTEM};
   453	    ink_notify_post(&n, NULL);
   454	}

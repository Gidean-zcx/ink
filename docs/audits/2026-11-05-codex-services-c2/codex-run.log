    17	static void cap_state(ink_call_t *c) { /* UI task */
    18	    static const char *const TYPE[] = {"plain", "number", "phone", "password"};
    19	    char *out = osal_malloc(16 * 1024, OSAL_MEM_EXTERNAL);
    20	    if (!out) {
    21	        fail(c, INK_RC_FAILED, "out of memory");
    22	        return;
    23	    }
    24	    ink_jw_t w;
    25	    ink_jw_init(&w, out, 16 * 1024);
    26	    if (!ink_text_focused()) ink_jw_raw(&w, "{\"focused\":false}");
    27	    else {
    28	        ink_jw_raw(&w, "{\"focused\":true,\"type\":");
    29	        ink_jw_str(&w, TYPE[ink_text_type()]);
    30	        ink_jw_raw(&w, ",\"hint\":");
    31	        ink_jw_str(&w, ink_text_hint());
    32	        if (ink_text_type() == INK_TEXT_PASSWORD || ink_text_ai_hidden()) ink_jw_raw(&w, ",\"hidden\":true");
    33	        else {
    34	            ink_jw_raw(&w, ",\"value\":");
    35	            ink_jw_str(&w, ink_text_value());
    36	            ink_jw_raw(&w, ",\"composing\":");
    37	            ink_jw_str(&w, ink_text_composing());
    38	            size_t sel_start, sel_end;
    39	            ink_text_selection(&sel_start, &sel_end);
    40	            ink_jw_raw(&w, ",\"cursor\":");
    41	            ink_jw_int(&w, (int64_t)ink_text_cursor());
    42	            ink_jw_raw(&w, ",\"selection_start\":");
    43	            ink_jw_int(&w, (int64_t)sel_start);
    44	            ink_jw_raw(&w, ",\"selection_end\":");
    45	            ink_jw_int(&w, (int64_t)sel_end);
    46	            if (ink_text_can_undo()) ink_jw_raw(&w, ",\"can_undo\":true");
    47	            if (ink_text_can_redo()) ink_jw_raw(&w, ",\"can_redo\":true");
    48	            if (ink_text_voice_state() != INK_VOICE_IDLE) {
    49	                ink_jw_raw(&w, ",\"heard\":");
    50	                ink_jw_str(&w, ink_text_voice_heard());
    51	            }
    52	        }
    53	        ink_jw_raw(&w, ",\"voice\":");
    54	        ink_jw_str(&w, ink_text_voice_state_name());
    55	        ink_jw_raw(&w, ink_text_voice_possible() ? ",\"voice_possible\":true}" : "}");
    56	    }
    57	    if (w.overflow) fail(c, INK_RC_FAILED, "too long");
    58	    else ink_cap_result(c, out);
    59	    osal_free(out);
    60	}

   110	static bool utf8_valid(const char *s, size_t n, size_t *complete) {
   111	    size_t i = 0;
   112	    while (i < n) {
   113	        unsigned char b = (unsigned char)s[i];
   114	        size_t len = b < 0x80 ? 1 : (b >> 5) == 6 ? 2 : (b >> 4) == 14 ? 3 : (b >> 3) == 30 ? 4 : 0;
   115	        if (!len) return false;
   116	        if (i + len > n) break; /* cut at the end of the buffer */
   117	        for (size_t k = 1; k < len; k++)
   118	            if (((unsigned char)s[i + k] & 0xC0) != 0x80) return false;
   119	        i += len;
   120	    }
   121	    *complete = i;
   122	    return true;
   123	}

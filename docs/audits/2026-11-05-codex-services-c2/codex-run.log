 blocks.append('### '+x['id']+'【'+x['severity']+'】'+x['title']+'\\n\\n【代码核查】【文档核查】位置：'+ '、'.join('"'`'"'+v+'"'`'"' for v in x['locations'])+'。\\n\\n'+x['impact']+'\\n\\n核查：'+x['reproduce']+'\\n\\n建议：'+x['recommendation']+'\\n')

   128	
   129	/* Newest first: what runs, then what ended. */
   130	static void cap_list(ink_call_t *c) {
   131	    char *out = osal_malloc(LIST_MAX, OSAL_MEM_EXTERNAL);
   132	    task_t *copy = osal_malloc(sizeof T.t, OSAL_MEM_EXTERNAL);
   133	    if (!out || !copy) {
   134	        c->rc.status = INK_RC_FAILED;
   135	        snprintf(c->rc.detail, sizeof c->rc.detail, "out of memory");
   136	        osal_free(out);
   137	        osal_free(copy);
   138	        return;
   139	    }
   140	    ink_svc_lock();
   141	    memcpy(copy, T.t, sizeof T.t);
   142	    ink_svc_unlock();
   143	    const char *member = ink_member_current()->id;
   144	    ink_jw_t w;
   145	    ink_jw_init(&w, out, LIST_MAX);
   146	    ink_jw_raw(&w, "[");
   147	    bool first = true;
   148	    for (int running = 1; running >= 0; running--) {
   149	        uint32_t below = UINT32_MAX;
   150	        for (;;) {
   151	            const task_t *t = NULL;
   152	            for (int i = 0; i < TASKS_MAX; i++) {
   153	                const task_t *x = &copy[i];
   154	                if (visible(x, member) && (x->state == INK_TASK_RUNNING) == (running == 1) && x->order < below && (!t || x->order > t->order)) t = x;
   155	            }
   156	            if (!t) break;
   157	            below = t->order;
   158	            ink_jw_raw(&w, first ? "{\"id\":" : ",{\"id\":");
   159	            first = false;
   160	            ink_jw_int(&w, t->id);
   161	            ink_jw_raw(&w, ",\"kind\":");
   162	            ink_jw_str(&w, t->kind);
   163	            ink_jw_raw(&w, ",\"title\":");
   164	            ink_jw_str(&w, t->title);
   165	            ink_jw_raw(&w, ",\"state\":");
   166	            ink_jw_str(&w, STATE_NAME[t->state]);
   167	            if (t->percent >= 0) {
   168	                ink_jw_raw(&w, ",\"percent\":");
   169	                ink_jw_int(&w, t->percent);
   170	            }
   171	            if (t->stage[0]) {
   172	                ink_jw_raw(&w, ",\"stage\":");
   173	                ink_jw_str(&w, t->stage);
   174	            }
   175	            if (t->cancel) ink_jw_raw(&w, ",\"can_cancel\":true");
   176	            if (t->result[0]) {
   177	                ink_jw_raw(&w, ",\"result\":");
   178	                ink_jw_str(&w, t->result);
   179	            }
   180	            if (t->object[0]) {
   181	                ink_jw_raw(&w, ",\"object\":");
   182	                ink_jw_str(&w, t->object);
   183	            }
   184	            if (t->ended_s) {
   185	                ink_jw_raw(&w, ",\"ended_s\":");
   186	                ink_jw_int(&w, t->ended_s);
   187	            }
   188	            ink_jw_raw(&w, "}");
   189	        }
   190	    }
   191	    ink_jw_raw(&w, "]");
   192	    if (w.overflow) {
   193	        c->rc.status = INK_RC_FAILED;
   194	        snprintf(c->rc.detail, sizeof c->rc.detail, "too long");
   195	    } else ink_cap_result(c, out);
   196	    osal_free(copy);
   197	    osal_free(out);
   198	}

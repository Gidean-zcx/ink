   551	static void pin_call_done(void *ctx, int result, uint32_t wait_s) {
   552	    ink_call_t *c = ctx;
   553	    if (result == INK_PIN_WAIT) snprintf(c->rc.detail, sizeof c->rc.detail, "wait %u s", (unsigned)wait_s);

   207	static pkg_err_t check_rules(const pkg_t *p) {
   208	    if (strcmp(p->product, U.product)) return PKG_WRONG_PRODUCT;
   209	    if (p->code == U.st.blocked_code) return PKG_BLOCKED;
   210	    if (p->code <= U.me.version_code && !(p->flags & 1)) return PKG_OLDER;
   211	    if (U.me.version_code < p->min_from) return PKG_TOO_OLD_TO_UPGRADE;
   212	    bool has_app = false;
   213	    for (uint32_t i = 0; i < p->nsec; i++)
   214	        if (p->sec[i].kind == SEC_APP) {
   215	            has_app = true;
   216	            if (p->sec[i].size > U.me.slot_size) return PKG_TOO_BIG;
   217	        }
   218	    return has_app ? PKG_OK : PKG_BAD_FORMAT;
   219	}
   220	
   221	/* Every section's hash, the whole file read. */
   222	static pkg_err_t check_sections(const char *path, const pkg_t *p) {
   223	    hal_file_t *f = hal_fs_open(path, HAL_O_READ);
   224	    if (!f) return PKG_NO_FILE;
   225	    uint8_t *buf = osal_malloc(BLOCK, OSAL_MEM_EXTERNAL);
   226	    ink_sha256_t *s = osal_malloc(sizeof *s, OSAL_MEM_EXTERNAL);
   227	    pkg_err_t e = buf && s ? PKG_OK : PKG_BAD_SECTION;
   228	    for (uint32_t i = 0; i < p->nsec && e == PKG_OK; i++) {
   229	        uint8_t got[32];
   230	        uint64_t left = p->sec[i].size;
   231	        if (hal_fs_seek(f, (int64_t)p->sec[i].offset, 0) != 0) e = PKG_BAD_SECTION;
   232	        ink_sha256_init(s);
   233	        while (left && e == PKG_OK) {
   234	            ssize_t n = hal_fs_read(f, buf, left < BLOCK ? (size_t)left : BLOCK);
   235	            if (n <= 0) e = PKG_BAD_SECTION;
   236	            else {
   237	                ink_sha256_update(s, buf, (size_t)n);
   238	                left -= (uint64_t)n;
   239	                osal_preempt_point();
   240	            }
   241	        }
   242	        if (e == PKG_OK) {
   243	            ink_sha256_final(s, got);
   244	            if (memcmp(got, p->sec[i].sha256, 32)) e = PKG_BAD_SECTION;
   245	        }
   246	    }
   247	    hal_fs_close(f);
   248	    osal_free(s);
   249	    osal_free(buf);
   250	    return e;
   251	}
   252	
   253	static pkg_err_t check_package(const char *path, pkg_t *p) {
   254	    pkg_err_t e = read_header(path, p);
   255	    if (e == PKG_OK) e = check_rules(p);
   256	    if (e == PKG_OK) e = check_sections(path, p);
   257	    return e;
   258	}
   259	
   260	/* ---- installing ---- */
   261	
   262	/* All of it touches the flash, so all of it in the storage task. */
   263	typedef struct {
   264	    const void *data;
   265	    size_t n;
   266	    int r;
   267	} slot_op_t;
   268	
   269	static void slot_begin(void *arg) {
   270	    slot_op_t *o = arg;
   271	    o->r = hal_ota_begin(o->n);
   272	}
   273	
   274	static void slot_write(void *arg) {
   275	    slot_op_t *o = arg;
   276	    o->r = hal_ota_write(o->data, o->n);
   277	}
   278	
   279	static void slot_finish(void *arg) { /* whole and well formed: the next boot is from there */
   280	    slot_op_t *o = arg;
   281	    o->r = hal_ota_end() == 0 && hal_ota_set_boot() == 0 ? 0 : -1;
   282	}
   283	
   284	static void slot_valid(void *arg) {
   285	    (void)arg;
   286	    hal_ota_mark_valid();
   287	}
   288	
   289	typedef struct {
   290	    int kind;
   291	    size_t offset, n;
   292	    const void *data;
   293	    int r;
   294	} res_op_t;
   295	
   296	static void res_write(void *arg) {
   297	    res_op_t *o = arg;
   298	    o->r = hal_ota_write_resource(o->kind, o->offset, o->data, o->n);
   299	}
   300	
   301	static void never_back(void) { /* hal_power_reboot does not come back on the device */
   302	    for (;;) osal_task_delay_us(1000000);
   303	}
   304	
   305	/* What stands in the way, in words. */
   306	static const char *not_now(void) {
   307	    if (ink_audio_focus_top() || ink_audio_recording()) return "a call, a recording or something being said comes first";
   308	    ink_media_status_t m;
   309	    ink_media_status(&m);
   310	    if (m.state == INK_MEDIA_PLAYING) return "something is playing";
   311	    hal_battery_t b; /* as it is now: someone who just plugged it in does not wait for the next look */
   312	    hal_power_battery(&b);
   313	    if (b.percent < MIN_BATTERY && !b.charging && !b.external_power) return "the battery is too low: charge it to 30%";
   314	    if (!hal_fs_card_present()) return "no card";
   315	    return NULL;
   316	}
   317	
   318	static int install(const char *path, const pkg_t *p) { /* exec.bg, holding the card. It returns only if it could not */
   319	    const sec_t *app = NULL;
   320	    for (uint32_t i = 0; i < p->nsec; i++)
   321	        if (p->sec[i].kind == SEC_APP) app = &p->sec[i];
   322	    hal_file_t *f = hal_fs_open(path, HAL_O_READ);
   323	    uint8_t *buf = osal_malloc(BLOCK, OSAL_MEM_EXTERNAL);
   324	    ink_sha256_t *sum = osal_malloc(sizeof *sum, OSAL_MEM_EXTERNAL);
   325	    slot_op_t op = {.n = (size_t)app->size, .r = -1};
   326	    if (f && buf && sum) ink_storage_run(slot_begin, &op, true);
   327	    if (!f || !buf || !sum || op.r != 0 || hal_fs_seek(f, (int64_t)app->offset, 0) != 0) {
   328	        if (f) hal_fs_close(f);
   329	        osal_free(sum);
   330	        osal_free(buf);
   331	        return -1;
   332	    }
   333	    ink_sha256_init(sum);
   334	    snprintf(U.st.state, sizeof U.st.state, "writing");
   335	    snprintf(U.st.version, sizeof U.st.version, "%s", p->version);
   336	    U.st.code = p->code;
   337	    snprintf(U.st.path, sizeof U.st.path, "%s", path);
   338	    U.st.res_done_section = 0;
   339	    save_state();
   340	    set_state("installing");
   341	    ink_power_hold(INK_NEED_AWAKE);
   342	    ink_power_hold(INK_NEED_NO_LOCK);
   343	    uint64_t done = 0;
   344	    int bad = 0;
   345	    int last_pct = -1;
   346	    while (done < app->size && !bad) {
   347	        size_t want = app->size - done < BLOCK ? (size_t)(app->size - done) : BLOCK;
   348	        ssize_t n = hal_fs_read(f, buf, want);
   349	        if (n <= 0) bad = 1;
   350	        else {
   351	            ink_sha256_update(sum, buf, (size_t)n);
   352	            op = (slot_op_t){buf, (size_t)n, 0};
   353	            ink_storage_run(slot_write, &op, true); /* between blocks the panel and the readers get their turn */
   354	            if (op.r != 0) bad = 1;
   355	            done += (uint64_t)n;
   356	            int pct = (int)(done * 100 / app->size);
   357	            if (pct != last_pct) {
   358	                last_pct = pct;
   359	                ink_state_set_int(U.h_progress, pct);
   360	            }
   390	    never_back();
   391	    return 0;
   392	}
   393	
   394	/* Installing from a path: the whole check again, nothing is taken on trust. Holding the card. */
   395	static void install_cap(ink_call_t *c, const char *path) {
   396	    const char *why = not_now();
   397	    if (why) {
   398	        fail(c, INK_RC_FAILED, why);
   399	        return;
   400	    }
   401	    pkg_t *p = osal_malloc(sizeof *p, OSAL_MEM_EXTERNAL);
   402	    if (!p) {
   403	        fail(c, INK_RC_FAILED, "out of memory");
   404	        return;
   405	    }
   406	    set_state("verifying");
   407	    pkg_err_t e = check_package(path, p);
   408	    if (e != PKG_OK) {
   409	        set_state("idle");
   410	        ink_probe_count("update.package_refused");
   411	        fail(c, INK_RC_FAILED, PKG_ERR[e]);
   412	    } else if (install(path, p) != 0) fail(c, INK_RC_FAILED, "it could not be written: the old system stays");
   413	    osal_free(p);
   414	}
   415	
   416	/* ---- looking for packages ---- */
   417	
   418	/* The newest good package in this folder: its path. */
   419	static bool newest_in(const char *dir, char *best, size_t cap, pkg_t *out) {
   420	    hal_dir_t *d = hal_fs_opendir(dir);
   421	    if (!d) return false;
   422	    pkg_t *p = osal_malloc(sizeof *p, OSAL_MEM_EXTERNAL);
   423	    char *path = osal_malloc(PKG_PATH_MAX, OSAL_MEM_EXTERNAL);
   424	    hal_dirent_t e;
   425	    bool found = false;
   426	    while (p && path && hal_fs_readdir(d, &e) == 1) {
   427	        size_t n = strlen(e.name);
   428	        if (e.is_dir || n < 7 || strcmp(e.name + n - 6, ".inkfw")) continue;
   429	        if (snprintf(path, PKG_PATH_MAX, "%s/%s", dir, e.name) >= PKG_PATH_MAX) continue;
   430	        if (read_header(path, p) != PKG_OK || check_rules(p) != PKG_OK) {
   431	            ink_probe_count("update.package_ignored");
   432	            continue;
   433	        }
   434	        if (found && p->code <= out->code) continue;
   435	        if (check_sections(path, p) != PKG_OK) { /* what is offered can be installed; this costs a read of it, only for what would be chosen */
   436	            ink_probe_count("update.package_ignored");
   437	            continue;
   438	        }
   439	        *out = *p;
   440	        snprintf(best, cap, "%s", path);
   441	        found = true;
   442	    }
   443	    hal_fs_closedir(d);
   444	    osal_free(path);
   445	    osal_free(p);
   446	    return found;
   447	}

   380	
   381	static bool writes_held(void) {
   382	    osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
   383	    bool h = ST.holds > 0;
   384	    osal_mutex_unlock(ST.lock);
   385	    return h;
   386	}
   387	
   388	static void storage_task(void *arg) {
   389	    (void)arg;
   390	    for (;;) {
   391	        /* sleep until there is work; only waiting prefetches (they need a quiet panel) look again now and then */
   392	        osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
   393	        bool waiting = false;
   394	        for (int i = 0; i < PREFETCH_MAX && !waiting; i++) waiting = ST.prefetch[i] != NULL;
   395	        osal_mutex_unlock(ST.lock);
   396	        osal_sem_take(ST.kick, waiting ? IDLE_POLL_US * 4 : OSAL_WAIT_FOREVER);
   397	        for (;;) {
   398	            serve_read();
   399	            prefetch_one();
   400	            job_t job;
   401	            int slot = take_job(&job);
   402	            if (slot < 0) break;
   403	            /* wait for a quiet panel and no write hold (reads are still served meanwhile) */
   404	            uint64_t t_wait = osal_now_us();
   405	            bool forced = false;
   406	            for (;;) {
   407	                serve_read();
   408	                bool held = writes_held();
   409	                if (!held && ink_display_busy() <= 0) break;
   410	                if (!held && ST.panel_async && osal_now_us() - t_wait >= ASYNC_PANEL_WAIT_US) {
   411	                    ink_probe_count("storage.writes_pausing_panel");
   412	                    break;
   413	                }
   414	                if (held && osal_now_us() - job.queued_us > MAX_DEFER_US) {
   415	                    forced = true;
   416	                    break;
   417	                }
   418	                osal_sem_take(ST.kick, IDLE_POLL_US); /* a new read wakes us early */
   419	            }
   420	            if (forced) ink_probe_count("storage.forced_writes");
   421	            ink_display_flash_guard(true);
   422	            uint64_t t0 = osal_now_us();
   423	            int r = run_job(&job);
   424	            if (r == NO_PARENT) {
   425	                make_parents(job.path);
   426	                r = run_job(&job);
   427	                if (r == NO_PARENT) r = -1;
   428	            }
   429	            ink_display_flash_guard(false);
   430	            ink_probe_value("storage.write_ms", (double)(osal_now_us() - t0) / 1000.0);
   431	            ink_probe_value("storage.wait_for_idle_ms", (double)(t0 - t_wait) / 1000.0);
   432	            if (r != 0) {
   433	                /* not stored: reads of this path must show what the flash holds, not the lost content */
   434	                ink_probe_count("storage.write_errors");
   435	                osal_mutex_lock(ST.lock, OSAL_WAIT_FOREVER);
   436	                ST.failed++;
   437	                cache_drop(job.path);
   438	                osal_mutex_unlock(ST.lock);
   439	            }
   440	            finish_job(slot);
   441	            if (job.done) job.done(job.ctx, r);
   442	        }
   443	    }
   444	}
   445	
   446	int ink_storage_init(void) {
   447	    hal_panel_info_t pi;
   448	    hal_display_get_info(&pi);
   449	    ST.panel_async = pi.async_updates;
   450	    const char *prev = osal_mem_tag("storage");
   451	    ST.lock = osal_mutex_create();
   452	    ST.read_lock = osal_mutex_create();
   453	    ST.kick = osal_sem_create(0, 1);
   454	    ST.read_done = osal_sem_create(0, 1);
   455	    ST.jobs = osal_malloc(sizeof(job_t) * MAX_JOBS, OSAL_MEM_EXTERNAL);
   456	    ST.cache = osal_calloc(CACHE_MAX, sizeof(centry_t), OSAL_MEM_EXTERNAL);
   457	    ST.scratch = osal_malloc(CACHE_FILE_MAX + 1, OSAL_MEM_EXTERNAL);
   458	    ST.path_buf = osal_malloc(PATH_BUF, OSAL_MEM_EXTERNAL);
   459	    osal_mem_tag(prev);

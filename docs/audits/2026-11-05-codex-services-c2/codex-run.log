   361	/* ---- the cursor, the selection and undo: in characters, as a label and the AI count them ---- */
   362	
   363	static size_t to_chars(size_t bytes) {
   364	    size_t n = 0;
   365	    for (size_t i = 0; i < bytes && TS.value[i]; i++) n += (TS.value[i] & 0xC0) != 0x80;
   366	    return n;
   367	}
   368	
   369	static size_t to_bytes(size_t chars) { /* past the end: the end */
   370	    size_t i = 0;
   371	    while (TS.value[i] && chars) {
   372	        i++;
   373	        while ((TS.value[i] & 0xC0) == 0x80) i++;
   374	        chars--;
   375	    }
   376	    return i;
   377	}
   378	
   379	static void moved(void) { /* the next key starts something new to undo */
   380	    TS.edit_kind = EDIT_NONE;
   381	    changed();
   382	}
   383	
   384	void ink_text_selection(size_t *start, size_t *end) {
   385	    size_t a = TS.value ? to_chars(TS.cursor) : 0, b = TS.value ? to_chars(TS.anchor) : 0;
   386	    if (start) *start = a < b ? a : b;
   387	    if (end) *end = a < b ? b : a;
   388	}
   389	
   390	size_t ink_text_cursor(void) { return TS.value ? to_chars(TS.cursor) : 0; }

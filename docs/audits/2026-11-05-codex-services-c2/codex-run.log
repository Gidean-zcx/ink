   463	static void clipboard(void) {
   464	    char out[64];
   465	    bool sens = true;
   466	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, &sens) == 0 && !sens, "empty");
   467	    CHECK(BY_HAND("clipboard.write", "{\"text\":\"一段话\"}") && g_rc.status == INK_RC_DONE, "written");
   468	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, NULL) > 0 && !strcmp(out, "一段话"), "the person reads it (%s)", out);
   469	    CHECK(AI("clipboard.read", NULL) && g_rc.status == INK_RC_REJECTED, "the AI does not, by default (%s)", ink_rc_name(g_rc.status));
   470	    ink_receipt_t rc;
   471	    ink_setting_set("ai.read_clipboard", 1, INK_SRC_TOUCH, &rc);
   472	    CHECK(AI("clipboard.read", NULL) && g_rc.status == INK_RC_DONE && strstr(g_result, "一段话"), "unless allowed (%s)", g_result);
   473	    CHECK(AI("clipboard.write", "{\"text\":\"密码\",\"sensitive\":true}") && g_rc.status == INK_RC_DONE, "something sensitive");
   474	    CHECK(AI("clipboard.read", NULL) && g_rc.status == INK_RC_REJECTED, "the AI never reads that (%s)", g_result);
   475	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, &sens) > 0 && sens, "the person can");
   476	    delay_ms(59000);
   477	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, NULL) > 0, "for a while");
   478	    delay_ms(2000);
   479	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, NULL) == 0, "a minute later it is gone");
   480	    /* not sensitive: it stays, and a new text ends the countdown */
   481	    ink_clip_set("敏感", true, INK_SRC_TOUCH);
   482	    ink_clip_set("普通", false, INK_SRC_TOUCH);
   483	    delay_ms(61000);
   484	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, NULL) > 0 && !strcmp(out, "普通"), "what replaced it stays (%s)", out);
   485	    /* gone with the member */
   486	    CHECK(ink_member_switch("kid") == 0, "someone else");
   487	    CHECK(ink_clip_get(out, sizeof out, INK_SRC_TOUCH, NULL) == 0, "it is not theirs");
   488	    ink_member_test_reset();
   489	    ink_setting_set("ai.read_clipboard", 0, INK_SRC_TOUCH, &rc);
   490	    char *huge = malloc(INK_CLIP_MAX + 2);
   491	    memset(huge, 'x', INK_CLIP_MAX + 1);
   492	    huge[INK_CLIP_MAX + 1] = 0;
   493	    CHECK(ink_clip_set(huge, false, INK_SRC_TOUCH) != 0, "too long is refused");
   494	    free(huge);
   495	}

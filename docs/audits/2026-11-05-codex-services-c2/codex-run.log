   171	/* In place of what is selected, or at the cursor. As much as fits, whole characters. */
   172	static void put(const char *s) {
   173	    size_t lo = TS.cursor < TS.anchor ? TS.cursor : TS.anchor, hi = TS.cursor < TS.anchor ? TS.anchor : TS.cursor;
   174	    size_t have = strlen(TS.value), add = strlen(s), rest = have - (hi - lo);
   175	    if (rest + add > TS.cap) {
   176	        add = TS.cap - rest;
   177	        while (add && (s[add] & 0xC0) == 0x80) add--;
   178	        ink_probe_count("text.too_long");
   179	    }
   180	    memmove(TS.value + lo + add, TS.value + hi, have - hi + 1);
   181	    memcpy(TS.value + lo, s, add);
   182	    TS.cursor = TS.anchor = lo + add;
   183	}
   184	
   185	static uint32_t word_id(const char *word) {
   186	    uint32_t id = ink_crc32(0, word, strlen(word)) & 0x7FFFFFFF;
   187	    return id ? id : 1;
   188	}
   189	
   190	/* How often this member took it. */
   191	static uint32_t picked_count(const char *word) {
   192	    uint32_t n = 0;
   193	    if (!TS.freq) return 0;
   194	    ink_rec_t r;
   195	    if (ink_db_get(TS.freq, word_id(word), &r, &n, sizeof n) != INK_DB_OK) return 0;
   196	    return n;
   197	}
   198	
   199	static void learn(const char *word) {
   200	    if (!TS.freq || TS.type == INK_TEXT_PASSWORD) return;
   201	    uint32_t n = picked_count(word) + 1;
   202	    int64_t wall = osal_wall_us();
   203	    ink_db_write_t w = {.id = word_id(word), .sort = wall > 0 ? wall / 1000000 : 0, .data = &n, .len = sizeof n, .flags = INK_DB_LAZY};
   204	    ink_db_put(TS.freq, &w, NULL);
   205	}
   206	
   207	static void compute_cands(void) {
   208	    if (TS.cands_valid) return;
   209	    TS.cands_valid = true;
   210	    TS.ncands = 0;
   211	    if (!TS.composing[0]) return;
   212	    py_cand_t *raw = osal_malloc(sizeof *raw * MAX_CANDS, OSAL_MEM_EXTERNAL);
   213	    uint32_t *score = osal_malloc(sizeof *score * MAX_CANDS, OSAL_MEM_EXTERNAL);
   214	    if (!raw || !score) {
   215	        osal_free(raw);
   216	        osal_free(score);
   217	        return;
   218	    }
   219	    ink_svc_lock();
   220	    int n = py_lookup(TS.composing, raw, MAX_CANDS);
   221	    for (int i = 0; i < n; i++) {
   222	        size_t len = raw[i].word_len < sizeof TS.cands[0].word - 1 ? raw[i].word_len : sizeof TS.cands[0].word - 1;
   223	        memcpy(TS.cands[i].word, raw[i].word, len);
   224	        TS.cands[i].word[len] = 0;
   225	        TS.cands[i].consumed = raw[i].consumed;
   226	        score[i] = raw[i].freq;
   227	    }
   228	    ink_svc_unlock();
   229	    /* what this member picks comes first within what is as long; the database has its own lock */
   230	    for (int i = 0; i < n; i++) score[i] += picked_count(TS.cands[i].word) * 2000u;
   231	    for (int i = 1; i < n; i++) { /* a short list: insertion keeps the longest keys first and the order stable */
   232	        ink_text_cand_t c = TS.cands[i];
   233	        uint32_t s = score[i];
   234	        int j = i - 1;
   235	        while (j >= 0 && TS.cands[j].consumed == c.consumed && score[j] < s) {
   236	            TS.cands[j + 1] = TS.cands[j];
   237	            score[j + 1] = score[j];
   238	            j--;
   239	        }
   240	        TS.cands[j + 1] = c;
   241	        score[j + 1] = s;
   242	    }
   243	    TS.ncands = n;
   244	    osal_free(raw);
   245	    osal_free(score);
   246	}
   247	
   248	int ink_text_candidates(int first, ink_text_cand_t *out, int max) {
   249	    if (!TS.session) return 0;
   250	    compute_cands();
   251	    int n = 0;
   252	    for (int i = first; i < TS.ncands && n < max; i++) out[n++] = TS.cands[i];
   253	    return n;
   254	}
   255	
   256	/* What is being composed goes in as typed. */
   257	static void flush_composing(void) {
   258	    if (!TS.composing[0]) return;
   259	    before_edit(EDIT_KEYS);
   260	    put(TS.composing);
   261	    TS.composing[0] = 0;
   262	}
   263	
   264	void ink_text_pick(int index) {
   265	    text_voice_clear_notice();
   266	    if (!TS.session) return;
   267	    compute_cands();
   268	    if (index < 0 || index >= TS.ncands) return;
   269	    ink_text_cand_t c = TS.cands[index];
   270	    before_edit(EDIT_KEYS);
   271	    put(c.word);
   272	    learn(c.word);
   273	    memmove(TS.composing, TS.composing + c.consumed, strlen(TS.composing + c.consumed) + 1);
   274	    ink_probe_count("text.picks");
   275	    changed();
   276	}

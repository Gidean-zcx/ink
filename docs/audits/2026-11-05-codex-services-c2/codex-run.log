   427	int ink_fs_move(const char *from, const char *to) {
   428	    char a[PHYS_MAX], b[PHYS_MAX];
   429	    if (virtual_root(from)) return INK_FS_ERR_DENIED;
   430	    int r = fs_resolve(from, true, a, sizeof a);
   431	    if (!r) r = fs_resolve(to, true, b, sizeof b);
   432	    if (r) return r;
   433	    if (hal_fs_size(a) < 0) return hal_fs_card_present() ? INK_FS_ERR_NOT_FOUND : card_error();
   434	    if (hal_fs_size(b) >= 0) return INK_FS_ERR_EXISTS;
   435	    size_t an = strlen(a);
   436	    if (!strncmp(a, b, an) && b[an] == '/') return INK_FS_ERR_PATH; /* into itself */
   437	    make_parents(b);
   438	    if (hal_fs_rename(a, b) != 0) return card_error();
   439	    changed(from, "moved");
   440	    changed(to, "moved");
   441	    return INK_FS_OK;
   442	}

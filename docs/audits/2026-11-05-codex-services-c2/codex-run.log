    83	
    84	/* What it wants kept goes to the flash in the background; nothing kept, nothing left. A full queue drains in moments: it
    85	 * waits that long. False: it could not be handed over, and what is in the app is the only copy. */
    86	#define SAVE_TRIES 40
    87	#define SAVE_WAIT_US 10000
    88	static bool save(app_t *a) {
    89	    if (!a->def->ops || !a->def->ops->save_state) return true;
    90	    char path[INK_LAYOUT_PATH_MAX];
    91	    void *buf = osal_malloc(INK_APP_STATE_MAX, OSAL_MEM_EXTERNAL);
    92	    if (!buf || state_path(a, path, sizeof path) < 0) {
    93	        osal_free(buf);
    94	        ink_probe_count("app.state_not_saved");
    95	        return false;
    96	    }
    97	    int n = a->def->ops->save_state(buf, INK_APP_STATE_MAX);
    98	    int r = -1;
    99	    for (int i = 0; i < SAVE_TRIES && r != 0; i++) {
   100	        r = n > 0 && n <= INK_APP_STATE_MAX ? ink_storage_write_atomic(path, buf, (size_t)n) : ink_storage_remove(path, NULL, NULL);
   101	        if (r != 0) osal_task_delay_us(SAVE_WAIT_US);
   102	    }
   103	    osal_free(buf);
   104	    if (r != 0) ink_probe_count("app.state_not_saved");
   105	    return r == 0;
   106	}
   107	
   108	static void restore(app_t *a) {
   109	    if (!a->def->ops || !a->def->ops->restore_state) return;
   110	    char path[INK_LAYOUT_PATH_MAX];
   111	    void *buf = osal_malloc(INK_APP_STATE_MAX, OSAL_MEM_EXTERNAL);
   112	    if (!buf || state_path(a, path, sizeof path) < 0) {
   113	        osal_free(buf);
   114	        return;
   115	    }
   116	    int n = ink_storage_read(path, buf, INK_APP_STATE_MAX); /* sees what is still queued for it */
   117	    if (n > 0) a->def->ops->restore_state(buf, (size_t)n);
   118	    osal_free(buf);
   119	}
   120	
   121	static void freeze(app_t *a) {
   122	    if (!save(a)) { /* the only copy of what it keeps is in it: it stays as it is, and is tried again after the same while */
   123	        a->left_at = osal_now_us();
   124	        return;
   125	    }
   126	    if (a->def->ops && a->def->ops->on_freeze) a->def->ops->on_freeze();
   127	    set_state(a, INK_APP_FROZEN);
   128	    ink_probe_count("app.frozen");
   129	}
   130	
   131	/* It has saved. */
   132	static void stop_saved(app_t *a) {
   133	    if (a->state == INK_APP_STOPPED) return;
   134	    if (a->def->ops && a->def->ops->on_stop) a->def->ops->on_stop();
   135	    ink_svc_lock();
   136	    a->bg = 0;
   137	    ink_svc_unlock();
   138	    set_state(a, INK_APP_STOPPED);
   139	    ink_probe_count("app.stopped");
   140	}
   141	
   142	/* From the background or frozen (what was frozen has saved already). When memory says so it goes, saved or not. */
   143	static void stop(app_t *a) {
   144	    if (a->state == INK_APP_STOPPED) return;
   145	    if (a->state != INK_APP_FROZEN) save(a);
   146	    stop_saved(a);
   147	}

   775	void ink_cap_emit(const char *id, const ink_args_t *payload) {
   776	    char key[64];
   777	    snprintf(key, sizeof key, "event.%s", id);
   778	    ink_probe_count(key);
   779	    char whose[INK_MEMBER_ID_MAX] = ""; /* who it says, or who is here now: whoever gets to it later may find someone else here */
   780	    if (payload) ink_args_get_str(payload, "member", whose, sizeof whose);
   781	    bool says = whose[0] != 0;
   782	    if (!says) snprintf(whose, sizeof whose, "%s", ink_member_current()->id);
   783	    keep_event(id, payload, whose);
   784	    for (int i = 0; i < nsubs; i++) {
   785	        if (strncmp(id, SUBS[i].prefix, SUBS[i].plen)) continue;
   786	        const char *prev = osal_mem_tag("cap");
   787	        event_job_t *e = osal_calloc(1, sizeof *e, OSAL_MEM_EXTERNAL);
   788	        osal_mem_tag(prev);
   789	        if (!e) {
   790	            ink_probe_count("event.dropped");
   791	            continue;
   792	        }
   793	        e->fn = SUBS[i].fn;
   794	        e->ctx = SUBS[i].ctx;
   795	        snprintf(e->id, sizeof e->id, "%s", id);
   796	        if (payload) e->payload = *payload;
   797	        else ink_args_init(&e->payload);
   798	        if (!says) ink_args_str(&e->payload, "member", whose);
   799	        if (ink_exec_post(SUBS[i].exec, &e->job, event_job, e) != 0) {
   800	            ink_probe_count("event.dropped");
   801	            osal_free(e);
   802	        }
   803	    }
   804	}

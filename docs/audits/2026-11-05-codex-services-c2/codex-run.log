   171	
   172	static void flush_cb(lv_display_t *d, const lv_area_t *area, uint8_t *px) {
   173	    if (!UI.fb_locked) {
   174	        ink_display_lock();
   175	        UI.fb_locked = true;
   176	    }
   177	    int w = lv_area_get_width(area), h = lv_area_get_height(area);
   178	    uint32_t stride = lv_draw_buf_width_to_stride((uint32_t)w, LV_COLOR_FORMAT_L8);
   179	    uint8_t *fb = ink_display_fb();
   180	    int fs = ink_display_stride();
   181	    osal_cost_units("lvgl.px", (uint64_t)w * (uint64_t)h);       /* rendering, amortized per pixel */
   182	    osal_cost_units("ui.rotate_px", (uint64_t)w * (uint64_t)h);  /* transpose into the native framebuffer */
   183	    for (int y = 0; y < h; y++) {
   184	        const uint8_t *row = px + (size_t)y * stride;
   185	        int ly = area->y1 + y;
   186	        for (int x = 0; x < w; x++) {
   187	            int nx, ny;
   188	            ink_logical_to_native(UI.nw, UI.nh, UI.rot, area->x1 + x, ly, &nx, &ny);
   189	            fb[(size_t)ny * fs + nx] = row[x];
   190	        }
   191	        if ((y & 31) == 31) osal_preempt_point();
   192	    }
   193	    add_dirty(native_rect(area), intent_for(area));
   194	    lv_display_flush_ready(d);
   195	}

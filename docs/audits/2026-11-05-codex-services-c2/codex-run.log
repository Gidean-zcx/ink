   274	    CHECK(ink_confirm_decide(token, false, INK_SRC_TOUCH) == 0, "a person says no");
   275	    CHECK(WAIT_FOR(event_seen_since(from, "\"confirm.result\"") && event_seen_since(from, "\"rejected\""), 2000), "the AI is told (%d)", sim_hub_events_seen() - from);
   276	    delay_ms(1200);
   277	
   278	    /* offline: the latest eight wait */
   279	    vtk_event_at(vtk_now() + SIM_MS(1), net_none, NULL);
   280	    CHECK(WAIT_FOR(!ink_hub_online(), 40000), "the network goes");
   281	    from = sim_hub_events_seen();
   282	    for (int i = 0; i < 12; i++) {
   283	        char title[16];
   284	        snprintf(title, sizeof title, "离线%02d", i);
   285	        ink_notify_t off = {.title = title, .prio = INK_NOTIFY_LOW};
   286	        ink_notify_post(&off, NULL);
   287	    }
   288	    delay_ms(1000);
   289	    CHECK(sim_hub_events_seen() == from, "nothing can go out");
   290	    vtk_event_at(vtk_now() + SIM_MS(1), net_wifi, NULL);
   291	    ink_hub_demand();
   292	    CHECK(WAIT_FOR(ink_hub_online(), 60000), "the network is back");
   293	    CHECK(WAIT_FOR(event_seen_since(from, "离线11"), 3000), "the last went out");
   294	    CHECK(sim_hub_events_seen() - from <= 12 && !event_seen_since(from, "离线03") && event_seen_since(from, "离线04"), "the latest eight (%d)", sim_hub_events_seen() - from);
   295	    ink_notify_clear();

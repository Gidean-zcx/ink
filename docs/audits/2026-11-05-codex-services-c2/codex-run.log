  1196	/* ------------------------------------------------------------ the hub's directory (step 8) */
  1197	
  1198	static void dir_reply(void *ctx, int status, const ink_json_t *j, int result) { /* hub task */
  1199	    (void)ctx;
  1200	    if (status != INK_HUB_OK) {
  1201	        ink_probe_count("cap.directory_failed");
  1202	        return;
  1203	    }
  1204	    int list = ink_json_find(j, result, "tools");
  1205	    if (list < 0 || j->tok[list].type != 2) return;
  1206	    remote_cap_t got[DIR_MAX];
  1207	    int n = 0, t = list + 1;
  1208	    for (int k = 0; k < j->tok[list].size && t < j->ntok && n < DIR_MAX; k++) {
  1209	        int end = j->tok[t].end, next = t + 1;
  1210	        while (next < j->ntok && j->tok[next].start < end) next++;
  1211	        char form[12] = "";
  1212	        if (ink_json_str(j, ink_json_find(j, t, "name"), got[n].id, sizeof got[n].id) > 0) {
  1213	            ink_json_str(j, ink_json_find(j, t, "form"), form, sizeof form);
  1214	            got[n].form = !strcmp(form, "session") ? INK_FORM_SESSION : !strcmp(form, "stream") ? INK_FORM_STREAM : INK_FORM_CALL;
  1215	            n++;
  1216	        }
  1217	        t = next;
  1218	    }
  1219	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
  1220	    memcpy(CB.dir, got, sizeof got[0] * (size_t)n);
  1221	    CB.ndir = n;
  1222	    osal_mutex_unlock(CB.lock);
  1223	    ink_probe_value("cap.directory_size", n);
  1224	}
  1225	
  1226	static void dir_fetch(void *ctx) { /* hub task: on every (re)connection */
  1227	    (void)ctx;
  1228	    ink_hub_call("caps/list", "{}", 10000000, dir_reply, NULL);
  1229	}
  1230	
  1231	static void on_caps_changed(void *ctx, const char *method, const ink_json_t *j, int params) { /* hub task */
  1232	    (void)ctx;
  1233	    (void)j;
  1234	    (void)params;
  1235	    if (!strcmp(method, "caps/changed")) dir_fetch(NULL);
  1236	}

   506	static int book_snapshot(char *buf, size_t cap) {
   507	    if (!book_ready() || !cap) return 0;
   508	    size_t a = RD.starts[RD.page];
   509	    size_t b = RD.page + 1 < RD.nstarts ? RD.starts[RD.page + 1] : RD.len;
   510	    if (b > RD.len) b = RD.len;
   511	    size_t n = b > a ? b - a : 0;
   512	    if (n >= cap) n = cap - 1;
   513	    while (n && ((unsigned char)RD.text[a + n] & 0xC0) == 0x80) n--; /* do not cut a UTF-8 character */
   514	    memcpy(buf, RD.text + a, n);
   515	    buf[n] = 0;
   516	    return (int)n;
   517	}

   436	/* The clock moved or the zone changed: what is ahead is worked out again; what is due now stays due. */
   437	static void clock_moved(void) {
   438	    int64_t now = ink_time_now_s();
   439	    ink_alarm_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
   440	    for (int i = 0;; i++) {
   441	        bool any = false, changed = false;
   442	        ink_svc_lock();
   443	        if (i < T.n) {
   444	            any = true;
   445	            if (T.a[i].enabled && (!T.a[i].next_s || T.a[i].next_s > now)) {
   446	                int64_t next = next_of(&T.a[i], now);
   447	                changed = next != T.a[i].next_s;
   448	                T.a[i].next_s = next;
   449	                if (changed && a) *a = T.a[i];
   450	            }
   451	        }
   452	        ink_svc_unlock();
   453	        if (!any) break;
   454	        if (changed && a) save_alarm(a); /* the next boot starts from what holds now */
   455	    }
   456	    osal_free(a);
   457	    publish_minute();
   458	    reschedule();
   459	}
   460	
   461	void ink_time_set(int64_t utc_s, bool from_hub) {
   462	    if (from_hub && !ink_setting_get("time.auto") && ink_time_valid()) return;
   463	    osal_set_wall_us(utc_s * 1000000);
   464	    __atomic_store_n(&T.valid, true, __ATOMIC_RELEASE);
   465	    if (!hal_rtc_set(utc_s)) ink_probe_count("time.rtc_write_failed");
   669	        ink_probe_count("time.rtc_invalid");
   670	        ink_hub_demand(); /* the hub knows */
   671	    }
   672	    hal_rtc_clear_alarm(); /* what fired while it was off must not hold the interrupt line down */
   673	    load_alarms();
   674	    if (T.valid) { /* what was due while it was off comes up as late: reported, not rung */
   675	        int64_t now = ink_time_now_s();
   676	        for (int i = 0; i < T.n; i++) /* what is ahead by today's rules and zone: a power cut may have come before it was saved */
   677	            if (T.a[i].enabled && (!T.a[i].next_s || T.a[i].next_s > now)) T.a[i].next_s = next_of(&T.a[i], now);
   678	        publish_minute();
   679	        minute_cb(NULL);
   680	        reschedule();
   681	    }
   682	    return ink_time_caps_init();
   683	}

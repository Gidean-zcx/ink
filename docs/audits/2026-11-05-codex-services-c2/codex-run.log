    88	static void cl_entered(void *ctx, const char *value) {
    89	    field_t *f = ctx;
    90	    remember(f);
    91	    if (f->entered) f->entered(f->ctx, value);
    92	}
    93	
    94	static void cl_ended(void *ctx) {
    95	    field_t *f = ctx;
    96	    f->session = 0;
    97	    show(f);
    98	}
    99	
   100	static const ink_text_client_t CLIENT = {cl_changed, cl_entered, cl_ended};
   101	
   102	static void focus(field_t *f) {
   103	    if (f->session) return;
   104	    ink_text_cfg_t c = f->cfg;
   105	    c.initial = f->text;
   106	    c.hint = f->hint;
   107	    f->session = ink_text_focus(&c, &CLIENT, f);
   108	    if (f->session < 0) f->session = 0;
   109	    show(f);
   110	}
   111	
   112	static void close_menu(field_t *f) {
   113	    if (f->menu) lv_obj_delete(f->menu);
   114	    f->menu = NULL;
   115	}
   116	
   117	/* What the tap or the long press was on, as a place in the text. */
   118	static size_t place_of(field_t *f, lv_event_t *e) {
   119	    lv_point_t p;
   120	    lv_indev_get_point(lv_event_get_indev(e), &p);
   121	    lv_area_t a;
   122	    lv_obj_get_coords(f->label, &a);
   123	    p.x -= a.x1;
   124	    p.y -= a.y1;
   125	    uint32_t letter = lv_label_get_letter_on(f->label, &p, true);
   126	    if (f->mark_at >= 0 && letter > (uint32_t)f->mark_at) letter--; /* the mark is not a letter of the text */
   127	    return f->window + letter;
   128	}
   129	
   130	static void on_copy(lv_event_t *e) {
   131	    field_t *f = lv_event_get_user_data(e);
   132	    char *what = osal_malloc(INK_CLIP_MAX + 1, OSAL_MEM_EXTERNAL);
   133	    if (what) {
   134	        if (f->session && ink_text_selected(what, INK_CLIP_MAX + 1) > 0) ink_clip_set(what, false, 0 /* the person's own */);
   135	        else if (f->cfg.type != INK_TEXT_PASSWORD) ink_clip_set(f->text, false, 0);
   136	        memset(what, 0, INK_CLIP_MAX + 1);
   137	        osal_free(what);
   138	    }
   139	    close_menu(f);
   140	}
   141	
   142	static void on_left(lv_event_t *e) {
   143	    (void)e;
   144	    ink_text_move(-1, true);
   145	}
   146	
   147	static void on_right(lv_event_t *e) {
   148	    (void)e;
   149	    ink_text_move(1, true);
   150	}
   151	
   152	static void on_undo(lv_event_t *e) {
   153	    field_t *f = lv_event_get_user_data(e);
   154	    close_menu(f);
   155	    ink_text_undo();
   156	}
   157	
   158	static void on_paste(lv_event_t *e) {
   159	    field_t *f = lv_event_get_user_data(e);
   160	    char *clip = osal_malloc(INK_CLIP_MAX + 1, OSAL_MEM_EXTERNAL);
   161	    close_menu(f);
   162	    if (!clip) return;
   163	    focus(f);
   164	    if (ink_clip_get(clip, INK_CLIP_MAX + 1, 0, NULL) > 0) ink_text_commit_utf8(clip);
   165	    osal_free(clip);
   166	}
   167	
   168	static void on_ask(lv_event_t *e) {
   169	    field_t *f = lv_event_get_user_data(e);
   170	    char *q = f->cfg.type == INK_TEXT_PASSWORD || f->cfg.ai_hidden ? NULL : f->text;
   171	    close_menu(f);
   172	    if (q && q[0]) ink_ai_ask_text(q);
   173	}
   174	
   175	static void menu_button(field_t *f, const char *label, lv_event_cb_t cb) {
   176	    lv_obj_t *b = lv_button_create(f->menu);
   177	    ink_ui_style_button(b);
   178	    lv_obj_add_event_cb(b, cb, LV_EVENT_CLICKED, f);
   179	    lv_obj_t *l = lv_label_create(b);
   180	    lv_obj_set_style_text_font(l, font(), 0);
   181	    lv_label_set_text(l, label);
   182	}
   183	
   184	static void field_event(lv_event_t *e) {
   185	    field_t *f = lv_event_get_user_data(e);
   186	    lv_event_code_t code = lv_event_get_code(e);
   187	    if (code == LV_EVENT_SHORT_CLICKED) { /* a plain click also comes after a long press */
   188	        close_menu(f);
   189	        if (f->session) ink_text_set_cursor(place_of(f, e)); /* the first tap is to start typing */
   190	        focus(f);
   191	    } else if (code == LV_EVENT_LONG_PRESSED) {
   192	        close_menu(f);
   193	        if (f->session && f->cfg.type != INK_TEXT_PASSWORD) ink_text_select_word(place_of(f, e));
   194	        f->menu = lv_obj_create(lv_layer_top());
   195	        lv_obj_remove_flag(f->menu, LV_OBJ_FLAG_SCROLLABLE);
   196	        lv_obj_set_size(f->menu, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
   197	        lv_obj_set_flex_flow(f->menu, LV_FLEX_FLOW_ROW);
   198	        lv_obj_align_to(f->menu, f->obj, LV_ALIGN_OUT_BOTTOM_LEFT, 0, ink_dp(4));
   199	        if (f->session && f->cfg.type != INK_TEXT_PASSWORD) {
   200	            menu_button(f, "◀", on_left);
   201	            menu_button(f, "▶", on_right);
   202	            menu_button(f, "撤销", on_undo);
   203	        }
   204	        menu_button(f, "复制", on_copy);
   205	        menu_button(f, "粘贴", on_paste);


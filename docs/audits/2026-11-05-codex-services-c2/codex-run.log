     1	/*
     2	 * What stays on the panel once the power has gone (placeholder look, D-64; system UI spec §7.12). Electronic paper keeps it, so it
     3	 * has to say the device is off; and it leaves where the reading was, like a bookmark, unless that is behind a closed space.
     4	 */
     5	#include <stdio.h>
     6	#include <string.h>
     7	
     8	#include "ink/osal.h"
     9	#include "ink/probe.h"
    10	#include "ink/sys/appreg.h"
    11	#include "ink/sys/display.h"
    12	#include "ink/sys/exec.h"
    13	#include "ink/sys/members.h"
    14	#include "ink/sys/power.h"
    15	#include "shell_card.h"
    16	
    17	#define PANEL_WAIT_US 6000000ull
    18	
    19	static struct {
    20	    shell_card_t card;
    21	    ink_exec_job_t job;
    22	    const char *why;
    23	    char body[192];
    24	    bool drawn;
    25	} O;
    26	
    27	static int snapshot(char *buf, size_t cap) {
    28	    int n = snprintf(buf, cap, "已关机。%s", O.body);
    29	    return n < 0 ? 0 : (size_t)n < cap ? n : (int)cap - 1;
    30	}
    31	
    32	static const ink_ui_overlay_t OVERLAY = {.name = "off", .level = 5, .snapshot = snapshot};
    33	
    34	static void add_bookmark(void) { /* the first card that is one */
    35	    for (int i = 0; i < ink_app_count(); i++) {
    36	        const ink_app_def_t *d = ink_app_at(i);
    37	        ink_card_t c = {0};
    38	        for (int k = 0; d->card && d->card(k, &c) == 1; k++)
    39	            if (c.bookmark) {
    40	                size_t n = strlen(O.body);
    41	                snprintf(O.body + n, sizeof O.body - n, "\n%s：%s", c.title, c.text);
    42	                return;
    43	            }
    44	    }
    45	}
    46	
    47	static void draw(void *arg) { /* UI task */
    48	    (void)arg;
    49	    snprintf(O.body, sizeof O.body, "%s", !strcmp(O.why, "battery") ? "没电了，东西都存好了。充上电再开机" : "按电源键开机");
    50	    if (ink_member_space_open()) add_bookmark();
    51	    shell_card_open(&O.card);
    52	    ink_ui_overlay_add(&OVERLAY, O.card.root);
    53	    shell_card_text(&O.card, "已关机", O.body);
    54	    __atomic_store_n(&O.drawn, true, __ATOMIC_RELEASE);
    55	}
    56	
    57	static void off_picture(const char *why) { /* the task that turns it off */
    58	    O.why = why;
    59	    ink_exec_post(INK_EXEC_UI, &O.job, draw, NULL);
    60	    uint64_t end = osal_now_us() + PANEL_WAIT_US;
    61	    while ((!__atomic_load_n(&O.drawn, __ATOMIC_ACQUIRE) || ink_ui_busy() || ink_display_busy() > 0) && osal_now_us() < end) osal_task_delay_us(50000);
    62	    ink_probe_count(osal_now_us() < end ? "ui.off_picture_on_panel" : "ui.off_picture_late");
    63	}
    64	
    65	int ink_shell_off_picture_init(void) {
    66	    ink_power_set_off_picture(off_picture);
    67	    return 0;
    68	}
     1	/*
     2	 * System-wide actions (available on every page): the same operations the
     3	 * HOME key, the control centre and the AI use.
     4	 */
     5	#include <stdio.h>
     6	#include <string.h>
     7	
     8	#include "ink/hal_power.h"
     9	#include "ink/hal_storage.h"
    10	#include "ink/osal.h"
    11	#include "ink/probe.h"
    12	#include "ink/sys/ai.h"
    13	#include "ink/sys/cap.h"
    14	#include "ink/sys/data.h"
    15	#include "ink/sys/file.h"
    16	#include "ink/sys/input.h"
    17	#include "ink/sys/storage.h"
    18	#include "ink/sys/settings.h"
    19	#include "ink/sys/state.h"
    20	#include "ink/sys/members.h"
    21	#include "ink/sys/notify.h"
    22	#include "ink/sys/power.h"
    23	#include "ink/sys/svc.h"
    24	#include "ink/sys/update.h"
    25	#include "ink/sys/ui.h"
    26	
    27	static void go_home(ink_call_t *c) {
    28	    ink_receipt_t *rc = &c->rc;
    29	    ink_ui_home();
    30	    snprintf(rc->object, sizeof rc->object, "screen:home");
    31	    snprintf(rc->say, sizeof rc->say, "回到主页了");
    32	}
    33	
    34	static void full_refresh(ink_call_t *c) {
    35	    ink_receipt_t *rc = &c->rc;
    36	    ink_ui_hint_frame(INK_REFRESH_FULL);
    37	    lv_obj_invalidate(lv_screen_active());
    38	    snprintf(rc->say, sizeof rc->say, "屏幕刷新一下");
    39	}
    40	
    41	static void set_volume(ink_call_t *c) {
    42	    int64_t v = 0;
    43	    ink_args_get_int(&c->args, "percent", &v); /* the schema checked it: 0..100 */
    44	    if (ink_setting_set("audio.volume", v, c->src, &c->rc) == INK_RC_DONE)
    45	        snprintf(c->rc.say, sizeof c->rc.say, "音量调到 %d", (int)v);
    46	}
    47	
    48	/* The keys are the same thing as the AI's capability. Locked only while something plays (system UI spec §3.5, LockPlaying): there is nothing else to hear. */
    49	#define VOLUME_STEP 10
    50	
    51	static int g_volume_steps;
    52	static ink_exec_job_t g_volume_job;
    53	
    54	static void volume_job(void *arg) { /* UI task */
    55	    (void)arg;
    56	    int steps = __atomic_exchange_n(&g_volume_steps, 0, __ATOMIC_ACQ_REL);
    57	    int64_t v = ink_setting_get("audio.volume") + steps * VOLUME_STEP;
    58	    ink_args_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    59	    if (!a) return;
    60	    ink_args_init(a);
    61	    ink_args_int(a, "percent", v < 0 ? 0 : v > 100 ? 100 : v);
    62	    ink_receipt_t rc;
    63	    ink_cap_invoke("system.set_volume", a, INK_SRC_KEY, 0, &rc);
    64	    osal_free(a);
    65	}
    66	
    67	static void on_volume_key(int delta, bool locked) { /* input task */
    68	    char playing[16] = "";
    69	    ink_state_get_str(ink_state_find("audio.now_playing"), playing, sizeof playing);
    70	    if (locked && !strcmp(playing, "none")) return;
    71	    __atomic_add_fetch(&g_volume_steps, delta, __ATOMIC_ACQ_REL);
    72	    ink_exec_post(INK_EXEC_UI, &g_volume_job, volume_job, NULL);
    73	}
    74	
    75	static void switch_member(ink_call_t *c) {
    76	    ink_receipt_t *rc = &c->rc;
    77	    char id[16];
    78	    ink_args_get_str(&c->args, "id", id, sizeof id); /* required by the schema */
    79	    if (c->src == INK_SRC_AI) ink_ai_switching_member();
    80	    int r = ink_member_switch(id);
    81	    if (r == -2) {
    82	        rc->status = INK_RC_REJECTED;
    83	        snprintf(rc->detail, sizeof rc->detail, "switching to an adult needs the PIN on the device");
    84	        return;
    85	    }
    86	    if (r != 0) {
    87	        rc->status = INK_RC_INVALID;
    88	        snprintf(rc->detail, sizeof rc->detail, "no such member");
    89	        return;
    90	    }
    91	    ink_ui_home(); /* a member's space starts at their home screen */
    92	    snprintf(rc->object, sizeof rc->object, "member:%s", id);
    93	    snprintf(rc->say, sizeof rc->say, "现在是%s的空间", ink_member_current()->name);
    94	}
    95	
    96	/*
    97	 * Everything of the people who used this device; the system and the family's shared content stay (system services design §11.5).
    98	 * Here only a mark and a restart. The next boot does the wiping, before any service runs: nothing is still writing, nothing has
    99	 * read what should be gone. A power cut in the middle of it, and the boot after that does it again, since the mark goes last.
   100	 * First the flash; the mark then changes its name for the card's part. Without a card that waits: the next boot with one, or
   101	 * while the device is in use a look every few seconds (no card-detect line is known). Any card: its folders of this product are cleared, whichever device
   102	 * they came from (§11.5).
   103	 */
   104	#define RESET_MARK "/user/sys/reset.pending"
   105	#define RESET_CARD_MARK "/user/sys/reset.card"
   106	
   107	#define CARD_LOOK_US 5000000ull
   108	
   109	static bool g_card_waits, g_card_cleared;
   110	static ink_exec_job_t g_reset_job, g_card_job;
   111	static ink_svc_deadline_t g_card_at;
   112	
   113	static bool write_reset_mark(void) { /* the storage task */
   114	    hal_fs_mkdir("/user/sys");
   115	    hal_file_t *f = hal_fs_open(RESET_MARK, HAL_O_WRITE | HAL_O_CREATE | HAL_O_TRUNC);
   116	    return f && hal_fs_close(f) == 0;
   117	}
   118	
   119	static void mark_reset(void *arg) { /* the storage task, guarded */
   120	    static const char *const KEEP_NOTHING[] = {NULL};
   121	    if (write_reset_mark()) *(bool *)arg = true;
   122	    else { /* the flash is full, the very reason for this perhaps: what is there goes now */
   123	        ink_storage_wipe_user(KEEP_NOTHING);
   124	        *(bool *)arg = write_reset_mark();
   125	    }
   126	}
   127	
   128	static void wipe_flash(void *arg) { /* the storage task, guarded */
   129	    (void)arg;
   130	    /* not whose the device was but what it is: which version did not hold, which fonts are half written */
   131	    static const char *const KEEP[] = {RESET_MARK, INK_UPDATE_STATE_FILE, NULL};
   132	    if (ink_storage_wipe_user(KEEP)) hal_fs_rename(RESET_MARK, RESET_CARD_MARK); /* else the next boot tries again */
   133	}
   134	
   135	static void forget_card_mark(void *arg) { /* the storage task, guarded */
   136	    (void)arg;
   137	    hal_fs_remove(RESET_CARD_MARK);
   138	}
   139	
   140	void ink_factory_reset_resume(void) { /* boot: nothing else runs yet */
   141	    bool just_now = ink_storage_size(RESET_MARK) >= 0;
   142	    if (just_now) {
   143	        ink_storage_run(wipe_flash, NULL, true);
   144	        ink_probe_count("system.factory_reset_done");
   145	    }
   146	    if (ink_storage_size(RESET_CARD_MARK) < 0) return;
   147	    g_card_waits = ink_fs_wipe_personal() != INK_FS_OK;
   148	    if (g_card_waits) return;
   149	    ink_storage_run(forget_card_mark, NULL, true);
   150	    ink_probe_count("system.factory_reset_card_at_boot");
   151	    g_card_cleared = !just_now; /* the person was told it would wait */
   152	}
   153	
   154	static void tell_card_cleared(void) {
   155	    ink_probe_count("system.factory_reset_card_done");
   156	    ink_notify_t n = {.channel = "system", .title = "存储卡上的个人文件清掉了", .body = "清空这台设备时没来得及清的，现在清了", .tag = "system.reset_card", .prio = INK_NOTIFY_NORMAL, .src = INK_SRC_SYSTEM};
   157	    ink_notify_post(&n, NULL);
   158	}
   159	
   160	static void card_look(void *arg);
   161	
   162	static void card_job(void *arg) { /* exec.bg */
   163	    (void)arg;
   164	    if (!g_card_waits) return;
   165	    if (hal_fs_card_present() && ink_fs_card_hold() == INK_FS_OK) {
   166	        bool cleared = ink_fs_wipe_personal() == INK_FS_OK;
   167	        ink_fs_card_release();
   168	        if (cleared) {
   169	            g_card_waits = false;
   170	            ink_storage_run(forget_card_mark, NULL, true);
   171	            tell_card_cleared();
   172	            return;
   173	        }
   174	    }
   175	    if (ink_power_state() != INK_PWR_LOCKED) ink_svc_at(&g_card_at, osal_now_us() + CARD_LOOK_US, card_look, NULL); /* locked: nobody uses it, and the chip sleeps */
   176	}
   177	
   178	static void card_look(void *arg) { /* the timer task: what it does blocks on the card */
   179	    (void)arg;
   180	    ink_exec_post(INK_EXEC_BG, &g_card_job, card_job, NULL);
   181	}
   182	
   183	static void on_power_for_card(void *ctx, int h, const char *id) { /* unlocked: looking again */
   184	    (void)ctx;
   185	    (void)h;
   186	    (void)id;
   187	    card_look(NULL);
   188	}
   189	
   190	static void restart_job(void *arg) { /* exec.bg, after the answer */
   191	    (void)arg;
   192	    osal_task_delay_us(300000);
   193	    hal_power_reboot();
   194	}
   195	
   196	static void factory_reset(ink_call_t *c) { /* exec.bg */
   197	    if (ink_usb_disk_active()) { /* nothing can be done about the card from here, and it is the person's to take back */
   198	        c->rc.status = INK_RC_FAILED;
   199	        snprintf(c->rc.detail, sizeof c->rc.detail, "the card is lent to a computer: take it back first");
   200	        snprintf(c->rc.say, sizeof c->rc.say, "存储卡借给电脑了，先收回再清空");
   201	        return;
   202	    }
   203	    bool marked = false;
   204	    ink_storage_run(mark_reset, &marked, true);
   205	    if (!marked) {
   206	        c->rc.status = INK_RC_FAILED;
   207	        snprintf(c->rc.detail, sizeof c->rc.detail, "cannot write to the flash");
   208	        snprintf(c->rc.say, sizeof c->rc.say, "这台设备的存储写不进去，没能清空");
   209	        return;
   210	    }
   211	    ink_probe_count("system.factory_resets");
   212	    snprintf(c->rc.say, sizeof c->rc.say, "%s", hal_fs_card_present() ? "清空这台设备，马上重启" : "清空这台设备，马上重启。存储卡不在，下次插上时再清卡上的");
   213	    ink_exec_post(INK_EXEC_BG, &g_reset_job, restart_job, NULL);
   214	}
   215	
   216	static void cap_reboot(ink_call_t *c) { /* exec.bg */
   217	    snprintf(c->rc.say, sizeof c->rc.say, "重启");
   218	    ink_db_flush_all();
   219	    for (int i = 0; i < 100 && (!ink_db_idle() || ink_storage_pending()); i++) osal_task_delay_us(50000);
   220	    hal_power_reboot();
   221	}
   222	
   223	#define LIST_CAP 4096
   224	
   225	static void state_list(ink_call_t *c) {
   226	    char *out = osal_malloc(LIST_CAP, OSAL_MEM_EXTERNAL);
   227	    if (!out || ink_state_json(out, LIST_CAP, INK_EXPOSE_AI) < 0) {
   228	        c->rc.status = INK_RC_FAILED;
   229	        snprintf(c->rc.detail, sizeof c->rc.detail, out ? "too long" : "out of memory");
   230	    } else ink_cap_result(c, out);
   231	    osal_free(out);
   232	}
   233	
   234	static void settings_list(ink_call_t *c) {
   235	    char *out = osal_malloc(LIST_CAP * 2, OSAL_MEM_EXTERNAL);
   236	    if (!out || ink_settings_json(out, LIST_CAP * 2) < 0) {
   237	        c->rc.status = INK_RC_FAILED;
   238	        snprintf(c->rc.detail, sizeof c->rc.detail, out ? "too long" : "out of memory");
   239	    } else ink_cap_result(c, out);
   240	    osal_free(out);
   241	}
   242	
   243	static const ink_cap_t SYSTEM_ACTIONS[] = {
   244	    {.id = "system.home", .title = "回到主页", .effect = INK_FX_NAVIGATE, .child_ok = true, .run = go_home},
   245	    {.id = "system.full_refresh", .title = "刷新屏幕", .effect = INK_FX_NAVIGATE, .child_ok = true, .run = full_refresh},
   246	    {.id = "system.set_volume",
   247	     .title = "调音量",
   248	     .input = "{\"type\":\"object\",\"properties\":{\"percent\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":100}},"
   249	             "\"required\":[\"percent\"]}",
   250	     .effect = INK_FX_LOCAL_WRITE,
   251	     .child_ok = true,
   252	     .while_locked = true,
   253	     .run = set_volume},
   254	    {.id = "system.switch_member",
   255	     .title = "切换家人",
   256	     .input = "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}",
   257	     .effect = INK_FX_NAVIGATE,
   258	     .child_ok = true,
   259	     .run = switch_member},
   260	    {.id = "state.list", .title = "系统现在的状态（电量、网络、前台应用……）", .output = "{\"type\":\"object\"}", .effect = INK_FX_READ, .child_ok = true, .exec = INK_EXEC_DIRECT, .run = state_list},
   261	    {.id = "settings.list", .title = "所有设置，各自的类型、取值范围和现在的值", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .exec = INK_EXEC_DIRECT, .run = settings_list},
   262	    {.id = "system.factory_reset", .title = "清空这台设备（清掉所有家人的数据，不能撤销）", .ask = "清空这台设备：清掉所有家人的数据，不能撤销", .effect = INK_FX_SYSTEM, .parent_pin = true, .child_ok = false, .exec = INK_EXEC_BG, .run = factory_reset},
   263	    {.id = "system.reboot", .title = "重启", .effect = INK_FX_SYSTEM, .child_ok = true, .while_locked = true, .exec = INK_EXEC_BG, .run = cap_reboot},
   264	};
   265	
   266	int ink_system_actions_init(void) {
   267	    ink_input_set_volume_key_hook(on_volume_key);
   268	    if (g_card_cleared) tell_card_cleared();
   269	    if (g_card_waits) {
   270	        if (ink_state_watch("power.state", on_power_for_card, NULL, INK_EXEC_DIRECT) != 0) return -1;
   271	        card_look(NULL);
   272	    }
   273	    return ink_cap_register(SYSTEM_ACTIONS, (int)(sizeof SYSTEM_ACTIONS / sizeof SYSTEM_ACTIONS[0]));
   274	}


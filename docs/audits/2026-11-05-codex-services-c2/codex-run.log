   484	    p->o = *o;
   485	    p->o.request_id = p->o.args_json = NULL; /* the caller's strings need not outlive the call */
   486	    p->o.member = NULL;
   487	    p->remote = remote;
   488	    p->deadline_us = osal_now_us() + (uint64_t)timeout_ms(c) * 1000u;
   489	    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
   490	    p->accepted = true;
   491	    if (!remote && (!CB.timer_due || p->deadline_us < CB.timer_due)) { /* only ever brought forward */
   492	        uint64_t now = osal_now_us();
   493	        CB.timer_due = p->deadline_us;
   494	        osal_timer_start(CB.timer, p->deadline_us > now ? p->deadline_us - now : 1, 0);
   495	    }
   496	    osal_mutex_unlock(CB.lock);
   497	    return p;
   498	}

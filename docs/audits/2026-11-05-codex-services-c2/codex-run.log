   325	static void pin_checked(void *ctx, int result, uint32_t wait_s) { /* exec.bg */
   326	    pin_answer_t *a = ctx;
   327	    if (result == INK_PIN_OK) decide(a->token, true);
   328	    if (a->done) a->done(a->ctx, result, wait_s);
   329	    osal_free(a);
   330	}

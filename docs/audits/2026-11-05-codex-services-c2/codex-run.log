   171	    lv_obj_add_flag(K.more, LV_OBJ_FLAG_HIDDEN);
   172	    /* the microphone: black, at the end of the candidates (the system UI's own look comes later) */
   173	    K.mic = lv_button_create(K.cands);
   174	    ink_ui_style_button(K.mic);
   175	    lv_obj_set_style_bg_color(K.mic, lv_color_black(), 0);

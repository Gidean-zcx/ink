   332	int ink_confirm_accept_with_pin(uint32_t token, const char *pin, ink_pin_done_fn done, void *ctx) {
   333	    pin_answer_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
   334	    if (!a) return -1;
   335	    *a = (pin_answer_t){token, done, ctx};
   336	    if (ink_member_check_parent(pin, pin_checked, a) != 0) {
   337	        osal_free(a);
   338	        return -1;
   339	    }
   340	    return 0;
   341	}
   342	
   343	static int decide(uint32_t token, bool accept) {
   344	    const char *prev = osal_mem_tag("confirm");
   345	    held_t *h = osal_malloc(sizeof *h, OSAL_MEM_EXTERNAL);
   346	    ran_t *r = osal_malloc(sizeof *r, OSAL_MEM_EXTERNAL);
   347	    osal_mem_tag(prev);
   348	    if (!h || !r || !take(token, h)) {
   349	        osal_free(h);
   350	        osal_free(r);
   351	        return -1;
   352	    }
   353	    changed();
   354	    r->token = token;
   355	    snprintf(r->cap, sizeof r->cap, "%s", h->cap->id);
   356	    snprintf(r->who, sizeof r->who, "%s", h->member);
   357	    if (!accept) tell(token, r->cap, "rejected", NULL, r->who);
   358	    else if (strcmp(h->member, ink_member_current()->id)) tell(token, r->cap, "member_changed", NULL, r->who);
   359	    else {
   360	        ink_call_opts_t o = {.src = INK_SRC_CONFIRMED, .page_gen = h->page_gen, .member = h->member, .reply_exec = INK_EXEC_DIRECT, .done = confirmed_done, .ctx = r};
   361	        int started = ink_cap_call(r->cap, &h->args, &o);
   362	        osal_free(h);
   363	        if (started == 0) return 0; /* confirmed_done frees it */
   364	        ink_receipt_t busy = {.status = INK_RC_FAILED};
   365	        snprintf(busy.detail, sizeof busy.detail, "could not be started");


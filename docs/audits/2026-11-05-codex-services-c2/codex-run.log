   275	/* What the session says now. */
   276	static void sync(void) { /* UI task */
   277	    if (!ink_text_focused()) {
   278	        if (K.root) {
   279	            lv_area_t a;
   280	            lv_obj_get_coords(K.root, &a);
   281	            ink_ui_hint_area(&a, INK_REFRESH_TEXT); /* the page under it comes back with its gray levels */
   282	            lv_obj_delete(K.root);
   283	            K.root = NULL;
   284	            K.first = 0;
   285	            K.symbols = K.shift = false;
   286	        }
   287	        return;
   288	    }
   289	    ink_text_type_t type = ink_text_type();
   290	    int kind = type == INK_TEXT_NUMBER || type == INK_TEXT_PHONE ? 3 : K.symbols ? 2 : 1;
   291	    if (!K.root || K.built_for != kind) build(kind);
   292	    ink_voice_state_t vs = ink_text_voice_state();
   293	    sync_voice(vs);
   294	    if (vs != INK_VOICE_IDLE) return;
   295	    lv_label_set_text(K.composing, ink_text_composing()[0] ? ink_text_composing() : ink_text_voice_notice());
   296	    ink_text_cand_t c[INK_TEXT_PAGE + 1];
   297	    int n = type == INK_TEXT_PLAIN ? ink_text_candidates(K.first, c, INK_TEXT_PAGE + 1) : 0;
   298	    if (!n && K.first) {
   299	        K.first = 0;
   300	        n = ink_text_candidates(0, c, INK_TEXT_PAGE + 1);
   301	    }
   302	    for (int i = 0; i < INK_TEXT_PAGE; i++) {
   303	        if (i < n) {
   304	            lv_label_set_text(K.cand_label[i], c[i].word);
   305	            lv_obj_remove_flag(K.cand_btn[i], LV_OBJ_FLAG_HIDDEN);
   306	        } else lv_obj_add_flag(K.cand_btn[i], LV_OBJ_FLAG_HIDDEN);
   307	    }
   308	    if (n > INK_TEXT_PAGE) lv_obj_remove_flag(K.more, LV_OBJ_FLAG_HIDDEN);
   309	    else lv_obj_add_flag(K.more, LV_OBJ_FLAG_HIDDEN);
   310	    if (ink_text_voice_possible()) lv_obj_remove_flag(K.mic, LV_OBJ_FLAG_HIDDEN);
   311	    else lv_obj_add_flag(K.mic, LV_OBJ_FLAG_HIDDEN);
   312	    K.shown = n;
   313	    ink_ui_hint_obj(K.cands, INK_REFRESH_FAST);
   314	    ink_ui_hint_obj(K.composing, INK_REFRESH_FAST);
   315	}

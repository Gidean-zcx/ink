   136	/* The field is there, and it is one the AI may touch. */
   137	static bool editable(ink_call_t *c) {
   138	    if (!ink_text_focused()) fail(c, INK_RC_FAILED, "no text field has the focus");
   139	    else if (ink_text_type() == INK_TEXT_PASSWORD || ink_text_ai_hidden()) fail(c, INK_RC_REJECTED, "this field is the person's to fill in");

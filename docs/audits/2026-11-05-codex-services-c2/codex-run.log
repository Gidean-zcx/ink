   299	
   300	int ink_confirm_decide(uint32_t token, bool accept, ink_source_t src) {
   301	    if (src != INK_SRC_TOUCH && src != INK_SRC_KEY) {
   302	        ink_probe_count("confirm.not_a_person");
   303	        return -1;
   304	    }
   305	    if (accept) { /* a yes that needs a parent comes with a PIN */
   306	        bool parent = false;
   307	        ink_svc_lock();
   308	        for (int i = 0; i < MAX_HELD; i++)
   309	            if (CF.held[i].used && CF.held[i].token == token) parent = CF.held[i].parent;
   310	        ink_svc_unlock();
   311	        if (parent) {
   312	            ink_probe_count("confirm.needs_pin");
   313	            return -1;
   314	        }
   315	    }
   316	    return decide(token, accept);
   317	}

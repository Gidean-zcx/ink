   556	    else if (result == INK_PIN_NO_MEMBER) snprintf(c->rc.detail, sizeof c->rc.detail, "no such member");
   557	    if (result != INK_PIN_OK) c->rc.status = result == INK_PIN_BAD_FORM || result == INK_PIN_NO_MEMBER ? INK_RC_INVALID : INK_RC_FAILED;
   558	    ink_cap_done(c);
   559	}

  1016	    ink_jw_raw(&w, "{");
  1017	    bool first = true;
  1018	    for (int i = 0; i < nreg; i++) {
  1019	        const char *dot = strchr(REG[i]->id, '.');
  1020	        size_t n = dot ? (size_t)(dot - REG[i]->id) : strlen(REG[i]->id);
  1021	        bool seen = false;
  1022	        int count = 0;
  1023	        for (int k = 0; k < nreg; k++) {
  1024	            if (!listed(REG[k]) || strncmp(REG[k]->id, REG[i]->id, n) || (REG[k]->id[n] != '.' && REG[k]->id[n])) continue;
  1025	            if (k < i) seen = true;
  1026	            count++;
  1027	        }
  1053	    for (int i = 0; i < nreg; i++) {
  1054	        const ink_cap_t *k = REG[i];
  1055	        if (!listed(k) || (!strstr(k->id, q) && !strstr(k->title, q))) continue;
  1056	        size_t before = w.len;

   107	static void forget_snaps(snap_t *list, int *n) {
   108	    for (int i = 0; i < *n; i++) {
   109	        memset(list[i].text, 0, strlen(list[i].text));
   110	        osal_free(list[i].text);
   111	    }
   112	    *n = 0;
   113	}
   114	
   115	static bool push_snap(snap_t *list, int *n) { /* what is there now; the oldest makes room */
   116	    char *copy = osal_malloc(strlen(TS.value) + 1, OSAL_MEM_EXTERNAL);
   117	    if (!copy) return false;
   118	    strcpy(copy, TS.value);
   119	    if (*n == UNDO_MAX) {
   120	        memset(list[0].text, 0, strlen(list[0].text));
   121	        osal_free(list[0].text);
   122	        memmove(list, list + 1, sizeof list[0] * (UNDO_MAX - 1));
   123	        (*n)--;
   124	    }
   125	    list[(*n)++] = (snap_t){copy, TS.cursor, TS.anchor};
   126	    return true;
   127	}

    18	
    19	static struct {
    20	    char text[INK_CLIP_MAX + 1];
    21	    bool sensitive;
    22	    ink_svc_deadline_t expiry;
    23	} CL INK_PSRAM_BSS;
    24	
    25	void ink_clip_clear(void) {
    26	    ink_svc_lock();
    27	    CL.text[0] = 0;
    28	    CL.sensitive = false;
    29	    ink_svc_unlock();
    30	    ink_svc_cancel(&CL.expiry);
    31	}
    32	
    33	static void expired(void *ctx) { /* the timer task */
    34	    (void)ctx;
    35	    ink_svc_lock();
    36	    bool was = CL.sensitive;
    37	    if (was) {
    38	        CL.text[0] = 0;
    39	        CL.sensitive = false;
    40	    }
    41	    ink_svc_unlock();
    42	    if (was) ink_probe_count("clipboard.sensitive_cleared");
    43	}
    44	
    45	int ink_clip_set(const char *text, bool sensitive, uint8_t src) {
    46	    (void)src;
    47	    if (!text || strlen(text) > INK_CLIP_MAX) return -1;
    48	    ink_svc_lock();
    49	    snprintf(CL.text, sizeof CL.text, "%s", text);
    50	    CL.sensitive = sensitive;
    51	    ink_svc_unlock();
    52	    if (sensitive) ink_svc_at(&CL.expiry, osal_now_us() + SENSITIVE_US, expired, NULL);
    53	    else ink_svc_cancel(&CL.expiry);
    54	    return 0;
    55	}
    56	
    57	int ink_clip_get(char *out, size_t cap, uint8_t src, bool *sensitive) {
    58	    bool remote = src == INK_SRC_AI || src == INK_SRC_REMOTE;
    59	    bool allowed = !remote || ink_setting_get("ai.read_clipboard");
    60	    ink_svc_lock();
    61	    bool s = CL.sensitive;
    62	    int n = -1;
    63	    if (allowed && !(remote && s)) {
    64	        n = snprintf(out, cap, "%s", CL.text);
    65	        if (n >= (int)cap) n = (int)cap - 1;
    66	    }
    67	    ink_svc_unlock();
    68	    if (sensitive) *sensitive = s;
    69	    if (n < 0) ink_probe_count("clipboard.refused");
    70	    return n;
    71	}
    72	
    73	static void on_member(void *ctx, int h, const char *id) { /* DIRECT: at the moment it changes hands */
    74	    (void)ctx;
    75	    (void)h;
    76	    (void)id;
    77	    ink_clip_clear();
    78	}

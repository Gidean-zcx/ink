   200	static void cap_cancel(ink_call_t *c) {
   201	    int64_t id = 0;
   202	    ink_args_get_int(&c->args, "id", &id);
   203	    const ink_member_t *m = ink_member_current();
   204	    void (*cancel)(void *) = NULL;
   205	    void *ctx = NULL;
   206	    const char *why = NULL;
   207	    ink_svc_lock();
   208	    task_t *t = find((int)id);
   209	    if (!t || !visible(t, m->id)) why = "no such task";
   210	    else if (t->state != INK_TASK_RUNNING) why = "it is over";
   211	    else if (!t->cancel) why = "this one cannot be stopped";
   212	    else if (t->for_everyone && m->role != INK_ROLE_ADULT) why = "an adult can stop this one";
   213	    else {
   214	        cancel = t->cancel;
   215	        ctx = t->cancel_ctx;
   216	    }
   217	    ink_svc_unlock();
   218	    if (why) {
   219	        c->rc.status = INK_RC_FAILED;
   220	        snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
   221	        return;
   222	    }
   223	    cancel(ctx);
   224	    snprintf(c->rc.say, sizeof c->rc.say, "正在停下");
   225	}

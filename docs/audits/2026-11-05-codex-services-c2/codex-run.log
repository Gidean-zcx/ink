    46	static void on_digit(lv_event_t *e) {
    47	    int d = (int)(intptr_t)lv_event_get_user_data(e);
    48	    if (d == 10) { /* delete */
    49	        if (P.n) P.pin[--P.n] = 0;
    50	    } else if (d == 11) { /* OK */
    51	        if (P.done) P.done(P.pin);
    52	        return;
    53	    } else if (P.n < sizeof P.pin - 1) {
    54	        P.pin[P.n++] = (char)('0' + d);
    55	        P.pin[P.n] = 0;
    56	    }
    57	    show_dots();
    58	}

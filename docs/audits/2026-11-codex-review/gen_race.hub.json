{
 "rules": [
  {
   "method": "hello",
   "think_ms": 40,
   "result": {
    "session": "sim",
    "proto": 1
   }
  },
  {
   "method": "ai.listen",
   "turns": [
    {
     "listen": {
      "stt_ms": 300,
      "transcript": "翻到下一页",
      "tts_first_ms": 400,
      "tts_chars_per_s": 4.5,
      "tts_speed": 2
     },
     "think_ms": 900,
     "stream": {
      "notify": "ai.delta",
      "interval_ms": 300,
      "chunks": [
       "好的。"
      ]
     },
     "result": {
      "done": true
     },
     "tools": [
      {
       "name": "reader.next_page",
       "arguments": {},
       "think_ms": 3000
      }
     ],
     "say_from_receipt": true
    }
   ]
  },
  {
   "method": "*",
   "think_ms": 30,
   "error": {
    "code": -32601,
    "message": "method not in hub script"
   }
  }
 ]
}
function(pkg name)
  execute_process(COMMAND ${PY} ${TOOL} ${ARGN} RESULT_VARIABLE rc ERROR_VARIABLE e)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "package ${name}: ${e}")
  endif()
endfunction()

# what the hub offers

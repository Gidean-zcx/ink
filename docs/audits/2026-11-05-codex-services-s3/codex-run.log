#!/usr/bin/env python3
"""Build an .inkfw upgrade package (system services design §12.2).

Little endian:
  header (4 KiB at most): magic "INKFW1\\0\\0", u32 format=1, u32 header_size, char product[32], char version[24],
    u32 version_code, u32 min_from_code, u32 flags (1: allow downgrade), u32 nsections,
    sections[n] { u32 kind (0 app, 1 font, 2 resources), u32 reserved, u64 offset, u64 size, u8 sha256[32] },
    u32 key_id, u8 signature[64]: over sha256 of the header, signature zeroed
  section data

The signature here is the simulator's stand-in (a keyed hash, the key is not secret). The real one is ECDSA P-256, made
off-line with a key that is not in this repository.

usage: make_inkfw.py OUT --version 2.0.0 --code 200 [--product P] [--min-from N] [--allow-downgrade]
                         [--app-size N] [--resources N] [--font N] [--corrupt-section] [--corrupt-signature]
"""
import argparse
import hashlib
import hmac
import struct

KEY = b"ink-simulator-test-signing-key"
PRODUCT = "metalio-e-ink4-plus"


def pad(s, n):
    return s.encode().ljust(n, b"\0")


def build(version, code, product=PRODUCT, min_from=0, flags=0, app_size=64 * 1024, resources=0, font=0, app_head=None):
    head = (app_head or f"SIMAPP {code} {version}\n").encode()
    app = head + bytes((i * 7) & 0xff for i in range(max(0, app_size - len(head))))
    sections = [(0, app)]
    if font:
        sections.append((1, bytes((i * 11) & 0xff for i in range(font))))
    if resources:
        sections.append((2, bytes((i * 13) & 0xff for i in range(resources))))
    header_size = 8 + 4 + 4 + 32 + 24 + 4 + 4 + 4 + 4 + len(sections) * (4 + 4 + 8 + 8 + 32) + 4 + 64
    off = header_size
    table = b""
    for kind, data in sections:
        table += struct.pack("<IIQQ", kind, 0, off, len(data)) + hashlib.sha256(data).digest()
        off += len(data)
    h = b"INKFW1\0\0" + struct.pack("<II", 1, header_size) + pad(product, 32) + pad(version, 24)
    h += struct.pack("<IIII", code, min_from, flags, len(sections)) + table + struct.pack("<I", 1)
    digest = hashlib.sha256(h + b"\0" * 64).digest()
    sig = hmac.new(KEY, digest, hashlib.sha256).digest().ljust(64, b"\0")
    return bytearray(h + sig + b"".join(d for _, d in sections)), header_size


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("out")
    ap.add_argument("--version", required=True)
    ap.add_argument("--code", type=int, required=True)
    ap.add_argument("--product", default=PRODUCT)
    ap.add_argument("--min-from", type=int, default=0)
    ap.add_argument("--allow-downgrade", action="store_true")
    ap.add_argument("--app-size", type=int, default=64 * 1024)
    ap.add_argument("--resources", type=int, default=0)
    ap.add_argument("--font", type=int, default=0)
    ap.add_argument("--corrupt-section", action="store_true")
    ap.add_argument("--corrupt-last-section", action="store_true")
    ap.add_argument("--corrupt-signature", action="store_true")
    ap.add_argument("--corrupt-header", action="store_true")
    a = ap.parse_args()
    data, hs = build(a.version, a.code, a.product, a.min_from, 1 if a.allow_downgrade else 0, a.app_size, a.resources, a.font)
    if a.corrupt_section:
        data[hs + 100] ^= 0xff
    if a.corrupt_last_section:
        data[-1] ^= 0xff
    if a.corrupt_signature:
        data[hs - 64 + 2] ^= 0xff
    if a.corrupt_header:
        data[8 + 4 + 4 + 32 + 2] ^= 0x01  # a character of the version: the signature no longer covers it
    with open(a.out, "wb") as f:
        f.write(data)
/*
 * A Bluetooth headset, as behaviour (see ink/hal_bt.h): it is switched on, in range, paired and connected; the sound goes
 * to it when the route says so (hal_audio_sim.c). No chip commands are made up here.
 */
#include <stdio.h>
#include <string.h>

#include "ink/hal_bt.h"
#include "ink/osal.h"
#include "sim.h"

#define MAX_HEADSETS 4
#define SCAN_FIND_US 1500000ull
#define PAIR_US 2000000ull
#define CONNECT_US 1500000ull

static struct {
    struct {
        hal_bt_device_t d;
        bool used, on, in_range, paired;
    } h[MAX_HEADSETS];
    int connected; /* index + 1 */
    void (*fn)(void *ctx, hal_bt_event_t ev);
    void *ctx;
} BT;

bool hal_bt_available(void) { return sim_board_present(); }

static int find(const char *addr) {
    for (int i = 0; i < MAX_HEADSETS; i++)
        if (BT.h[i].used && !strcmp(BT.h[i].d.addr, addr)) return i;
    return -1;
}

int hal_bt_scan(hal_bt_device_t *out, int max, int timeout_ms) {
    osal_task_delay_us((uint64_t)timeout_ms * 1000u < SCAN_FIND_US ? (uint64_t)timeout_ms * 1000u : SCAN_FIND_US);
    int n = 0;
    for (int i = 0; i < MAX_HEADSETS && n < max; i++)
        if (BT.h[i].used && BT.h[i].on && BT.h[i].in_range) out[n++] = BT.h[i].d;
    return n;
}

int hal_bt_pair(const char *addr) {
    int i = find(addr);
    if (i < 0 || !BT.h[i].on || !BT.h[i].in_range) return -1;
    osal_task_delay_us(PAIR_US);
    if (!BT.h[i].on || !BT.h[i].in_range) return -1;
    BT.h[i].paired = true;
    sim_metric_add("bt.pairs", 1);
    return 0;
}

int hal_bt_connect(const char *addr) {
    int i = find(addr);
    if (i < 0 || !BT.h[i].paired || !BT.h[i].on || !BT.h[i].in_range) return -1;
    osal_task_delay_us(CONNECT_US);
    if (!BT.h[i].on || !BT.h[i].in_range) return -1;
    BT.connected = i + 1;
    sim_metric_add("bt.connects", 1);
    if (BT.fn) BT.fn(BT.ctx, HAL_BT_EV_CONNECTED);
    return 0;
}

void hal_bt_disconnect(void) { BT.connected = 0; }

void hal_bt_forget(const char *addr) {
    int i = find(addr);
    if (i < 0) return;
    BT.h[i].paired = false;
    if (BT.connected == i + 1) BT.connected = 0;
}

void hal_bt_on_event(void (*fn)(void *ctx, hal_bt_event_t ev), void *ctx) {
    BT.fn = fn;
    BT.ctx = ctx;
}

/* ---- the script's hands ---- */

static void tell_lost(void *arg) { /* the system event task, as with the network's news */
    (void)arg;
    if (BT.fn) BT.fn(BT.ctx, HAL_BT_EV_LOST);
}

static void gone(int i) {
    if (BT.connected != i + 1) return;
    BT.connected = 0;
    sim_sys_evt(tell_lost, NULL);
}

void sim_headset_add(const char *addr, const char *name) {
    for (int i = 0; i < MAX_HEADSETS; i++)
        if (!BT.h[i].used) {
            BT.h[i].used = BT.h[i].on = BT.h[i].in_range = true;
            snprintf(BT.h[i].d.addr, sizeof BT.h[i].d.addr, "%s", addr);
            snprintf(BT.h[i].d.name, sizeof BT.h[i].d.name, "%s", name);
            return;
        }
}

void sim_headset_power(const char *addr, bool on) {
    int i = find(addr);
    if (i < 0) return;
    BT.h[i].on = on;
    if (!on) gone(i);
}

void sim_headset_range(const char *addr, bool in) {
    int i = find(addr);
    if (i < 0) return;
    BT.h[i].in_range = in;
    if (!in) gone(i);
}
static void start_talking(const char *phrases) {
    sim_hub_asr_script(phrases, NULL, 0);
    CHECK(press("话筒"), "the microphone key is there");
    CHECK(WAIT_FOR(state_is(INK_VOICE_LISTENING), 5000), "listening (%d)", g_state);
    mic("speech");
}

/* The keyboard's height: the panel takes the place of the keys, nothing above it moves. */
static int g_kb_h;
static void do_kb_height(void) {
    g_kb_h = 0;
    lv_obj_t *top = lv_layer_top();
    for (uint32_t i = 0; i < lv_obj_get_child_count(top); i++) {
        lv_obj_t *c = lv_obj_get_child(top, (int32_t)i);
        lv_obj_update_layout(c);
        if (lv_obj_get_height(c) > g_kb_h) g_kb_h = lv_obj_get_height(c);
    }
}
static int kb_height(void) {
    on_ui(do_kb_height);
    return g_kb_h;
}

static volatile int g_ended;
static char g_ended_how[16], g_ended_why[64];
static void on_ended(void *ctx, const char *id, const ink_args_t *a) {
    (void)ctx;
    (void)id;
    g_ended_how[0] = g_ended_why[0] = 0;
    ink_args_get_str(a, "how", g_ended_how, sizeof g_ended_how);
    ink_args_get_str(a, "why", g_ended_why, sizeof g_ended_why);
    g_ended++;
}

/* ---- the plain case ---- */

static void happy(void) {
    CHECK(ink_cap_subscribe("text.voice_ended", on_ended, NULL, INK_EXEC_DIRECT) == 0, "listening for the end");
    focus_as(INK_TEXT_PLAIN, "备注：");
    delay_ms(300);
    double opened = sim_metric_value("hub.asr_opened");
    int height = kb_height();
    start_talking("今晚七点到家。|给我留饭。");
    CHECK(kb_height() == height, "the panel is the size of the keys (%d, %d)", kb_height(), height);
    CHECK(sim_metric_value("hub.asr_opened") == opened + 1, "one session");
    CHECK(strstr(sim_hub_asr_params(), "\"kind\":\"text\"") && strstr(sim_hub_asr_params(), "\"format\":\"opus\""), "as what (%s)", sim_hub_asr_params());
    CHECK(!strcmp(ink_state_get_str(ink_state_find("text.voice"), g_value, sizeof g_value) >= 0 ? g_value : "", "listening"), "state says so (%s)", g_value);
    /* the panel where the keys were */
    CHECK(there("说完了") && there("用键盘") && !there("q") && !there("话筒"), "the panel instead of the keys");
    {
        char mic_now[16] = "";
        ink_state_get_str(ink_state_find("audio.mic"), mic_now, sizeof mic_now);
        CHECK(!strcmp(mic_now, "sending"), "the microphone says it goes out (%s)", mic_now);
    }
    /* what is heard shows in the panel and not in the field */
    CHECK(WAIT_FOR((look(), g_heard[0] != 0), 3000), "the first words come");
    CHECK(WAIT_FOR((look(), strstr(g_heard, "今晚七点到家。") != NULL), 3000), "the first sentence (%s)", g_heard);
    CHECK(keyboard_says("今晚七点到家。"), "on the panel");
    CHECK(!strcmp(g_value, "备注：") && !strstr(ink_text_value(), "今晚"), "the field has not changed (%s)", g_value);
    CHECK(WAIT_FOR((look(), strstr(g_heard, "给我") != NULL), 3000), "a part of the next (%s)", g_heard);
    CHECK(sim_metric_value("hub.asr_frames") > 20, "frames go (%.0f)", sim_metric_value("hub.asr_frames"));
    /* the finger says it is over */
    double ends = sim_metric_value("hub.asr_turn_end");
    CHECK(press("说完了"), "said");
    CHECK(WAIT_FOR(state_is(INK_VOICE_IDLE), 3000), "over (%d)", g_state);
    CHECK(sim_metric_value("hub.asr_turn_end") == ends + 1, "the hub was told");
    CHECK(WAIT_FOR(sim_metric_value("hub.asr_cancelled") == cancelled + 1, 1000), "and the hub hears it");
    delay_ms(300);

    /* locking */
    focus_as(INK_TEXT_PLAIN, "锁之前");
    delay_ms(300);
    start_talking("这句也丢掉。");
    CHECK(WAIT_FOR((look(), g_heard[0] != 0), 3000), "heard");
    ink_power_lock();
    CHECK(WAIT_FOR(state_is(INK_VOICE_IDLE), 2000), "locked: over");
    look();
    CHECK(!strcmp(g_value, "锁之前"), "nothing goes in (%s)", g_value);
    ink_power_unlock(osal_now_us());
    CHECK(WAIT_FOR(strcmp(power_state(), "locked") != 0, 70000), "unlocked");
    ink_power_activity(osal_now_us());
    delay_ms(300);

    /* a call (system UI spec §8): the microphone goes at once, what was said is not lost, and it can go on afterwards */
    start_talking("来电话了。");
    CHECK(WAIT_FOR((look(), g_heard[0] != 0), 3000), "heard");
    g_hw.num[0] = 0;
    snprintf(g_hw.num, sizeof g_hw.num, "10086");
    int ended = g_ended;
    hw(HW_CALL, 0, 0);
    CHECK(WAIT_FOR(!strcmp(active_state(), "call"), 5000), "it rings (%s)", active_state());
    CHECK(!ink_audio_capture_busy() || WAIT_FOR(!ink_audio_capture_busy(), 500), "the microphone is free for it");
    double frames = sim_metric_value("hub.asr_frames");
    delay_ms(1000);
    CHECK(sim_metric_value("hub.asr_frames") == frames, "and nothing of the call goes to the hub (%.0f)", sim_metric_value("hub.asr_frames") - frames);
    CHECK(WAIT_FOR(state_is(INK_VOICE_IDLE), 3000), "a call: over");
    CHECK(WAIT_FOR(g_ended > ended, 500) && !strcmp(g_ended_how, "interrupted"), "and says how (%s)", g_ended_how);
    look();
    CHECK(strstr(g_value, "锁之前") && strstr(g_value, "来电话了。"), "what was said goes in (%s)", g_value);
    CHECK(strstr(g_notice, "接着说"), "and it can go on (%s)", g_notice);
    hw(HW_HANGUP, 0, 0);
    CHECK(WAIT_FOR(!strcmp(active_state(), "none"), 5000), "it hangs up");
    delay_ms(1000);
    CHECK(ink_text_focused() && there("话筒"), "back in the field, the key is there");
    start_talking("接着说的。");
    CHECK(WAIT_FOR((look(), g_heard[0] != 0), 3000), "heard");
    CHECK(press("说完了"), "said");
    CHECK(WAIT_FOR(state_is(INK_VOICE_IDLE), 3000), "over");
    look();
    CHECK(strstr(g_value, "来电话了。接着说的。"), "it goes on from there (%s)", g_value);
    delay_ms(300);

    /* half a sentence, and the hub does not answer any more: what was heard is what there is */
    sim_hub_asr_script("半句话说到这里", "mute", 12);
    CHECK(press("话筒"), "the microphone key is there");
    CHECK(WAIT_FOR(state_is(INK_VOICE_LISTENING), 5000), "listening (%d)", g_state);
    mic("speech");
    CHECK(WAIT_FOR((look(), g_heard[0] != 0), 3000), "heard (%s)", g_heard);
    char half[64];
    snprintf(half, sizeof half, "%s", g_heard);
    int by_call = ink_audio_focus_acquire(INK_AUDIO_PRIO_CALL, NULL, NULL, INK_EXEC_DIRECT);
    CHECK(by_call > 0 && WAIT_FOR(state_is(INK_VOICE_IDLE), 10000), "over, after a while");
    look();
    CHECK(strstr(g_value, half), "half a sentence is not lost (%s, %s)", g_value, half);
    CHECK(strstr(g_notice, "接着说"), "and it is not told about the hub, only that it can go on (%s)", g_notice);
    ink_audio_focus_release(by_call);
    delay_ms(300);

    /* an alarm's level */
    start_talking("闹钟响了。");
    int alert = ink_audio_focus_acquire(INK_AUDIO_PRIO_ALERT, NULL, NULL, INK_EXEC_DIRECT);
    CHECK(alert > 0 && WAIT_FOR(!ink_audio_capture_busy(), 500), "an alarm: the microphone is free");
    CHECK(WAIT_FOR(state_is(INK_VOICE_IDLE), 3000), "over");
    look();
    CHECK(strstr(g_value, "闹钟响了"), "what was said goes in (%s)", g_value);
    /* under it, or under a call, it does not start */
    on_ui(do_start);


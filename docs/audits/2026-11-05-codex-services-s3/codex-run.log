int text_caps_init(void) { return ink_cap_register(TEXT_CAPS, (int)(sizeof TEXT_CAPS / sizeof TEXT_CAPS[0])); }
/* A text field for pages (see ink/sys/textfield.h). The session is the text service's; this shows it. */
#include <stdio.h>
#include <string.h>

#include "ink/hal_display.h"
#include "ink/osal.h"
#include "ink/sys/ai.h"
#include "ink/sys/font.h"
#include "ink/sys/textfield.h"

typedef struct {
    lv_obj_t *obj, *label, *menu;
    ink_text_cfg_t cfg;
    char hint[48];
    char *text; /* what it holds: the session's while it has one */
    size_t cap;
    int session;
    size_t window; /* the character the label starts with */
    int mark_at;   /* the place of the mark in the label, -1 none */
    void (*entered)(void *ctx, const char *value);
    void *ctx;
} field_t;

#define WINDOW_CHARS 30

static const lv_font_t *font(void) {
    hal_panel_info_t pi;
    hal_display_get_info(&pi);
    ink_font_t *cjk = ink_font_for_pt(10, pi.dpi);
    return cjk ? ink_font_lvgl(cjk) : ink_ui_font(0);
}

static const char *char_at(const char *s, size_t chars) {
    while (*s && chars) {
        s++;
        while ((*s & 0xC0) == 0x80) s++;
        chars--;
    }
    return s;
}

/* The text with what is being composed where the cursor is; the cursor or the selection marked unless it is simply at the end
 * (placeholder look, D-64). A long text starts so that the cursor is in view. */
static void compose_line(field_t *f, const char *v, const char *c, char *line, size_t cap) {
    size_t start, end;
    ink_text_selection(&start, &end);
    size_t all = 0;
    for (const char *p = v; *p; p++) all += (*p & 0xC0) != 0x80;
    f->window = end > WINDOW_CHARS ? end - WINDOW_CHARS : 0;
    const char *from = char_at(v, f->window), *a = char_at(v, start), *b = char_at(v, end);
    if (start != end) {
        f->mark_at = (int)(start - f->window);
        snprintf(line, cap, "%.*s[%.*s]%s", (int)(a - from), from, (int)(b - a), a, b);
    } else if (end < all || c[0]) {
        f->mark_at = (int)(end - f->window);
        snprintf(line, cap, "%.*s%s|%s", (int)(a - from), from, c, a);
    } else snprintf(line, cap, "%s", from);
}

static void show(field_t *f) {
    const char *v = f->session ? ink_text_value() : f->text;
    const char *c = f->session ? ink_text_composing() : "";
    char line[256];
    f->window = 0;
    f->mark_at = -1;
    if (f->cfg.type == INK_TEXT_PASSWORD) {
        size_t n = strlen(v);
        if (n >= sizeof line) n = sizeof line - 1;
        memset(line, '*', n);
        line[n] = 0;
    } else if (!v[0] && !c[0]) snprintf(line, sizeof line, "%s", f->hint);
    else if (f->session) compose_line(f, v, c, line, sizeof line);
    else snprintf(line, sizeof line, "%s%s", v, c);
    lv_label_set_text(f->label, line);
    ink_ui_hint_obj(f->obj, INK_REFRESH_FAST);
}

static void remember(field_t *f) {
    if (f->session) snprintf(f->text, f->cap + 1, "%s", ink_text_value());
}

static void cl_changed(void *ctx) {
    field_t *f = ctx;
    remember(f);
    show(f);
}

static void cl_entered(void *ctx, const char *value) {
    field_t *f = ctx;
    remember(f);
    if (f->entered) f->entered(f->ctx, value);
}

static void cl_ended(void *ctx) {
    field_t *f = ctx;
    f->session = 0;
    show(f);
}

static const ink_text_client_t CLIENT = {cl_changed, cl_entered, cl_ended};

static void focus(field_t *f) {
    if (f->session) return;
    ink_text_cfg_t c = f->cfg;
    c.initial = f->text;
    c.hint = f->hint;
    f->session = ink_text_focus(&c, &CLIENT, f);
    if (f->session < 0) f->session = 0;
    show(f);
}

static void close_menu(field_t *f) {
    if (f->menu) lv_obj_delete(f->menu);
    f->menu = NULL;
}

/* What the tap or the long press was on, as a place in the text. */
static size_t place_of(field_t *f, lv_event_t *e) {
    lv_point_t p;
    lv_indev_get_point(lv_event_get_indev(e), &p);
    lv_area_t a;
    lv_obj_get_coords(f->label, &a);
    p.x -= a.x1;
    p.y -= a.y1;
    uint32_t letter = lv_label_get_letter_on(f->label, &p, true);
    if (f->mark_at >= 0 && letter > (uint32_t)f->mark_at) letter--; /* the mark is not a letter of the text */
    return f->window + letter;
}

static void on_copy(lv_event_t *e) {
    field_t *f = lv_event_get_user_data(e);
    char *what = osal_malloc(INK_CLIP_MAX + 1, OSAL_MEM_EXTERNAL);
    if (what) {
        if (f->session && ink_text_selected(what, INK_CLIP_MAX + 1) > 0) ink_clip_set(what, false, 0 /* the person's own */);
        else if (f->cfg.type != INK_TEXT_PASSWORD) ink_clip_set(f->text, false, 0);
        memset(what, 0, INK_CLIP_MAX + 1);
        osal_free(what);
    }
    close_menu(f);
}

static void on_left(lv_event_t *e) {
    (void)e;
    ink_text_move(-1, true);
}

static void on_right(lv_event_t *e) {
    (void)e;
    ink_text_move(1, true);
}

static void on_undo(lv_event_t *e) {
    field_t *f = lv_event_get_user_data(e);
    close_menu(f);
    ink_text_undo();
}

static void on_paste(lv_event_t *e) {
    field_t *f = lv_event_get_user_data(e);
    char *clip = osal_malloc(INK_CLIP_MAX + 1, OSAL_MEM_EXTERNAL);
    close_menu(f);
    if (!clip) return;
    focus(f);
    if (ink_clip_get(clip, INK_CLIP_MAX + 1, 0, NULL) > 0) ink_text_commit_utf8(clip);
    osal_free(clip);
}

static void on_ask(lv_event_t *e) {
    field_t *f = lv_event_get_user_data(e);
    char *q = f->cfg.type == INK_TEXT_PASSWORD || f->cfg.ai_hidden ? NULL : f->text;
    close_menu(f);
    if (q && q[0]) ink_ai_ask_text(q);
}

static void menu_button(field_t *f, const char *label, lv_event_cb_t cb) {
    lv_obj_t *b = lv_button_create(f->menu);
    ink_ui_style_button(b);
    lv_obj_add_event_cb(b, cb, LV_EVENT_CLICKED, f);
    lv_obj_t *l = lv_label_create(b);
    lv_obj_set_style_text_font(l, font(), 0);
    lv_label_set_text(l, label);
}

static void field_event(lv_event_t *e) {
    field_t *f = lv_event_get_user_data(e);
    lv_event_code_t code = lv_event_get_code(e);
    if (code == LV_EVENT_SHORT_CLICKED) { /* a plain click also comes after a long press */
        close_menu(f);
        if (f->session) ink_text_set_cursor(place_of(f, e)); /* the first tap is to start typing */
        focus(f);
    } else if (code == LV_EVENT_LONG_PRESSED) {
        close_menu(f);
        if (f->session && f->cfg.type != INK_TEXT_PASSWORD) ink_text_select_word(place_of(f, e));
        f->menu = lv_obj_create(lv_layer_top());
        lv_obj_remove_flag(f->menu, LV_OBJ_FLAG_SCROLLABLE);
        lv_obj_set_size(f->menu, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
        lv_obj_set_flex_flow(f->menu, LV_FLEX_FLOW_ROW);
        lv_obj_align_to(f->menu, f->obj, LV_ALIGN_OUT_BOTTOM_LEFT, 0, ink_dp(4));
        if (f->session && f->cfg.type != INK_TEXT_PASSWORD) {
            menu_button(f, "◀", on_left);
            menu_button(f, "▶", on_right);
            menu_button(f, "撤销", on_undo);
        }
        menu_button(f, "复制", on_copy);
        menu_button(f, "粘贴", on_paste);
        menu_button(f, "问 AI", on_ask);
        ink_ui_hint_obj(f->menu, INK_REFRESH_FAST);
    } else if (code == LV_EVENT_DELETE) {
        close_menu(f);
        if (f->session) ink_text_blur(f->session);
        osal_free(f->text);
        osal_free(f);
    }
}

lv_obj_t *ink_textfield_create(lv_obj_t *parent, const ink_text_cfg_t *cfg, void (*entered)(void *ctx, const char *value), void *ctx, bool start) {
    field_t *f = osal_calloc(1, sizeof *f, OSAL_MEM_EXTERNAL);
    size_t cap = cfg->max ? cfg->max : 1024;
    char *text = osal_malloc(cap + 1, OSAL_MEM_EXTERNAL);
    if (!f || !text) {
        osal_free(f);
        osal_free(text);
        return NULL;
    }
    f->cfg = *cfg;
    f->cap = cap;
    f->text = text;
    snprintf(f->text, cap + 1, "%s", cfg->initial ? cfg->initial : "");
    snprintf(f->hint, sizeof f->hint, "%s", cfg->hint ? cfg->hint : "");
    f->entered = entered;
    f->ctx = ctx;
    f->obj = lv_obj_create(parent);
    lv_obj_remove_flag(f->obj, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_size(f->obj, LV_PCT(90), ink_dp(48));
    lv_obj_set_style_border_color(f->obj, lv_color_black(), 0);
    lv_obj_set_style_border_width(f->obj, 2, 0);
    lv_obj_set_style_radius(f->obj, ink_dp(4), 0);
    f->label = lv_label_create(f->obj);
    lv_obj_set_style_text_font(f->label, font(), 0);
    lv_obj_set_width(f->label, LV_PCT(100));
    lv_label_set_long_mode(f->label, LV_LABEL_LONG_CLIP);
    lv_obj_add_event_cb(f->obj, field_event, LV_EVENT_ALL, f);
    lv_obj_set_user_data(f->obj, f);
    show(f);
    if (start) focus(f);
    return f->obj;
}

const char *ink_textfield_text(lv_obj_t *field) {
    field_t *f = lv_obj_get_user_data(field);
    return f ? f->text : "";
}
/*
 * The list of what goes on in the background (ink/sys/task.h). A small table under the shared lock: what ended stays until there
 * is no room for something new, the oldest of it going first. Each member sees their own and what is for everyone.
 */
#include <stdio.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/cap.h"
#include "ink/sys/json.h"
#include "ink/sys/layout.h"
#include "ink/sys/members.h"
#include "ink/sys/state.h"
#include "ink/sys/svc.h"
#include "ink/sys/task.h"
#include "ink/sys/time.h"

#define TASKS_MAX 16
#define LIST_MAX 6144 /* all of them with everything filled in */

typedef struct {
    int id;
    ink_task_state_t state;
    int percent;
    bool for_everyone;
    void (*cancel)(void *ctx);
    void *cancel_ctx;
    char kind[24], title[64], stage[16], result[96], object[48];
    char member[INK_MEMBER_ID_MAX];
    int64_t ended_s;
    uint32_t order;
} task_t;

static struct {
    task_t t[TASKS_MAX];
    int next_id;
    uint32_t next_order;
    int h_running;
    bool ready;
} T INK_PSRAM_BSS;

static const char *const STATE_NAME[] = {"running", "done", "failed", "cancelled"};

static void publish_running(void) {
    if (!T.ready) return; /* some test programs run without the list */
    int n = 0;
    ink_svc_lock();
    for (int i = 0; i < TASKS_MAX; i++) n += T.t[i].id && T.t[i].state == INK_TASK_RUNNING;
    ink_svc_unlock();
    ink_state_set_int(T.h_running, n);
}

static task_t *find(int id) { /* under the lock */
    for (int i = 0; id > 0 && i < TASKS_MAX; i++)
        if (T.t[i].id == id) return &T.t[i];
    return NULL;
}

int ink_task_begin(const char *kind, const char *title, bool for_everyone, void (*cancel)(void *ctx), void *ctx) {
    char member[INK_MEMBER_ID_MAX];
    snprintf(member, sizeof member, "%s", for_everyone ? "" : ink_member_current()->id);
    ink_svc_lock();
    task_t *slot = NULL, *oldest = NULL;
    for (int i = 0; i < TASKS_MAX && !slot; i++) {
        task_t *t = &T.t[i];
        if (!t->id) slot = t;
        else if (t->state != INK_TASK_RUNNING && (!oldest || t->order < oldest->order)) oldest = t;
    }
    if (!slot) slot = oldest;
    int id = 0;
    if (slot) {
        id = ++T.next_id;
        *slot = (task_t){.id = id, .state = INK_TASK_RUNNING, .percent = -1, .for_everyone = for_everyone, .cancel = cancel, .cancel_ctx = ctx, .order = ++T.next_order};
        snprintf(slot->kind, sizeof slot->kind, "%s", kind);
        snprintf(slot->title, sizeof slot->title, "%s", title);
        snprintf(slot->member, sizeof slot->member, "%s", member);
    }
    ink_svc_unlock();
    if (id) publish_running();
    else ink_probe_count("task.no_room");
    return id;
}

void ink_task_progress(int id, int percent, const char *stage) {
    ink_svc_lock();
    task_t *t = find(id);
    if (t && t->state == INK_TASK_RUNNING) {
        t->percent = percent;
        if (stage) snprintf(t->stage, sizeof t->stage, "%s", stage);
    }
    ink_svc_unlock();
}

void ink_task_end(int id, ink_task_state_t how, const char *result, const char *object) {
    ink_args_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    if (a) ink_args_init(a);
    ink_svc_lock();
    task_t *t = find(id);
    bool ended = t && t->state == INK_TASK_RUNNING;
    if (ended) {
        t->state = how;
        t->cancel = NULL;
        t->ended_s = ink_time_now_s();
        if (how == INK_TASK_DONE) t->percent = 100;
        if (result) snprintf(t->result, sizeof t->result, "%s", result);
        if (object) snprintf(t->object, sizeof t->object, "%s", object);
        if (a) {
            ink_args_int(a, "id", id);
            ink_args_str(a, "kind", t->kind);
            ink_args_str(a, "title", t->title);
            ink_args_str(a, "state", STATE_NAME[how]);
            if (t->result[0]) ink_args_str(a, "result", t->result);
            if (t->object[0]) ink_args_str(a, "object", t->object);
            if (t->member[0]) ink_args_str(a, "member", t->member); /* told only while it is theirs who is here */
        }
    }
    ink_svc_unlock();
    if (ended) {
        publish_running();
        if (a) ink_cap_emit("job.finished", a);
    }
    osal_free(a);
}

/* Theirs, or for everyone. */
static bool visible(const task_t *t, const char *member) { return t->id && (t->for_everyone || !strcmp(t->member, member)); }

/* Newest first: what runs, then what ended. */
static void cap_list(ink_call_t *c) {
    char *out = osal_malloc(LIST_MAX, OSAL_MEM_EXTERNAL);
    task_t *copy = osal_malloc(sizeof T.t, OSAL_MEM_EXTERNAL);
    if (!out || !copy) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "out of memory");
        osal_free(out);
        osal_free(copy);
        return;
    }
    ink_svc_lock();
    memcpy(copy, T.t, sizeof T.t);
    ink_svc_unlock();
    const char *member = ink_member_current()->id;
    ink_jw_t w;
    ink_jw_init(&w, out, LIST_MAX);
    ink_jw_raw(&w, "[");
    bool first = true;
    for (int running = 1; running >= 0; running--) {
        uint32_t below = UINT32_MAX;
        for (;;) {
            const task_t *t = NULL;
            for (int i = 0; i < TASKS_MAX; i++) {
                const task_t *x = &copy[i];
                if (visible(x, member) && (x->state == INK_TASK_RUNNING) == (running == 1) && x->order < below && (!t || x->order > t->order)) t = x;
            }
            if (!t) break;
            below = t->order;
            ink_jw_raw(&w, first ? "{\"id\":" : ",{\"id\":");
            first = false;
            ink_jw_int(&w, t->id);
            ink_jw_raw(&w, ",\"kind\":");
            ink_jw_str(&w, t->kind);
            ink_jw_raw(&w, ",\"title\":");
            ink_jw_str(&w, t->title);
            ink_jw_raw(&w, ",\"state\":");
            ink_jw_str(&w, STATE_NAME[t->state]);
            if (t->percent >= 0) {
                ink_jw_raw(&w, ",\"percent\":");
                ink_jw_int(&w, t->percent);
            }
            if (t->stage[0]) {
                ink_jw_raw(&w, ",\"stage\":");
                ink_jw_str(&w, t->stage);
            }
            if (t->cancel) ink_jw_raw(&w, ",\"can_cancel\":true");
            if (t->result[0]) {
                ink_jw_raw(&w, ",\"result\":");
                ink_jw_str(&w, t->result);
            }
            if (t->object[0]) {
                ink_jw_raw(&w, ",\"object\":");
                ink_jw_str(&w, t->object);
            }
            if (t->ended_s) {
                ink_jw_raw(&w, ",\"ended_s\":");
                ink_jw_int(&w, t->ended_s);
            }
            ink_jw_raw(&w, "}");
        }
    }
    ink_jw_raw(&w, "]");
    if (w.overflow) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "too long");
    } else ink_cap_result(c, out);
    osal_free(copy);
    osal_free(out);
}

static void cap_cancel(ink_call_t *c) {
    int64_t id = 0;
    ink_args_get_int(&c->args, "id", &id);
    const ink_member_t *m = ink_member_current();
    void (*cancel)(void *) = NULL;
    void *ctx = NULL;
    const char *why = NULL;
    ink_svc_lock();
    task_t *t = find((int)id);
    if (!t || !visible(t, m->id)) why = "no such task";
    else if (t->state != INK_TASK_RUNNING) why = "it is over";
    else if (!t->cancel) why = "this one cannot be stopped";
    else if (t->for_everyone && m->role != INK_ROLE_ADULT) why = "an adult can stop this one";
    else {
        cancel = t->cancel;
        ctx = t->cancel_ctx;
    }
    ink_svc_unlock();
    if (why) {
        c->rc.status = INK_RC_FAILED;
        snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
        return;
    }
    cancel(ctx);
    snprintf(c->rc.say, sizeof c->rc.say, "正在停下");
}

static const ink_cap_t TASK_CAPS[] = {
    {.id = "job.list", .title = "后台在做什么、做到哪了、做完的结果", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .exec = INK_EXEC_DIRECT, .run = cap_list},
    {.id = "job.cancel", .title = "停下一件后台在做的事",
     .input = "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"id\"]}",
     .effect = INK_FX_NAVIGATE, .child_ok = true, .exec = INK_EXEC_DIRECT, .run = cap_cancel},
    {.id = "job.finished", .title = "一件后台的事结束了（做好了、失败了、停下了）", .form = INK_FORM_EVENT, .effect = INK_FX_READ, .child_ok = true},
};

static const ink_state_def_t ST_RUNNING = {.id = "job.running", .type = INK_ST_INT, .title = "后台有几件事在做"};

int ink_task_init(void) {
    T.h_running = ink_state_define(&ST_RUNNING);
    ink_state_set_int(T.h_running, 0);
    T.ready = true;
    return ink_cap_register(TASK_CAPS, (int)(sizeof TASK_CAPS / sizeof TASK_CAPS[0]));
}


index 0000000000000000000000000000000000000000..1e53dbf2e69ee2e978b0f1b07b043e35506553d8
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-s3/experiments/reset_depth_probe.c
@@ -0,0 +1,17 @@
+#include "product_probe.h"
+static void audit_task(void *arg) {
+    (void)arg; delay_ms(1800);
+    const char *p = "/me/a/b/c/d/e/f/g/h/i/private.txt";
+    CHECK(ink_fs_write_atomic(p, "AUDIT-SYNTHETIC", 15) == INK_FS_OK, "make deep personal file through file service");
+    int r = ink_fs_wipe_personal();
+    ink_fs_stat_t st;
+    int remains = ink_fs_stat(p, &st);
+    printf("AUDIT wipe_result=%d deep_file_stat=%d\n", r, remains);
+    CHECK(r == INK_FS_OK && remains == INK_FS_OK, "reproduce successful wipe leaving personal file");
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t c = {.name="audit-reset", .fn=audit_task, .stack_bytes=16384, .priority=OSAL_PRIO_NORMAL, .core=-1, .flags=OSAL_TASK_STACK_EXTERNAL};
+    osal_task_create(&c, NULL);
+}
diff --git a/docs/audits/2026-11-05-codex-services-s3/experiments/update_cancel_probe.c b/docs/audits/2026-11-05-codex-services-s3/experiments/update_cancel_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..1f463a8a8bff7cbcc9439fe1a76c1b2d31cda950
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-s3/experiments/update_cancel_probe.c
@@ -0,0 +1,24 @@
+#include "product_probe.h"
+extern int audit_waiting_chunk(void), audit_download_task(void);
+static void audit_task(void *arg) {
+    (void)arg;
+    delay_ms(1800);
+    ink_hub_demand();
+    CHECK(WAIT_FOR(ink_hub_online(), 20000), "hub online");
+    CHECK(BY_HAND("update.check", NULL) && g_rc.status == INK_RC_DONE, "check: %s", g_rc.detail);
+    CHECK(BY_HAND("update.download", NULL) && g_rc.status == INK_RC_DONE, "download: %s", g_rc.detail);
+    for (int i = 0; i < 10000 && !audit_waiting_chunk(); i++) delay_ms(1);
+    CHECK(audit_waiting_chunk(), "a real chunk request is pending");
+    char a[64];
+    snprintf(a, sizeof a, "{\"id\":%d}", audit_download_task());
+    printf("AUDIT cancelling pending download task=%d\n", audit_download_task()); fflush(stdout);
+    CHECK(BY_HAND("job.cancel", a) && g_rc.status == INK_RC_DONE, "cancel: %s", g_rc.detail);
+    delay_ms(4000);
+    printf("AUDIT survived late chunk\n");
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t c = {.name="audit-cancel", .fn=audit_task, .stack_bytes=16384, .priority=OSAL_PRIO_NORMAL, .core=-1, .flags=OSAL_TASK_STACK_EXTERNAL};
+    osal_task_create(&c, NULL);
+}

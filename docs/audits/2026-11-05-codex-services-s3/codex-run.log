/*
 * The keyboard panel (placeholder look until the system UI, D-64): a system panel at the bottom of the screen, under the
 * cards, over the page. It shows what the input session says and feeds in what is pressed; the page above it stays usable.
 * What changes is driven with the fast waveform (foundation §4.8).
 */
#include <stdio.h>
#include <string.h>

#include "ink/hal_display.h"
#include "ink/osal.h"
#include "ink/sys/font.h"
#include "ink/sys/textinput.h"
#include "ink/sys/ui.h"

#define KEY_BACKSPACE '\b'
#define KEY_ENTER '\n'
#define KEY_SWITCH '\1'
#define KEY_SHIFT '\2'

static struct {
    lv_obj_t *root, *keys, *cands, *composing;
    lv_obj_t *cand_btn[INK_TEXT_PAGE], *cand_label[INK_TEXT_PAGE], *more, *mic;
    lv_obj_t *panel, *status, *heard; /* the voice panel: where the keys were, the same size */
    int first;
    int shown;
    bool symbols, shift;
    int built_for; /* 1 letters, 2 symbols, 3 digits */
} K;

static const lv_font_t *font(void) {
    hal_panel_info_t pi;
    hal_display_get_info(&pi);
    ink_font_t *cjk = ink_font_for_pt(10, pi.dpi);
    return cjk ? ink_font_lvgl(cjk) : ink_ui_font(0);
}

static void sync(void);

static void on_key(lv_event_t *e) {
    char c = (char)(intptr_t)lv_event_get_user_data(e);
    switch (c) {
    case KEY_BACKSPACE: ink_text_backspace(); break;
    case KEY_ENTER: ink_text_enter(); break;
    case KEY_SWITCH:
        K.symbols = !K.symbols;
        sync();
        return;
    case KEY_SHIFT: K.shift = !K.shift; return;
    default:
        if (K.shift && c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
        K.shift = false;
        ink_text_key(c);
        break;
    }
    K.first = 0;
    ink_ui_cause(osal_now_us(), "text.key_to_visible_ms");
}

static void on_cand(lv_event_t *e) {
    int i = (int)(intptr_t)lv_event_get_user_data(e);
    int first = K.first;
    K.first = 0;
    ink_text_pick(first + i);
    ink_ui_cause(osal_now_us(), "text.key_to_visible_ms");
}

static void on_more(lv_event_t *e) {
    (void)e;
    K.first += INK_TEXT_PAGE;
    sync();
}

static lv_obj_t *key(lv_obj_t *row, const char *label, char code, int grow) {
    lv_obj_t *b = lv_button_create(row);
    ink_ui_style_button(b);
    lv_obj_set_style_pad_all(b, ink_dp(2), 0);
    lv_obj_set_height(b, ink_dp(44));
    lv_obj_set_flex_grow(b, (uint8_t)grow);
    lv_obj_add_event_cb(b, on_key, LV_EVENT_CLICKED, (void *)(intptr_t)code);
    lv_obj_t *l = lv_label_create(b);
    lv_obj_set_style_text_font(l, font(), 0);
    lv_label_set_text(l, label);
    lv_obj_center(l);
    return b;
}

static void on_mic(lv_event_t *e) {
    (void)e;
    ink_text_voice_start();
    ink_ui_cause(osal_now_us(), "text.voice_tap_to_panel_ms");
}

static void on_said(lv_event_t *e) {
    (void)e;
    ink_text_voice_finish();
}

static void on_use_keys(lv_event_t *e) {
    (void)e;
    ink_text_voice_cancel();
}

static lv_obj_t *new_row(void) {
    lv_obj_t *r = lv_obj_create(K.keys);
    lv_obj_remove_style_all(r);
    lv_obj_set_size(r, LV_PCT(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(r, LV_FLEX_FLOW_ROW);
    lv_obj_set_style_pad_column(r, ink_dp(2), 0);
    return r;
}

static void char_row(const char *keys) {
    lv_obj_t *r = new_row();
    for (const char *p = keys; *p; p++) {
        char s[2] = {*p, 0};
        key(r, s, *p, 1);
    }
}

static const char *enter_label(void) {
    static const char *const N[] = {"完成", "发送", "搜索", "下一个"};
    return N[ink_text_enter_kind()];
}

static void build(int kind) {
    if (K.root) lv_obj_delete(K.root);
    K.root = lv_obj_create(lv_layer_top());
    lv_obj_remove_flag(K.root, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_size(K.root, LV_PCT(100), LV_SIZE_CONTENT);
    lv_obj_align(K.root, LV_ALIGN_BOTTOM_MID, 0, 0);
    lv_obj_set_style_bg_color(K.root, lv_color_white(), 0);
    lv_obj_set_style_bg_opa(K.root, LV_OPA_COVER, 0);
    lv_obj_set_style_border_color(K.root, lv_color_black(), 0);
    lv_obj_set_style_border_width(K.root, 2, 0);
    lv_obj_set_style_border_side(K.root, LV_BORDER_SIDE_TOP, 0);
    lv_obj_set_style_radius(K.root, 0, 0);
    lv_obj_set_style_pad_all(K.root, ink_dp(2), 0);
    lv_obj_set_style_pad_row(K.root, ink_dp(2), 0);
    lv_obj_set_flex_flow(K.root, LV_FLEX_FLOW_COLUMN);
    K.built_for = kind;
    K.keys = lv_obj_create(K.root);
    lv_obj_remove_style_all(K.keys);
    lv_obj_set_size(K.keys, LV_PCT(100), LV_SIZE_CONTENT);
    lv_obj_set_style_pad_row(K.keys, ink_dp(2), 0);
    lv_obj_set_flex_flow(K.keys, LV_FLEX_FLOW_COLUMN);
    K.composing = lv_label_create(K.keys);
    lv_obj_set_style_text_font(K.composing, font(), 0);
    lv_label_set_text(K.composing, "");
    K.cands = new_row();
    for (int i = 0; i < INK_TEXT_PAGE; i++) {
        K.cand_btn[i] = lv_button_create(K.cands);
        ink_ui_style_button(K.cand_btn[i]);
        lv_obj_set_style_pad_all(K.cand_btn[i], ink_dp(2), 0);
        lv_obj_set_height(K.cand_btn[i], ink_dp(40));
        lv_obj_set_flex_grow(K.cand_btn[i], 1);
        lv_obj_add_event_cb(K.cand_btn[i], on_cand, LV_EVENT_CLICKED, (void *)(intptr_t)i);
        K.cand_label[i] = lv_label_create(K.cand_btn[i]);
        lv_obj_set_style_text_font(K.cand_label[i], font(), 0);
        lv_label_set_text(K.cand_label[i], "");
        lv_obj_center(K.cand_label[i]);
        lv_obj_add_flag(K.cand_btn[i], LV_OBJ_FLAG_HIDDEN);
    }
    K.more = lv_button_create(K.cands);
    ink_ui_style_button(K.more);
    lv_obj_set_style_pad_all(K.more, ink_dp(2), 0);
    lv_obj_set_height(K.more, ink_dp(40));
    lv_obj_add_event_cb(K.more, on_more, LV_EVENT_CLICKED, NULL);
    lv_obj_t *ml = lv_label_create(K.more);
    lv_obj_set_style_text_font(ml, font(), 0);
    lv_label_set_text(ml, "更多");
    lv_obj_add_flag(K.more, LV_OBJ_FLAG_HIDDEN);
    /* the microphone: black, at the end of the candidates (the system UI's own look comes later) */
    K.mic = lv_button_create(K.cands);
    ink_ui_style_button(K.mic);
    lv_obj_set_style_bg_color(K.mic, lv_color_black(), 0);
    lv_obj_set_style_bg_opa(K.mic, LV_OPA_COVER, 0);
    lv_obj_set_style_pad_all(K.mic, ink_dp(2), 0);
    lv_obj_set_height(K.mic, ink_dp(40));
    lv_obj_add_event_cb(K.mic, on_mic, LV_EVENT_CLICKED, NULL);
    lv_obj_t *mic = lv_label_create(K.mic);
    lv_obj_set_style_text_font(mic, font(), 0);
    lv_obj_set_style_text_color(mic, lv_color_white(), 0);
    lv_label_set_text(mic, "话筒");
    lv_obj_add_flag(K.mic, LV_OBJ_FLAG_HIDDEN);
    if (kind == 3) {
        char_row("123");
        char_row("456");
        char_row("789");
        lv_obj_t *r = new_row();
        key(r, ink_text_type() == INK_TEXT_PHONE ? "+" : ".", ink_text_type() == INK_TEXT_PHONE ? '+' : '.', 1);
        key(r, "0", '0', 1);
        key(r, "删除", KEY_BACKSPACE, 1);
        key(r, enter_label(), KEY_ENTER, 1);
    } else {
        if (kind == 1) {
            char_row("qwertyuiop");
            char_row("asdfghjkl");
            lv_obj_t *r = new_row();
            key(r, "大写", KEY_SHIFT, 2);
            for (const char *p = "zxcvbnm"; *p; p++) {
                char s[2] = {*p, 0};
                key(r, s, *p, 1);
            }
            key(r, "删除", KEY_BACKSPACE, 2);
        } else {
            char_row("1234567890");
            char_row("-/:;()@&\"'");
            lv_obj_t *r = new_row();
            for (const char *p = ".,?!"; *p; p++) {
                char s[2] = {*p, 0};
                key(r, s, *p, 1);
            }
            key(r, "删除", KEY_BACKSPACE, 2);
        }
        lv_obj_t *bottom = new_row();
        key(bottom, K.symbols ? "字母" : "符号", KEY_SWITCH, 2);
        key(bottom, "空格", ' ', 5);
        key(bottom, enter_label(), KEY_ENTER, 2);
    }
    K.panel = lv_obj_create(K.root);
    lv_obj_remove_style_all(K.panel);
    lv_obj_set_width(K.panel, LV_PCT(100));
    lv_obj_set_style_pad_row(K.panel, ink_dp(4), 0);
    lv_obj_set_flex_flow(K.panel, LV_FLEX_FLOW_COLUMN);
    K.status = lv_label_create(K.panel);
    lv_obj_set_style_text_font(K.status, font(), 0);
    K.heard = lv_label_create(K.panel);
    lv_obj_set_style_text_font(K.heard, font(), 0);
    lv_obj_set_width(K.heard, LV_PCT(100));
    lv_obj_set_flex_grow(K.heard, 1);
    lv_label_set_long_mode(K.heard, LV_LABEL_LONG_WRAP);
    lv_label_set_text(K.heard, "");
    lv_obj_t *row = lv_obj_create(K.panel);
    lv_obj_remove_style_all(row);
    lv_obj_set_size(row, LV_PCT(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);
    lv_obj_set_style_pad_column(row, ink_dp(2), 0);
    for (int i = 0; i < 2; i++) {
        lv_obj_t *b = lv_button_create(row);
        ink_ui_style_button(b);
        lv_obj_set_height(b, ink_dp(44));
        lv_obj_set_flex_grow(b, 1);
        lv_obj_add_event_cb(b, i ? on_use_keys : on_said, LV_EVENT_CLICKED, NULL);
        lv_obj_t *l = lv_label_create(b);
        lv_obj_set_style_text_font(l, font(), 0);
        lv_label_set_text(l, i ? "用键盘" : "说完了");
        lv_obj_center(l);
    }
    lv_obj_add_flag(K.panel, LV_OBJ_FLAG_HIDDEN);
    ink_ui_hint_obj(K.root, INK_REFRESH_FAST);
}

/* The voice panel over the keys, or the keys back: only the fixed area changes while it lasts. */
static void sync_voice(ink_voice_state_t vs) {
    bool on = vs != INK_VOICE_IDLE, was = !lv_obj_has_flag(K.panel, LV_OBJ_FLAG_HIDDEN);
    if (on != was) {
        if (on) {
            lv_obj_update_layout(K.root);
            lv_obj_set_height(K.panel, lv_obj_get_height(K.keys)); /* the same size: nothing above it moves */
            lv_obj_add_flag(K.keys, LV_OBJ_FLAG_HIDDEN);
            lv_obj_remove_flag(K.panel, LV_OBJ_FLAG_HIDDEN);
        } else {
            lv_obj_add_flag(K.panel, LV_OBJ_FLAG_HIDDEN);
            lv_obj_remove_flag(K.keys, LV_OBJ_FLAG_HIDDEN);
        }
        ink_ui_hint_obj(K.root, INK_REFRESH_FAST);
    }
    if (!on) return;
    lv_label_set_text(K.status, vs == INK_VOICE_CONNECTING ? "正在连接，可以说了" : vs == INK_VOICE_LISTENING ? "请说，停一下就结束" : "正在整理成文字");
    lv_label_set_text(K.heard, ink_text_voice_heard());
    ink_ui_hint_obj(K.status, INK_REFRESH_FAST);
    ink_ui_hint_obj(K.heard, INK_REFRESH_FAST);
}

/* What the session says now. */
static void sync(void) { /* UI task */
    if (!ink_text_focused()) {
        if (K.root) {
            lv_area_t a;
            lv_obj_get_coords(K.root, &a);
            ink_ui_hint_area(&a, INK_REFRESH_TEXT); /* the page under it comes back with its gray levels */
            lv_obj_delete(K.root);
            K.root = NULL;
            K.first = 0;
            K.symbols = K.shift = false;
        }
        return;
    }
    ink_text_type_t type = ink_text_type();
    int kind = type == INK_TEXT_NUMBER || type == INK_TEXT_PHONE ? 3 : K.symbols ? 2 : 1;
    if (!K.root || K.built_for != kind) build(kind);
    ink_voice_state_t vs = ink_text_voice_state();
    sync_voice(vs);
    if (vs != INK_VOICE_IDLE) return;
    lv_label_set_text(K.composing, ink_text_composing()[0] ? ink_text_composing() : ink_text_voice_notice());
    ink_text_cand_t c[INK_TEXT_PAGE + 1];
    int n = type == INK_TEXT_PLAIN ? ink_text_candidates(K.first, c, INK_TEXT_PAGE + 1) : 0;
    if (!n && K.first) {
        K.first = 0;
        n = ink_text_candidates(0, c, INK_TEXT_PAGE + 1);
    }
    for (int i = 0; i < INK_TEXT_PAGE; i++) {
        if (i < n) {
            lv_label_set_text(K.cand_label[i], c[i].word);
            lv_obj_remove_flag(K.cand_btn[i], LV_OBJ_FLAG_HIDDEN);
        } else lv_obj_add_flag(K.cand_btn[i], LV_OBJ_FLAG_HIDDEN);
    }
    if (n > INK_TEXT_PAGE) lv_obj_remove_flag(K.more, LV_OBJ_FLAG_HIDDEN);
    else lv_obj_add_flag(K.more, LV_OBJ_FLAG_HIDDEN);
    if (ink_text_voice_possible()) lv_obj_remove_flag(K.mic, LV_OBJ_FLAG_HIDDEN);
    else lv_obj_add_flag(K.mic, LV_OBJ_FLAG_HIDDEN);
    K.shown = n;
    ink_ui_hint_obj(K.cands, INK_REFRESH_FAST);
    ink_ui_hint_obj(K.composing, INK_REFRESH_FAST);
}

int ink_shell_keyboard_init(void) {
    ink_text_set_presenter(sync);
    return 0;
}
/* The power menu (placeholder look, D-64): the power key held down. What its buttons do are the capabilities the AI has too. */
#include <stdio.h>
#include <string.h>

#include "ink/sys/cap.h"
#include "ink/sys/exec.h"
#include "ink/sys/input.h"
#include "ink/sys/interrupt.h"
#include "ink/sys/state.h"
#include "shell_card.h"

static struct {
    shell_card_t card;
    ink_exec_job_t open_job, close_job;
} M;

static int snapshot(char *buf, size_t cap) {
    int n = snprintf(buf, cap, "电源菜单：关机、重启、取消。");
    return n < 0 ? 0 : (size_t)n < cap ? n : (int)cap - 1;
}

static bool on_key(ink_key_t key, bool long_press);

static const ink_ui_overlay_t OVERLAY = {.name = "power_menu", .level = 2, .on_key = on_key, .snapshot = snapshot};

static void close_menu(void) { /* UI task */
    if (!M.card.root) return;
    shell_card_close(&M.card);
    ink_ui_overlay_remove(&OVERLAY);
}

static bool on_key(ink_key_t key, bool long_press) {
    (void)long_press;
    if (key == HAL_KEY_HOME) {
        close_menu();
        return true;
    }
    return false;
}

static void on_button(lv_event_t *e) {
    const char *cap = lv_event_get_user_data(e);
    close_menu();
    if (!cap) return;
    ink_call_opts_t o = {.src = INK_SRC_TOUCH, .reply_exec = INK_EXEC_DIRECT};
    ink_cap_call(cap, NULL, &o);
}

static void open_job(void *arg) { /* UI task */
    (void)arg;
    if (M.card.root || ink_interrupt_active()) return;
    shell_card_open(&M.card);
    ink_ui_overlay_add(&OVERLAY, M.card.root);
    shell_card_text(&M.card, "电源", "");
    shell_card_button(&M.card, "关机", on_button, (void *)"system.shutdown");
    shell_card_button(&M.card, "重启", on_button, (void *)"system.reboot");
    shell_card_button(&M.card, "取消", on_button, NULL);
}

static void on_long(void) { /* the timer task. A call or an alarm does not answer to it */
    ink_exec_post(INK_EXEC_UI, &M.open_job, open_job, NULL);
}

static void close_job(void *arg) { /* UI task */
    (void)arg;
    close_menu();
}

static void on_power(void *ctx, int h, const char *id) { /* locked: nobody is looking at it */
    (void)ctx;
    (void)id;
    char s[16] = "";
    ink_state_get_str(h, s, sizeof s);
    if (!strcmp(s, "locked")) ink_exec_post(INK_EXEC_UI, &M.close_job, close_job, NULL);
}

int ink_shell_power_menu_init(void) {
    ink_input_set_power_long_hook(on_long);
    return ink_state_watch("power.state", on_power, NULL, INK_EXEC_DIRECT);
}
/* While the system is being installed nothing else can be used (placeholder look, D-64): the card says how far it is. */
#include <stdio.h>
#include <string.h>

#include "ink/sys/exec.h"
#include "ink/sys/state.h"
#include "shell_card.h"

static struct {
    shell_card_t card;
    ink_exec_job_t job;
    int shown;
} C;

static int snapshot(char *buf, size_t cap) {
    int n = snprintf(buf, cap, "正在安装新系统，%d%%。", C.shown);
    return n < 0 ? 0 : (size_t)n < cap ? n : (int)cap - 1;
}

static const ink_ui_overlay_t OVERLAY = {.name = "update", .level = 4, .snapshot = snapshot};

static void sync_card(void *arg) { /* UI task */
    (void)arg;
    char st[16] = "";
    int64_t pct = 0;
    ink_state_get_str(ink_state_find("update.state"), st, sizeof st);
    ink_state_get_int(ink_state_find("update.progress"), &pct);
    bool want = !strcmp(st, "installing") || !strcmp(st, "rebooting");
    if (!want) {
        if (C.card.root) {
            shell_card_close(&C.card);
            ink_ui_overlay_remove(&OVERLAY);
        }
        return;
    }
    if (!C.card.root) {
        shell_card_open(&C.card);
        ink_ui_overlay_add(&OVERLAY, C.card.root);
        C.shown = -1;
    }
    /* every ten percent: a refresh costs the installation time too */
    if (pct / 10 != C.shown / 10 || C.shown < 0) {
        char body[48];
        C.shown = (int)pct;
        snprintf(body, sizeof body, "%d%%，别关机", C.shown);
        shell_card_text(&C.card, "正在安装新系统", body);
    }
}

static void on_change(void *ctx, int h, const char *id) {
    (void)ctx;
    (void)h;
    (void)id;
    ink_exec_post(INK_EXEC_UI, &C.job, sync_card, NULL);
}

int ink_shell_update_card_init(void) {
    if (ink_state_watch("update.", on_change, NULL, INK_EXEC_DIRECT) != 0) return -1;
    return 0;
}
| --- | --- | --- |
| 通知 | 只显示数量，不显示内容（“锁屏显示通知内容”默认关），不能点 | 看不到内容 |
| AI | AI 键只负责唤醒 | AI 一律拒绝，验证后才打开（系统服务设计 §11.4） |
| 相机 | 没有入口。屏幕不响应触摸，放了也点不到；要不要加，用户还没选 | 同左 |
| 控制中心 | 打不开 | 打不开 |
| 加家人、家长设置 | 打不开 | 先输密码，验证后回到原请求 |

三种锁屏画面：

| 模式 | 画板 | 时间走不走 | 耗电 |
| --- | --- | --- | --- |
| 这一页（默认） | `LockPage` | 不显示时钟 | 不额外刷新 |
| 时钟和待办 | `Lock` | 每分钟刷新（D-96），要定时唤醒 | 没有计入现有待机估算；RTC 唤醒待测 |
| 壁纸 | `LockImage` | 不显示时钟 | 锁屏时刷新一次 |

锁定时放声音（`LockPlaying`）：声音继续，小标记写“正在听”；暂停要先唤醒。充电时（`Charging`）显示百分比，建议每涨 10% 才刷一次。

### 3.6 语音的入口

| 入口 | 怎么结束 |
| --- | --- |
| 按住 AI 键 | 松开 |
| 点 Dock 中间的圆、AI 页的话筒 | 停一下自动结束，也可以再点话筒 |
| 叫名字（D-52） | 停一下自动结束 |
| 键盘的话筒（听写，R-056、D-65） | 停一下自动结束，或点“说完了”，或点“用键盘” |

麦克风状态一直写在状态栏（底座设计 §8，`PartsNew`）：线条话筒 = 能叫名字（本地等）；黑底“在听” = 声音正在送出去；黑底“录音” = 在录音；锁定时不听（除非设成“一直”）。

### 3.7 通知和控制中心

普通通知只改状态栏小图标，不弹横幅（横幅每次消失都要刷新）；来电、闹钟才占全屏。通话时长只到分钟，计时器也不显示跳动的秒。勿扰时闹钟照响，来电不响铃但全屏（D-68，在底层分支上）。

| 控件 | 规则 |
| --- | --- |
| Wi-Fi | 黑 = 开。副标题是实际连的网络 |
| 4G | 黑 = 开，副标题说明状态：备用（Wi-Fi 在用）、正在使用、已关闭 |
| 飞行（建议） | 关掉 4G、Wi-Fi、蓝牙；之后可以单独再开 Wi-Fi 和蓝牙，4G 不能开 |
| 叫名字 | 开 = 设置里选的那一档（使用时或一直），关 = 关（D-52） |
| 滑杆 | 0～10，0 是关；黑条长度就是档位，压在黑条上的字反白；孩子的音量有上限（竖线） |
| 音量 | 现在全家一个音量，听书、AI 和提示音共用。闹钟要不要有最低音量，随闹钟一起定 |

孩子的控制中心（`KidControl`）只有亮度、暖光、音量和通知。

## 4. 页面清单

画布上有 173 个画板，首版的在前面：

| 组 | 画板 |
| --- | --- |
| 主页和系统壳 | `Today`、`Main`、`Apps`、`LockPage`、`Lock`、`LockImage`、`Control`、`Notifications` |
| 首次开机 | `FirstBoot`、`BootWifi`、`BootWifiPass`、`BootJoining`、`BootJoinFail`、`BootClaim`、`BootNoHub`、`BootConfirm`、`BootRestore`、`BootHello`、`BootRevoked` |
| 家人和密码 | `Members`、`MembersBack`、`MemberSwitch`、`Pin`、`PinWrong`、`PinWait`、`PinForgot`、`PinSet`、`FactoryReset`、`FactoryDone` |
| 孩子 | `KidHome`、`KidToday`、`KidApps`、`KidControl`、`KidLimit`、`KidTimeUp`、`SetKid` |
| AI | `AiListen`、`AiListenTap`、`AiThink`、`Ai`、`AiLong`、`AiSpeak`、`AiOffline`、`AiTimeout`、`AiBudget`、`AiHome`、`AiAsk`、`AiReceipts` |
| 确认卡 | `Confirm`、`ConfirmCall`、`ConfirmSetting`、`ConfirmWeb`、`ConfirmDelete`、`ConfirmParent`、`ConfirmExpired`、`StressConfirm` |
| 键盘和语音 | `ImePinyin`、`ImeCandidates`、`ImeEdit`、`ImeLong`、`ImeSymbols`、`ImeAi`、`ImePassword`、`ImeVoice`、`ImeVoiceStates` |
| 备忘 | `Memo`、`MemoDetail`、`MemoEdit`、`MemoRecord`、`MemoPending`、`MemoChecklist`、`MemoUndo`、`MemoSaveFail` |
| 正在进行 | `MainPlaying`、`ControlPlaying`、`LockPlaying`、`MainInCall`、`Tasks` |
| 放书进来 | `Import`、`ImportFind`、`FilePicker`、`ImportJob`、`ImportFail` |
| 文件和传输 | `Files`、`FileList`、`FileActions`、`FileMove`、`Transfer`、`TransferLive`、`TransferUsbBusy`、`TransferUsbOn`、`TransferUsbFail` |
| 网页（D-85 首版做） | `Remote`、`RemoteLoading`、`RemoteOffline`、`RemoteAddress`、`RemoteType`、`RemoteBlocked` |
### 7.4 AI

- 面板：`AiListen`（按住）、`AiListenTap`（点按或叫名字）、`AiThink`、`Ai`（答案先出来，一句话，写“出自这一页”）、`AiLong`（讲细一点，翻页）、`AiSpeak`（读给你听，AI 键打断）。
- 问不了时：`AiOffline`、`AiTimeout`、`AiBudget`（D-79：120% 后说“今天的额度用完了”，孩子说“可以问爸爸妈妈”）。主按钮都是“继续读”。
- 结果：`AiReceipts` 列全了，做好了、一部分、等联网、不能做、过期、撤销不了、不确定、页面变了、换了人。**不确定就不自动重试**（中枢协议 §3.7）。
- 确认：`Confirm`（短信，能改一下）、`ConfirmCall`、`ConfirmSetting`、`ConfirmWeb`（网页上已登录时点任何东西都要确认，D-85）、`ConfirmDelete`、`ConfirmParent`（卡上输大人密码）、`ConfirmExpired`、`StressConfirm`（内容长时翻完才能确认）。卡片写清楚对象、内容、以谁的身份、多久有效，由系统画。

### 7.5 键盘和听写

`ImeSymbols` 两页符号，英文模式用半角；`ImeCandidates` 全部候选；`ImeEdit` 改字；`ImeLong` 长文字翻页，草稿自动存。听写的每种情况在 `ImeVoiceStates`：连接中、在听、整理成文字、没网、没听清、额度用完、来电打断。键盘区大小不变，说的字说完才进输入框，半句不丢，通话声音不进听写。密码框没有话筒，AI 键仍然只叫 AI。

### 7.6 备忘

打开就能说一句（`MemoRecord`，没网也能记，时长只到分钟），或写一条。没有保存按钮，`MemoEdit` 写“已记下”。AI 找到的事是建议（`MemoDetail`：“这段话里有 3 件事”，一件一件加，加完就地变成“已加入提醒”）。没网时 `MemoPending`：录音已保存，连上后整理成文字。删除不问，给撤销（`MemoUndo`）。存不上时 `MemoSaveFail`：字还在。清单 `MemoChecklist`。

### 7.7 正在进行

同一时间只显示一件最要紧的事：主屏的胶囊变成 `ActivityCard`（`MainPlaying`），控制中心最上面也是它（`ControlPlaying`），通话时顶部一条回去（`MainInCall`，随通信版本）。其余任务在 `Tasks`，带进度和取消；做好了放在下面，点了打开。换人时先暂停存位置。

### 7.8 放书进来

`Import`：让 AI 找、从电脑传、从存储卡选。真实阶段有七步（已请求、传输中、已到达、已登记、已索引、可打开、可离线，底座设计 §5.6），屏幕上合成四步（`ImportJob`）：收到了、正在准备这本书、下载到这台设备、可以读了。失败 `ImportFail` 才说格式。`ImportFind`：AI 只说真实找到的（中枢设计 §5.6）。

### 7.9 文件和传输

`FileList`、`FileActions`（选中后拷贝、移动、删除，R-058）、`FileMove`、`ConfirmDelete`（说清楚删什么、找不回来）。无线传输（建议）：`Transfer` 给地址和一次性数字，只能放到“传进来的”，看不到别的文件，关页或 10 分钟没动静就断开；`TransferLive`。U 盘（D-72）：大人确认 → `TransferUsbBusy`（谁在用卡，先停下）→ `TransferUsbOn` → 弹出或拔线后重新整理；读不了时 `TransferUsbFail`，不自动格式化。

### 7.10 网页

D-85 用户选了首版做。`RemoteLoading`（第一屏最多等 1.5 秒）、`RemoteOffline`（5 分钟内回得来）、`RemoteAddress`、`RemoteType`（打完字才发给网页）、`RemoteBlocked`。设备现在只有点按，翻页、长按、提交文字要补（中枢设计 §13）。

### 7.11 备份和隐私

平时一行“已备份”（`SetStorage` → `Backup`）。失败 `BackupFail`：还有几条没备份，先存在设备上，不会丢。三种保存状态（底座设计 §5.7 的本地已保存、等待上传、中枢已收到）用 `SaveMark`：已存在这台设备、等联网备份、已备份，只在需要时显示。

恢复（`Restore` → `Pin#restore` → `RestoreRun` → `RestoreDone`，失败 `RestoreFail`）：先看谁的什么、哪天的备份、现在的东西会被替换；做完列出每个人回到哪一页，以及没放回来的。不重放发过的短信，不补过期的提醒（中枢设计 §5.8）。

`SetPrivacy` 用人话写清楚东西放在哪、AI 能看到什么（这一页，密码框看不到；会发给选的模型服务商）、留多久（D-34）、孩子的记录。`Records` 看和删；`AiMemory` 看 AI 记得的事，可以忘掉（D-93）。

### 7.12 电量、关机和更新

`BatteryLow`（5%）、`BatterySaving`（2%，存好再关）、`Charging`。关机图（`PowerOff`、`PowerOffEmpty`）：电子纸断电后还留着画面，所以要写清楚已关机；顺手留下读到哪儿，像一张书签。`BootRecovery`：新版本没装好，退回了，东西都在。更新：`Update`（下载，不打扰）→ `UpdateReady` → 输密码 → `UpdateInstall` → `UpdateDone`；不能装时 `UpdateBlocked`，包有问题时 `UpdateFail`。

### 7.13 搜索和长按

`Search` 一个输入框，既搜也问：第一行总是“问 AI”。`SearchEmpty`。`IconMenu` 长按图标：接着做、放到今日屏。`TodayEdit` 选今日屏的四张卡。

## 8. 打断时怎么办

优先级：来电 > 闹钟 > 低电量；AI 面板和确认卡都让路（底座设计 §7，系统服务设计 §6.2）。

| 正在做 | 来了 | 屏幕 | 声音和麦克风 | 结束后 |
| --- | --- | --- | --- | --- |
| AI 在听或在说 | 来电 | 来电全屏 | 这一轮结束，排队的声音清掉 | 回到原页，AI 面板不再开 |
| 听写 | 来电 | 来电全屏 | 停止收音，通话声音不进听写 | 回到输入框，半句留着，“接着说” |
| 朗读、听书 | 闹钟 | 闹钟全屏 | 朗读暂停，闹钟响 | 关掉闹钟后接着读（按暂停原因决定） |
| 通话 | 闹钟 | 通话不动 | 通话优先 | 通话结束后闹钟全屏再响 |
| 确认卡 | 来电 | 来电在上 | — | 回来卡还在；过期了就 `ConfirmExpired`，不发 |
| 确认卡 | 锁屏 | 卡先收起 | — | 解锁后还在；过期了同上 |
| 确认卡 | 换人 | 作废 | — | 新的人看不到 |
| 任何页面 | 低电量 5% | 提示全屏 | 照常 | 回到原页 |

闹钟时按电源键是稍后再响，不是停止。来电时按电源键是静音，不挂断。

## 9. 四个内置应用和系统的交接
### 4.1 通用底座

| 能力 | 谁要用 | 状态 | 说明 |
| --- | --- | --- | --- |
| 结构化数据存储 | 联系人、短信、通话记录、备忘、日历、单词 | 部分 | 追加日志加快照，按成员隔离，分页读，每条记录有版本，断电测试过（详细设计 §3、§15）。**保存回执只到“本地已落盘”**（`ink_db_durable_ver`、`ink_db_wait`）；等待上传、中枢收到要等同步 |
| 文件服务 | 文件、相册、录音、壁纸、阅读导入 | 部分 | 统一路径和权限、拷贝移动删除作业、占用和 TF 卸载、U 盘模式已有；真 FAT 和 USB **待测**。缺稳定的文件编号和类型、索引和缩略图、无线传输授权、转换作业 |
| 时间服务 | 闹钟、日历、提醒、状态栏、证书校验 | 有 | 校时、时区、闹钟、提醒、农历、重启后恢复计划；RTC 中断唤醒**待测**：出厂日志里 P16 一直为低 |
| 通知服务和打断通道 | 几乎所有应用 | 有 | 收件箱、渠道、成员、持久化、已读和清除、勿扰；来电、闹钟、低电量不经前台应用，锁定时临时放开触摸，结束后恢复 |
| 文本输入和剪贴板 | 搜索、短信、备忘、配网、设置 | 部分 | 全拼、候选分页、文本框、占位键盘、语音输入（R-056，详细设计 §9.5）、剪贴板。**编辑会话还缺选区、撤销、长文本**（§15.4）；正式词库的来源和许可等决定（D-70），仓库里只有测试用的小词表 |
| 系统确认事务 | AI 操作、发短信、拨号 | 有 | 持有、展示、取消、过期、确认后执行；绑定成员、参数、内容版本，确认时重新校验；触摸和按键不能重放 AI 请求；家长 PIN。外观是占位（D-64） |
| 应用注册和生命周期 | 主页、全部应用、后台播放 | 部分 | 目录、前后台、冻结、恢复、权限、服务卡片。图标等视觉定稿；**可展示的作业进度和结果**只有文件作业和升级有（§15.4），草稿和导航恢复随系统壳 |
| 音频 | 听、电话、闹钟、备忘 | 有（外放） | 五档焦点、Ogg Opus 播放和续播、录成文件、路由；通话声音**待测**（RK-07） |
| 蓝牙服务 | 控制中心、设置、耳机 | 接口和模型 | 能力、状态、模拟器的耳机；**BH1098G 的协议不知道，真机上 `hal_bt_available` 为假**。外置芯片的音频模式、S31 蓝牙、翻页器 HID 还没分开 |
| Wi-Fi 管理 | 控制中心、设置、首次开机 | 有 | 自动选网，加扫描、连接、忘记；真机 HAL 没写 |
| 成员、PIN | 成员切换、儿童模式 | 有 | 成员表、PBKDF2 PIN、错误限速、闲置退回（计时见 D-95，等用户定）、删成员、恢复出厂。家庭绑定、中枢重置 PIN 没有 |
| 锁屏 | 锁屏、唤醒 | 部分 | 锁标记（已写上 AI 键）、电源键和 AI 键唤醒、锁屏时关成人空间已有；时钟、通知、壁纸三种画面归系统壳 |
| 配网和家庭绑定 | 首次开机 | 无 | 设计有。配网、绑定、令牌要分开（中枢协议 §3.2、§4）。分支明确后移，**但审计认为首版需要**，要排期 |
| 备份和恢复 | 存储设置、首次开机 | 无 | 原表漏了。备份清单、上传回执、恢复预览、覆盖确认、未恢复项目（R-023，D-01 列在首版）。**没有人在做，要排期** |
| 系统更新和回滚 | 系统更新 | 有 | OTA、卡刷、自检、回滚（详细设计 §12）。**真机回滚要先换引导程序**；中枢协议还是占位 |
| 电源 | 关机、重启、低电量 | 有 | 电量、自动锁定、关机、重启、低电量策略（15%、5%、2%）；电源键长按是电源菜单（占位外观）。关机图归系统壳 |

### 4.2 界面框架

## 7. 补首版页面时新发现的要求

2026-11-04 画首版流程时发现的，对照的是基线 `cd486a2` 和分支上的设计文档，没有逐项看分支代码。页面见[界面规范第 7 节](../product/system-ui-spec.md)。

| 要求 | 谁要用 | 现状或来源 |
| --- | --- | --- |
| 电源键长按 | 电源菜单 | **已做**（系统服务设计 §13） |
| 成人闲置退回改规则，验证后回到原页和原位置（D-95） | `MembersBack` | 系统服务设计 §11.4 是闲置 120 秒或一锁屏就退回；这和 D-38 的理由冲突，等用户确认 |
| 放声音时，锁定状态下音量键能用（建议） | `LockPlaying` | **已做**（系统服务设计 §13）。顺带发现音量键以前根本没人处理，也补了 |
| 状态栏要知道麦克风在做什么：本地等名字、声音送出去、录音 | 所有页面 | **已做**：状态 `audio.mic`（系统服务设计 §10.3） |
| 活动卡：现在放什么、暂停、回到内容；任务列表：进度、取消、结果 | `ActivityCard`、`Tasks` | **任务列表已做**：`job.list`、`job.cancel`（系统服务设计 §13.1）。活动卡的数据是现成的：`media.status`、`media.pause` |
| 作业七个阶段合成四步显示 | `ImportJob` | 任务有阶段词（§13.1）；放书的作业要等中枢协议接上 |
| 每个对象能查保存到哪一步 | `SaveMark`、`BackupFail` | **已做本地这一段**：`data.status`（系统服务设计 §15.4）。“等联网备份”要等同步 |
| 配对状态（未配对到已吊销）、设备自己的热点和小网页、存储卡配对文件 | `FirstBoot`、`BootClaim`、`BootRevoked` | 中枢设计 §13，还没人做 |
| 一小段可离线读的示例内容 | `BootHello` | D-99，新的小资源 |
| 文字编辑：移动光标、选区、撤销 | `ImeEdit` | **已做**（系统服务设计 §9.4.1）。中文的“词”现在只是两个字，要准得等词库能反查 |
| 关机前写好关机图，没电时先存再写 | `PowerOff`、`PowerOffEmpty` | **已做**（占位外观，系统服务设计 §13） |
| 无线传输：一次性数字授权，只放一个目录，超时断开 | `Transfer` | 系统服务设计 §13 明确后移；画的是建议 |
| 额度用完是一种明确的错误 | `AiBudget`、听写 | 中枢设计 §5.2、§5.3 |
| 网页的翻页、长按、提交文字、地址编辑 | `RemoteAddress`、`RemoteType` | 中枢设计 §13，D-85 用户选了首版做 |
| 文字选区的动作：问 AI、加单词 | 阅读、报纸 | R-036，第 4.2 节的文本框架 |


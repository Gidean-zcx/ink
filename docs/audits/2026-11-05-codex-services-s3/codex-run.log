#include "product_probe.h"
static volatile int pin_done, pin_result;
static volatile uint32_t pin_wait;
static bool cut_at_reply;
static void power_cut(void *arg) { (void)arg; sim_storage_power_cut(); }
static void told(void *ctx, int result, uint32_t wait_s) {
    (void)ctx;
    pin_result = result; pin_wait = wait_s; pin_done = 1;
    if (cut_at_reply) {
        printf("AUDIT PIN before_cut result=%d wait_s=%u\n", result, wait_s);
        CHECK(result == INK_PIN_WRONG && wait_s > 0, "wait applies before power cut");
        ink_probe_count("test.finished");
        vtk_event_at(vtk_now() + SIM_US(1), power_cut, NULL);
    }
}
static void attempt(const char *pin) {
    pin_done = 0;
    CHECK(ink_member_unlock("owner", pin, told, NULL) == 0 && WAIT_FOR(pin_done, 5000), "PIN attempt completed");
}
static void durable(void) {
    ink_db_flush_all();
    CHECK(WAIT_FOR(ink_db_idle() && !ink_storage_pending(), 6000), "setup durable");
}
static void audit_task(void *arg) {
    (void)arg;
    delay_ms(1800);
    if (getenv("AUDIT_PIN_CUT")) {
        CHECK(ink_member_set_pin("owner", NULL, "123456", told, NULL) == 0 && WAIT_FOR(pin_done, 5000), "fixture PIN");
        durable();
        attempt("000000"); attempt("000000"); durable();
        cut_at_reply = true;
        attempt("000000");
    } else {
        CHECK(ink_member_has_pin("owner") && !ink_member_space_open(), "protected before attempting");
        attempt("123456");
        printf("AUDIT PIN after_cut result=%d wait_s=%u space_open=%d\n", pin_result, pin_wait, ink_member_space_open());
        CHECK(pin_result == INK_PIN_OK && ink_member_space_open(), "reproduce lost wait after power cut");
        ink_probe_count("test.finished");
    }
}
void ink_main(void) {
    product_main();
    osal_task_cfg_t c = {.name="audit-pin-cut", .fn=audit_task, .stack_bytes=16384, .priority=OSAL_PRIO_NORMAL, .core=-1, .flags=OSAL_TASK_STACK_EXTERNAL};
    osal_task_create(&c, NULL);
}
    h->cap = c;
    h->args = *args;
    h->src = src;
    h->page_gen = page_gen;
    h->expires_us = osal_now_us() + EXPIRE_US;
    snprintf(h->member, sizeof h->member, "%s", ink_member_current()->id);
    describe(c, args, h->detail, sizeof h->detail);
    bool full = true;
    ink_svc_lock();
    for (int i = 0; i < MAX_HELD && full; i++)
        if (!CF.held[i].used) {
            h->token = ++CF.next_token;
            CF.held[i] = *h;
            full = false;
        }
    ink_svc_unlock();
    uint32_t token = h->token;
    osal_free(h);
    if (full) {
        ink_probe_count("confirm.queue_full");
        rc->status = INK_RC_REJECTED;
        snprintf(rc->detail, sizeof rc->detail, "the confirmation queue is full");
        return rc->status;
    }
    snprintf(rc->object, sizeof rc->object, "confirm:%u", (unsigned)token);
    snprintf(rc->say, sizeof rc->say, "这件事要你在设备上确认一下。");
    changed();
    return rc->status;
}

int ink_confirm_list(ink_confirm_view_t *out, int max) {
    int n = 0;
    ink_svc_lock();
    bool picked[MAX_HELD] = {false};
    while (n < max) {
        const held_t *first = NULL;
        int at = -1;
        for (int i = 0; i < MAX_HELD; i++)
            if (CF.held[i].used && !picked[i] && (!first || CF.held[i].token < first->token)) {
                first = &CF.held[i];
                at = i;
            }
        if (!first) break;
        picked[at] = true;
        ink_confirm_view_t *v = &out[n++];
        memset(v, 0, sizeof *v);
        v->token = first->token;
        snprintf(v->cap, sizeof v->cap, "%s", first->cap->id);
        snprintf(v->title, sizeof v->title, "%s", first->cap->title);
        snprintf(v->detail, sizeof v->detail, "%s", first->detail);
        v->src = (uint8_t)first->src;
        v->parent = first->parent;
        v->expires_us = first->expires_us;
    }
    ink_svc_unlock();
    return n;
}

typedef struct {
    uint32_t token;
    char cap[48];
} ran_t;

static void confirmed_done(void *ctx, const ink_receipt_t *rc) {
    ran_t *r = ctx;
    tell(r->token, r->cap, "accepted", rc);
    osal_free(r);
}

static int decide(uint32_t token, bool accept);

int ink_confirm_decide(uint32_t token, bool accept, ink_source_t src) {
    if (src != INK_SRC_TOUCH && src != INK_SRC_KEY) {
        ink_probe_count("confirm.not_a_person");
        return -1;
    }
    if (accept) { /* a yes that needs a parent comes with a PIN */
        bool parent = false;
        ink_svc_lock();
        for (int i = 0; i < MAX_HELD; i++)
            if (CF.held[i].used && CF.held[i].token == token) parent = CF.held[i].parent;
        ink_svc_unlock();
        if (parent) {
            ink_probe_count("confirm.needs_pin");
            return -1;
        }
    }
    return decide(token, accept);
}

typedef struct {
    uint32_t token;
    ink_pin_done_fn done;
    void *ctx;
} pin_answer_t;

static void pin_checked(void *ctx, int result, uint32_t wait_s) { /* exec.bg */
    pin_answer_t *a = ctx;
    if (result == INK_PIN_OK) decide(a->token, true);
    if (a->done) a->done(a->ctx, result, wait_s);
    osal_free(a);
}

int ink_confirm_accept_with_pin(uint32_t token, const char *pin, ink_pin_done_fn done, void *ctx) {
    pin_answer_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    if (!a) return -1;
    *a = (pin_answer_t){token, done, ctx};
    if (ink_member_check_parent(pin, pin_checked, a) != 0) {
        osal_free(a);
        return -1;
    }
    return 0;
}

static int decide(uint32_t token, bool accept) {
    const char *prev = osal_mem_tag("confirm");
    held_t *h = osal_malloc(sizeof *h, OSAL_MEM_EXTERNAL);
    ran_t *r = osal_malloc(sizeof *r, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!h || !r || !take(token, h)) {
        osal_free(h);
        osal_free(r);
        return -1;
    }
    changed();
    r->token = token;
    snprintf(r->cap, sizeof r->cap, "%s", h->cap->id);
    if (!accept) tell(token, r->cap, "rejected", NULL);
    else if (strcmp(h->member, ink_member_current()->id)) tell(token, r->cap, "member_changed", NULL);
    else {
        ink_call_opts_t o = {.src = INK_SRC_CONFIRMED, .page_gen = h->page_gen, .member = h->member, .reply_exec = INK_EXEC_DIRECT, .done = confirmed_done, .ctx = r};
        int started = ink_cap_call(r->cap, &h->args, &o);
        osal_free(h);
        if (started == 0) return 0; /* confirmed_done frees it */
        ink_receipt_t busy = {.status = INK_RC_FAILED};
        snprintf(busy.detail, sizeof busy.detail, "could not be started");
        tell(token, r->cap, "accepted", &busy);
        osal_free(r);
        return 0;
    }
    osal_free(h);
    osal_free(r);
    return 0;
}

int ink_confirm_withdraw(uint32_t token, ink_source_t src) {
    bool mine = false, person = src == INK_SRC_TOUCH || src == INK_SRC_KEY;
    uint32_t got = 0;
    const char *cap = NULL;
    ink_svc_lock();
    for (int i = 0; i < MAX_HELD; i++)
        if (CF.held[i].used && CF.held[i].token == token) {
            mine = person || CF.held[i].src == src;
            if (mine) {
                CF.held[i].used = false;
                got = token;
                cap = CF.held[i].cap->id;
            }
        }
    ink_svc_unlock();
    if (!got) return -1;
    changed();
    tell(token, cap, "withdrawn", NULL);
    return 0;
}

void ink_confirm_set_presenter(const ink_confirm_presenter_t *p) {
    ink_svc_lock();
    CF.has_presenter = p != NULL;
    if (p) CF.presenter = *p;
    ink_svc_unlock();
    present();
}

/* ---- what moves it ---- */

static void on_member(void *ctx, int h, const char *id) { /* wherever the switch happened: what they asked for ends with them */
    (void)ctx;
    (void)h;
    (void)id;
    const char *now = ink_member_current()->id;
    for (;;) {
        uint32_t token = 0;
        const char *cap = NULL;
        ink_svc_lock();
        for (int i = 0; i < MAX_HELD && !token; i++)
            if (CF.held[i].used && strcmp(CF.held[i].member, now)) {
                CF.held[i].used = false;
                token = CF.held[i].token;
                cap = CF.held[i].cap->id;
            }
        ink_svc_unlock();
        if (!token) return;
        changed();
        tell(token, cap, "member_changed", NULL);
    }
}

static void on_screen_changed(void *ctx, int h, const char *id) { /* with nothing waiting nothing is on screen: the UI sleeps on */
    (void)ctx;
    (void)h;
    (void)id;
    bool any = false;
    ink_svc_lock();
    for (int i = 0; i < MAX_HELD; i++) any = any || CF.held[i].used;
    ink_svc_unlock();
    if (any) present();
}

/* ---- on the bus ---- */

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static void cap_list(ink_call_t *c) {
    static const char *const SRC[] = {"touch", "key", "ai", "system", "app", "remote", "confirmed"};
    char *out = osal_malloc(LIST_CAP, OSAL_MEM_EXTERNAL);
    ink_confirm_view_t *v = osal_malloc(sizeof *v * MAX_HELD, OSAL_MEM_EXTERNAL);
    if (!out || !v) {
        fail(c, INK_RC_FAILED, "out of memory");
    } else {
        int n = ink_confirm_list(v, MAX_HELD);
        uint64_t now = osal_now_us();
        ink_jw_t w;
/*
 * The confirmation card: the system's placeholder for what ink_confirm_set_presenter shows. It is drawn here, over
 * everything, so that no page can look like it; only a touch or a key on it counts as a person's answer. The real look
 * comes with the system UI (D-64).
 */
#include <stdio.h>
#include <string.h>

#include "ink/sys/confirm.h"
#include "ink/sys/exec.h"
#include "pinpad.h"
#include "shell_card.h"

static struct {
    shell_card_t card;
    ink_confirm_view_t now;
    lv_obj_t *pad;
    int pin_result;
    uint32_t pin_wait;
    ink_exec_job_t told_job;
} C;

static void told_job(void *arg);

static void pin_told(void *ctx, int result, uint32_t wait_s) { /* exec.bg */
    (void)ctx;
    __atomic_store_n(&C.pin_result, result, __ATOMIC_RELEASE);
    C.pin_wait = wait_s;
    ink_exec_post(INK_EXEC_UI, &C.told_job, told_job, NULL);
}

static void told_job(void *arg) { /* UI task */
    (void)arg;
    int r = __atomic_load_n(&C.pin_result, __ATOMIC_ACQUIRE);
    if (r == INK_PIN_OK || !C.pad) return; /* the card goes by itself */
    char s[48];
    if (C.pin_wait) snprintf(s, sizeof s, "请等 %u 秒再试", (unsigned)C.pin_wait);
    else snprintf(s, sizeof s, "密码不对");
    shell_pinpad_clear();
    shell_pinpad_say(s);
}

static void pin_entered(const char *pin) {
    ink_confirm_accept_with_pin(C.now.token, pin, pin_told, NULL);
    shell_pinpad_clear();
    shell_pinpad_say("正在核对…");
}

static void on_answer(lv_event_t *e) {
    bool yes = lv_event_get_user_data(e) != NULL;
    if (yes && C.now.parent) { /* a yes here takes a parent */
        if (!C.pad) C.pad = shell_pinpad(C.card.root, pin_entered);
        return;
    }
    ink_confirm_decide(C.now.token, yes, INK_SRC_TOUCH);
}

static int snapshot(char *buf, size_t cap) {
    int n = snprintf(buf, cap, "等你确认：%s。%s。按钮：确认、取消。", C.now.title, C.now.detail);
    return n < 0 ? 0 : (size_t)n < cap ? n : (int)cap - 1;
}

static bool on_key(ink_key_t key, bool long_press) {
    if ((key == INK_KEY_BACK || key == INK_KEY_HOME) && !long_press) ink_confirm_decide(C.now.token, false, INK_SRC_KEY); /* leaving is a no: not every device has a back key */
    return true;
}

static const ink_ui_overlay_t OVERLAY = {.name = "confirm", .level = 1, .on_key = on_key, .snapshot = snapshot};

static void show(const ink_confirm_view_t *top) { /* UI task */
    if (!top) {
        if (!C.card.root) return;
        shell_card_close(&C.card);
        C.pad = NULL;
        ink_ui_overlay_remove(&OVERLAY);
        return;
    }
    if (C.card.root && C.now.token == top->token) return;
    C.now = *top;
    if (C.pad) {
        lv_obj_delete(C.pad);
        C.pad = NULL;
    }
    if (!C.card.root) {
        shell_card_open(&C.card);
        ink_ui_overlay_add(&OVERLAY, C.card.root);
    }
    shell_card_text(&C.card, C.now.title, C.now.detail);
    shell_card_clear_buttons(&C.card);
    shell_card_button(&C.card, "确认", on_answer, (void *)1);
    shell_card_button(&C.card, "取消", on_answer, NULL);
}

int ink_shell_confirm_card_init(void) {
    static const ink_confirm_presenter_t P = {.show = show, .exec = INK_EXEC_UI};
    ink_confirm_set_presenter(&P);
    return 0;
}

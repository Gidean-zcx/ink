/*
 * The time service on the soft bus: what the clock and calendar apps' buttons do, and what the AI can
 * do. None of it blocks: the table is in memory and writes are queued.
 */
#include <stdio.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/sys/cap.h"
#include "ink/sys/json.h"
#include "ink/sys/members.h"
#include "ink/sys/state.h"
#include "ink/sys/time.h"
#include "time_internal.h"

#define UNDO_MS 10000

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static void local_text(int64_t utc, char *out, size_t cap) {
    ink_tm_t t;
    ink_time_to_local(utc, &t);
    snprintf(out, cap, "%04d-%02d-%02d %02d:%02d:%02d", t.year, t.month, t.day, t.hour, t.min, t.sec);
}

static void cap_now(ink_call_t *c) {
    if (!ink_time_valid()) {
        fail(c, INK_RC_FAILED, "the clock is not known yet");
        return;
    }
    int64_t now = ink_time_now_s();
    ink_tm_t t;
    ink_time_to_local(now, &t);
    char text[24], lunar[32] = "", gz[12] = "", out[256];
    local_text(now, text, sizeof text);
    ink_lunar_t l;
    bool has_lunar = ink_lunar_from_solar(t.year, t.month, t.day, &l);
    if (has_lunar) {
        ink_lunar_name(&l, lunar, sizeof lunar);
        ink_lunar_ganzhi(l.year, gz, sizeof gz);
    }
    int64_t synced = 0;
    ink_state_get_int(ink_state_find("time.synced"), &synced);
    snprintf(out, sizeof out, "{\"utc_s\":%lld,\"local\":\"%s\",\"weekday\":%d,\"zone\":\"%s\",\"offset_min\":%d,\"lunar\":\"%s\",\"ganzhi\":\"%s\",\"synced\":%s}",
             (long long)now, text, t.wday, ink_time_zone(), t.offset_min, lunar, gz, synced ? "true" : "false");
    ink_cap_result(c, out);
    snprintf(c->rc.say, sizeof c->rc.say, "现在是 %.16s", text);
}

static void cap_set(ink_call_t *c) {
    int64_t s = 0;
    ink_args_get_int(&c->args, "utc_s", &s);
    ink_time_set(s, false);
    snprintf(c->rc.say, sizeof c->rc.say, "时间改好了");
}

static void cap_lunar(ink_call_t *c) {
    int64_t y = 0, m = 0, d = 0, ly = 0, lm = 0, ld = 0;
    bool leap = false;
    ink_args_get_bool(&c->args, "leap", &leap);
    char out[160], name[32] = "", gz[12] = "";
    if (ink_args_get_int(&c->args, "lunar_year", &ly) && ink_args_get_int(&c->args, "lunar_month", &lm) && ink_args_get_int(&c->args, "lunar_day", &ld)) {
        ink_lunar_t l = {(int)ly, (int)lm, (int)ld, leap};
        int sy, sm, sd;
        if (!ink_lunar_to_solar(&l, &sy, &sm, &sd)) {
            fail(c, INK_RC_INVALID, "no such lunar date");
            return;
        }
        snprintf(out, sizeof out, "{\"year\":%d,\"month\":%d,\"day\":%d}", sy, sm, sd);
    } else {
        ink_tm_t t = {0};
        if (!ink_args_get_int(&c->args, "year", &y) || !ink_args_get_int(&c->args, "month", &m) || !ink_args_get_int(&c->args, "day", &d)) {
            if (!ink_time_valid()) {
                fail(c, INK_RC_FAILED, "the clock is not known yet");
                return;
            }
            ink_time_to_local(ink_time_now_s(), &t);
            y = t.year;
            m = t.month;
            d = t.day;
        }
        ink_lunar_t l;
        if (!ink_lunar_from_solar((int)y, (int)m, (int)d, &l)) {
            fail(c, INK_RC_INVALID, "outside the calendar (1901-2100)");
            return;
        }
        ink_lunar_name(&l, name, sizeof name);
    INK_REPEAT_MONTHLY,     /* the same day of each month that has it */
    INK_REPEAT_YEARLY,
    INK_REPEAT_LUNAR_YEARLY /* the same lunar date: birthdays */
} ink_repeat_t;

/* What is kept for an alarm (one fixed record, schema 1, in the device's data area). */
typedef struct {
    uint32_t id;
    uint8_t kind, repeat, weekdays, src; /* src: who set it (ink_source_t) */
    bool enabled;
    uint8_t hour, min;     /* local time of day */
    uint8_t lmonth, lday;  /* lunar repeat */
    bool lleap;
    int16_t year;          /* local date of a single or a dated one; 0 = the next time that hour and minute comes */
    uint8_t month, day;
    int64_t at_utc;        /* a reminder at a moment, whatever the zone becomes; 0 = local time above */
    int64_t next_s;        /* when it goes off next (0 = not scheduled) */
    int64_t snooze_until;
    char owner[16];        /* whose it is; it rings whoever is using the device */
    char title[48];
} ink_alarm_t;

/** Add: fills id and next_s. > 0 the id, < 0 refused (table full, not valid). */
int ink_alarm_add(ink_alarm_t *a);
int ink_alarm_cancel(uint32_t id);
/** The next of the current member's, after *cursor (start from 0): 1, 0 at the end. */
int ink_alarm_next(int *cursor, ink_alarm_kind_t kind, ink_alarm_t *out);
/** Stop a ringing alarm (id 0: all). Repeats stay scheduled. */
int ink_alarm_dismiss(uint32_t id);
/** Ring again in `minutes` (0: 9). */
int ink_alarm_snooze(uint32_t id, int minutes);

#ifdef __cplusplus
}
#endif
#endif
/*
 * Storage service task: the ONLY code that touches /user (internal flash).
 *
 * Its stack is in internal RAM. On the MCU every flash API call — reads too —
 * disables the caches; a task whose stack is in PSRAM would lose its stack
 * (ESP-IDF asserts), so other tasks never call the flash API themselves:
 * reads are executed here on their behalf (the caller blocks), writes are
 * queued.
 *
 * No flash operation runs while the panel scans: every read and write holds
 * the display's flash guard, which waits for the waveform in flight to end
 * and keeps the next one from starting until the flash is done (a flash
 * operation freezes the feeders and masks the LCD refill interrupt; IDF's
 * cross-core IPC also waits behind the max-priority feeders). Writes
 * additionally wait until nothing is queued for the panel and no one holds
 * writes off (audio streaming).
 *
 * Writes are atomic (temp file + rename); repeated writes of one path
 * coalesce. Appends and removes go through the same queue, in the order they
 * were accepted. Reads see queued writes, including the one being written; then
 * the read cache (small files and "does not exist", external RAM, LRU),
 * filled by reads, writes and background prefetches; only then the flash.
 * The cache never holds an older version than the newest write: a write
 * replaces the entry, or drops it when the new content does not fit (too
 * large, no memory) or the write failed; what a read or prefetch got from
 * the flash is not cached while a newer write for the path is queued.
 */
#include <stdio.h>
#include <string.h>

#include "ink/hal_display.h"
#include "ink/hal_storage.h"
#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/display.h"
#include "ink/sys/res.h"
#include "ink/sys/storage.h"

#define MAX_JOBS 8
#define ST_STACK 3584
#define ST_PRIO 3
#define IDLE_POLL_US 50000
#define MAX_DEFER_US 30000000ull /* writes held off longer than this are forced (counted) */
/* direct-drive panels (async) can pause between drive phases for a flash operation: a write waits
 * this long for a quiet panel, then goes ahead and pauses the drive (a hiccup, no garbage) instead
 * of waiting behind continuous updates (AI text streaming keeps such a panel busy) */
#define ASYNC_PANEL_WAIT_US 500000
#define CACHE_MAX 32
#define CACHE_FILE_MAX 1024 /* larger files are not cached */
#define PREFETCH_MAX 16

typedef struct {
    char *path; /* path and data share one external-RAM block */
    uint8_t *data;
    int len; /* -1: the file does not exist */
    uint32_t used_at;
} centry_t;

typedef enum { J_WRITE = 0, J_APPEND, J_REMOVE } job_kind_t;

typedef struct {
    char *path; /* path and (copied) data share one external-RAM block */
    const uint8_t *data;
    size_t len;
    uint64_t queued_us;
    uint32_t seq;   /* content version: the newest queued content of a path wins */
    uint32_t order; /* place in line, kept when a write is merged into it */
    uint8_t kind;
    bool used;
    bool inflight; /* taken by the storage task: stays visible to reads, never coalesced into */
    ink_storage_done_fn done;
    void *ctx;
} job_t;

typedef struct {
    const char *path;
    void *buf;
    size_t cap;
    int result;
    void (*fn)(void *arg); /* other work to run on the storage task, instead of a small-file read */


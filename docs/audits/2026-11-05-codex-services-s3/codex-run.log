diff --git a/docs/audits/2026-11-05-codex-services-s3/experiments/events_probe.c b/docs/audits/2026-11-05-codex-services-s3/experiments/events_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..385ce24e93878782cd361b7a1a4392d28f55bfca
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-s3/experiments/events_probe.c
@@ -0,0 +1,24 @@
+#include "product_probe.h"
+extern void sim_net_set_link(const char *);
+static void online(void *arg) { (void)arg; sim_net_set_link("wifi"); }
+static void audit_task(void *arg) {
+    (void)arg; delay_ms(1800);
+    CHECK(!ink_hub_online(), "offline fixture");
+    CHECK(ink_fs_write_atomic("/me/AUDIT-owner-only.txt", "synthetic", 9) == INK_FS_OK, "owner creates private file");
+    CHECK(ink_member_switch("kid") == 0, "child takes device");
+    vtk_event_at(vtk_now()+SIM_MS(1), online, NULL); ink_hub_demand();
+    CHECK(WAIT_FOR(ink_hub_online(), 30000), "child online"); delay_ms(2000);
+    int leaked=0, without_member=0;
+    for (int i=0;i<sim_hub_events_seen();i++) {
+        const char *e=sim_hub_event_at(i);
+        if(e && strstr(e,"AUDIT-owner-only")) { leaked++; without_member += strstr(e,"\"member\"") == NULL; }
+    }
+    printf("AUDIT recipient=%s private_file_events=%d unscoped=%d\n",ink_member_current()->id,leaked,without_member);
+    CHECK(leaked > 0 && without_member > 0,"reproduce event across members");
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t c = {.name="audit-events", .fn=audit_task, .stack_bytes=16384, .priority=OSAL_PRIO_NORMAL, .core=-1, .flags=OSAL_TASK_STACK_EXTERNAL};
+    osal_task_create(&c,NULL);
+}
diff --git a/docs/audits/2026-11-05-codex-services-s3/experiments/member_retry_boundary.c b/docs/audits/2026-11-05-codex-services-s3/experiments/member_retry_boundary.c
new file mode 100644
index 0000000000000000000000000000000000000000..7d65833817c43bd1fcdef3524252c70241567c6c
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-s3/experiments/member_retry_boundary.c
@@ -0,0 +1,19 @@
+/* Pause before a real datastore read during a retry. Product statements stay unchanged. */
+#include "ink/sys/data.h"
+#include "ink/osal.h"
+static int audit_next(ink_db_t *, ink_db_cursor_t *, ink_rec_t *, void *, size_t);
+#define ink_db_next audit_next
+#include "../../../../system/policy/members.c"
+#undef ink_db_next
+static osal_sem_t *go;
+static volatile int armed, entered;
+void audit_arm_retry(void) { go = osal_sem_create(0, 1); armed = 1; }
+int audit_retry_entered(void) { return entered; }
+void audit_release_retry(void) { osal_sem_give(go); }
+static int audit_next(ink_db_t *db, ink_db_cursor_t *c, ink_rec_t *r, void *p, size_t n) {
+    if (armed) {
+        armed = 0; entered = 1;
+        osal_sem_take(go, OSAL_WAIT_FOREVER);
+    }
+    return ink_db_next(db, c, r, p, n);
+}
diff --git a/docs/audits/2026-11-05-codex-services-s3/experiments/member_retry_probe.c b/docs/audits/2026-11-05-codex-services-s3/experiments/member_retry_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..7ae6e2e172172abfa8a72b523162a0a58428e91c
--- /dev/null
+++ b/docs/audits/2026-11-05-codex-services-s3/experiments/member_retry_probe.c
@@ -0,0 +1,33 @@
+#include "product_probe.h"
+extern void audit_arm_retry(void), audit_release_retry(void);
+extern int audit_retry_entered(void);
+static volatile int pin_done, pin_result;
+static void told(void *ctx, int r, uint32_t wait_s) { (void)ctx; (void)wait_s; pin_result=r; pin_done=1; }
+static void audit_task(void *arg) {
+    (void)arg; delay_ms(1800);
+    if (getenv("AUDIT_WRITE_FIXTURE")) {
+        CHECK(ink_member_set_pin("owner", NULL, "123456", told, NULL) == 0, "set fixture PIN");
+        CHECK(WAIT_FOR(pin_done, 5000) && pin_result == INK_PIN_OK, "fixture accepted");
+        ink_db_flush_all();
+        CHECK(WAIT_FOR(ink_db_idle() && !ink_storage_pending(), 6000), "fixture durable");
+    } else {
+        CHECK(ink_member_has_pin("owner") && !ink_member_space_open(), "unread table initially fails closed");
+        audit_arm_retry();
+        CHECK(ink_member_unlock("owner", "000000", told, NULL) == 0, "start wrong PIN retry");
+        CHECK(WAIT_FOR(audit_retry_entered(), 5000), "retry reaches datastore iteration");
+        int open = ink_member_space_open(), pin = ink_member_has_pin("owner");
+        CHECK(AI("state.list", NULL), "AI direct call while retry is paused");
+        printf("AUDIT retry has_pin=%d space_open=%d ai_status=%d\n", pin, open, g_rc.status);
+        CHECK(open && !pin && g_rc.status == INK_RC_DONE, "reproduce transient fail-open");
+        audit_release_retry();
+        CHECK(WAIT_FOR(pin_done, 5000) && pin_result == INK_PIN_WRONG, "PIN still rejected eventually");
+        printf("AUDIT after_retry space_open=%d pin_result=%d\n", ink_member_space_open(), pin_result);
+        CHECK(!ink_member_space_open(), "closes after reload");
+    }
+    ink_probe_count("test.finished");
+}
+void ink_main(void) {
+    product_main();
+    osal_task_cfg_t c = {.name="audit-retry", .fn=audit_task, .stack_bytes=16384, .priority=OSAL_PRIO_NORMAL, .core=-1, .flags=OSAL_TASK_STACK_EXTERNAL};
+    osal_task_create(&c, NULL);
+}

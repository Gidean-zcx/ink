    int level;
    ink_audio_frame_fn cap_fn;
    void *cap_ctx;
    int16_t *ring; /* CAP_RING samples, PSRAM */
    /* hands-free listening (R-047): the microphone stays open for the voice front end */
    bool listen_on, afe_speech;
    bool afe_on; /* audio task: the front end is started */
    ink_audio_listen_fn listen_fn;
    void *listen_ctx;
    int16_t *ref_ring;  /* CAP_RING samples of what the speaker played, PSRAM (allocated on first listen) */
    int16_t *ref_frame; /* FRAME samples */
    uint32_t rd, wr; /* sample counters (mod CAP_RING when indexing) */
    uint32_t cap_seq;
    hal_opus_enc_t *enc;
    /* playback */
    int stream, next_stream;
    ink_audio_prio_t prio;
    bool finishing, started;
    jb_frame_t *jb; /* JB_MAX, PSRAM */
    int jb_head, jb_count, plc_run;
    hal_opus_dec_t *dec;
    int dec_stream; /* the stream the decoder state belongs to */
    int16_t *pcm; /* staging: one decoded frame or a tone (PSRAM); service task only */
    int pcm_off, pcm_len;
    int staged_stream; /* stream the staged samples belong to (0 = a tone) */
    bool out_open;
    uint64_t waiting_since; /* output open, the stream has nothing ready since (0 = not waiting) */
    uint64_t open_failing_since, open_retry_at; /* the output did not open or play for the stream (0 = it plays) */
    uint64_t stall_since;                       /* the open output stopped taking samples (0 = it takes them) */
    unsigned open_tries;
    ink_audio_fail_fn fail_fn; /* told when a stream fails */
    void *fail_ctx;
    /* tone request */
    bool tone_pending;
    ink_tone_t tone;
    uint64_t tone_cause;
    const char *tone_probe;
    const char *heard_probe; /* set while the staged samples are the start of a probed tone/stream */
    const char *stream_probe; /* the current stream's "first sample heard" probe (until used) */
    uint64_t stream_cause;
    uint64_t heard_cause;
    bool ring_on;    /* a call or an alarm rings */
    uint32_t ring_t; /* samples since it began */
    int ring_focus;
    struct {
        int token;
        ink_audio_prio_t prio;
        ink_focus_fn fn;
        void *ctx;
        ink_exec_t exec;
        bool paused;
    } focus[MAX_FOCUS];
    int next_focus;
    uint32_t stream_played; /* real frames of the stream on staging */
    int last_stream;
    uint32_t last_played;
    ink_audio_route_t route, route_want;
    int child_max;
    bool holding_writes, holding_awake;
    bool boosting;
    hal_cpu_boost_t *boost;
} AU;

static void lock(void) { osal_mutex_lock(AU.lock, OSAL_WAIT_FOREVER); }
static void unlock(void) { osal_mutex_unlock(AU.lock); }

/* Under the lock: what is left of a stream when it goes. */
static void stream_gone(void) {
    if (!AU.stream) return;
    AU.last_stream = AU.stream;
    AU.last_played = AU.stream_played;
    AU.stream = 0;
}

/* --------------------------------------------------------------- capture */

/* Platform audio task: copy the chunk; samples the platform lost become silence so timing holds. */
static void capture_cb(void *ctx, const int16_t *mic, const int16_t *ref, int samples, int lost, uint64_t t_us) {
    (void)ctx;
    (void)ref;
    (void)t_us;
    lock();
    if ((AU.cap_on && !AU.cap_ending) || AU.listen_on) {
        if (lost > 0) ink_probe_value("audio.capture_gap_ms", lost * 1000.0 / HAL_AUDIO_RATE);
        bool with_ref = AU.listen_on && AU.ref_ring;
        for (int pass = 0; pass < 2; pass++) {
            int n = pass ? samples : (lost > CAP_RING / 4 ? CAP_RING / 4 : lost);
            for (int i = 0; i < n; i++) {
                if (AU.wr - AU.rd >= CAP_RING) {
                    AU.rd++; /* ring full (the encoder fell 2 s behind): drop the oldest */
                    ink_probe_count("audio.capture_overflow_samples");
                }
                if (with_ref) AU.ref_ring[AU.wr % CAP_RING] = pass && ref ? ref[i] : 0;
                AU.ring[AU.wr++ % CAP_RING] = pass ? mic[i] : 0;
            }
        }
    }
    unlock();
    osal_sem_give(AU.wake);
}

static bool take_frame(int16_t *out) { /* under lock */
    if (AU.wr - AU.rd < FRAME) return false;
    bool ref = AU.listen_on && AU.ref_ring;
    for (int i = 0; i < FRAME; i++) {
        if (ref) AU.ref_frame[i] = AU.ref_ring[AU.rd % CAP_RING];
        out[i] = AU.ring[AU.rd++ % CAP_RING];
    }
    return true;
}

static void close_output(bool drain);
static void free_jb(void);

static int g_last_command = -1;

static void listen_event(ink_listen_ev_t ev, uint64_t t_us) {
    if (AU.listen_fn) AU.listen_fn(AU.listen_ctx, ev, t_us);
}

/* One frame through the voice front end: wake word, speech edges, barge-in. Audio task. */
static void afe_step(const int16_t *frame) {
    hal_afe_result_t r;
    uint64_t now = osal_now_us();
    hal_afe_feed(frame, AU.ref_frame, FRAME, now, &r);
    if (r.wake) listen_event(INK_LISTEN_WAKE, now);
    if (r.command >= 0) {
        __atomic_store_n(&g_last_command, r.command, __ATOMIC_RELEASE);
        listen_event(INK_LISTEN_COMMAND, now);
    }
    if (r.speech && !AU.afe_speech) {
        lock();
        bool answer = AU.stream && AU.prio == INK_AUDIO_PRIO_VOICE; /* an answer is playing: speech interrupts it */
        if (answer) {
            free_jb();
            AU.stream = 0;
            AU.finishing = AU.started = false;
        }
        unlock();
        if (answer) {
            close_output(false); /* stop now, not after the DMA ring drained */
            ink_probe_value("ai.barge_to_stop_ms", (double)(osal_now_us() - r.speech_since_us) / 1000.0);
            listen_event(INK_LISTEN_BARGE, r.speech_since_us);
        } else listen_event(INK_LISTEN_SPEECH, r.speech_since_us);
    } else if (!r.speech && AU.afe_speech) listen_event(INK_LISTEN_QUIET, now);
    AU.afe_speech = r.speech;
}

static void encode_and_deliver(const int16_t *frame) {
    if (__atomic_load_n(&AU.measure, __ATOMIC_RELAXED)) {
        uint32_t sum = 0;
        for (int i = 0; i < FRAME; i += 4) sum += (uint32_t)(frame[i] < 0 ? -(int32_t)frame[i] : frame[i]);
        osal_cost_units("audio.mix_sample", FRAME / 4);
        __atomic_store_n(&AU.level, (int)(sum / (FRAME / 4)), __ATOMIC_RELAXED);
    }
    uint8_t pkt[HAL_OPUS_MAX_PACKET];
    int n = hal_opus_encode(AU.enc, frame, pkt, sizeof pkt);
    if (n > 0 && AU.cap_fn) AU.cap_fn(AU.cap_ctx, pkt, (size_t)n, AU.cap_seq++);
}

/* Encode one frame, or finish an ending capture. Returns true if there may be more to encode. */
static bool capture_step(int16_t *scratch) {
    lock();
    bool on = AU.cap_on, ending = AU.cap_ending, listen = AU.listen_on, got = (on || listen) && take_frame(scratch);
    uint32_t left = AU.wr - AU.rd;
    if (!got && on && ending && !listen) { /* flush the tail (padded) and signal the end */
        for (int i = 0; i < FRAME; i++) scratch[i] = i < (int)left ? AU.ring[AU.rd++ % CAP_RING] : 0;
    }
    unlock();
    if (got && listen && AU.afe_on) afe_step(scratch); /* afe_on: set in this task, once it started */
    if (got && on) encode_and_deliver(scratch);
    if (got && !(on && ending && listen)) return true; /* listening: the capture ends right here */
    if (on && ending) {
        if (!got && !listen && left) encode_and_deliver(scratch);
        /* Taken over here, then cleaned up, then the owner told; only after that is the capture over:
         * a new one cannot begin before this one's end was delivered, nor share anything with it. */
        lock();
    do_stop();
}

int ink_media_play(const char *path, uint32_t start_ms) { return post_cmd(c_play, start_ms, path); }
void ink_media_pause(void) { post_cmd(c_pause, 0, NULL); }
void ink_media_resume(void) { post_cmd(c_resume, 0, NULL); }
int ink_media_seek(uint32_t ms) { return post_cmd(c_seek, ms, NULL); }
void ink_media_stop(void) { post_cmd(c_stop, 0, NULL); }

void ink_media_status(ink_media_status_t *out) {
    ink_svc_lock();
    *out = M.st;
    ink_svc_unlock();
}

/* ---- what else stops it ---- */

static void rec_member_changed(void);

static void member_job(void *arg) { /* someone else: it stays with the one who was listening */
    (void)arg;
    do_stop();
    rec_member_changed();
}

static void on_member(void *ctx, int h, const char *id) {
    (void)ctx;
    (void)h;
    (void)id;
    ink_exec_post(INK_EXEC_MEDIA, &M.member_job, member_job, NULL);
}

static void route_job(void *arg) { /* the headset went: not suddenly out loud */
    (void)arg;
    if (ink_audio_route() == INK_ROUTE_SPEAKER) do_pause(INK_MEDIA_BY_ROUTE);
}

static void on_route(void *ctx, int h, const char *id) {
    (void)ctx;
    (void)h;
    (void)id;
    ink_exec_post(INK_EXEC_MEDIA, &M.route_job, route_job, NULL);
}

/* ---- recording ---- */

typedef struct {
    uint8_t *data;
    uint16_t len;
} rec_frame_t;

static struct {
    bool on, ending;     /* under the service lock */
    ogg_writer_t *w;
    char path[INK_FS_PATH_MAX];
    char member[INK_MEMBER_ID_MAX]; /* whose it is: what the next one says does not go into it */
    rec_frame_t q[REC_FRAMES];
    uint32_t head, tail; /* under the service lock */
    uint32_t last_sync_ms, max_ms;
    int focus;
    int dropped;
    char why[24];
    ink_exec_job_t write_job, stop_job;
    int h_recording;
} REC INK_PSRAM_BSS;

bool ink_audio_recording(void) {
    ink_svc_lock();
    bool on = REC.on;
    ink_svc_unlock();
    return on;
}

static void rec_finish(const char *why) { /* executor */
    uint32_t ms = ogg_written_ms(REC.w);
    int r = ogg_finish(REC.w);
    REC.w = NULL;
    if (REC.focus) ink_audio_focus_release(REC.focus);
    REC.focus = 0;
    ink_svc_lock();
    REC.on = REC.ending = false;
    ink_svc_unlock();
    ink_state_set_bool(REC.h_recording, false);
    ink_probe_count("media.recordings");
    ink_args_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    if (a) {
        ink_args_init(a);
        ink_args_str(a, "path", REC.path);
        ink_args_str(a, "member", REC.member);
        ink_args_int(a, "ms", ms);
        ink_args_str(a, "why", r && !REC.why[0] ? "write_failed" : why);
        ink_cap_emit("audio.record_done", a);
        osal_free(a);
    }
}

static void rec_write(void *arg) { /* executor: what the microphone gave, to the card */
    (void)arg;
    if (!REC.w) return;
    for (;;) {
        rec_frame_t f = {0};
        ink_svc_lock();
        bool any = REC.tail != REC.head;
        if (any) {
            f = REC.q[REC.tail % REC_FRAMES];
            REC.tail++;
        }
        bool ending = REC.ending;
        ink_svc_unlock();
        if (!any) {
            if (ending) rec_finish(REC.why[0] ? REC.why : "stopped");
            return;
        }
        if (!f.data) { /* the end of the capture, in its place in the queue */
            ink_svc_lock();
            REC.ending = true;
            ink_svc_unlock();
            continue;
        }
        int e = ogg_write_packet(REC.w, f.data, f.len, OGG_FRAME_MS);
        osal_free(f.data);
        if (e) { /* full, or the card went */
            snprintf(REC.why, sizeof REC.why, "%s", e == INK_FS_ERR_NO_SPACE || e == INK_FS_ERR_IO ? "no_space" : "write_failed"); /* a card that is there and takes no more */
            ink_audio_capture_end();
            continue;
        }
        uint32_t ms = ogg_written_ms(REC.w);
        if (ms - REC.last_sync_ms >= REC_SYNC_MS) {
            REC.last_sync_ms = ms;
            ogg_sync(REC.w);
        }
        if (REC.max_ms && ms >= REC.max_ms && !REC.why[0]) {
            snprintf(REC.why, sizeof REC.why, "max_length");
            ink_audio_capture_end();
        }
    }
}

static void rec_frame(void *ctx, const uint8_t *data, size_t len, uint32_t seq) { /* the audio task: short */
    (void)ctx;
    (void)seq;
    uint8_t *copy = NULL;
    if (len && strcmp(ink_member_current()->id, REC.member)) return; /* someone else has it now, the end is on its way */
    if (len) {
        copy = osal_malloc(len, OSAL_MEM_EXTERNAL);
        if (!copy) {
            ink_probe_count("media.record_lost_frames");
            return;
        }
        memcpy(copy, data, len);
    }
    ink_svc_lock();
    bool room = REC.head - REC.tail < REC_FRAMES;
    if (room) REC.q[REC.head++ % REC_FRAMES] = (rec_frame_t){copy, (uint16_t)len};
    ink_svc_unlock();
    if (!room) {
        osal_free(copy);
        ink_probe_count("media.record_lost_frames");
    }
    ink_exec_post(INK_EXEC_MEDIA, &REC.write_job, rec_write, NULL);
}

static void rec_member_changed(void) { /* executor */
    if (!ink_audio_recording() || !strcmp(ink_member_current()->id, REC.member)) return;
    snprintf(REC.why, sizeof REC.why, "member_changed");
    ink_audio_capture_end();
}

static void rec_on_focus(void *ctx, ink_focus_event_t ev, ink_audio_prio_t by) { /* something comes first: what there is, is kept */
    (void)ctx;
    (void)by;
    if (ev != INK_FOCUS_LOST || !ink_audio_recording()) return;
    REC.focus = 0;
    snprintf(REC.why, sizeof REC.why, "interrupted");
    ink_audio_capture_end();
}

/* ---- on the bus ---- */

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static void cap_play(ink_call_t *c) { /* executor */
    char path[INK_FS_PATH_MAX];
    int64_t start = -1;
    ink_args_get_str(&c->args, "path", path, sizeof path);
    ink_args_get_int(&c->args, "start_ms", &start);
    int e = do_play(path, start < 0 ? INK_MEDIA_RESUME : (uint32_t)start);
    if (e == -100) fail(c, INK_RC_FAILED, "not an Ogg Opus file (one channel)");
    else if (e) fail(c, INK_RC_FAILED, ink_fs_err_name(e));
    else {
        snprintf(c->rc.object, sizeof c->rc.object, "media:%.40s", path);
        ink_media_status_t st;
        ink_media_status(&st);
        snprintf(c->rc.say, sizeof c->rc.say, "从第 %u 秒开始放", (unsigned)(st.position_ms / 1000));
    }
}

static void need_session(ink_call_t *c, void (*act)(void)) {
    if (!M.r) fail(c, INK_RC_FAILED, "nothing is playing");
    else act();
}

static void act_pause(void) { do_pause(INK_MEDIA_BY_USER); }
static void act_resume(void) { do_resume(0); }
static void act_stop(void) { do_stop(); }
static void cap_pause(ink_call_t *c) { need_session(c, act_pause); }
static void cap_resume(ink_call_t *c) { need_session(c, act_resume); }
static void cap_stop(ink_call_t *c) { need_session(c, act_stop); }
/*
 * Wi-Fi management (system services design §11.1): the networks this device knows, finding new ones. Passwords go in and
 * never come out: the collection is closed to the AI, and they are in no snapshot, log or receipt. Choosing between Wi-Fi
 * and LTE stays with the net service (D-58): this only says which networks are known.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "ink/hal_net.h"
#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/cap.h"
#include "ink/sys/crc.h"
#include "ink/sys/data.h"
#include "ink/sys/json.h"
#include "ink/sys/net.h"
#include "ink/sys/power.h"
#include "ink/sys/state.h"
#include "ink/sys/svc.h"

#define MAX_KNOWN 8
#define MAX_SEEN 12
#define SCAN_MS 4000
#define JOIN_MS 10000

/* Closed: no ai_read, its name is not offered to anyone. */
static const ink_db_def_t KNOWN = {.name = "net.wifi", .title = "已知的 Wi-Fi", .scope = INK_DB_DEVICE, .schema = 1, .max_records = MAX_KNOWN};

static struct {
    int h_state, h_ssid;
} W INK_PSRAM_BSS;

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static uint32_t ssid_id(const char *ssid) {
    uint32_t id = ink_crc32(0, ssid, strlen(ssid)) & 0x7fffffff;
    return id ? id : 1;
}

static void told(const char *what, const char *ssid) {
    ink_args_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    if (a) {
        ink_args_init(a);
        ink_args_str(a, "what", what);
        ink_args_str(a, "ssid", ssid);
        ink_cap_emit("wifi.changed", a);
        osal_free(a);
    }
}

/* The platform's list from what is stored. Returns how many. */
static int publish_known(void) {
    ink_db_t *db = ink_db_open(&KNOWN, NULL);
    hal_wifi_known_t *list = osal_malloc(sizeof *list * MAX_KNOWN, OSAL_MEM_EXTERNAL);
    int n = 0;
    if (db && list) {
        ink_db_cursor_t cur = {0};
        ink_rec_t r;
        while (n < MAX_KNOWN && ink_db_next(db, &cur, &r, &list[n], sizeof list[n]) == 1)
            if (r.len == sizeof list[n]) n++;
        hal_wifi_set_known(list, n);
    }
    osal_free(list);
    ink_db_close(db);
    return n;
}

static void cap_scan(ink_call_t *c) { /* exec.bg */
    hal_wifi_ap_t *ap = osal_malloc(sizeof *ap * MAX_SEEN, OSAL_MEM_EXTERNAL);
    char *out = osal_malloc(1536, OSAL_MEM_EXTERNAL);
    if (!ap || !out) fail(c, INK_RC_FAILED, "out of memory");
    else {
        ink_state_set_str(W.h_state, "scanning");
        ink_power_hold(INK_NEED_AWAKE);
        int n = hal_wifi_scan(ap, MAX_SEEN, SCAN_MS);
        ink_power_release(INK_NEED_AWAKE);
        ink_state_set_str(W.h_state, "idle");
        ink_jw_t w;
        ink_jw_init(&w, out, 1536);
        ink_jw_raw(&w, "[");
        for (int i = 0; i < n; i++) {
            ink_jw_raw(&w, i ? ",{\"ssid\":" : "{\"ssid\":");
            ink_jw_str(&w, ap[i].ssid);
            ink_jw_raw(&w, ",\"rssi\":");
            ink_jw_int(&w, ap[i].rssi);
            ink_jw_raw(&w, ap[i].secured ? ",\"secured\":true}" : ",\"secured\":false}");
        }
        ink_jw_raw(&w, "]");
        if (w.overflow) fail(c, INK_RC_FAILED, "too long");
        else ink_cap_result(c, out);
    }
    osal_free(out);
    osal_free(ap);
}

static void cap_list(ink_call_t *c) { /* exec.bg: names only */
    ink_db_t *db = ink_db_open(&KNOWN, NULL);
    hal_wifi_known_t *k = osal_malloc(sizeof *k, OSAL_MEM_EXTERNAL);
    char *out = osal_malloc(512, OSAL_MEM_EXTERNAL);
    if (!db || !k || !out) fail(c, INK_RC_FAILED, "out of memory");
    else {
        ink_jw_t w;
        ink_jw_init(&w, out, 512);
        ink_jw_raw(&w, "[");
        ink_db_cursor_t cur = {0};
        ink_rec_t r;
        bool first = true;
        while (ink_db_next(db, &cur, &r, k, sizeof *k) == 1) {
            if (!first) ink_jw_raw(&w, ",");
            first = false;
            ink_jw_str(&w, k->ssid);
        }
        ink_jw_raw(&w, "]");
        if (w.overflow) fail(c, INK_RC_FAILED, "too long");
        else ink_cap_result(c, out);
    }
    osal_free(out);
    osal_free(k);
    ink_db_close(db);
}

static void cap_connect(ink_call_t *c) { /* exec.bg */
    hal_wifi_known_t *k = osal_calloc(1, sizeof *k, OSAL_MEM_EXTERNAL);
    if (!k) {
        fail(c, INK_RC_FAILED, "out of memory");
        return;
    }
    ink_args_get_str(&c->args, "ssid", k->ssid, sizeof k->ssid);
    ink_args_get_str(&c->args, "password", k->password, sizeof k->password);
    ink_state_set_str(W.h_state, "joining");
    ink_state_set_str(W.h_ssid, k->ssid);
    ink_power_hold(INK_NEED_AWAKE);
    int r = hal_wifi_connect(k->ssid, k->password, JOIN_MS);
    ink_power_release(INK_NEED_AWAKE);
    if (r == HAL_WIFI_OK) {
        ink_db_t *db = ink_db_open(&KNOWN, NULL);
        ink_db_write_t rec = {.id = ssid_id(k->ssid), .data = k, .len = sizeof *k, .src = (uint8_t)c->src};
        int saved = db ? ink_db_put(db, &rec, NULL) : INK_DB_ERR_ARG;
        ink_db_close(db);
        if (saved != INK_DB_OK) ink_probe_count("wifi.not_saved");
        publish_known();
        ink_state_set_str(W.h_state, "connected");
        told("connected", k->ssid);
        snprintf(c->rc.say, sizeof c->rc.say, "连上了 %.60s", k->ssid);
        snprintf(c->rc.object, sizeof c->rc.object, "wifi:%.32s", k->ssid);
    } else {
        ink_state_set_str(W.h_state, "failed");
        ink_state_set_str(W.h_ssid, "");
        fail(c, INK_RC_FAILED, r == HAL_WIFI_ERR_AUTH ? "wrong password" : r == HAL_WIFI_ERR_NOT_FOUND ? "that network is not around" : "it took too long");
    }
    memset(k, 0, sizeof *k);
    osal_free(k);
}

static void cap_forget(ink_call_t *c) { /* exec.bg */
    char ssid[33];
    ink_args_get_str(&c->args, "ssid", ssid, sizeof ssid);
    ink_db_t *db = ink_db_open(&KNOWN, NULL);
    int r = db ? ink_db_del(db, ssid_id(ssid), (uint8_t)c->src) : INK_DB_ERR_ARG;
    ink_db_close(db);
    if (r != INK_DB_OK) {
        fail(c, INK_RC_FAILED, "not a known network");
        return;
    }
    publish_known();
    ink_state_set_str(W.h_ssid, "");
    ink_state_set_str(W.h_state, "idle");
    told("forgotten", ssid);
}

static const ink_cap_t WIFI_CAPS[] = {
    {.id = "wifi.scan", .title = "找附近的 Wi-Fi（要几秒）", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .timeout_ms = 10000, .exec = INK_EXEC_BG, .run = cap_scan},
    {.id = "wifi.list", .title = "这台设备记得的 Wi-Fi（只有名字）", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .exec = INK_EXEC_BG, .run = cap_list},
    {.id = "wifi.connect", .title = "连接一个 Wi-Fi 并记住它", .ask = "连接 Wi-Fi：{ssid}",
     .input = "{\"type\":\"object\",\"properties\":{\"ssid\":{\"type\":\"string\",\"maxLength\":32},\"password\":{\"type\":\"string\",\"maxLength\":64}},\"required\":[\"ssid\"]}",
     .effect = INK_FX_SYSTEM, .timeout_ms = 20000, .exec = INK_EXEC_BG, .run = cap_connect},
    {.id = "wifi.forget", .title = "忘掉一个 Wi-Fi", .ask = "忘掉 Wi-Fi：{ssid}", .input = "{\"type\":\"object\",\"properties\":{\"ssid\":{\"type\":\"string\",\"maxLength\":32}},\"required\":[\"ssid\"]}",

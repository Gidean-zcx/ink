/*
 * The pinyin engine: full pinyin, whole-key matches of the longest prefix first (system services design §9.2). No
 * syllable splitting: the data decides ("xian" is both 先 and 西安). The dictionary is a file on the card, read into
 * external RAM the first time it is needed, searched in place, given back when memory is short and nobody is typing.
 * Without it (no card, a bad file) a small table in the program does.
 */
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "ink/hal_storage.h"
#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/crc.h"
#include "ink/sys/file.h"
#include "ink/sys/exec.h"
#include "ink/sys/res.h"
#include "ink/sys/svc.h"
#include "text_internal.h"

#define DICT_MAX (1024u * 1024u)

typedef struct __attribute__((packed)) {
    uint32_t text_off;
    uint16_t key_len, count;
    uint32_t first;
} dict_key_t;

typedef struct __attribute__((packed)) {
    uint32_t text_off;
    uint16_t word_len, freq;
} dict_entry_t;

typedef struct __attribute__((packed)) {
    char magic[4];
    uint32_t nkeys, nentries, keys_off, entries_off, text_off, text_len, crc;
} dict_head_t;

static struct {
    uint8_t *block;
    const dict_key_t *keys;
    const dict_entry_t *entries;
    const char *text;
    uint32_t nkeys;
    bool loading, tried;
    void (*ready)(void);
    ink_exec_job_t load_job, ready_job;
} PY INK_PSRAM_BSS;

/* When there is no dictionary: the commonest characters, sorted by key. */
static const struct {
    const char *key, *word;
    uint16_t freq;
} SMALL[] = {
    {"bu", "不", 8700}, {"da", "大", 7800}, {"de", "的", 9000}, {"ge", "个", 8000}, {"guo", "国", 7400}, {"hao", "好", 7500}, {"lai", "来", 7500}, {"ni", "你", 8000},
    {"ren", "人", 8600}, {"shang", "上", 7600}, {"shi", "是", 8900}, {"ta", "他", 8200}, {"wo", "我", 8500}, {"xia", "下", 7000}, {"yi", "一", 8800}, {"you", "有", 8400},
    {"zai", "在", 8300}, {"zhe", "这", 8100}, {"zhong", "中", 7000},
};

/* Everything in it is within it: a bad file must not take the device down. */
static bool dict_ok(const uint8_t *b, size_t n) {
    if (n < sizeof(dict_head_t)) return false;
    dict_head_t h;
    memcpy(&h, b, sizeof h);
    if (memcmp(h.magic, "IKD1", 4) || h.keys_off != sizeof h) return false;
    uint64_t keys_end = (uint64_t)h.keys_off + (uint64_t)h.nkeys * sizeof(dict_key_t), entries_end = (uint64_t)h.entries_off + (uint64_t)h.nentries * sizeof(dict_entry_t);
    if (keys_end != h.entries_off || entries_end != h.text_off || (uint64_t)h.text_off + h.text_len != n) return false;
    if (ink_crc32(0, b + sizeof h, n - sizeof h) != h.crc) return false;
    const dict_key_t *keys = (const dict_key_t *)(b + h.keys_off);
    const dict_entry_t *entries = (const dict_entry_t *)(b + h.entries_off);
    for (uint32_t i = 0; i < h.nkeys; i++) {
        if ((uint64_t)keys[i].text_off + keys[i].key_len > h.text_len || (uint64_t)keys[i].first + keys[i].count > h.nentries) return false;
    }
    for (uint32_t i = 0; i < h.nentries; i++)
        if ((uint64_t)entries[i].text_off + entries[i].word_len > h.text_len) return false;
    return true;
}

static void ready_job(void *arg) { /* UI task */
    (void)arg;
    void (*fn)(void) = PY.ready;
    if (fn) fn();
}

static void load_job(void *arg) { /* exec.bg */
    (void)arg;
    uint8_t *b = NULL;
    bool held = ink_fs_card_hold() == INK_FS_OK; /* on a computer now: the small table until next time */
    int64_t size = held ? hal_fs_size(PY_DICT_PATH) : -1;
    if (size > 0 && size <= DICT_MAX) {
        hal_file_t *f = hal_fs_open(PY_DICT_PATH, HAL_O_READ);
        b = f ? ink_mem_alloc("ime", INK_MEM_PSRAM, (size_t)size) : NULL;
        size_t got = 0;
        while (b && got < (size_t)size) {
            ssize_t r = hal_fs_read(f, b + got, (size_t)size - got);
            if (r <= 0) break;
            got += (size_t)r;
        }
        if (f) hal_fs_close(f);
        ink_fs_card_release();
        held = false;
        if (b && (got != (size_t)size || !dict_ok(b, got))) {
            ink_probe_count("text.dict_bad");
            ink_mem_free(b);
            b = NULL;
        }
    }
    if (held) ink_fs_card_release();
    dict_head_t h = {0};
    if (b) memcpy(&h, b, sizeof h);
    ink_svc_lock();
    PY.loading = false;
    if (b) {
        PY.block = b;
        PY.nkeys = h.nkeys;
        PY.keys = (const dict_key_t *)(b + h.keys_off);
        PY.entries = (const dict_entry_t *)(b + h.entries_off);
        PY.text = (const char *)(b + h.text_off);
    }
    ink_svc_unlock();
    if (b) {
        ink_probe_count("text.dict_loaded");
        ink_exec_post(INK_EXEC_UI, &PY.ready_job, ready_job, NULL);
    }
}

void py_want_dict(void (*ready)(void)) {
    ink_svc_lock();
    bool go = !PY.block && !PY.loading;
    if (go) PY.loading = true;
    PY.ready = ready;
    ink_svc_unlock();
    if (go && ink_exec_post(INK_EXEC_BG, &PY.load_job, load_job, NULL) != 0) {
        ink_svc_lock();
        PY.loading = false;
        ink_svc_unlock();
    }
}

bool py_dict_loaded(void) {
    ink_svc_lock();
    bool b = PY.block != NULL;
    ink_svc_unlock();
    return b;
}

/* -1, 0, 1: the key at i against these letters. */
static int key_cmp(uint32_t i, const char *s, size_t n) {
    const dict_key_t *k = &PY.keys[i];
    size_t m = k->key_len < n ? k->key_len : n;
    int c = memcmp(PY.text + k->text_off, s, m);
    return c ? c : k->key_len < n ? -1 : k->key_len > n ? 1 : 0;
}

int py_lookup(const char *composing, py_cand_t *out, int max) {
    size_t len = strlen(composing);
    int got = 0;
    for (size_t n = len; n > 0 && got < max; n--) {
        if (PY.block) {
            uint32_t lo = 0, hi = PY.nkeys;
            while (lo < hi) {
                uint32_t mid = lo + (hi - lo) / 2;
                int c = key_cmp(mid, composing, n);
                if (c == 0) {
                    const dict_key_t *k = &PY.keys[mid];
                    for (uint32_t e = 0; e < k->count && got < max; e++) {
                        const dict_entry_t *d = &PY.entries[k->first + e];
                        out[got++] = (py_cand_t){.word = PY.text + d->text_off, .word_len = d->word_len, .consumed = (uint8_t)n, .freq = d->freq};
                    }
                    break;
                }
                if (c < 0) lo = mid + 1;
                else hi = mid;
            }
        } else {
            for (size_t i = 0; i < sizeof SMALL / sizeof SMALL[0] && got < max; i++)
                if (strlen(SMALL[i].key) == n && !memcmp(SMALL[i].key, composing, n))
                    out[got++] = (py_cand_t){.word = SMALL[i].word, .word_len = (uint16_t)strlen(SMALL[i].word), .consumed = (uint8_t)n, .freq = SMALL[i].freq};
        }
    }
    return got;
}

static size_t reclaim(void *ctx, size_t want) { /* memory is short: it can be read again */
    (void)ctx;
    (void)want;
    ink_svc_lock();
    void *b = PY.block;
    PY.block = NULL;
    PY.keys = NULL;
    PY.entries = NULL;
    PY.text = NULL;
    PY.nkeys = 0;
    ink_svc_unlock();
    if (!b) return 0;
    size_t n = ink_mem_used("ime", INK_MEM_PSRAM);
    ink_mem_free(b);
    ink_probe_count("text.dict_reclaimed");
    return n;
}

void py_init(void) {
    ink_mem_budget("ime", INK_MEM_PSRAM, DICT_MAX);
    ink_mem_reclaimer("ime-dict", 30, reclaim, NULL);
}
/*
 * The clipboard (see ink/sys/textinput.h): one text in external RAM, never stored. Who reads it is the policy's: the AI
 * only if the member allowed it (default off), and never what was marked sensitive.
 */
#include <stdio.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/cap.h"
#include "ink/sys/settings.h"
#include "ink/sys/state.h"
#include "ink/sys/svc.h"
#include "ink/sys/textinput.h"
#include "text_internal.h"

#define SENSITIVE_US 60000000ull

static struct {
    char text[INK_CLIP_MAX + 1];
    bool sensitive;
    ink_svc_deadline_t expiry;
} CL INK_PSRAM_BSS;

void ink_clip_clear(void) {
    ink_svc_lock();
    CL.text[0] = 0;
    CL.sensitive = false;
    ink_svc_unlock();
    ink_svc_cancel(&CL.expiry);
}

static void expired(void *ctx) { /* the timer task */
    (void)ctx;
    ink_svc_lock();
    bool was = CL.sensitive;
    if (was) {
        CL.text[0] = 0;
        CL.sensitive = false;
    }
    ink_svc_unlock();
    if (was) ink_probe_count("clipboard.sensitive_cleared");
}

int ink_clip_set(const char *text, bool sensitive, uint8_t src) {
    (void)src;
    if (!text || strlen(text) > INK_CLIP_MAX) return -1;
    ink_svc_lock();
    snprintf(CL.text, sizeof CL.text, "%s", text);
    CL.sensitive = sensitive;
    ink_svc_unlock();
    if (sensitive) ink_svc_at(&CL.expiry, osal_now_us() + SENSITIVE_US, expired, NULL);
    else ink_svc_cancel(&CL.expiry);
    return 0;
}

int ink_clip_get(char *out, size_t cap, uint8_t src, bool *sensitive) {
    bool remote = src == INK_SRC_AI || src == INK_SRC_REMOTE;
    bool allowed = !remote || ink_setting_get("ai.read_clipboard");
    ink_svc_lock();
    bool s = CL.sensitive;
    int n = -1;
    if (allowed && !(remote && s)) {
        n = snprintf(out, cap, "%s", CL.text);
        if (n >= (int)cap) n = (int)cap - 1;
    }
    ink_svc_unlock();
    if (sensitive) *sensitive = s;
    if (n < 0) ink_probe_count("clipboard.refused");
    return n;
}

static void on_member(void *ctx, int h, const char *id) { /* DIRECT: at the moment it changes hands */
    (void)ctx;
    (void)h;
    (void)id;
    ink_clip_clear();
}

void clip_init(void) { ink_state_watch("member.current", on_member, NULL, INK_EXEC_DIRECT); }
/*
 * Bluetooth headsets (system services design §10.4): finding, pairing and connecting them, and what follows. Connected, the
 * sound goes to the headset; gone, it comes back to the speaker and media pauses. How the chip does it is not known yet
 * (ink/hal_bt.h): where the HAL says it cannot, these capabilities say so and the speaker stays.
 */
#include <stdio.h>
#include <string.h>

#include "ink/hal_bt.h"
#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/audio.h"
#include "ink/sys/cap.h"
#include "ink/sys/crc.h"
#include "ink/sys/data.h"
#include "ink/sys/json.h"
#include "ink/sys/power.h"
#include "ink/sys/state.h"
#include "ink/sys/svc.h"

#define SCAN_MS 4000
#define MAX_SCAN 8

static const ink_db_def_t DEVICES = {.name = "bt.devices", .title = "配对过的蓝牙耳机", .scope = INK_DB_DEVICE, .schema = 1, .json = true, .ai_read = true, .max_records = 16};

static struct {
    int h_available, h_connected, h_device;
    char current[18];
    ink_exec_job_t lost_job;
} BT INK_PSRAM_BSS;

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static bool usable(ink_call_t *c) {
    if (hal_bt_available()) return true;
    fail(c, INK_RC_FAILED, "this device cannot use a Bluetooth headset yet");
    return false;
}

static uint32_t addr_id(const char *addr) {
    uint32_t id = ink_crc32(0, addr, strlen(addr)) & 0x7fffffff;
    return id ? id : 1;
}

static void told(const char *what) {
    ink_args_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    if (a) {
        ink_args_init(a);
        ink_args_str(a, "what", what);
        ink_cap_emit("bt.changed", a);
        osal_free(a);
    }
}

static void set_connected(const char *addr) {
    bool on = addr && addr[0];
    ink_svc_lock();
    snprintf(BT.current, sizeof BT.current, "%s", on ? addr : "");
    ink_svc_unlock();
    ink_state_set_bool(BT.h_connected, on);
    ink_state_set_str(BT.h_device, on ? addr : "");
    ink_audio_set_route(on ? INK_ROUTE_HEADSET : INK_ROUTE_SPEAKER);
    told(on ? "connected" : "disconnected");
}

static void lost_job(void *arg) { /* exec.bg */
    (void)arg;
    ink_probe_count("bt.lost");
    set_connected(NULL);
}

static void on_link(void *ctx, hal_bt_event_t ev) { /* where the news arrives: an event, maybe */
    (void)ctx;
    if (ev == HAL_BT_EV_LOST) ink_exec_post(INK_EXEC_BG, &BT.lost_job, lost_job, NULL);
}

static void cap_scan(ink_call_t *c) { /* exec.bg */
    if (!usable(c)) return;
    hal_bt_device_t *d = osal_malloc(sizeof *d * MAX_SCAN, OSAL_MEM_EXTERNAL);
    char *out = osal_malloc(1024, OSAL_MEM_EXTERNAL);
    if (!d || !out) fail(c, INK_RC_FAILED, "out of memory");
    else {
        ink_power_hold(INK_NEED_AWAKE);
        int n = hal_bt_scan(d, MAX_SCAN, SCAN_MS);
        ink_power_release(INK_NEED_AWAKE);
        ink_jw_t w;
        ink_jw_init(&w, out, 1024);
        ink_jw_raw(&w, "[");
        for (int i = 0; i < n; i++) {
            ink_jw_raw(&w, i ? ",{\"addr\":" : "{\"addr\":");
            ink_jw_str(&w, d[i].addr);
            ink_jw_raw(&w, ",\"name\":");
            ink_jw_str(&w, d[i].name);
            ink_jw_raw(&w, "}");
        }
        ink_jw_raw(&w, "]");
        if (w.overflow) fail(c, INK_RC_FAILED, "too long");
        else ink_cap_result(c, out);
    }
    osal_free(out);
    osal_free(d);
}

static void cap_list(ink_call_t *c) { /* exec.bg: the list may need reading */
    ink_db_t *db = ink_db_open(&DEVICES, NULL);
    char *out = osal_malloc(2048, OSAL_MEM_EXTERNAL);
    char *buf = osal_malloc(128, OSAL_MEM_EXTERNAL);
    if (!db || !out || !buf) fail(c, INK_RC_FAILED, "out of memory");
    else {
        ink_jw_t w;
        ink_jw_init(&w, out, 2048);
        ink_jw_raw(&w, "[");
        ink_db_cursor_t cur = {0};
        ink_rec_t r;
        bool first = true;
        while (ink_db_next(db, &cur, &r, buf, 127) == 1) {
            buf[r.len < 127 ? r.len : 127] = 0;
            if (!first) ink_jw_raw(&w, ",");
            first = false;
            ink_jw_raw(&w, buf);
        }
        ink_jw_raw(&w, "]");
        if (w.overflow) fail(c, INK_RC_FAILED, "too long");
        else ink_cap_result(c, out);
    }
    osal_free(buf);
    osal_free(out);
    ink_db_close(db);
}

static void cap_pair(ink_call_t *c) { /* exec.bg */
    char addr[18], name[32] = "";
    ink_args_get_str(&c->args, "addr", addr, sizeof addr);
    ink_args_get_str(&c->args, "name", name, sizeof name);
    if (!usable(c)) return;
    ink_power_hold(INK_NEED_AWAKE); /* the chip does not sleep in the middle of it */
    int paired = hal_bt_pair(addr);
    ink_power_release(INK_NEED_AWAKE);
    if (paired != 0) {
        fail(c, INK_RC_FAILED, "it did not pair: is it on and looking?");
        return;
    }
    ink_db_t *db = ink_db_open(&DEVICES, NULL);
    if (db) {
        char buf[96];
        ink_jw_t w;
        ink_jw_init(&w, buf, sizeof buf);
        ink_jw_raw(&w, "{\"addr\":");
        ink_jw_str(&w, addr);
        ink_jw_raw(&w, ",\"name\":");
        ink_jw_str(&w, name);
        ink_jw_raw(&w, "}");
        ink_db_write_t rec = {.id = addr_id(addr), .data = buf, .len = w.len, .src = (uint8_t)c->src};
        if (!w.overflow) ink_db_put(db, &rec, NULL);
        ink_db_close(db);
    }
    told("paired");
}

static void cap_connect(ink_call_t *c) { /* exec.bg */
    char addr[18];
    ink_args_get_str(&c->args, "addr", addr, sizeof addr);
    if (!usable(c)) return;
    ink_power_hold(INK_NEED_AWAKE);
    int linked = hal_bt_connect(addr);
    ink_power_release(INK_NEED_AWAKE);
    if (linked != 0) {
        fail(c, INK_RC_FAILED, "it did not connect: is it on, near and paired?");
        return;
    }
    set_connected(addr);
    snprintf(c->rc.say, sizeof c->rc.say, "耳机连上了");
}

static void cap_disconnect(ink_call_t *c) { /* exec.bg */
    if (!usable(c)) return;
    hal_bt_disconnect();
    set_connected(NULL);
}

static void cap_forget(ink_call_t *c) { /* exec.bg */
    char addr[18];
    ink_args_get_str(&c->args, "addr", addr, sizeof addr);
    if (!usable(c)) return;
    char current[18];
    ink_svc_lock();
    snprintf(current, sizeof current, "%s", BT.current);
    ink_svc_unlock();
    hal_bt_forget(addr);
    if (!strcmp(current, addr)) set_connected(NULL);
    ink_db_t *db = ink_db_open(&DEVICES, NULL);
    if (db) {
        ink_db_del(db, addr_id(addr), (uint8_t)c->src);
        ink_db_close(db);
    }
    told("forgotten");
}

#define ADDR_ARG "{\"type\":\"object\",\"properties\":{\"addr\":{\"type\":\"string\",\"maxLength\":17}},\"required\":[\"addr\"]}"

static const ink_cap_t BT_CAPS[] = {
    {.id = "bt.scan", .title = "找附近的蓝牙耳机（要几秒）", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .timeout_ms = 10000, .exec = INK_EXEC_BG, .run = cap_scan},
    {.id = "bt.list", .title = "配对过的耳机", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .exec = INK_EXEC_BG, .run = cap_list},
    {.id = "bt.pair", .title = "配对一副耳机", .input = "{\"type\":\"object\",\"properties\":{\"addr\":{\"type\":\"string\",\"maxLength\":17},\"name\":{\"type\":\"string\",\"maxLength\":31}},\"required\":[\"addr\"]}",
     .effect = INK_FX_LOCAL_WRITE, .child_ok = true, .timeout_ms = 20000, .exec = INK_EXEC_BG, .run = cap_pair},
    {.id = "bt.connect", .title = "连上耳机，声音走耳机", .input = ADDR_ARG, .effect = INK_FX_NAVIGATE, .child_ok = true, .timeout_ms = 20000, .exec = INK_EXEC_BG, .run = cap_connect},
    {.id = "bt.disconnect", .title = "断开耳机，声音回到外放", .effect = INK_FX_NAVIGATE, .child_ok = true, .exec = INK_EXEC_BG, .run = cap_disconnect},
    {.id = "bt.forget", .title = "忘掉一副耳机", .input = ADDR_ARG, .effect = INK_FX_LOCAL_WRITE, .child_ok = true, .exec = INK_EXEC_BG, .run = cap_forget},
    {.id = "bt.changed", .title = "蓝牙耳机的情况变了", .form = INK_FORM_EVENT, .effect = INK_FX_READ, .child_ok = true},
};

static const ink_state_def_t ST_AVAILABLE = {.id = "bt.available", .type = INK_ST_BOOL, .title = "这台设备能用蓝牙耳机"};
static const ink_state_def_t ST_CONNECTED = {.id = "bt.connected", .type = INK_ST_BOOL, .title = "耳机连着"};
static const ink_state_def_t ST_DEVICE = {.id = "bt.device", .type = INK_ST_STR, .title = "连着的耳机"};

int ink_bt_service_init(void) {
    BT.h_available = ink_state_define(&ST_AVAILABLE);
    BT.h_connected = ink_state_define(&ST_CONNECTED);
    BT.h_device = ink_state_define(&ST_DEVICE);
    ink_state_set_bool(BT.h_available, hal_bt_available());
    ink_state_set_bool(BT.h_connected, false);
    ink_state_set_str(BT.h_device, "");
    hal_bt_on_event(on_link, NULL);
    if (ink_db_register(&DEVICES) != 0) return -1;
    return ink_cap_register(BT_CAPS, (int)(sizeof BT_CAPS / sizeof BT_CAPS[0]));
}


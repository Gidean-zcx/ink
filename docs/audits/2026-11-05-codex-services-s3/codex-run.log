extern const ink_activity_t ink_app_home;
extern const ink_app_def_t ink_appdef_home, ink_appdef_reader;

int ink_system_actions_init(void);
void ink_factory_reset_resume(void);
int ink_reader_actions_init(void);
int ink_remote_init(void);
int ink_ui_lock_mark_init(void);
int ink_shell_interrupt_card_init(void);
int ink_shell_confirm_card_init(void);
int ink_shell_keyboard_init(void);
int ink_bt_service_init(void);
int ink_shell_member_gate_init(void);
int ink_shell_update_card_init(void);
int ink_shell_power_menu_init(void);
int ink_shell_off_picture_init(void);

void ink_main(void) {
    hal_log_write("ink: starting system services");
    if (ink_display_init() != 0) osal_panic("display service failed to start");
    if (ink_storage_init() != 0) osal_panic("storage service failed to start");
    ink_factory_reset_resume();
    if (ink_cap_init() != 0 || ink_exec_init() != 0 || ink_res_init() != 0 || ink_storage_reclaimable() != 0)
        osal_panic("capability bus or resource manager failed to start");
    if (ink_state_init() != 0 || ink_settings_init() != 0) osal_panic("state and settings tables failed to start");
    if (ink_svc_init() != 0 || ink_confirm_init() != 0 || ink_data_init() != 0) osal_panic("data store failed to start");
    if (ink_task_init() != 0) osal_panic("task list failed to start");
    if (ink_power_init() != 0 || ink_file_service_init() != 0) osal_panic("power or file service failed to start");
    ink_members_init();
    if (ink_members_start() != 0) osal_panic("members failed to start");
    if (ink_net_init() != 0 || ink_wifi_init() != 0 || ink_light_init() != 0) osal_panic("network or light settings failed to start");
    if (ink_hub_init("wss://hub.local/v1/device") != 0 || ink_rt_init() != 0) osal_panic("hub link failed to start");
    if (ink_audio_init() != 0) osal_panic("audio service failed to start");
    /* before time: an alarm that is due now goes off as soon as the time service is up */
    if (ink_notify_init() != 0) osal_panic("notification service failed to start");
    if (ink_time_init() != 0) osal_panic("time service failed to start");
    if (ink_text_service_init() != 0) osal_panic("text input failed to start");
    if (ink_media_init() != 0 || ink_bt_service_init() != 0) osal_panic("media or Bluetooth failed to start");
    if (ink_update_init() != 0) osal_panic("system upgrades failed to start");
    hal_device_info_t di;
    hal_device_get_info(&di);
    if (ink_camera_init() != 0 || (di.has_modem && ink_comm_init() != 0)) osal_panic("camera or communication service failed to start");
    if (ink_ai_init() != 0) osal_panic("ai service failed to start");
    if (ink_tools_init() != 0 || ink_system_actions_init() != 0 || ink_reader_actions_init() != 0 || ink_remote_init() != 0)
        osal_panic("action registry failed to start");
    if (ink_apps_init() != 0 || ink_app_register(&ink_appdef_home) != 0 || ink_app_register(&ink_appdef_reader) != 0) osal_panic("app directory failed to start");
    if (ink_ui_start(&ink_app_home) != 0 || ink_ui_lock_mark_init() != 0 || ink_shell_interrupt_card_init() != 0 || ink_shell_confirm_card_init() != 0 || ink_shell_keyboard_init() != 0 || ink_shell_member_gate_init() != 0 || ink_shell_update_card_init() != 0 || ink_shell_power_menu_init() != 0 || ink_shell_off_picture_init() != 0) osal_panic("ui failed to start");
    ink_fs_refresh_state(); /* blocks on the card: here, not in anyone's way */
    ink_data_refresh_state();
    ink_power_battery_policy_start();
    ink_update_boot_check();
    ink_probe_mark("system-started");
}
    osal_free(d);
}

int ink_fs_mkdir(const char *path) {
    char phys[PHYS_MAX];
    int r = fs_resolve(path, true, phys, sizeof phys);
    if (r) return r;
    make_parents(phys);
    if (hal_fs_mkdir(phys) != 0) return card_error();
    changed(path, "created");
    return INK_FS_OK;
}

int ink_fs_remove(const char *path) {
    char phys[PHYS_MAX];
    int r = fs_resolve(path, true, phys, sizeof phys);
    if (r) return r;
    if (hal_fs_size(phys) < 0) return hal_fs_card_present() ? INK_FS_ERR_NOT_FOUND : card_error();
    if (hal_fs_remove(phys) != 0) return card_error();
    changed(path, "removed");
    return INK_FS_OK;
}

int ink_fs_move(const char *from, const char *to) {
    char a[PHYS_MAX], b[PHYS_MAX];
    if (virtual_root(from)) return INK_FS_ERR_DENIED;
    int r = fs_resolve(from, true, a, sizeof a);
    if (!r) r = fs_resolve(to, true, b, sizeof b);
    if (r) return r;
    if (hal_fs_size(a) < 0) return hal_fs_card_present() ? INK_FS_ERR_NOT_FOUND : card_error();
    if (hal_fs_size(b) >= 0) return INK_FS_ERR_EXISTS;
    size_t an = strlen(a);
    if (!strncmp(a, b, an) && b[an] == '/') return INK_FS_ERR_PATH; /* into itself */
    make_parents(b);
    if (hal_fs_rename(a, b) != 0) return card_error();
    changed(from, "moved");
    changed(to, "moved");
    return INK_FS_OK;
}

static void wipe_tree(const char *phys, int depth) {
    if (depth > 8) return;
    char *path = osal_malloc(PHYS_MAX, OSAL_MEM_EXTERNAL);
    hal_dirent_t *e = osal_malloc(sizeof *e, OSAL_MEM_EXTERNAL);
    hal_dir_t *d = path && e ? hal_fs_opendir(phys) : NULL;
    while (d && hal_fs_readdir(d, e) == 1) {
        if (!strcmp(e->name, ".") || !strcmp(e->name, "..")) continue;
        if (snprintf(path, PHYS_MAX, "%s/%s", phys, e->name) >= PHYS_MAX) continue;
        if (e->is_dir) wipe_tree(path, depth + 1);
        hal_fs_remove(path);
    }
    if (d) hal_fs_closedir(d);
    osal_free(path);
    osal_free(e);
}

int ink_fs_wipe_personal(void) {
    if (FS.usb_lent) return INK_FS_ERR_USB;
    if (!hal_fs_card_present()) return INK_FS_ERR_NO_CARD;
    wipe_tree("/content/.m", 0);
    wipe_tree("/content/.update", 0);
    wipe_tree("/cache", 0);
    return INK_FS_OK;
}

int ink_fs_write_atomic(const char *path, const void *data, size_t n) {
    char phys[PHYS_MAX], tmp[PHYS_MAX + 8];
    int r = fs_resolve(path, true, phys, sizeof phys);
    if (r) return r;
    snprintf(tmp, sizeof tmp, "%s" TMP_SUFFIX, phys);
    make_parents(phys);
    hal_file_t *f = hal_fs_open(tmp, HAL_O_WRITE | HAL_O_CREATE | HAL_O_TRUNC);
    if (!f) return card_error();
    ssize_t w = hal_fs_write(f, data, n);
    int c = hal_fs_close(f);
    if (w != (ssize_t)n || c != 0) {
        hal_fs_remove(tmp);
        int e = card_error();
        return e == INK_FS_ERR_IO ? INK_FS_ERR_NO_SPACE : e;
    }
    if (hal_fs_rename(tmp, phys) != 0) {
        hal_fs_remove(tmp);
        return card_error();
    }
    changed(path, "written");
    return INK_FS_OK;
}

int ink_fs_free(uint64_t *free_bytes, uint64_t *total_bytes) {
    if (FS.usb_lent) return INK_FS_ERR_USB;
    hal_fs_volume_info_t vi;
    if (hal_fs_volume_info("/content", &vi) != 0) return card_error();
    if (free_bytes) *free_bytes = vi.free_bytes;
    if (total_bytes) *total_bytes = vi.total_bytes;
    return INK_FS_OK;
}

void ink_fs_refresh_state(void) {
    ink_state_set_str(FS.h_mode, FS.usb_lent ? "usb" : "normal");
    ink_state_set_bool(FS.h_usb, hal_usb_host_connected());
    bool card = hal_fs_card_present();
    ink_state_set_bool(FS.h_card, card);
    uint64_t free_bytes = 0;
    if (card && ink_fs_free(&free_bytes, NULL) == INK_FS_OK) ink_state_set_int(FS.h_free, (int64_t)free_bytes);
}

static void refresh_job(void *arg) {
    (void)arg;
    ink_fs_refresh_state();
}

void fs_refresh_cb(void *arg) { /* timer task: what it does blocks on the card */
    (void)arg;
    ink_exec_post(INK_EXEC_BG, &FS.refresh_job, refresh_job, NULL);
}

/* ------------------------------------------------------------ jobs */

static void job_failed(fjob_t *j, int err) {
    ink_svc_lock();
    j->st.err = err;
    j->st.state = INK_FS_JOB_FAILED;
    ink_svc_unlock();
}

/* Close what the walk holds. */
static void job_release(fjob_t *j) {
    while (j->depth > 0) hal_fs_closedir(j->dirs[--j->depth]);
    if (j->in) hal_fs_close(j->in);
    j->in = NULL;
    if (j->out) {
        hal_fs_close(j->out);
        hal_fs_remove(j->part); /* never half a file under its name */
    }
    j->out = NULL;
    osal_free(j->buf);
    j->buf = NULL;
}

static bool job_push(fjob_t *j, const char *dir) {
    if (j->depth >= JOB_DEPTH) return false;
    hal_dir_t *d = hal_fs_opendir(dir);
    if (!d) return false;
    j->dirs[j->depth++] = d;
    return true;
}


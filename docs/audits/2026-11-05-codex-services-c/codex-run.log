/* ------------------------------------------------------------ hub tools */

typedef struct {
    ink_exec_job_t job;
    int64_t id;
    bool list;
    int cursor;        /* tools/list: the page */
    char domain[16];   /* tools/list: only this domain */
    uint32_t page_gen;
    uint64_t received_us;
    char name[48];
    char rid[RID_CAP]; /* _meta.request_id: a retry gets the first receipt again */
    char args[];       /* JSON object text */
} tool_job_t;

static void tool_done(void *ctx, const ink_receipt_t *rc) { /* where the capability finished */
    tool_job_t *t = ctx;
    char key[48];
    snprintf(key, sizeof key, "tools.calls.%s", ink_rc_name(rc->status));
    ink_probe_count(key);
    const char *prev = osal_mem_tag("tools");
    size_t cap = 768 + (rc->result ? strlen(rc->result) : 0);
    char *out = osal_malloc(cap, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!out || ink_receipt_json(rc, out, cap) < 0) ink_hub_respond_error(t->id, -32603, out ? "receipt too long" : "out of memory");
    else ink_hub_respond(t->id, out);
    osal_free(out);
    osal_free(t);
}

#define TOOLS_PAGE 6144

static void tool_run(void *arg) { /* UI task */
    tool_job_t *t = arg;
    if (t->list) { /* paged (architecture: progressive disclosure): caps.domains and caps.find say what there is */
        const char *prev = osal_mem_tag("tools");
        char *out = osal_malloc(TOOLS_PAGE, OSAL_MEM_EXTERNAL);
        osal_mem_tag(prev);
        int next = -1, n = out ? ink_cap_manifest_page(t->cursor, t->domain[0] ? t->domain : NULL, out + 9, TOOLS_PAGE - 48, &next) : -1;
        if (n < 0) ink_hub_respond_error(t->id, -32603, "out of memory");
        else {
            memcpy(out, "{\"tools\":", 9);
            if (next >= 0) snprintf(out + 9 + n, 48, ",\"nextCursor\":\"%d\"}", next);
            else snprintf(out + 9 + n, 48, "}");
            ink_hub_respond(t->id, out);
        }
        osal_free(out);
        osal_free(t);
        return;
    }
    ink_ui_cause(t->received_us, "ai.tool_to_visible_ms"); /* what the capability changes on screen */
    ink_call_opts_t o = {.src = INK_SRC_AI, .page_gen = t->page_gen, .request_id = t->rid[0] ? t->rid : NULL, .args_json = t->args,
                         .reply_exec = INK_EXEC_DIRECT, .done = tool_done, .ctx = t};
    if (ink_cap_call(t->name, NULL, &o) != 0) {
        ink_hub_respond_error(t->id, -32603, "busy");
        osal_free(t);
    }
}

static void on_tools(void *ctx, int64_t id, const char *method, const ink_json_t *j, int params) { /* hub task */
    (void)ctx;
    bool list = !strcmp(method, "tools/list");
    if (!list && strcmp(method, "tools/call")) {
        ink_hub_respond_error(id, -32601, "unknown tools method");
        return;
    }
    /* a request id is compared whole: one that does not fit, or is not a string, could run a retry again */
    int rid_t = list ? -1 : ink_json_find(j, params, "_meta.request_id");
    if (rid_t >= 0 && (j->tok[rid_t].type != 4 || j->tok[rid_t].end - j->tok[rid_t].start >= RID_CAP)) {
        ink_hub_respond_error(id, -32602, "request_id must be a short string");
        return;
    }
    int args_t = list ? -1 : ink_json_find(j, params, "arguments");
    size_t alen = args_t >= 0 ? (size_t)(j->tok[args_t].end - j->tok[args_t].start) : 0;
    const char *prev = osal_mem_tag("tools");
    tool_job_t *t = osal_calloc(1, sizeof *t + alen + 1, OSAL_MEM_EXTERNAL);
    osal_mem_tag(prev);
    if (!t) {
        ink_hub_respond_error(id, -32603, "out of memory");
        return;
    }
    t->id = id;
    t->list = list;
    t->received_us = osal_now_us();
    if (list) {
        char cursor[16];
        if (ink_json_str(j, ink_json_find(j, params, "cursor"), cursor, sizeof cursor) > 0) t->cursor = atoi(cursor);
        ink_json_str(j, ink_json_find(j, params, "domain"), t->domain, sizeof t->domain);
    }
    if (!list) {
        if (ink_json_str(j, ink_json_find(j, params, "name"), t->name, sizeof t->name) < 0) {
            osal_free(t);
            ink_hub_respond_error(id, -32602, "tools/call needs a name");
            return;
        }
        int64_t pg = 0;
        if (ink_json_int(j, ink_json_find(j, params, "page_gen"), &pg) || ink_json_int(j, ink_json_find(j, params, "_meta.page_gen"), &pg))
            t->page_gen = (uint32_t)pg;
        ink_json_str(j, ink_json_find(j, params, "_meta.request_id"), t->rid, sizeof t->rid);
        if (alen) memcpy(t->args, j->text + j->tok[args_t].start, alen);
        t->args[alen] = 0;
    }
    ink_exec_post(INK_EXEC_UI, &t->job, tool_run, t);
}

/* ------------------------------------------------------------ the hub's directory (step 8) */

static void dir_reply(void *ctx, int status, const ink_json_t *j, int result) { /* hub task */
    (void)ctx;
    if (status != INK_HUB_OK) {
        ink_probe_count("cap.directory_failed");
        return;
    }
    int list = ink_json_find(j, result, "tools");
    if (list < 0 || j->tok[list].type != 2) return;
    remote_cap_t got[DIR_MAX];
    int n = 0, t = list + 1;
    for (int k = 0; k < j->tok[list].size && t < j->ntok && n < DIR_MAX; k++) {
        int end = j->tok[t].end, next = t + 1;
        while (next < j->ntok && j->tok[next].start < end) next++;
        char form[12] = "";
        if (ink_json_str(j, ink_json_find(j, t, "name"), got[n].id, sizeof got[n].id) > 0) {
            ink_json_str(j, ink_json_find(j, t, "form"), form, sizeof form);
            got[n].form = !strcmp(form, "session") ? INK_FORM_SESSION : !strcmp(form, "stream") ? INK_FORM_STREAM : INK_FORM_CALL;
            n++;
        }
        t = next;
    }
    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
    memcpy(CB.dir, got, sizeof got[0] * (size_t)n);
    CB.ndir = n;
    osal_mutex_unlock(CB.lock);
    ink_probe_value("cap.directory_size", n);
}

static void dir_fetch(void *ctx) { /* hub task: on every (re)connection */
    (void)ctx;
    ink_hub_call("caps/list", "{}", 10000000, dir_reply, NULL);
}

static void on_caps_changed(void *ctx, const char *method, const ink_json_t *j, int params) { /* hub task */
    (void)ctx;
    (void)j;
    (void)params;
    if (!strcmp(method, "caps/changed")) dir_fetch(NULL);
}

int ink_tools_init(void) {
    if (ink_hub_on_online(dir_fetch, NULL) || ink_hub_subscribe("caps/", on_caps_changed, NULL)) return -1;
    ink_hub_set_tick(send_events);
    return ink_hub_on_request("tools/", on_tools, NULL);
}
/*
 * The app directory and lifecycle (see ink/sys/appreg.h). The foreground follows the UI's activity stack and the lock:
 * whatever puts a page on top, a button, the AI or a key, the same transitions happen, before the page is built. The
 * table changes in the UI task, under the shared service lock so that other tasks can read it; what apps are told is
 * told outside the lock.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/appreg.h"
#include "ink/sys/cap.h"
#include "ink/sys/exec.h"
#include "ink/sys/json.h"
#include "ink/sys/layout.h"
#include "ink/sys/members.h"
#include "ink/sys/power.h"
#include "ink/sys/res.h"
#include "ink/sys/state.h"
#include "ink/sys/storage.h"
#include "ink/sys/svc.h"
#include "ink/sys/ui.h"

#define MAX_APPS 16
#define FREEZE_AFTER_US 10000000ull
#define LIST_CAP 2048

typedef struct {
    const ink_app_def_t *def;
    ink_app_state_t state;
    uint32_t bg;       /* background work going on */
    uint64_t left_at;  /* when it left the foreground */
    uint64_t last_use;
} app_t;

static struct {
    bool ready;
    app_t a[MAX_APPS];
    int n;
    int fg;            /* in the foreground: index, or -1 */
    char top[32];      /* the app of the page on top: "" for a page of nobody's */
    bool locked;
    char member[INK_MEMBER_ID_MAX]; /* whose data the running apps are using */
    int h_foreground, h_cards_rev;
    int cards_rev;
    ink_svc_deadline_t freeze_at;
    ink_exec_job_t freeze_job, power_job, pressure_job, member_job;
} AP INK_PSRAM_BSS;

const char *ink_app_state_name(ink_app_state_t s) {
    static const char *const N[] = {"stopped", "foreground", "background", "frozen"};
    return (unsigned)s < 4 ? N[s] : "?";
}

static app_t *find(const char *id) {
    for (int i = 0; i < AP.n; i++)
        if (!strcmp(AP.a[i].def->id, id)) return &AP.a[i];
    return NULL;
}

/* The state changes under the lock, and it is told. UI task. */
static void set_state(app_t *a, ink_app_state_t s) {
    ink_svc_lock();
    a->state = s;
    ink_svc_unlock();
    ink_args_t *args = osal_malloc(sizeof *args, OSAL_MEM_EXTERNAL);
    if (args) {
        ink_args_init(args);
        ink_args_str(args, "id", a->def->id);
        ink_args_str(args, "state", ink_app_state_name(s));
        ink_cap_emit("app.state", args);
        osal_free(args);
    }
}

static int state_path(const app_t *a, char *out, size_t cap) {
    char name[48];
    snprintf(name, sizeof name, "%s.state", a->def->id);
    return ink_layout_member(out, cap, AP.member, name);
}

/* What it wants kept goes to the flash in the background; nothing kept, nothing left. A full queue drains in moments: it
 * waits that long. False: it could not be handed over, and what is in the app is the only copy. */
#define SAVE_TRIES 40
#define SAVE_WAIT_US 10000
static bool save(app_t *a) {
    if (!a->def->ops || !a->def->ops->save_state) return true;
    char path[INK_LAYOUT_PATH_MAX];
    void *buf = osal_malloc(INK_APP_STATE_MAX, OSAL_MEM_EXTERNAL);
    if (!buf || state_path(a, path, sizeof path) < 0) {
        osal_free(buf);
        ink_probe_count("app.state_not_saved");
        return false;
    }
    int n = a->def->ops->save_state(buf, INK_APP_STATE_MAX);
    int r = -1;
    for (int i = 0; i < SAVE_TRIES && r != 0; i++) {
        r = n > 0 && n <= INK_APP_STATE_MAX ? ink_storage_write_atomic(path, buf, (size_t)n) : ink_storage_remove(path, NULL, NULL);
        if (r != 0) osal_task_delay_us(SAVE_WAIT_US);
    }
    osal_free(buf);
    if (r != 0) ink_probe_count("app.state_not_saved");
    return r == 0;
}

static void restore(app_t *a) {
    if (!a->def->ops || !a->def->ops->restore_state) return;
    char path[INK_LAYOUT_PATH_MAX];
    void *buf = osal_malloc(INK_APP_STATE_MAX, OSAL_MEM_EXTERNAL);
    if (!buf || state_path(a, path, sizeof path) < 0) {
        osal_free(buf);
        return;
    }
    int n = ink_storage_read(path, buf, INK_APP_STATE_MAX); /* sees what is still queued for it */
    if (n > 0) a->def->ops->restore_state(buf, (size_t)n);
    osal_free(buf);
}

static void freeze(app_t *a) {
    if (!save(a)) { /* the only copy of what it keeps is in it: it stays as it is, and is tried again after the same while */
        a->left_at = osal_now_us();
        return;
    }
    if (a->def->ops && a->def->ops->on_freeze) a->def->ops->on_freeze();
    set_state(a, INK_APP_FROZEN);
    ink_probe_count("app.frozen");
}

/* It has saved. */
static void stop_saved(app_t *a) {
    if (a->state == INK_APP_STOPPED) return;
    if (a->def->ops && a->def->ops->on_stop) a->def->ops->on_stop();
    ink_svc_lock();
    a->bg = 0;
    ink_svc_unlock();
    set_state(a, INK_APP_STOPPED);
    ink_probe_count("app.stopped");
}

/* From the background or frozen (what was frozen has saved already). When memory says so it goes, saved or not. */
static void stop(app_t *a) {
    if (a->state == INK_APP_STOPPED) return;
    if (a->state != INK_APP_FROZEN) save(a);
    stop_saved(a);
}

static void freeze_due(void *arg);

static void plan_freeze(void) { /* UI task */
    uint64_t next = 0;
    for (int i = 0; i < AP.n; i++) {
        const app_t *a = &AP.a[i];
        if (a->state == INK_APP_BACKGROUND && !a->bg && (!next || a->left_at + FREEZE_AFTER_US < next)) next = a->left_at + FREEZE_AFTER_US;
    }
    if (next) ink_svc_at(&AP.freeze_at, next, freeze_due, NULL);
    else ink_svc_cancel(&AP.freeze_at);
}

static void freeze_job(void *arg) { /* UI task */
    (void)arg;
    uint64_t now = osal_now_us();
    for (int i = 0; i < AP.n; i++) {
        app_t *a = &AP.a[i];
        if (a->state == INK_APP_BACKGROUND && !a->bg && now >= a->left_at + FREEZE_AFTER_US) freeze(a);
    }
    plan_freeze();
}

static void freeze_due(void *arg) { /* the timer task */
    (void)arg;
    ink_exec_post(INK_EXEC_UI, &AP.freeze_job, freeze_job, NULL);
}

/* What should be in the foreground now: the app of the page on top, unless the device is locked. UI task. */
static void sync_foreground(void) {
    app_t *want = AP.locked || !AP.top[0] ? NULL : find(AP.top);
    app_t *was = AP.fg >= 0 ? &AP.a[AP.fg] : NULL;
    if (want == was) return;
    uint64_t now = osal_now_us();
    if (was) {
        was->left_at = now;
        was->last_use = now;
        if (was->def->ops && was->def->ops->on_background) was->def->ops->on_background();
        set_state(was, INK_APP_BACKGROUND);
    }
    ink_svc_lock();
    AP.fg = want ? (int)(want - AP.a) : -1;
    ink_svc_unlock();
    if (want) {
        const ink_app_ops_t *ops = want->def->ops;
        if (want->state == INK_APP_STOPPED) {
            if (ops && ops->on_start) ops->on_start();
            restore(want);
int ink_ui_snapshot(char *buf, size_t cap, const char **activity_name) {
    if (UI.noverlays) {
        const ink_ui_overlay_t *o = UI.overlays[UI.noverlays - 1];
        if (activity_name) *activity_name = o->name;
        if (o->snapshot && cap) return o->snapshot(buf, cap);
        if (cap) buf[0] = 0;
        return 0;
    }
    const ink_activity_t *top = UI.depth ? UI.stack[UI.depth - 1].a : NULL;
    if (activity_name) *activity_name = top ? top->name : "";
    if (!top || !top->snapshot || !cap) {
        if (cap) buf[0] = 0;
        return 0;
    }
    return top->snapshot(buf, cap);
}

void ink_ui_hint_frame(ink_refresh_t intent) {
    if (intent > UI.frame_intent) UI.frame_intent = intent;
}

/* --------------------------------------------------------------- styles */

static void styles_init(void) {
    lv_style_init(&UI.st_screen);
    lv_style_set_bg_color(&UI.st_screen, lv_color_white());
void ink_ui_restart(void (*between)(void)) {
    if (UI.depth && UI.stack[UI.depth - 1].a->destroy) UI.stack[UI.depth - 1].a->destroy();
    if (UI.depth) UI.depth = 1;
    if (between) between();
    if (UI.depth) show_top();
}

bool ink_ui_full(void) { return UI.depth >= MAX_ACTIVITIES; }

void ink_ui_set_top_hook(void (*fn)(const char *app)) { UI.top_hook = fn; }

static bool of_app(const frame_t *f, const char *app) { return f->a->app && !strcmp(f->a->app, app); }

bool ink_ui_bring_up(const char *app) {
    int at = -1;
    for (int i = UI.depth - 1; i >= 0 && at < 0; i--)
        if (of_app(&UI.stack[i], app)) at = i;
    if (at < 0) return false;
    if (at == UI.depth - 1) return true;
    if (UI.stack[UI.depth - 1].a->destroy) UI.stack[UI.depth - 1].a->destroy();
                CF.held[i].used = false;
                token = CF.held[i].token;
                cap = CF.held[i].cap->id;
                snprintf(who, sizeof who, "%s", CF.held[i].member);
            }
        ink_svc_unlock();
        if (!token) return;
        changed();
        tell(token, cap, "member_changed", NULL, who);
    }
}

static void on_screen_changed(void *ctx, int h, const char *id) { /* with nothing waiting nothing is on screen: the UI sleeps on */
    (void)ctx;
    (void)h;
    (void)id;
    bool any = false;
    ink_svc_lock();
    for (int i = 0; i < MAX_HELD; i++) any = any || CF.held[i].used;
    ink_svc_unlock();
    if (any) present();
}

/* ---- on the bus ---- */

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static void cap_list(ink_call_t *c) {
    static const char *const SRC[] = {"touch", "key", "ai", "system", "app", "remote", "confirmed"};
    char *out = osal_malloc(LIST_CAP, OSAL_MEM_EXTERNAL);
    ink_confirm_view_t *v = osal_malloc(sizeof *v * MAX_HELD, OSAL_MEM_EXTERNAL);
    if (!out || !v) {
        fail(c, INK_RC_FAILED, "out of memory");
    } else {
        int n = ink_confirm_list(v, MAX_HELD);
        uint64_t now = osal_now_us();
        ink_jw_t w;
        ink_jw_init(&w, out, LIST_CAP);
        ink_jw_raw(&w, "[");
        for (int i = 0; i < n; i++) {
            ink_jw_raw(&w, i ? ",{\"token\":" : "{\"token\":");
            ink_jw_int(&w, v[i].token);
            ink_jw_raw(&w, ",\"cap\":");
            ink_jw_str(&w, v[i].cap);
            ink_jw_raw(&w, ",\"title\":");
            ink_jw_str(&w, v[i].title);
            ink_jw_raw(&w, ",\"detail\":");
            ink_jw_str(&w, v[i].detail);
            ink_jw_raw(&w, ",\"asked_by\":");
            ink_jw_str(&w, SRC[v[i].src]);
            ink_jw_raw(&w, ",\"expires_in_s\":");
            ink_jw_int(&w, v[i].expires_us > now ? (int64_t)((v[i].expires_us - now) / 1000000) : 0);
            ink_jw_raw(&w, "}");
        }
        ink_jw_raw(&w, "]");
        if (w.overflow) fail(c, INK_RC_FAILED, "too long");
        else ink_cap_result(c, out);
    }
    osal_free(v);
    osal_free(out);
}

static void cap_withdraw(ink_call_t *c) {
    int64_t token = 0;
    ink_args_get_int(&c->args, "token", &token);
    if (ink_confirm_withdraw((uint32_t)token, c->src) != 0) fail(c, INK_RC_FAILED, "not waiting, or someone else's");
}

static void cap_accept(ink_call_t *c) {
    int64_t token = 0;
    ink_args_get_int(&c->args, "token", &token);
    if (ink_confirm_decide((uint32_t)token, true, c->src) != 0) fail(c, INK_RC_FAILED, "not waiting any more");
}

static void cap_reject(ink_call_t *c) {
    int64_t token = 0;
    ink_args_get_int(&c->args, "token", &token);
    if (ink_confirm_decide((uint32_t)token, false, c->src) != 0) fail(c, INK_RC_FAILED, "not waiting any more");
}

#define TOKEN_ARG "{\"type\":\"object\",\"properties\":{\"token\":{\"type\":\"integer\",\"minimum\":1}},\"required\":[\"token\"]}"

static const ink_cap_t CONFIRM_CAPS[] = {
    {.id = "confirm.list", .title = "有什么在等人确认", .output = "{\"type\":\"array\"}", .effect = INK_FX_READ, .child_ok = true, .exec = INK_EXEC_DIRECT, .run = cap_list},
    {.id = "confirm.withdraw", .title = "撤回自己发起、还在等确认的请求", .input = TOKEN_ARG, .effect = INK_FX_NAVIGATE, .child_ok = true, .exec = INK_EXEC_DIRECT, .run = cap_withdraw},
    {.id = "confirm.accept", .title = "确认（只有人在设备上能按）", .input = TOKEN_ARG, .effect = INK_FX_NAVIGATE, .child_ok = true, .expose = INK_EXPOSE_OWNER, .exec = INK_EXEC_DIRECT, .run = cap_accept},
    {.id = "confirm.reject", .title = "取消（只有人在设备上能按）", .input = TOKEN_ARG, .effect = INK_FX_NAVIGATE, .child_ok = true, .expose = INK_EXPOSE_OWNER, .exec = INK_EXEC_DIRECT, .run = cap_reject},
    {.id = "confirm.result", .title = "一个待确认的请求结束了（accepted、rejected、expired、withdrawn、member_changed，确认后还有回执）", .form = INK_FORM_EVENT, .effect = INK_FX_READ, .child_ok = true},
};

static const ink_state_def_t ST_PENDING = {.id = "confirm.pending", .type = INK_ST_INT, .title = "等人确认的请求数"};

int ink_confirm_init(void) {
    CF.h_pending = ink_state_define(&ST_PENDING);
    ink_state_set_int(CF.h_pending, 0);
    if (ink_cap_register(CONFIRM_CAPS, (int)(sizeof CONFIRM_CAPS / sizeof CONFIRM_CAPS[0])) != 0) return -1;
    if (ink_state_watch("member.current", on_member, NULL, INK_EXEC_DIRECT) != 0 || ink_state_watch("power.state", on_screen_changed, NULL, INK_EXEC_DIRECT) != 0 ||
        ink_state_watch("interrupt.active", on_screen_changed, NULL, INK_EXEC_DIRECT) != 0)
        return -1;
    CF.ready = true;
    return 0;
}


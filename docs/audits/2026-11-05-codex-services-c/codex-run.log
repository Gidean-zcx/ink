/*
 * Hands-free listening (D-52), on the whole product with the voice front end modelled: the three settings of voice.handsfree,
 * what listening while locked costs (the chip stays up), and who the wake word gets through to. The front end's words and timing
 * are estimates (detailed design §13). Results are the probe counters "test.pass" / "test.fail", as in systest.c.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "ink/sys/confirm.h"
#include "ink/sys/hub.h"
#include "ink/sys/settings.h"

#define ink_main product_main
#include "../../system/boot/main.c"
#undef ink_main

#include "whole_product.h"

enum { SCREEN_ON = 0, ALWAYS = 1, OFF = 2 };

static void mic_event(void *arg) { sim_audio_mic_source(arg); }

static void mic(const char *what) {
    vtk_event_at(vtk_now() + SIM_MS(1), mic_event, (void *)what);
    delay_ms(5);
}

static bool listening(void) {
    int64_t v = 0;
    ink_state_get_int(ink_state_find("audio.listening"), &v);
    return v != 0;
}

static void set_mode(int mode) {
    ink_receipt_t rc;
    CHECK(ink_setting_set("voice.handsfree", mode, INK_SRC_TOUCH, &rc) == INK_RC_DONE, "setting %d (%s)", mode, rc.detail);
    delay_ms(100);
}

/* The wake word, a question and the end of it. */
static void say_something(void) {
    mic("wake");
    delay_ms(700);
    mic("speech");
    delay_ms(1500);
    mic("silence");
    delay_ms(1500);
}

static const char *mic_state(void) {
    static char s[16];
    s[0] = 0;
    ink_state_get_str(ink_state_find("audio.mic"), s, sizeof s);
    return s;
}

static double wakes(void) { return sim_metric_value("ai.wakes"); }
static double questions(void) { return sim_metric_value("hub.requests.ai.listen"); }

static void lock(void) {
    ink_power_lock();
    CHECK(WAIT_FOR(!strcmp(power_state(), "locked"), 2000), "locked (%s)", power_state());
}

static void unlock(void) {
    ink_power_unlock(osal_now_us());
    CHECK(WAIT_FOR(strcmp(power_state(), "locked") != 0, 70000), "unlocked (%s)", power_state());
    ink_power_activity(osal_now_us());
}

static volatile int g_pin_done, g_pin_result;
static void pin_told(void *ctx, int result, uint32_t wait_s) {
    (void)ctx;
    (void)wait_s;
    g_pin_result = result;
    g_pin_done++;
}

static void test_task(void *arg) {
    (void)arg;
    delay_ms(1500);
    ink_hub_demand();
    CHECK(WAIT_FOR(ink_hub_online(), 30000), "online");

    /* by default: while the screen is on and unlocked */
    CHECK(listening(), "it listens from the start");
    CHECK(!strcmp(mic_state(), "local"), "on the device only, the microphone says (%s)", mic_state());
    double was = wakes(), asked = questions();
    say_something();
    CHECK(wakes() == was + 1 && questions() >= asked + 1, "the wake word starts a turn (%.0f, %.0f)", wakes() - was, questions() - asked);
    delay_ms(12000);
    lock();
    CHECK(WAIT_FOR(!listening(), 2000), "locked: it stops");
    int sleeps = sim_power_sleeps();
    delay_ms(70000);
    CHECK(sim_power_sleeps() > sleeps, "and the chip sleeps");
    unlock();
    CHECK(WAIT_FOR(listening(), 2000), "and listens again when unlocked");

    /* always: the chip stays up for it */
    set_mode(ALWAYS);
    lock();
    delay_ms(2000);
    CHECK(listening(), "always: locked too");
    sleeps = sim_power_sleeps();
    double tries = sim_metric_value("power.sleep_refused");
    delay_ms(70000);
    CHECK(sim_power_sleeps() == sleeps && !strcmp(power_state(), "locked"), "the chip stays up, the screen locked (%d, %s)", sim_power_sleeps() - sleeps, power_state());
    CHECK(sim_metric_value("power.sleep_refused") == tries, "because it was asked to, not because it keeps trying and failing (%.0f)", sim_metric_value("power.sleep_refused") - tries);
    was = wakes();
    asked = questions();
    say_something();
    CHECK(wakes() == was + 1 && questions() >= asked + 1, "the wake word works on a locked device (%.0f, %.0f)", wakes() - was, questions() - asked);
    delay_ms(12000);
    CHECK(listening(), "and it goes on listening");
    unlock();

    /* off: nothing listens, nothing wakes */
    set_mode(OFF);
    CHECK(WAIT_FOR(!listening(), 2000), "off: not even unlocked");
    CHECK(WAIT_FOR(!strcmp(mic_state(), "off"), 200), "the microphone is off (%s)", mic_state());
    was = wakes();
    say_something();
    CHECK(wakes() == was, "the wake word means nothing (%.0f)", wakes() - was);
    set_mode(ALWAYS);
    CHECK(WAIT_FOR(listening(), 2000), "and on again");

    /* it does not get past a card that is asking something */
    CHECK(AI("notify.clear", NULL) && g_rc.status == INK_RC_PENDING_CONFIRMATION, "a card asks");
    unsigned token = 0;
    sscanf(g_rc.object, "confirm:%u", &token);
    delay_ms(1000);
    was = wakes();
    asked = questions();
    double refused = sim_metric_value("ai.wake_not_now");
    say_something();
    CHECK(wakes() == was && questions() == asked && sim_metric_value("ai.wake_not_now") > refused, "the wake word waits for it (%.0f, %.0f)", wakes() - was, questions() - asked);
    CHECK(ink_confirm_decide(token, false, INK_SRC_TOUCH) == 0, "answered");
    delay_ms(1500);
    was = wakes();
    say_something();
    CHECK(wakes() == was + 1, "then it works again");
    delay_ms(12000);

static void noboot3(void) { /* a boot with it: before anything could read it */
    CHECK(sim_metric_value("system.factory_reset_card_at_boot") == 1, "cleared at the boot, before anything could read it");
    CHECK(sim_metric_value("system.factory_reset_card_done") == 1, "and the person is told");
    delay_ms(500);
    nocard_card_clean();
    ink_probe_count("test.finished");
}

/* The family's table is there and cannot be read (AUD16-001): nobody gets in as a default adult without a PIN. INK_TEST_TABLE_FAILS. */
static void table1(void) {
    CHECK(set_pin("owner", NULL, "1234") == INK_PIN_OK, "a PIN");
    ink_db_flush_all();
    CHECK(WAIT_FOR(ink_db_idle() && !ink_storage_pending(), 6000), "stored");
    ink_probe_count("test.finished");
}

static void table2(void) { /* two reads fail: the boot's and the first try */
    CHECK(sim_metric_value("members.table_unread") >= 1, "the boot could not read it");
    CHECK(ink_member_has_pin("owner") && ink_member_any_pin(), "so an adult may have a PIN");
    CHECK(!ink_member_space_open(), "the space is closed");
    CHECK(AI("file.list", "{\"path\":\"/me\"}") && g_rc.status == INK_RC_REJECTED, "the AI does not get in (%s)", ink_rc_name(g_rc.status));
    CHECK(ink_member_switch("owner") == -2, "no way in without the PIN");
    CHECK(ink_member_switch("kid") == 0 && ink_member_switch("owner") == -2, "nor by going round through a child");
    ink_member_test_reset();
    CHECK(unlock("owner", "1234") == INK_PIN_WAIT, "it cannot tell yet, so it asks to wait");
    CHECK(!ink_member_space_open(), "still closed");
    ink_probe_count("test.finished"); /* the next try can read it: everything starts over (AUD17-003) */
    int d = g_pin_done;
    CHECK(ink_member_unlock("owner", "1234", pin_told, NULL) == 0, "again");
    for (int i = 0; i < 400; i++) { /* until the power goes: nothing opens meanwhile */
        CHECK(!ink_member_space_open() && g_pin_done == d, "nothing opens, nothing is decided (%d)", g_pin_done - d);
        delay_ms(10);
    }
    CHECK(0, "it should have restarted");
}

/* The card says no to being cleared (AUD17-002): it is not called done, and it stays to do. */
static void stuck2(void) {
    ink_fs_stat_t st;
    CHECK(!ink_member_has_pin("owner"), "the flash is clean");
    CHECK(ink_storage_size("/user/sys/reset.card") >= 0, "the card's part waits");
    CHECK(sim_metric_value("system.factory_reset_card_at_boot") == 0, "not called done");
    CHECK(ink_fs_stat("/me/mine.txt", &st) == 0 || hal_fs_size("/content/.m/owner/stuck/left.txt") > 0, "what could not go is still there");
    delay_ms(6000);
    CHECK(ink_storage_size("/user/sys/reset.card") >= 0, "it keeps looking");
    ink_probe_count("test.finished");
}

static void stuck3(void) {
    CHECK(sim_metric_value("system.factory_reset_card_at_boot") == 1, "now it can");
    CHECK(hal_fs_size("/content/.m/owner/stuck/left.txt") < 0, "and it is gone");
    CHECK(ink_storage_size("/user/sys/reset.card") < 0, "nothing waits");
    ink_probe_count("test.finished");
}

static void stuck1(void) {
    CHECK(ink_fs_write_atomic("/me/stuck/left.txt", "mine", 4) == 0, "a file");
    reset1();
}

static void table3(void) { /* a normal boot: the table as it was */
    CHECK(sim_metric_value("members.table_unread") == 0, "read");
    CHECK(ink_member_has_pin("owner") && !ink_member_space_open(), "the PIN is still there");
    CHECK(unlock("owner", "1234") == INK_PIN_OK, "and it is the same one");
    ink_probe_count("test.finished");
}

static void test_task(void *arg) {
    (void)arg;
    delay_ms(1500);
    const char *phase = getenv("INK_PEOPLE_PHASE");
    if (phase && !strcmp(phase, "reset1")) reset1();
    else if (phase && !strcmp(phase, "reset2")) reset2();
    else if (phase && !strcmp(phase, "stuck1")) stuck1();
    else if (phase && !strcmp(phase, "stuck2")) stuck2();
    else if (phase && !strcmp(phase, "stuck3")) stuck3();
    else if (phase && !strcmp(phase, "nocard1")) nocard1();
    else if (phase && !strcmp(phase, "nocard2")) nocard2();
    else if (phase && !strcmp(phase, "nocard3")) nocard3();
    else if (phase && !strcmp(phase, "noboot2")) noboot2();
    else if (phase && !strcmp(phase, "noboot3")) noboot3();
    else if (phase && !strcmp(phase, "table1")) table1();
    else if (phase && !strcmp(phase, "table2")) table2();
    else if (phase && !strcmp(phase, "table3")) table3();
    else {
        wifi();
        members_and_pin();
        add_and_remove();
        reboot_keeps();
        ink_probe_count("test.finished");
    }
}

void ink_main(void) {
    product_main();
    osal_task_cfg_t cfg = {.name = "peopletest", .fn = test_task, .stack_bytes = 16384, .priority = OSAL_PRIO_NORMAL, .core = -1, .flags = OSAL_TASK_STACK_EXTERNAL};
    if (osal_task_create(&cfg, NULL) != OSAL_OK) osal_panic("test task");
}
/*
 * The data store unchanged, with the family's table not readable the first few times (tests/integration/people.c, INK_TEST_TABLE_FAILS).
 */
#include <stdlib.h>
#include <string.h>

#include "ink/sys/storage.h"

static int load_for_test(const char *path, void **out, size_t *len);
#define ink_storage_load load_for_test
#include "../../system/services/data/datastore.c"
#undef ink_storage_load

static int load_for_test(const char *path, void **out, size_t *len) {
    static int failed;
    const char *fails = getenv("INK_TEST_TABLE_FAILS");
    if (fails && strstr(path, "member.table") && strstr(path, ".log") && failed < atoi(fails)) {
        failed++;
        *out = NULL;
        *len = 0;
        return INK_STORAGE_LOAD_FAILED;
    }
    return ink_storage_load(path, out, len);
}
## 9. 文本输入和剪贴板

### 9.1 输入会话

```c
typedef struct { ink_text_type_t type; ink_text_enter_t enter; const char *initial, *hint; size_t max; bool ai_hidden; } ink_text_cfg_t;
int  ink_text_focus(const ink_text_cfg_t *cfg, const ink_text_client_t *client, void *ctx); /* 界面任务 */
void ink_text_blur(int session);
/* 键盘（或测试）喂进来 */
void ink_text_key(char c); void ink_text_backspace(void); void ink_text_pick(int index); void ink_text_enter(void); void ink_text_commit_utf8(const char *s);
/* 读 */
const char *ink_text_value(void), *ink_text_composing(void); int ink_text_candidates(int first, ink_text_cand_t *out, int max);
```

- 一个时刻一个会话。类型：普通、数字、电话、密码（不进候选、不学词、对 AI 掩码、不能复制）。
- 流程：字母进组合串 → 查候选 → 选中提交一部分，剩下的继续组合。回车键的动作由类型决定（完成、发送、搜索、下一个）。
- 文本框控件 `ink_textfield_create()`（`system/ui/textfield.c`，LVGL 占位）：焦点、组合串、光标、长按菜单（复制、粘贴、问 AI）；键盘面板 `system/ui/shell/keyboard.c` 是系统浮层，候选条用快刷（底座设计 §4.8）。
- 按键完整排队，不因为刷新忙丢键。

### 9.2 拼音引擎

- 全拼（首版）。词库是一个文件 `/content/.system/ime/base.ikd`：头 + 按拼音排序的键表 + 词表（词、频率），第一次开键盘时读进 PSRAM（目标 ≤ 1 MiB），登记为可回收；没卡时退到内置的很小的单字表。
- 查询：取组合串，从最长的前缀往短找完全匹配的键，同长度按“用户频率 + 词库频率”排。选中一个候选消耗对应的字母。不做拼音切分：数据本身决定（`xian` 既是“先”也是“西安”）。
- 用户词频：成员集合 `text.user_freq`，选中时 `INK_DB_LAZY` 更新；密码框不学。
- 词库来源（D-70）：工具 `tools/imedict` 从制表文本生成；仓库里放一份测试和模拟器够用的小词表，正式词库的来源和许可等决定。
- AI 联想（R-027）：不在这一轮做，接口也没留（等要做时按软总线能力加）。

### 9.3 剪贴板

```c
int ink_clip_set(const char *text, bool sensitive, uint8_t src);
int ink_clip_get(char *out, size_t cap, uint8_t src, bool *sensitive);
void ink_clip_clear(void);
```

一条文本（最多 4 KiB，PSRAM），不落盘；换成员清空；敏感内容 60 s 后自动清。AI 读要过策略：设置 `ai.read_clipboard` 默认关，关着就“被拒绝”；敏感内容永远不给 AI。

### 9.4 给 AI 的能力

`text.state`（有没有焦点、类型、内容；密码掩码）、`text.insert {text}`（往焦点框里写，等于替用户打字）、`text.submit`（等于按回车）；`clipboard.read`、`clipboard.write`。这样“帮我把这段填到搜索框”不用模拟按键。语音输入见 §9.5。

### 9.4.1 编辑：光标、选区、撤销（界面规范 `ImeEdit`）

都按字符算（一个汉字算一个），标签和 AI 也是这么数的。

```c
size_t ink_text_cursor(void);
void ink_text_selection(size_t *start, size_t *end); /* start == end：没选中 */
void ink_text_set_cursor(size_t at);                 /* 超过末尾就是末尾 */
void ink_text_select(size_t start, size_t end);
void ink_text_select_word(size_t at);
void ink_text_move(int chars, bool end);             /* 没选中：移光标；选中了：移选区的尾或头 */
int  ink_text_selected(char *out, size_t cap);       /* 密码回 -1 */
bool ink_text_undo(void);
bool ink_text_redo(void);
```

- **键盘、候选、语音、粘贴都写在光标处**，选中的被替换；退格删光标前一个字或者选中的全部。动光标时正在拼的字母先按原样进去。
- **电子纸上不拖动**：点一下放光标，长按选一个词，◀ ▶ 调（占位外观：`system/ui/textfield.c` 长按出菜单，选区用方括号、光标用竖线标在文字里，光标在末尾时不标；长文字从光标往前 30 个字开始显示）。
- **什么算一个词**：连在一起的字母和数字；中文现在只是两个字（最常见的词长），没有分词表。要准得等词库能反查。
- **撤销**：记整段文字的快照，最近 16 步，PSRAM，随输入会话走。连着打的键算一步（中间停 3 s、动过光标就算新的一步）；提交的一段文字（语音、粘贴、AI 写的）单独一步；退格连着算一步。撤销后再改就不能重做。**密码不留历史**，选中的内容也拿不出来。结束会话时擦掉。
- **给 AI**：`text.select {start, end?}`（不给 `end` 就是放光标）、`text.undo`、`text.redo`；`text.state` 带 `cursor`、`selection_start`、`selection_end`、`can_undo`、`can_redo`。`ai_hidden` 的框和密码框 AI 碰不到。

### 9.5 语音输入（听写，R-056、D-65）

文字来自中枢（`asr.stream`，[中枢协议 §3.11](https://github.com/Gidean-zcx/ink/blob/claude/hub-design-8fd433/docs/hub/device-protocol.md)，在分支 `claude/hub-design-8fd433` 上）：设备自己只有命令词识别，没有中枢就没有听写，这一点要告诉用户。代码在 `system/services/text/voice_input.c`，面板在 `system/ui/shell/keyboard.c`。

```c
typedef enum { INK_VOICE_IDLE, INK_VOICE_CONNECTING, INK_VOICE_LISTENING, INK_VOICE_FINISHING } ink_voice_state_t;
bool ink_text_voice_possible(void);      /* 有话筒键吗 */
int  ink_text_voice_start(void);         /* 0；-1 时 ink_text_voice_notice() 说为什么 */
void ink_text_voice_finish(void);        /* 说完了 */
void ink_text_voice_cancel(void);        /* 用键盘：什么都不写进去 */
const char *ink_text_voice_heard(void);  /* 听到的末尾，给面板的固定小区域 */
```

- **界面**：候选条右端黑色话筒键；点了键盘区换成同样大小的语音面板（占位外观）：一行状态、固定一小块显示听到的字（快速黑白刷新，中枢按 `interim_ms` 800 节流）、“说完了”“用键盘”。字说完才进输入框，之后和打的字一样能改。键上的提示留到下一次按键。
- **有没有话筒键**：不是密码框、有麦克风；联网时还要中枢目录里有 `asr.stream`（`ink_cap_available`，这位成员不允许就没有键）。没网时键还在，点了才说为什么。
- **一路流程**：点键：取音频焦点（语音档，媒体暂停、朗读停）、预连中枢、开实时会话、开麦克风，**从这时起就开始听**，会话没确认前的帧先留着（最多 3 s），确认后一起发。结果（`rt.asr`，同一个 `seg` 后来的替换前面的）只进面板。说完（停顿或点“说完了”）：关麦克风，等采集结束的回调再发 `rt.turn end`，等 `rt.asr.done` 才把定稿的字写进输入框，关会话。一路最长由中枢定（120 s）。
- **停顿怎么判断**：看每帧的音量（`ink_audio_capture_level`，每帧取 240 个样本的平均绝对值），高于 300 算有声音；有过声音后 1.5 s 没声音就算说完；一直没声音 8 s 也结束，中枢回 0 句，提示“没听清”。阈值是估计，要实机校准（§14.2）。没有用语音前端，因为现在没有档案声明有它（详细设计 §13 第 6 步）；吵的环境可能一直不结束，这时靠“说完了”或中枢的 120 s。
- **结束和字的去向**（界面规范 §7.5、§8：半句不丢，通话声音不进听写。这比最初的说法改了：来电、闹钟和 AI 键原来是丢弃）：

| 情况 | 字 | 提示 |
| --- | --- | --- |
| 说完，中枢 `rt.asr.done` | 听到的进输入框 | 一句都没有：“没听清” |
| 来电、闹钟、按 AI 键 | 麦克风立刻停，已经说的还发给中枢，回来的字进输入框，半句也留着 | “接着说”（话筒键在，点了接着说，字接在后面）；事件 `how` 是 `interrupted` |
| 点“用键盘”、切页面（输入会话结束）、锁屏、换成员 | **都丢掉**，`rt.close` 等于告诉中枢取消。这几种是人自己要走或者换人了 | — |
| 中枢 `rt.asr.error`（`budget`、`not_allowed`、`too_long`、`vendor`、`timeout`） | 听到的留下，半句也留着 | “今天的额度用完了，用键盘吧”等 |
| 中枢拒绝或关掉会话 | 同上 | “语音输入暂时用不了” |
| 断线、6 s 连不上 | 同上 | “现在连不上，用键盘吧” |
| 说完后 8 s 没有结果 | 同上 | “语音输入暂时用不了” |

- **断线**：不续传。发现断线（200 ms 看一次，或者同一路第二次收到“会话确认”，那说明已经是新连接）就关会话退回键盘。设备发现之前如果又连上了，`on_online` 会把会话重新登记一次，第二次确认就是用来发现这种情况的。
- **麦克风只有一个**：录音时不能听写（“正在录音，先停了再说”）；AI 正在听时不能听写；听写时录音失败；听写时**免按键的唤醒词和打断都不生效**（`listen_job` 查状态）；按 AI 键：听写算被打断（上表），等麦克风空出来（最多 200 ms），AI 这一轮照常。AI 键仍然只叫 AI。
- **数字框**：`kind` 发 `number`，写进去之前只留数字框收的字符。**密码框**：没有话筒键，`ink_text_voice_start` 和 `text.voice_start` 都拒绝。
- **孩子**：可以用（中枢设计 §5.3.1：它只是打字；D-25 不限制通信），家长要关就在中枢那边，目录里没有就没有键。
- **给 AI**：`text.voice_start`（副作用按外部算，走确认卡，声音会发给中枢）、`text.voice_finish`、`text.voice_cancel`；`text.state` 带 `voice`、`voice_possible`、`heard`（`ai_hidden` 的框不给）；状态 `text.voice`；事件 `text.voice_ended {how, why}`。标了 `ai_hidden` 的框 AI 不能开。
- **没做的**：麦克风开着时状态栏的标记归系统壳（状态 `audio.mic`，§10.3）；口语整理（中枢以后做）。

### 12.7 给 AI 的能力

`update.status`、`update.check`、`update.download` 给 AI（它可以提醒“有新版本”“我帮你下好了”）；`system.upgrade`、`system.upgrade_from_card` 不给：标了 `INK_EXPOSE_OWNER`，清单里没有；策略关口还有一条规则，名字带 upgrade 的 AI 一律拒绝（底座设计 §6.2）。人来也要过确认卡（`ask_by_hand`）。

## 13. 其余缺项

详细设计 §13 里和这些相关的：

| 缺项 | 处理 |
| --- | --- |
| `storage.free` | §4 |
| `time.zone`、闹钟提醒 | §5 |
| `audio.record` | §10.3 |
| `system.reboot` | HAL 加 `hal_power_reboot`，能力系统级 |
| “一直在听”没有专门测试 | `integration-listening`：三种设置；锁屏听的时候不睡；唤醒词过不了确认卡，也进不了锁着的空间 |
| 作业“离线不跑、联网后跑”没有专门测试 | `systest-services` 里加了 |
| 生命周期回调和状态保存 | §8 |
| 权限检查 | §8.1 |
| 给 AI 的上下文带系统状态；事件转发（主动决策的第一步） | §1.2 第 3、4 条 |
| 工具清单只有 6 KiB 缓冲，能力多了放不下 | 分页（§1.2 第 5 条） |
| `MAX_CAPS` 96、事件订阅 16、状态 48、设置 32、`on_online` 2 | 都要加大，放 PSRAM |
| `SDK 头文件自成一体` | 这轮不做，界面框架会动这些头文件，记在 §15 |

另外加大了：状态和设置的监听 24 个（`WATCH_MAX`），`on_online` 6 个。

界面审计（`claude/system-layer` 的[设计审计 §5](../audits/2026-11-04-codex-ui/report.md)）提到的电源键：**长按 1.5 s 是电源菜单**（`system/ui/shell/power_menu.c`，占位外观，关机、重启、取消，按钮走 `system.shutdown`、`system.reboot`）。短按还是锁屏；锁定时长按先唤醒再出菜单；来电和闹钟不响应长按，松开也不算短按；HOME 关菜单；锁屏时菜单收起。谁拿着设备谁能关机：孩子、关着的成人空间都能按，AI 替孩子不行。关机和重启都先写完在等的东西。锁屏标记改成“按电源键或 AI 键唤醒”（D-38）。

**音量键**（D-19，音量键只调音量）：之前按了没有任何反应，这次补上。一次 10，走 `system.set_volume`，和 AI 同一条路。不交给应用，不唤醒设备。**锁屏时**只有正在放声音才有用（界面规范 `LockPlaying`，规范里写的是建议）：放声音时能调，不解锁，不打开成人空间；什么都没放就什么也不发生。`system.set_volume` 因此标了 `while_locked`，AI 在空间关着时仍然被关口拒绝。

**关机图**（界面规范 §7.12，`system/ui/shell/off_picture.c`，占位外观）：电子纸断电后画面还在，所以关机前要写清楚已关机。`ink_power_set_off_picture` 登记，关机和没电都走它：先把要写的写完，再画，等屏幕刷完（最多 6 s），才断电。没电时写“没电了，东西都存好了”。如果有应用的卡片标了 `bookmark`（现在是阅读的“在读”），留一行读到哪儿；**空间关着时不留**，电子纸上的字谁都能看。

明确不做的（以后）：媒体索引、节气、成员级设置（现在设置表是设备级的，音量等都全家一个）、AI 联想、S31 自带蓝牙、配对（首次开机）、无线传输。

### 13.1 任务列表（`ink/sys/task.h`，界面规范 §7.7）

用户能看到的“后台在做什么”。干活的还是原来那些（`ink_job_*`、文件作业、下载），这里只是一张它们自己报上来的表：标题、做到百分之几、一个阶段词（界面拿去合成自己的几步，`ImportJob` 用）、能不能停、怎么结束的、结果一句话、做出来的东西。

```c
int  ink_task_begin(const char *kind, const char *title, bool for_everyone, void (*cancel)(void *ctx), void *ctx);
void ink_task_progress(int id, int percent, const char *stage);
void ink_task_end(int id, ink_task_state_t how, const char *result, const char *object);
```

- **能力**：`job.list`（正在做的在前，然后是结束的，都是新的在前）、`job.cancel {id}`、事件 `job.finished`、状态 `job.running`。按钮和 AI 是同一条路。
- **谁能看、谁能停**：默认是开始它的那位家人自己的，别人看不到也停不了，结束事件也只在这位还在时才发。`for_everyone`（系统更新下载）大家都看得到，只有大人能停。
- **现在接上的**：文件拷贝和删除、系统更新下载。停下更新下载后 `.part` 留着，下次接着下。
- **只在内存里**：16 条，结束的按时间让位给新的；重启后是空的。下载重启后要重新开始才会再出现。
- **`file.copy` 的回执**不变（小文件等结果，大的回 `queued`），多了能查进度的地方。

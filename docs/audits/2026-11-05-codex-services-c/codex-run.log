### 15.4 和界面约定的对照

界面审计提的跨服务约定（[设计审计 §5.2](../audits/2026-11-04-codex-ui/report.md)），现在做到哪了。**缺的都记在这里，这一轮没有做：**

| 约定 | 现在有 | 还缺 |
| --- | --- | --- |
| 保存回执（写进队列不等于已保存；分清本地保存、等待上传、中枢收到） | C 接口：`ink_db_durable_ver`、`ink_db_acked_ver`、`ink_db_wait`、`ink_db_error`，事件 `data.write_failed`。能力 `data.put` 回 `revision`，`data.status {collection, id 或 revision}` 回 `saving`、`on_device`、`at_hub`、`failed` | “等待上传”这一步要等同步（中枢协议 §3.9）：现在还没有上传队列，`on_device` 也包括了它 |
| 后台作业（能查进度和结果，界面能显示） | §13.1：`job.list`、`job.cancel`、`job.finished`、`job.running`；文件作业、系统更新下载 | 中枢那边的作业（放书进来的七个阶段）要等中枢协议接上；`ink_job_*` 里别的后台活（阅读预渲染这种）不算用户关心的，不进列表 |
| 系统手势仲裁（保留起点，系统先判边缘带；键盘、滑杆、文字选择按下后输入归它们） | 输入事件有 `x`、`y`、`dx`、`dy` 和方向，浮层独占输入，一个已按下的手指不能按到新出现的东西 | 起点没有传给前台，边缘带和“按下后归谁”都没有。归界面框架，和手势一起做 |
| 编辑会话 | 类型、组合串、候选分页、提交和取消、成员清空、语音输入、光标、选区、撤销（§9.4.1） | 长文本翻页（`ImeLong`，现在上限 4 KiB）；草稿自动存归页面 |
| 成员、确认事务 | §7、§11 | 确认结果落盘（中枢协议要求，见下） |
| 应用状态恢复（D-95 如果定了，“回到原页和原位置”） | `save_state`、`restore_state` 存到 `/user/m/<成员>/`；成人空间关闭时页面栈不动，成员门盖在上面，解锁就回到原页 | §11.4 现在是 120 s 闲置或一锁屏就关。**D-95 等用户定，定了再改计时**，恢复这一半已经够 |

中枢协议 v0.2 要设备改的（[hub-architecture §13](https://github.com/Gidean-zcx/ink/blob/claude/hub-design-8fd433/docs/hub/hub-architecture.md)，服务器设计说还没到做的阶段，先记着）：`device/event` 加 `seq`、`boot`、`member`；`confirm/request`；`ink/member`；块传输（kind 6、7，`update/fetch` 固定包标识，现在是 JSON 里放 base64）；`hub_link` 的配对状态；确认结果落盘、`confirm.status`；同步的快照安装。

确认规则要改（D-105、R-063，用户的要求，[服务器设计概要 §7.5、§13](https://github.com/Gidean-zcx/ink/blob/claude/hub-design-8fd433/docs/hub/hub-architecture.md)，协议 §3.3）：默认自动，确认卡只留给高风险。**还没改，什么时候改由用户定。** 要动的：`confirm_for`（`cap.c`）里外部和系统副作用不再一律弹卡，中枢发来的 `tools/call` 带 `_meta.asked:true` 就直接做；高风险的打上 `ask_by_hand`（花钱、改家人的密码、清空设备、删家人、批量删除、移除设备、退出家庭、改孩子的规则、恢复备份，这份清单还可以改）；`text.voice_start` 这类不再一律弹卡；自动做的进活动记录，能撤销的给撤销。这和现在的 §7、底座设计 §6.2 不一样，现在的代码和测试还是旧规则。

还没做、也不属于这一轮的：中枢真正的 `update/*` 协议；正式词库；`ports/esp32s31` 上这些 HAL 全部没有实现（§14.2）；应用权限按前台应用查（第十四轮报告的架构节）。事件信封：带 `member` 的事件已经按成员发（§11.4），`seq`、`boot` 还没有。

/*
 * The time service on the soft bus: what the clock and calendar apps' buttons do, and what the AI can
 * do. None of it blocks: the table is in memory and writes are queued.
 */
#include <stdio.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/sys/cap.h"
#include "ink/sys/json.h"
#include "ink/sys/members.h"
#include "ink/sys/state.h"
#include "ink/sys/time.h"
#include "time_internal.h"

#define UNDO_MS 10000

static void fail(ink_call_t *c, ink_rc_t st, const char *why) {
    c->rc.status = st;
    snprintf(c->rc.detail, sizeof c->rc.detail, "%s", why);
}

static void local_text(int64_t utc, char *out, size_t cap) {
    ink_tm_t t;
    ink_time_to_local(utc, &t);
    snprintf(out, cap, "%04d-%02d-%02d %02d:%02d:%02d", t.year, t.month, t.day, t.hour, t.min, t.sec);
}

static void cap_now(ink_call_t *c) {
    if (!ink_time_valid()) {
        fail(c, INK_RC_FAILED, "the clock is not known yet");
        return;
    }
    int64_t now = ink_time_now_s();
    ink_tm_t t;
    ink_time_to_local(now, &t);
    char text[24], lunar[32] = "", gz[12] = "", out[256];
    local_text(now, text, sizeof text);
    ink_lunar_t l;
    bool has_lunar = ink_lunar_from_solar(t.year, t.month, t.day, &l);
    if (has_lunar) {
        ink_lunar_name(&l, lunar, sizeof lunar);
        ink_lunar_ganzhi(l.year, gz, sizeof gz);
    }
    int64_t synced = 0;
    ink_state_get_int(ink_state_find("time.synced"), &synced);
    snprintf(out, sizeof out, "{\"utc_s\":%lld,\"local\":\"%s\",\"weekday\":%d,\"zone\":\"%s\",\"offset_min\":%d,\"lunar\":\"%s\",\"ganzhi\":\"%s\",\"synced\":%s}",
             (long long)now, text, t.wday, ink_time_zone(), t.offset_min, lunar, gz, synced ? "true" : "false");
    ink_cap_result(c, out);
    snprintf(c->rc.say, sizeof c->rc.say, "现在是 %.16s", text);
}

static void cap_set(ink_call_t *c) {
    int64_t s = 0;
    ink_args_get_int(&c->args, "utc_s", &s);
    ink_time_set(s, false);
    snprintf(c->rc.say, sizeof c->rc.say, "时间改好了");
}

static void cap_lunar(ink_call_t *c) {
    int64_t y = 0, m = 0, d = 0, ly = 0, lm = 0, ld = 0;
    bool leap = false;
    ink_args_get_bool(&c->args, "leap", &leap);
    char out[160], name[32] = "", gz[12] = "";
    if (ink_args_get_int(&c->args, "lunar_year", &ly) && ink_args_get_int(&c->args, "lunar_month", &lm) && ink_args_get_int(&c->args, "lunar_day", &ld)) {
        ink_lunar_t l = {(int)ly, (int)lm, (int)ld, leap};
        int sy, sm, sd;
        if (!ink_lunar_to_solar(&l, &sy, &sm, &sd)) {
            fail(c, INK_RC_INVALID, "no such lunar date");
            return;
        }
        snprintf(out, sizeof out, "{\"year\":%d,\"month\":%d,\"day\":%d}", sy, sm, sd);
    } else {
        ink_tm_t t = {0};
        if (!ink_args_get_int(&c->args, "year", &y) || !ink_args_get_int(&c->args, "month", &m) || !ink_args_get_int(&c->args, "day", &d)) {
            if (!ink_time_valid()) {
                fail(c, INK_RC_FAILED, "the clock is not known yet");
                return;
            }
            ink_time_to_local(ink_time_now_s(), &t);
            y = t.year;
            m = t.month;
            d = t.day;
        }
        ink_lunar_t l;
        if (!ink_lunar_from_solar((int)y, (int)m, (int)d, &l)) {
            fail(c, INK_RC_INVALID, "outside the calendar (1901-2100)");
            return;
        }
        ink_lunar_name(&l, name, sizeof name);
        ink_lunar_ganzhi(l.year, gz, sizeof gz);
        snprintf(out, sizeof out, "{\"lunar_year\":%d,\"lunar_month\":%d,\"lunar_day\":%d,\"leap\":%s,\"name\":\"%s\",\"ganzhi\":\"%s\",\"zodiac\":\"%s\"}", l.year, l.month, l.day,
                 l.leap ? "true" : "false", name, gz, ink_lunar_zodiac(l.year));
    }
    ink_cap_result(c, out);
}

static bool parse_at(const char *s, ink_alarm_t *a) { /* "2026-11-05 15:00" */
    int y, mo, d, h, mi;
    if (sscanf(s, "%d-%d-%d %d:%d", &y, &mo, &d, &h, &mi) != 5 || h < 0 || h > 23 || mi < 0 || mi > 59) return false;
    a->year = (int16_t)y;
    a->month = (uint8_t)mo;
    a->day = (uint8_t)d;
    a->hour = (uint8_t)h;
    a->min = (uint8_t)mi;
    return true;
}

static void answer_add(ink_call_t *c, ink_alarm_t *a, const char *undo_cap) {
    int id = ink_alarm_add(a);
    if (id <= 0) {
        fail(c, id == -3 ? INK_RC_REJECTED : INK_RC_INVALID, id == -2 ? "that time has passed" : id == -3 ? "too many alarms" : "not a valid time");
        return;
    }
    snprintf(c->rc.object, sizeof c->rc.object, "%s:%d", a->kind == INK_ALARM ? "alarm" : "reminder", id);
    char next[24];
    if (a->next_s) {
        local_text(a->next_s, next, sizeof next);
        snprintf(c->rc.say, sizeof c->rc.say, "好的，%.16s", next);
    }
    ink_args_t undo;
    ink_args_init(&undo);
    ink_args_int(&undo, "id", id);
    ink_cap_undoable(c, undo_cap, &undo, UNDO_MS);
}

static void cap_alarm_set(ink_call_t *c) {
    ink_alarm_t a = {.kind = INK_ALARM, .src = (uint8_t)c->src};
    int64_t h = 0, m = 0, wd = 0;
    ink_args_get_int(&c->args, "hour", &h);
    ink_args_get_int(&c->args, "minute", &m);
    a.hour = (uint8_t)h;
    a.min = (uint8_t)m;
    if (ink_args_get_int(&c->args, "weekdays", &wd) && wd) {
        a.repeat = INK_REPEAT_WEEKDAYS;
        a.weekdays = (uint8_t)wd;
    }
    ink_args_get_str(&c->args, "title", a.title, sizeof a.title);
    answer_add(c, &a, "alarm.cancel");
}

static void cap_reminder_add(ink_call_t *c) {
    ink_alarm_t a = {.kind = INK_REMINDER, .src = (uint8_t)c->src};
    char at[32] = "", repeat[16] = "";
    ink_args_get_str(&c->args, "at", at, sizeof at);
    ink_args_get_str(&c->args, "title", a.title, sizeof a.title);
    ink_args_get_str(&c->args, "repeat", repeat, sizeof repeat);
    if (!parse_at(at, &a)) {
        fail(c, INK_RC_INVALID, "at: YYYY-MM-DD HH:MM");
        return;
    }
    if (!strcmp(repeat, "monthly")) a.repeat = INK_REPEAT_MONTHLY;
    else if (!strcmp(repeat, "yearly")) a.repeat = INK_REPEAT_YEARLY;
    else if (!strcmp(repeat, "lunar_yearly")) {
        ink_lunar_t l;
        if (!ink_lunar_from_solar(a.year, a.month, a.day, &l)) {
            fail(c, INK_RC_INVALID, "outside the calendar (1901-2100)");
            return;
        }
        a.repeat = INK_REPEAT_LUNAR_YEARLY;
        a.lmonth = (uint8_t)l.month;
        a.lday = (uint8_t)l.day;
        a.lleap = l.leap;
    } else if (!strcmp(repeat, "weekly")) {
        a.repeat = INK_REPEAT_WEEKDAYS;
        int64_t days = time_days_from_civil(a.year, a.month, a.day);
        a.weekdays = (uint8_t)(1u << (((days % 7) + 11) % 7));
    } else if (!strcmp(repeat, "daily")) {
        a.repeat = INK_REPEAT_WEEKDAYS;
        a.weekdays = 0x7F;
    }
    answer_add(c, &a, "reminder.cancel");
}

static void list_kind(ink_call_t *c, ink_alarm_kind_t kind) {
    char *out = osal_malloc(4096, OSAL_MEM_EXTERNAL);
    ink_alarm_t *a = osal_malloc(sizeof *a, OSAL_MEM_EXTERNAL);
    if (!out || !a) {
        osal_free(out);
        osal_free(a);
        fail(c, INK_RC_FAILED, "out of memory");
        return;
    }
    ink_jw_t w;
    ink_jw_init(&w, out, 4096);
    ink_jw_raw(&w, "[");
    int cursor = 0;
    bool first = true;
    while (ink_alarm_next(&cursor, kind, a) == 1) {
        char next[24] = "";
        if (a->next_s) local_text(a->next_s, next, sizeof next);
        size_t before = w.len;
        ink_jw_raw(&w, first ? "{\"id\":" : ",{\"id\":");
        ink_jw_int(&w, a->id);
        ink_jw_raw(&w, ",\"title\":");
        ink_jw_str(&w, a->title);
        ink_jw_raw(&w, ",\"enabled\":");
        ink_jw_raw(&w, a->enabled ? "true" : "false");
        ink_jw_raw(&w, ",\"next\":");
        ink_jw_str(&w, next);
        ink_jw_raw(&w, ",\"repeat\":");
        ink_jw_int(&w, a->repeat);
        ink_jw_raw(&w, "}");
        if (w.overflow) {
            w.overflow = false;
            w.len = before;
            break;
        }
        first = false;
    }
    ink_jw_raw(&w, "]");
    ink_cap_result(c, out);
    osal_free(out);
    osal_free(a);
}

static void cap_alarm_list(ink_call_t *c) { list_kind(c, INK_ALARM); }
static void cap_reminder_list(ink_call_t *c) { list_kind(c, INK_REMINDER); }

static void cap_cancel(ink_call_t *c) {
            CHECK(tool != NULL, "%s is in the tool list the hub gets", c->id);
            const cJSON *title = cJSON_GetObjectItem(tool, "title");
            CHECK(cJSON_IsString(title) && title->valuestring[0], "%s: with a title there", c->id);
            takes(c->id, cJSON_GetObjectItem(tool, "inputSchema"), FOR_AI[yes].args);
        } else {
            if (no >= 0) CHECK(!tool, "%s must not be in it (%s)", c->id, NOT_FOR_AI[no].why);
            cJSON *own = cJSON_Parse(c->input ? c->input : "{\"type\":\"object\"}"); /* not listed from here: what it declares */
            takes(c->id, own, yes >= 0 ? FOR_AI[yes].args : no >= 0 ? NOT_FOR_AI[no].args : NULL);
            cJSON_Delete(own);
        }
        if (yes >= 0) callable++;
    }
    /* nothing in the tables that is not there */
    for (int i = 0; FOR_AI[i].id; i++) CHECK(ink_cap_find(FOR_AI[i].id) != NULL, "%s is in the table but not registered", FOR_AI[i].id);
    for (int i = 0; NOT_FOR_AI[i].id; i++) CHECK(ink_cap_find(NOT_FOR_AI[i].id) != NULL, "%s is in the table but not registered", NOT_FOR_AI[i].id);
    CHECK(callable > 50, "the table is not empty (%d)", callable);
    /* what the design promises for finding things */
    CHECK(AI("caps.domains", NULL) && strstr(g_result, "notify") && strstr(g_result, "file") && strstr(g_result, "app"), "a directory of domains (%s)", g_result);
    CHECK(AI("caps.find", "{\"query\":\"通知\"}") && strstr(g_result, "notify.list"), "and a search (%s)", g_result);
    cJSON_Delete(g_tools);
    g_tools = NULL;
}

/* A record as large as there can be, all the way to the hub: a tool's answer as the model gets it (audit AUD15-004). */
static const ink_db_def_t BIG = {.name = "test.big", .title = "大记录", .scope = INK_DB_DEVICE, .schema = 1, .json = true, .ai_read = true};

static void a_large_answer(void) {
    CHECK(ink_db_register(&BIG) == 0, "registered");
    ink_db_t *db = ink_db_open(&BIG, NULL);
    static char v[INK_DB_RECORD_MAX];
    size_t n = (size_t)snprintf(v, sizeof v, "{\"text\":\"");
    while (n + 3 < sizeof v) v[n++] = 'x';
    v[n++] = '"';
    v[n++] = '}';
    uint32_t id = 0;
    ink_db_write_t w = {.data = v, .len = n};
    CHECK(db && ink_db_put(db, &w, &id) == INK_DB_OK, "the largest there can be");
    ink_db_close(db);
    char params[96];
    snprintf(params, sizeof params, "{\"name\":\"data.get\",\"arguments\":{\"collection\":\"test.big\",\"id\":%u}}", (unsigned)id);
    const char *reply = ask_device("tools/call", params);
    cJSON *j = cJSON_Parse(reply ? reply : "");
    const cJSON *receipt = cJSON_GetObjectItem(j, "result"), *value = cJSON_GetObjectItem(cJSON_GetObjectItem(receipt, "result"), "value");
    const cJSON *text = cJSON_GetObjectItem(value, "text");
    CHECK(cJSON_IsString(text) && strlen(text->valuestring) == n - 11, "the hub gets all of it, as JSON (%zu)", reply ? strlen(reply) : 0);
    cJSON_Delete(j);
}

static void state_and_settings(void) {
    CHECK(AI("state.list", NULL) && g_rc.status == INK_RC_DONE, "state.list (%s)", g_rc.detail);
    for (int i = 0; STATES[i]; i++) {
        char needle[64];
        snprintf(needle, sizeof needle, "\"%s\":", STATES[i]);
        CHECK(strstr(g_result, needle), "state %s is there", STATES[i]);
    }
    CHECK(AI("settings.list", NULL) && g_rc.status == INK_RC_DONE, "settings.list (%s)", g_rc.detail);
    for (int i = 0; SETTINGS[i]; i++) {
        char needle[64];
        snprintf(needle, sizeof needle, "\"id\":\"%s\"", SETTINGS[i]);
        CHECK(strstr(g_result, needle), "setting %s is there", SETTINGS[i]);
    }
    for (int i = 0; EVENTS[i]; i++) {
        const ink_cap_t *c = ink_cap_find(EVENTS[i]);
        CHECK(c && c->form == INK_FORM_EVENT, "event %s is registered", EVENTS[i]);
    }
    int64_t user_free = 0;
    CHECK(ink_state_get_int(ink_state_find("storage.user_free"), &user_free) && user_free > 0, "the internal storage's free space was measured (%lld)", (long long)user_free);
}

static bool event_seen_since(int from, const char *text) {
    for (int i = from; i < sim_hub_events_seen(); i++) {
        const char *e = sim_hub_event_at(i);
        if (e && strstr(e, text)) return true;
    }
    return false;
}

static void network_event(const char *which) {
    /* the script's commands, from here */
    extern void sim_net_set_link(const char *);
    sim_net_set_link(which);
}
static void net_none(void *arg) {
    (void)arg;
    network_event("none");
}
static void net_wifi(void *arg) {
    (void)arg;
    network_event("wifi");
}


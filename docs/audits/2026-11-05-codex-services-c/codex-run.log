static int read_table(slot_t *fresh) {
    ink_db_t *db = ink_db_open(&TABLE, NULL);
    if (!db) return -1;
    ink_db_cursor_t c = {0};
    ink_rec_t r;
    stored_t st;
    int n = 0;
    while (n < INK_MEMBERS_MAX && ink_db_next(db, &c, &r, &st, sizeof st) == 1) {

/*
 * The clipboard (see ink/sys/textinput.h): one text in external RAM, never stored. Who reads it is the policy's: the AI
 * only if the member allowed it (default off), and never what was marked sensitive.
 */
#include <stdio.h>
#include <string.h>

#include "ink/osal.h"
#include "ink/probe.h"
#include "ink/sys/cap.h"
#include "ink/sys/settings.h"
#include "ink/sys/state.h"
#include "ink/sys/svc.h"
#include "ink/sys/textinput.h"
#include "text_internal.h"

#define SENSITIVE_US 60000000ull

static struct {
    char text[INK_CLIP_MAX + 1];
    bool sensitive;
    ink_svc_deadline_t expiry;
} CL INK_PSRAM_BSS;

void ink_clip_clear(void) {
    ink_svc_lock();
    CL.text[0] = 0;
    CL.sensitive = false;
    ink_svc_unlock();
    ink_svc_cancel(&CL.expiry);
}

static void expired(void *ctx) { /* the timer task */
    (void)ctx;
    ink_svc_lock();
    bool was = CL.sensitive;
    if (was) {
        CL.text[0] = 0;
        CL.sensitive = false;
    }
    ink_svc_unlock();
    if (was) ink_probe_count("clipboard.sensitive_cleared");
}

int ink_clip_set(const char *text, bool sensitive, uint8_t src) {
    (void)src;
    if (!text || strlen(text) > INK_CLIP_MAX) return -1;
    ink_svc_lock();
    snprintf(CL.text, sizeof CL.text, "%s", text);
    CL.sensitive = sensitive;
    ink_svc_unlock();
    if (sensitive) ink_svc_at(&CL.expiry, osal_now_us() + SENSITIVE_US, expired, NULL);
    else ink_svc_cancel(&CL.expiry);
    return 0;
}

int ink_clip_get(char *out, size_t cap, uint8_t src, bool *sensitive) {
    bool remote = src == INK_SRC_AI || src == INK_SRC_REMOTE;
    bool allowed = !remote || ink_setting_get("ai.read_clipboard");
    ink_svc_lock();
    bool s = CL.sensitive;
    int n = -1;
    if (allowed && !(remote && s)) {
        n = snprintf(out, cap, "%s", CL.text);
        if (n >= (int)cap) n = (int)cap - 1;
    }
    ink_svc_unlock();
    if (sensitive) *sensitive = s;
    if (n < 0) ink_probe_count("clipboard.refused");
    return n;
}

static void on_member(void *ctx, int h, const char *id) { /* DIRECT: at the moment it changes hands */
    (void)ctx;
    (void)h;
    (void)id;
    ink_clip_clear();
}

void clip_init(void) { ink_state_watch("member.current", on_member, NULL, INK_EXEC_DIRECT); }
/*
 * The keyboard panel (placeholder look until the system UI, D-64): a system panel at the bottom of the screen, under the
 * cards, over the page. It shows what the input session says and feeds in what is pressed; the page above it stays usable.
 * What changes is driven with the fast waveform (foundation §4.8).
 */
#include <stdio.h>
#include <string.h>

#include "ink/hal_display.h"
#include "ink/osal.h"
#include "ink/sys/font.h"
#include "ink/sys/textinput.h"
#include "ink/sys/ui.h"

#define KEY_BACKSPACE '\b'
#define KEY_ENTER '\n'
#define KEY_SWITCH '\1'
#define KEY_SHIFT '\2'

static struct {
    lv_obj_t *root, *keys, *cands, *composing;
    lv_obj_t *cand_btn[INK_TEXT_PAGE], *cand_label[INK_TEXT_PAGE], *more, *mic;
    lv_obj_t *panel, *status, *heard; /* the voice panel: where the keys were, the same size */
    int first;
    int shown;
    bool symbols, shift;
    int built_for; /* 1 letters, 2 symbols, 3 digits */
} K;

static const lv_font_t *font(void) {
    hal_panel_info_t pi;
    hal_display_get_info(&pi);
    ink_font_t *cjk = ink_font_for_pt(10, pi.dpi);
    return cjk ? ink_font_lvgl(cjk) : ink_ui_font(0);
}

static void sync(void);

static void on_key(lv_event_t *e) {
    char c = (char)(intptr_t)lv_event_get_user_data(e);
    switch (c) {
    case KEY_BACKSPACE: ink_text_backspace(); break;
    case KEY_ENTER: ink_text_enter(); break;
    case KEY_SWITCH:
        K.symbols = !K.symbols;
        sync();
        return;
    case KEY_SHIFT: K.shift = !K.shift; return;
    default:
        if (K.shift && c >= 'a' && c <= 'z') c = (char)(c - 'a' + 'A');
        K.shift = false;
        ink_text_key(c);
        break;
    }
    K.first = 0;
    ink_ui_cause(osal_now_us(), "text.key_to_visible_ms");
}

static void on_cand(lv_event_t *e) {
    int i = (int)(intptr_t)lv_event_get_user_data(e);
    int first = K.first;
    K.first = 0;
    ink_text_pick(first + i);
    ink_ui_cause(osal_now_us(), "text.key_to_visible_ms");
}

static void on_more(lv_event_t *e) {
    (void)e;
    K.first += INK_TEXT_PAGE;
    sync();
}

static lv_obj_t *key(lv_obj_t *row, const char *label, char code, int grow) {
    lv_obj_t *b = lv_button_create(row);
    ink_ui_style_button(b);
    lv_obj_set_style_pad_all(b, ink_dp(2), 0);
    lv_obj_set_height(b, ink_dp(44));
    lv_obj_set_flex_grow(b, (uint8_t)grow);
    lv_obj_add_event_cb(b, on_key, LV_EVENT_CLICKED, (void *)(intptr_t)code);
    lv_obj_t *l = lv_label_create(b);
    lv_obj_set_style_text_font(l, font(), 0);
    lv_label_set_text(l, label);
    lv_obj_center(l);
    return b;
}

static void on_mic(lv_event_t *e) {
    (void)e;
    ink_text_voice_start();
    ink_ui_cause(osal_now_us(), "text.voice_tap_to_panel_ms");
}

static void on_said(lv_event_t *e) {
    (void)e;
    ink_text_voice_finish();
}

static void on_use_keys(lv_event_t *e) {
    (void)e;
    ink_text_voice_cancel();
}

static lv_obj_t *new_row(void) {
    lv_obj_t *r = lv_obj_create(K.keys);
    lv_obj_remove_style_all(r);
    lv_obj_set_size(r, LV_PCT(100), LV_SIZE_CONTENT);
    lv_obj_set_flex_flow(r, LV_FLEX_FLOW_ROW);
    lv_obj_set_style_pad_column(r, ink_dp(2), 0);
    return r;
}

static void char_row(const char *keys) {
    lv_obj_t *r = new_row();
    for (const char *p = keys; *p; p++) {
        char s[2] = {*p, 0};
        key(r, s, *p, 1);
    }
}


}

/* ------------------------------------------------------------ undo (foundation §6.2: reversible writes say how long) */

#define UNDO_MAX 4

typedef struct {
    char object[48], cap[48], member[16];
    ink_args_t args;
    uint64_t until_us;
} undo_t;

static undo_t UNDO[UNDO_MAX] INK_PSRAM_BSS;
static int undo_next;

void ink_cap_undoable(ink_call_t *call, const char *cap, const ink_args_t *args, uint32_t ms) {
    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
    undo_t *u = &UNDO[undo_next];
    undo_next = (undo_next + 1) % UNDO_MAX;
    snprintf(u->object, sizeof u->object, "%s", call->rc.object);
    snprintf(u->cap, sizeof u->cap, "%s", cap);
    snprintf(u->member, sizeof u->member, "%s", ink_member_current()->id);
    if (args) u->args = *args;
    else ink_args_init(&u->args);
    u->until_us = osal_now_us() + (uint64_t)ms * 1000u;
    osal_mutex_unlock(CB.lock);
    call->rc.undo_ms = ms;
}

static void undo_done(void *ctx, const ink_receipt_t *rc) {
    ink_call_t *c = ctx;
    if (rc->status == INK_RC_DONE) {
        c->rc.status = INK_RC_UNDONE;
        snprintf(c->rc.say, sizeof c->rc.say, "撤销了");
    } else {
        c->rc.status = rc->status;
        snprintf(c->rc.detail, sizeof c->rc.detail, "%s", rc->detail);
    }
    ink_cap_done(c);
}

static void cap_undo(ink_call_t *c) {
    char object[48];
    ink_args_get_str(&c->args, "object", object, sizeof object);
    undo_t u = {0};
    bool found = false;
    uint64_t now = osal_now_us();
    osal_mutex_lock(CB.lock, OSAL_WAIT_FOREVER);
    for (int i = 0; i < UNDO_MAX && !found; i++) {
        undo_t *e = &UNDO[i];
        if (e->until_us > now && !strcmp(e->object, object) && !strcmp(e->member, ink_member_current()->id)) {
            u = *e;
            e->until_us = 0; /* once */
            found = true;
        }
    }
    osal_mutex_unlock(CB.lock);
    if (!found) {
        reject(&c->rc, INK_RC_FAILED, "nothing to undo, or too late");
        return;
    }
    snprintf(c->rc.object, sizeof c->rc.object, "%s", object);
    ink_cap_defer(c); /* the inverse may run on another executor: the member's own undo, no second confirmation */
    ink_call_opts_t o = {.src = INK_SRC_SYSTEM, .reply_exec = INK_EXEC_DIRECT, .done = undo_done, .ctx = c};
    if (ink_cap_call(u.cap, &u.args, &o) != 0) {
        reject(&c->rc, INK_RC_FAILED, "busy");
        ink_cap_done(c);
    }
/*
 * Who is using the device (placeholder, D-64): an adult's space that has closed (idle, locked) asks who it is before anything
 * else. It shows the members; one with a PIN asks for it; the keys do nothing. The rules are the members' and the policy's.
 */
#include <stdio.h>
#include <string.h>

#include "ink/hal_display.h"
#include "ink/osal.h"
#include "ink/sys/exec.h"
#include "ink/sys/font.h"
#include "ink/sys/members.h"
#include "ink/sys/power.h"
#include "ink/sys/state.h"
#include "ink/sys/ui.h"
#include "pinpad.h"
#include "shell_card.h"

static struct {
    shell_card_t card;
    char picked[16];
    lv_obj_t *pad;
    int result;
    uint32_t wait_s;
    ink_exec_job_t sync_job, result_job;
} G;

static void sync_gate(void *arg);

static int snapshot(char *buf, size_t cap) {
    int n = snprintf(buf, cap, "设备锁着：请选择家人，或输入密码。");
    return n < 0 ? 0 : (size_t)n < cap ? n : (int)cap - 1;
}

static const ink_ui_overlay_t OVERLAY = {.name = "member_gate", .level = 2, .snapshot = snapshot};

static void result_job(void *arg) { /* UI task */
    (void)arg;
    if (G.result == INK_PIN_OK) return; /* the state changes, the gate goes */
    char s[48];
    if (G.result == INK_PIN_WAIT || G.wait_s) snprintf(s, sizeof s, "请等 %u 秒再试", (unsigned)G.wait_s);
    else snprintf(s, sizeof s, "密码不对");
    shell_pinpad_clear();
    shell_pinpad_say(s);
}

static void pin_result(void *ctx, int result, uint32_t wait_s) { /* exec.bg */
    (void)ctx;
    G.result = result;
    G.wait_s = wait_s;
    ink_exec_post(INK_EXEC_UI, &G.result_job, result_job, NULL);
}

static void pin_entered(const char *pin) { /* UI task */
    ink_member_unlock(G.picked, pin, pin_result, NULL);
    shell_pinpad_clear();
    shell_pinpad_say("正在核对…");
}

static void on_member(lv_event_t *e) {
    const ink_member_t *m = lv_event_get_user_data(e);
    snprintf(G.picked, sizeof G.picked, "%s", m->id);
    if (ink_member_has_pin(m->id)) {
        if (!G.pad) G.pad = shell_pinpad(G.card.root, pin_entered);
        shell_card_text(&G.card, m->name, "");
    } else if (ink_member_switch(m->id) == 0) {
        ink_exec_post(INK_EXEC_UI, &G.sync_job, sync_gate, NULL);
    }
}

static void sync_gate(void *arg) { /* UI task */
    (void)arg;
    bool want = !ink_member_space_open() && ink_power_state() != INK_PWR_LOCKED;
    if (!want) {
        if (G.card.root) {
            shell_card_close(&G.card);
            G.pad = NULL;
            ink_ui_overlay_remove(&OVERLAY);
        }
        return;
    }
    if (G.card.root) return;
    shell_card_open(&G.card);
    ink_ui_overlay_add(&OVERLAY, G.card.root);
    shell_card_text(&G.card, "谁在用？", "");
    shell_card_clear_buttons(&G.card);
    const ink_member_t *m;
    for (int i = 0; (m = ink_member_at(i)) != NULL; i++) shell_card_button(&G.card, m->name, on_member, (void *)m);
    /* the one whose space it is first */
    snprintf(G.picked, sizeof G.picked, "%s", ink_member_current()->id);
    G.pad = shell_pinpad(G.card.root, pin_entered);
}

static void on_change(void *ctx, int h, const char *id) {
    (void)ctx;
    (void)h;
    (void)id;
    ink_exec_post(INK_EXEC_UI, &G.sync_job, sync_gate, NULL);
}

int ink_shell_member_gate_init(void) {
    if (ink_state_watch("member.authed", on_change, NULL, INK_EXEC_DIRECT) != 0 || ink_state_watch("power.state", on_change, NULL, INK_EXEC_DIRECT) != 0) return -1;
    ink_exec_post(INK_EXEC_UI, &G.sync_job, sync_gate, NULL);
    return 0;
}
/*
 * The confirmation card: the system's placeholder for what ink_confirm_set_presenter shows. It is drawn here, over
 * everything, so that no page can look like it; only a touch or a key on it counts as a person's answer. The real look
 * comes with the system UI (D-64).
 */
#include <stdio.h>
#include <string.h>

#include "ink/sys/confirm.h"
#include "ink/sys/exec.h"
#include "pinpad.h"
#include "shell_card.h"

static struct {
    shell_card_t card;
    ink_confirm_view_t now;
    lv_obj_t *pad;
    int pin_result;
    uint32_t pin_wait;
    ink_exec_job_t told_job;
} C;

static void told_job(void *arg);

static void pin_told(void *ctx, int result, uint32_t wait_s) { /* exec.bg */
    (void)ctx;
    __atomic_store_n(&C.pin_result, result, __ATOMIC_RELEASE);
    C.pin_wait = wait_s;
    ink_exec_post(INK_EXEC_UI, &C.told_job, told_job, NULL);
}

static void told_job(void *arg) { /* UI task */
    (void)arg;
    int r = __atomic_load_n(&C.pin_result, __ATOMIC_ACQUIRE);
    if (r == INK_PIN_OK || !C.pad) return; /* the card goes by itself */
    char s[48];
    if (C.pin_wait) snprintf(s, sizeof s, "请等 %u 秒再试", (unsigned)C.pin_wait);
    else snprintf(s, sizeof s, "密码不对");
    shell_pinpad_clear();
    shell_pinpad_say(s);
}

static void pin_entered(const char *pin) {
    ink_confirm_accept_with_pin(C.now.token, pin, pin_told, NULL);
    shell_pinpad_clear();
    shell_pinpad_say("正在核对…");
}

static void on_answer(lv_event_t *e) {
    bool yes = lv_event_get_user_data(e) != NULL;
    if (yes && C.now.parent) { /* a yes here takes a parent */
        if (!C.pad) C.pad = shell_pinpad(C.card.root, pin_entered);
        return;
    }
    ink_confirm_decide(C.now.token, yes, INK_SRC_TOUCH);
}

static int snapshot(char *buf, size_t cap) {
    int n = snprintf(buf, cap, "等你确认：%s。%s。按钮：确认、取消。", C.now.title, C.now.detail);
    return n < 0 ? 0 : (size_t)n < cap ? n : (int)cap - 1;
}

static bool on_key(ink_key_t key, bool long_press) {
    if ((key == INK_KEY_BACK || key == INK_KEY_HOME) && !long_press) ink_confirm_decide(C.now.token, false, INK_SRC_KEY); /* leaving is a no: not every device has a back key */
    return true;
}

static const ink_ui_overlay_t OVERLAY = {.name = "confirm", .level = 1, .on_key = on_key, .snapshot = snapshot};

static void show(const ink_confirm_view_t *top) { /* UI task */
    if (!top) {
        if (!C.card.root) return;
        shell_card_close(&C.card);
        C.pad = NULL;
        ink_ui_overlay_remove(&OVERLAY);
        return;
    }
    if (C.card.root && C.now.token == top->token) return;
    C.now = *top;
    if (C.pad) {
        lv_obj_delete(C.pad);
        C.pad = NULL;
    }
    if (!C.card.root) {
        shell_card_open(&C.card);
        ink_ui_overlay_add(&OVERLAY, C.card.root);
    }
    shell_card_text(&C.card, C.now.title, C.now.detail);
    shell_card_clear_buttons(&C.card);
    shell_card_button(&C.card, "确认", on_answer, (void *)1);
    shell_card_button(&C.card, "取消", on_answer, NULL);
}

int ink_shell_confirm_card_init(void) {
    static const ink_confirm_presenter_t P = {.show = show, .exec = INK_EXEC_UI};
    ink_confirm_set_presenter(&P);
    return 0;
}

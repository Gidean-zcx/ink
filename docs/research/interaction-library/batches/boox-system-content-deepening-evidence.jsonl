{"evidence_id": "E-BXSD-01", "product_id": "M-004", "title": "Screensaver", "url": "https://booxsupport.zendesk.com/hc/en-us/articles/10701146091284-Screensaver", "source_type": "official_help", "access_mode": "local_saved_public_help_body_read_and_selected_static_attachments", "checked_on": "2026-10-27", "source_updated_on": "2026-05-25T02:20:37Z", "version_scope": "Tab系列说明；本机适用未核；Note Air5 C V4.1.2为案例基线，当前帮助不等于该构建验证", "app_build": null, "firmware_version": "case baseline V4.1.2; source varies", "locator": "Article 10701146091284; body sections; source-notes section E-BXSD-01", "note": "Settings → Desktop & Screensaver → Screensaver；单图/轮播可从本地、系统、云或推送选图。Memo显示当天日历备忘，Transparent保留当前画面，月历仅部分机型。含时钟的屏保会使自动关机不启用；关机图另设。 限制：没有实际入睡/关机、优先级、更新功耗或失败反馈。图仅为城堡屏保和时钟备忘示例，不是选图或类型选择过程。", "hands_on": false, "visual_observed": true, "archived_artifact": "artifacts/boox-system-content-deepening/source-notes.md", "sha256": "048d41d748eb67a942982e5d783accf607264033fb58c61d8d72fbd6bf04a14e", "capture_state": "short_notes_and_selected_official_static_images_archived", "supersedes": null, "raw_work_path": "work/eink-systems-research/boox-articles.json", "raw_sha256": "a6bbfd6cb4e8ff122152ccac6f0b504608734649ef826877f8024613de275390", "article_body_sha256": "25e1081b3a202548871c11d80b0f79703a8e4c4a23e4107cf88ce5939aeaf055", "artifact_hashes": {"artifacts/boox-system-content-deepening/screensaver-image-example.jpg": "fae41d5c31af195fc58fc9aebc83dffbe0c77a0c5122c73176fd5520a8447b63", "artifacts/boox-system-content-deepening/memo-screensaver-example.jpg": "c03c9b8127d881c260589f821a7b23082f4e88fd753ff97e420c4cd4b47e36af"}}

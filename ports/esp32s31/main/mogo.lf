# The new reader's own statics (TrueType slots, layout runs and link hits, about 13 KB) live in PSRAM: they are
# used from ordinary tasks only, and the device's internal RAM is kept for Wi-Fi, Bluetooth, 4G and DMA.
[mapping:ink_mogo_native]
archive: libink_mogo_native.a
entries:
    * (extram_bss)

# lock-styles-1: Mogo's lock style statics (the mini library's model, about 9 KB) and their glue, the same way.
[mapping:ink_mogo_lock_native]
archive: libink_mogo_lock_native.a
entries:
    * (extram_bss)

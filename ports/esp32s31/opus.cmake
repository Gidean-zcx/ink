# Factory dependency: 78/esp-opus 1.0.5, fixed-point libopus (BSD-3-Clause).
set(ink_opus_archive "${CMAKE_BINARY_DIR}/esp-opus-1.0.5.zip")
set(ink_opus_sha f04982787072427616f2ef86e228844d4912f0a6952a2ee597bb4dc6e5ced829)
if(NOT EXISTS "${ink_opus_archive}")
    file(DOWNLOAD "https://components.espressif.com/api/downloads/?object_id=9eeb1cfd-208e-4d37-bd99-9d2e38e02258&object_type=component"
        "${ink_opus_archive}" STATUS ink_opus_status TIMEOUT 90 TLS_VERIFY ON)
    list(GET ink_opus_status 0 ink_opus_error)
    if(ink_opus_error)
        file(REMOVE "${ink_opus_archive}")
        message(FATAL_ERROR "ink: 无法下载 Opus 1.0.5；离线构建请预置 build 目录的 esp-opus-1.0.5.zip，SHA256=${ink_opus_sha}")
    endif()
endif()
file(SHA256 "${ink_opus_archive}" ink_opus_actual)
if(NOT ink_opus_actual STREQUAL ink_opus_sha)
    message(FATAL_ERROR "ink: Opus 1.0.5 SHA256 不符，请重新取得固定版本压缩包")
endif()
if(NOT EXISTS "${CMAKE_BINARY_DIR}/esp-opus/CMakeLists.txt")
    file(ARCHIVE_EXTRACT INPUT "${ink_opus_archive}" DESTINATION "${CMAKE_BINARY_DIR}")
endif()
set(ink_opus_source "${CMAKE_BINARY_DIR}/esp-opus")

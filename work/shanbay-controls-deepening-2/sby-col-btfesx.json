{"objects": [{"id": "qexpe", "type": "FORBIDDEN_COMMENT", "title": "\u4ecb\u7ecd", "description": "\u4ecb\u7ecd", "content_html": "<div class=\"kraft-content\" style=\"width:100%;padding:16px;color:#333;font-size:16px;line-height:1.75;letter-spacing:1px;word-spacing:0;word-break:break-word;background-color:#fff;overflow:hidden\"><h4 style=\"margin:0;padding:7px 0;font-weight:bold;font-size:16px\"><span>\u4ecb\u7ecd</span></h4><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u8bcd\u6c47\u91cf\u7684\u79ef\u7d2f\u662f\u4e00\u4e2a\u539a\u79ef\u800c\u8584\u53d1\u7684\u8fc7\u7a0b\uff0c\u4f46\u662f\u9664\u4e86\u8003\u8bd5\u4e4b\u5916\uff0c\u5927\u90e8\u5206\u5b66\u4e60\u8005\u4e0d\u77e5\u9053\u81ea\u5df1\u7684\u8bcd\u6c47\u7334\u5e74\u9a6c\u6708\u624d\u80fd\u6d3e\u4e0a\u7528\u573a\uff0c\u4f46\u662f\u901a\u8fc7\u6247\u8d1d\u9605\u8bfb\uff0c\u5b66\u4e60\u8005\u5373\u80fd\u591f\u5c06\u6240\u5b66\u5355\u8bcd\u52a0\u4ee5\u4f7f\u7528\uff0c\u6269\u5c55\u65b0\u77e5\uff0c\u53c8\u80fd\u901a\u8fc7\u9605\u8bfb\u8fdb\u4e00\u6b65\u79ef\u7d2f\u8bcd\u6c47\u3002</span></p><hr style=\"height:2px;margin:16px 0;background-color:#d9d9d9;border:none\"/><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><strong><span>Q\uff1a\u4e3a\u4ec0\u4e48\u8981\u9605\u8bfb\uff1f</span></strong></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><strong><span>A\uff1a</span></strong><span>\u6211\u4eec\u4e00\u76f4\u9f13\u52b1\u5927\u5bb6\u5b66\u82f1\u8bed\u4e0d\u4ec5\u4ec5\u80cc\u8bf5\u548c\u8bb0\u5fc6\u5355\u8bcd\uff0c\u66f4\u8981\u91cd\u89c6\u9605\u8bfb\uff0c\u5c24\u5176\u662f\u82f1\u7f8e\u62a5\u520a\u4e66\u7c4d\u7684\u539f\u6587\u3002\u56e0\u4e3a\u2014\u2014</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u9605\u8bfb\uff0c\u662f\u6bd4\u80cc\u8bf5\u66f4\u597d\u7684\u8bb0\u5fc6\uff1b<br/>\u9605\u8bfb\uff0c\u662f\u68c0\u9a8c\u8bcd\u6c47\u638c\u63e1\u7a0b\u5ea6\u7684\u8bd5\u91d1\u77f3\uff1b<br/>\u9605\u8bfb\uff0c\u80fd\u5e2e\u4f60\u8d70\u51fa\u82f1\u8bed\u201c\u5b66\u201d\u4e86\u5341\u51e0\u5e74\u8fd8\u201c\u5b66\u201d\u4e0d\u5b8c\u7684\u602a\u5708\uff0c\u800c\u5f00\u59cb\u201c\u7528\u82f1\u8bed\u5b66\u201d\uff0c\u771f\u6b63\u7684\u5b66\u4ee5\u81f4\u7528\u3002<br/></span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u5373\u4fbf\u4ece\u5e94\u8bd5\u89d2\u5ea6\u800c\u8a00\uff0c\u6240\u6709\u7684\u91cd\u8981\u8003\u8bd5\u4e2d\uff0c\u9605\u8bfb\u76f8\u5173\u9898\u578b\u7684\u5206\u503c\u90fd\u662f\u6700\u5927\u7684\uff0c\u8b6c\u5982\u8003\u7814\u82f1\u8bed\u7684100\u5206\u4e2d\uff0c\u9605\u8bfb\u9898\u5c31\u5360\u4e8660\u5206\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4f20\u7edf\u9605\u8bfb\u6750\u6599\u7684\u4e0d\u8db3<br/>\u4f46\u662f\uff0c\u5373\u4fbf\u5f88\u591a\u4eba\u77e5\u9053\u9605\u8bfb\u7684\u91cd\u8981\u6027\uff0c\u4f9d\u7136\u4e0d\u5f97\u5176\u6cd5\uff0c\u6839\u636e\u6211\u4eec\u7684\u7814\u7a76\uff0c\u4e3b\u8981\u6709\u8fd9\u4e9b\u969c\u788d\uff1a</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u627e\u4e0d\u5230\u5408\u9002\u7684\u9605\u8bfb\u6750\u6599\uff0c\u603b\u611f\u89c9\u9605\u8bfb\u539f\u6587\u662f\u4e00\u4ef6\u79bb\u81ea\u5df1\u5f88\u9065\u8fdc\u7684\u4e8b\u60c5\uff0c\u603b\u5e0c\u671b\u7b49\u7740\u81ea\u5df1\u7684\u8bcd\u6c47\u91cf\u8db3\u591f\u5927\u4e86\u518d\u5f00\u59cb\u9605\u8bfb\uff0c\u4f46\u662f\u8bcd\u6c47\u91cf\u4eff\u4f5b\u4ece\u6765\u6ca1\u6709\u591f\u7684\u65f6\u5019\uff1b</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u9605\u8bfb\u6750\u6599\u9648\u65e7\uff0c\u59cb\u7ec8\u6446\u8131\u4e0d\u4e86\u4f9d\u7136\u5728\u201c\u5b66\u82f1\u8bed\u201d\u7684\u611f\u89c9\uff0c\u65e0\u6cd5\u5f97\u5230\u901a\u8fc7\u9605\u8bfb\u62d3\u5c55\u65b0\u77e5\u6216\u8005\u4f53\u9a8c\u7684\u6ee1\u8db3\u611f\uff1b</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u9605\u8bfb\u8fc7\u7a0b\u4e2d\u9047\u5230\u4e86\u751f\u8bcd\uff0c\u5373\u4fbf\u5f53\u65f6\u67e5\u4e86\u5b57\u5178\uff0c\u6216\u8005\u6dfb\u52a0\u5230\u5404\u79cd\u201c\u751f\u8bcd\u672c\u201d\u91cc\uff0c\u4e0b\u6b21\u9047\u5230\u4f9d\u7136\u4e0d\u8bb0\u5f97\uff0c\u4ece\u800c\u65e0\u6cd5\u901a\u8fc7\u9605\u8bfb\u6269\u5c55\u8bcd\u6c47\u91cf\uff0c\u5f88\u6709\u632b\u6298\u611f\uff1b</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4e09\u5929\u6253\u6e14\u4e24\u5929\u6652\u7f51\uff0c\u56e0\u4e3a\u65e0\u6cd5\u611f\u77e5\u81ea\u5df1\u7684\u8fdb\u5ea6\uff0c\u975e\u5e38\u5bb9\u6613\u653e\u5f03\u3002</span></p><hr style=\"height:2px;margin:16px 0;background-color:#d9d9d9;border:none\"/><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><strong><span>Q\uff1a\u4e3a\u4ec0\u4e48\u6247\u8d1d\u9605\u8bfb\u80fd\u591f\u5e2e\u52a9\u4f60\uff1f</span></strong></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><strong><span>A\uff1a</span></strong></p><ol style=\"margin:0 0 0 3px;padding:0;list-style-type:decimal;text-align:start;letter-spacing:normal;word-spacing:0px\"><li style=\"margin-left:23px\"><p style=\"margin:0;padding:0;line-height:1.75\"><span>\u6247\u8d1d\u6309\u7167\u4f60\u7684\u8bcd\u6c47\u91cf\u6765\u63a8\u8350\u5408\u9002\u7684\u9605\u8bfb\u6750\u6599\uff1a<br/>\u6211\u4eec\u7cfb\u7edf\u7684\u628a\u6587\u7ae0\u5206\u6210\u4e0d\u540c\u7684\u96be\u5ea6\u7ea7\u522b\u3002\u5982\u679c\u4f60\u53d1\u73b0\u4f60\u5728\u9605\u8bfb\u7684\u7ea7\u522b\u5bf9\u4f60\u6765\u8bf4\u592a\u96be\u6216
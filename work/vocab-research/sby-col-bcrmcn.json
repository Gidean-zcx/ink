tyle=\"color:#28bea0;text-decoration:none\"><span>\u67ef\u6797\u65af\u9ad8\u9636\u7cbe\u534e\u7248</span></a><span>\u6765\u6253\u9020\u7eaf\u82f1\u6587\u7684\u5b66\u4e60\u73af\u5883\u3002</span></p><hr style=\"height:2px;margin:16px 0;background-color:#d9d9d9;border:none\"/></div>", "like_num": 0, "comment_num": 0, "assign_date": "2021-06-28T16:00:00+00:00", "order_type": "COMMEND", "reply_push_url": null, "weight": null, "allow_comment": false, "is_send": false, "column_id": "bcrmcn", "cover_url": "", "tags": [], "redirect_url": "https://web.shanbay.com/op/articles/yjgia?shanbay_immersive_mode=true", "column": {"id": "bcrmcn", "name": "\u5b98\u7f51\u5e2e\u52a9-\u80cc\u5355\u8bcd"}}, {"id": "blksqe", "type": "FORBIDDEN_COMMENT", "title": "\u5355\u8bcd\u5b66\u4e60\u987a\u5e8f", "description": "\u5355\u8bcd\u5b66\u4e60\u987a\u5e8f", "content_html": "<div class=\"kraft-content\" style=\"width:100%;padding:16px;color:#333;font-size:16px;line-height:1.75;letter-spacing:1px;word-spacing:0;word-break:break-word;background-color:#fff;overflow:hidden\"><h4 style=\"margin:0;padding:7px 0;font-weight:bold;font-size:16px\"><span>\u5355\u8bcd\u5b66\u4e60\u987a\u5e8f</span></h4><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4e24\u79cd\u5b66\u4e60\u987a\u5e8f\uff0c\u81ea\u7531\u9009\u62e9\uff0c\u771f\u6b63\u638c\u63e1\u8bcd\u6c47\uff0c\u5f7b\u5e95\u62d2\u7edd\u80cc\u4e86\u5c31\u5fd8\uff01</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u987a\u5e8f\u4e00\uff1a\u5148\u590d\u4e60\u65e7\u8bcd\uff0c\u540e\u5b66\u4e60\u65b0\u8bcd\uff0c\u7531\u7b80\u5165\u96be\uff0c\u53cd\u590d\u518d\u73b0\uff0c\u79d1\u5b66\u8bb0\u5fc6\u795e\u52a9\u653b\uff01</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u987a\u5e8f\u4e8c\uff1a\u65b0\u65e7\u8bcd\u6df7\u5408\uff0c\u667a\u80fd\u642d\u914d\uff0c\u5b66\u4e60\u66f4\u8f7b\u677e\uff01</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u540c\u5b66\u4eec\u53ef\u4ee5\u5728\u300c\u6211\u7684-\u5b66\u4e60\u8bbe\u7f6e\u300d\u91cc\u9762\u8bbe\u7f6e\u5b66\u4e60\u987a\u5e8f\u3002</span></p></div>", "like_num": 0, "comment_num": 0, "assign_date": "2021-06-28T16:00:00+00:00", "order_type": "COMMEND", "reply_push_url": null, "weight": null, "allow_comment": false, "is_send": false, "column_id": "bcrmcn", "cover_url": "", "tags": [], "redirect_url": "https://web.shanbay.com/op/articles/blksqe?shanbay_immersive_mode=true", "column": {"id": "bcrmcn", "name": "\u5b98\u7f51\u5e2e\u52a9-\u80cc\u5355\u8bcd"}}, {"id": "anjli", "type": "FORBIDDEN_COMMENT", "title": "\u80cc\u5355\u8bcd\u8981\u9002\u53ef\u800c\u6b62", "description": "\u80cc\u5355\u8bcd\u8981\u9002\u53ef\u800c\u6b62", "content_html": "<div class=\"kraft-content\" style=\"width:100%;padding:16px;color:#333;font-size:16px;line-height:1.75;letter-spacing:1px;word-spacing:0;word-break:break-word;background-color:#fff;overflow:hidden\"><h4 style=\"margin:0;padding:7px 0;font-weight:bold;font-size:16px\"><span>\u80cc\u5355\u8bcd\u8981\u9002\u53ef\u800c\u6b62</span></h4><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4f60\u4e5f\u8bb8\u5e0c\u671b\u4e00\u904d\u53c8\u4e00\u904d\u7684\u5237\u5355\u8bcd\uff0c\u56e0\u4e3a\u2014\u2014<br/>1. \u4f9d\u7136\u89c9\u5f97\u5f88\u591a\u80cc\u8fc7\u7684\u8bcd\u8bb0\u5f97\u4e0d\u591f\u7262<br/>2. \u89c9\u5f97\u5355\u8bcd\u91cd\u590d\u80cc\u7684\u6b21\u6570\u8d8a\u591a\uff0c \u82f1\u8bed\u5b66\u5f97\u5c31\u8d8a\u597d</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4e0d\u77e5\u4f60\u6709\u6ca1\u6709\u770b\u8fc7\u8fd9\u4e2a\u5fae\u535a\u6bb5\u5b50\uff1a</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u542c\u8bf4\uff0c\u4eba\u751f\u6700\u8f89\u714c\u7684\u4e00\u6bb5\u65f6\u95f4\u662f\u9ad8\u8003\u524d6\u4e2a\u6708\uff0c\u8fd9\u65f6\u4f60\u4e0a\u77e5\u5929\u4f53\u8fd0\u884c\u539f\u7406\uff0c\u4e0b\u77e5\u6709\u673a\u65e0\u673a\u53cd\u5e94\uff0c\u524d\u6709\u692d\u5706\u53cc\u66f2\u7ebf\uff0c\u540e\u6709\u6742\u4ea4\u751f\u7269\u5708\uff0c\u5916\u53ef\u8bf4\u82f1\u8bed\uff0c\u5185\u53ef\u4fee\u53e4\u6587\uff0c\u6c42\u5f97\u4e86\u6570\u5217\uff0c\u8bf4\u5f97\u4e86\u9a6c\u54f2...... \u73b0\u5728\u5462\uff0c\u9664\u4e86\u73a9\u624b\u673a\uff0c\u5e9f\u4eba\u4e00\u4e2a\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u7684\u786e\uff0c\u95ee\u95ee\u81ea\u5df1\uff0c\u4e00\u5143\u4e8c\u6b21\u65b9\u7a0b\u8fd8\u4f1a\u89e3\u4e48\uff0c\u79ef\u5316\u548c\u5dee\u548c\u5dee\u5316\u79ef\u8fd8\u4f1a\u7b97\u4e48\uff0c\u5316\u5b66\u65b9\u7a0b\u5f0f\u8fd8\u4f1a\u914d\u5e73\u4e48\uff1f</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u8fd9\u4e9b\u57fa\u7840\u7684\u6570\u7406\u77e5\u8bc6\uff0c\u7ecf\u8fc7\u6574\u4e2a\u4e2d\u5b66\u9636\u6bb5\u9ad8\u5f3a\u5ea6\u7684\u8bad\u7ec3\uff0c\u4e00\u65e6\u505c\u4e0b\u6765\u4e0d\u7528\uff0c\u4e0d\u51fa\u4e24\u5e74\u5c31\u4f1a\u5168\u90e8\u5fd8\u5149\uff0c\u90a3\u51ed\u4ec0\u4e48\u82f1\u8bed\u5355\u8bcd\u80cc\u51e0\u4e0b\u5c31\u80fd\u966a\u4f60\u4e00\u8f88\u5b50\uff1f</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u56e0\u6b64\uff0c</span><strong><span>\u65e0\u8bba\u628a\u5355\u8bcd\u80cc\u591a\u5c11\u904d\uff0c\u4e5f\u4e0d\u8bba\u600e\u4e48\u80cc\uff0c\u5230\u5934\u90fd\u662f\u4f1a\u5fd8\u7684\u3002</span></strong></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u56e0\u4e3a\u5fd8\u8bb0\u662f\u5fc5\u7136\uff0c\u4e0d\u5fd8\u624d\u662f\u5076\u7136\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u90a3\u4e48\u80cc\u5355\u8bcd\u662f\u4e0d\u662f\u6ca1\u6709\u610f\u4e49\u4e86\u5462\uff1f\u5f53\u7136\u4e0d\u662f\uff0c\u5728\u4f60\u8bcd\u6c47\u91cf\u4e25\u91cd\u4e0d\u8db3\u7684\u65f6\u5019\uff0c\u90a3\u4e48\u4e0d\u8bba\u53bb\u7ec3\u9605\u8bfb\u8fd8\u662f\u542c\u529b\uff0c\u90fd\u4f1a\u975e\u5e38\u75db\u82e6\uff0c\u4e5f\u65e0\u6cd5\u53d6\u5f97\u8db3\u591f\u7684\u6548\u679c\u2014\u2014\u8bd5\u60f3\u4e00\u6bb5\u8bdd\u51e0\u5341\u4e2a\u8bcd\u5f53\u4e2d\u4f60\u53ea\u80fd\u8ba4\u51fa\u4e2a\u628a\uff0c\u8fd9\u600e\u4e48\u575a\u6301\uff1f \u800c\u80cc\u5355\u8bcd\u662f\u5e2e\u4f60\u5feb\u901f\u767b\u4e0a\u4e00\u4e2a\u53f0\u9636\u7684\u91cd\u8981\u624b\u6bb5\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4f46\u662f\u5f53\u4f60\u771f\u7684\u4e0a\u4e86\u90a3\u4e2a\u53f0\u9636\uff0c\u4e0d\u8bba\u4f60\u662f\u5e0c\u671b\u4fdd\u6301\uff0c\u8fd8\u662f\u5e0c\u671b\u66f4\u4e0a\u4e00\u5c42\u697c\uff0c\u4ec5\u4ec5\u9760\u518d\u53cd\u590d\u7684\u80cc\u662f\u5f92\u52b3\u7684\uff0c\u53ea\u4f1a\u8ba9\u4f60\u9677\u5165\u8bcd\u6d77\u65e0\u6daf\u4f55\u5904\u662f\u5cb8\u7684\u65e0\u5c3d\u632b\u6298\u611f\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u5728\u8fd9\u4e2a\u9636\u6bb5\uff0c\u66f4\u597d\u7684\u5de9\u56fa\u548c\u5b66\u4e60\u65b9\u6cd5\uff0c\u5c31\u662f\u7acb\u523b\u5f00\u59cb\u5b66\u4ee5\u81f4\u7528\uff0c\u6700\u7b80\u5355\u7684\u65b9\u6cd5\uff0c\u5c31\u662f\u9605\u8bfb\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u5f88\u591a\u4eba\u4f1a\u8bf4\uff0c\u6211\u4e5f\u60f3\u8bfb\u554a\uff0c\u53ef\u662f\u6211\u60f3\u5148\u628a\u5355\u8bcd\u90fd\u80cc\u597d\u4e86\u518d\u53bb\u8bfb\uff0c\u5426\u5219\u8bfb\u4e0d\u61c2\u554a\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u6b63\u662f\u8fd9\u6837\u7684\u60f3\u6cd5\uff0c\u5bfc\u81f4\u65e0\u6570\u4eba\u5b66\u4e86\u5341\u51e0\u5e74\u82f1\u8bed\uff0c\u4f9d\u7136\u53ea\u77e5\u9053\u8bfb\u65b0\u6982\u5ff5\uff0c\u8fd8\u8981\u5355\u8bcd\u4eceA\u80cc\u5230C\uff0c\u518d\u4eceA\u80cc\u5230C\uff0c\u518d\u4eceA\u80cc\u5230C......</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4f60\u77e5\u9053\u95ee\u9898\u5728\u54ea\u91cc\u4e48\uff1f</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u56e0\u4e3a\u5bf9\u4e8e\u4efb\u4f55\u77e5\u8bc6\uff0c\u201c\u5b66\u201d\u548c\u201c\u7528\u201d\u4e4b\u95f4\uff0c\u672c\u5c31\u6ca1\u6709\u4e00\u6761\u9ed1\u767d\u5206\u660e\u7684\u754c\u9650\uff0c\u4e0d\u662f\u8bf4\u4f60\u82b1100\u5929\u53bb\u4e13\u5fc3\u5b66\u4e60\uff0c\u5230\u4e86101\u5929\uff0c\u554a\uff0c\u89c1\u8bc1\u5947\u8ff9\u7684\u65f6\u523b\uff0c\u4f60\u7a81\u7136\u53ef\u4ee5\u5f00\u59cb\u7528\u4e86\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u5927\u5bb6\u90fd\u5b66\u8fc7\u4e2d\u6587\uff0c\u6709\u8c01\u662f\u628a\u51e0\u4e07\u4e2a\u6c49\u5b57\u548c\u6210\u8bed\u90fd\u5148\u638c\u63e1\u4e86\uff0c\u518d\u53bb\u770b\u4e66\u8bfb\u62a5\u7684\uff1f</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u4f1a\u5f00\u8f66\u7684\u8bdd\uff0c\u8c01\u53c8\u662f\u628a\u8f66\u6280\u7ec3\u5f97\u8ddf\u8212\u9a6c\u8d6b\u4e00\u6837\u518d\u4e0a\u8def\u7684\uff1f</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u5b66\u82f1\u6587\u96be\u9053\u4e0d\u662f\u4e00\u4e2a\u9053\u7406\u4e48\uff0c\u5982\u679c\u4f60\u5df2\u7ecf\u719f\u6089\u4e86\u4e09\u56db\u5343\u4e2a\u5355\u8bcd\uff0c\u90a3\u4e48\u4f60\u5c31\u5e94\u8be5\u5927\u80c6\u5f00\u59cb\u9605\u8bfb\u539f\u6587\uff0c\u5e76\u4e14\u679c\u65ad\u629b\u5f03\u4e2d\u6587\u8bd1\u6587\u3002\u5982\u540c\u6211\u5728\u300a\u4f60\u60f3\u8981\u4ec0\u4e48\u6837\u7684\u8bed\u8a00\u73af\u5883\u300b\u4e00\u6587\u91cc\u8bf4\u7684\uff1a \u4f60\u4ee5\u4e3a\u81ea\u5df1\u5728\u53cc\u8bed\u9605\u8bfb\u7684\u65f6\u5019\uff0c\u6839\u672c\u5c31\u662f\u5728\u6c49\u8bed\u9605\u8bfb\u800c\u5df2\u561b\u3002</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u9664\u975e\u662f\u5173\u7cfb\u4f60\u996d\u7897\u6216\u8005\u751f\u547d\u7684\u9605\u8bfb\u6750\u6599\uff0c\u5426\u5219\u4e0d\u7528\u6015\u8bfb\u4e0d\u61c2\uff0c\u4e0d\u7528\u6015\u7406\u89e3\u9519\uff0c\u4f60\u60f3\u8c61\u4e00\u4e0b\u81ea\u5df1\u5c0f\u65f6\u5019\u662f\u600e\u4e48\u4e00\u70b9\u70b9\u5b66\u4f1a\u770b\u4e2d\u6587\u4e66\u7684\uff0c\u4e0d\u4e5f\u662f\u4ece\u8fde\u8499\u5e26\u731c\u5f00\u59cb\u7684\u4e48\uff1b\u4f46\u662f\u4f60\u8bfb\u4e86\u51e0\u5341\u51e0\u767e\u7bc7\uff0c\u81ea\u7136\u5c31\u8bfb\u51fa\u4e86\u611f\u89c9\uff0c\u8bfb\u51fa\u4e86\u81ea\u4fe1\uff0c\u662f\u4e0d\u662f\u8fd9\u4e2a\u9053\u7406\uff1f</span></p><p style=\"margin:0;padding:0;line-height:1.75;text-align:start;letter-spacing:normal;word-spacing:0px\"><span>\u51b5\u4e14\uff0c\u6211\u4eec\u4e0d\u8fd8\u7ed9\u5927\u5bb6\u5f00\u53d1\u4e86\u6247\u8d1d\u9605\u8bfb\u8fd9\u6837\u597d\u7528\u7684\u5de5\u5177\uff0c\u5355\u8bcd\u5373\u70b9\u5373\u67e5\uff0c\u751f\u8bcd\u968f\u65f6\u52a0\u5165\u5b66\u4e60\u8ba1\u5212\u5b89\u6392\u590d\u4e60\u3002\u7279\u522b\u7684\uff0c\u6211\u4eec\u4f1a\u8d34\u5fc3\u7684\u6807\u51fa\u6587\u7ae0\u5f53\u4e2d\u4f60\u66fe\u7ecf\u80cc\u8fc7\u7684\u5355\u8bcd\uff0c\u5982\u679c\u4f60\u53d1\u73b0\u8fd9\u4e2a\u8bcd\u5df2\u7ecf\u4e0d\u592a\u8bb0\u5f97\u4e86\uff0c\u53ef\u4ee5\u7acb\u523b\u70b9\u51fb\u8fd9\u4e2a\u8bcd\u56de\u7089\u518d\u9020
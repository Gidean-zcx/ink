# Default UI size, adult member. Backspace erases only this new draft's text.
# Keyboard geometry follows system-ui-spec section 7.5 and INK_KEY=96.
@6s cap app.open {"id":"memo"}
+3s cap memo.edit {}
+3s tap 26% 92%       # switch Chinese to English
+2s tap 61% 77%       # h
+1s tap 25% 68%       # e
+1s tap 89% 77%       # l
+1s tap 89% 77%       # l
+1s tap 84% 68%       # o
+2s note memo_text_entered
+0 tap 89% 85%        # backspace
+1s tap 89% 85%
+1s tap 89% 85%
+1s tap 89% 85%
+1s tap 89% 85%
+2s note memo_text_erased
+0 key home           # fold keyboard
+2s key home           # leave memo
+3s end

# Default UI size, adult member. Backspace erases only this new draft's text.
# Key centres measured in the simulator (tests/keyboard2 shots case prints KEY_CENTRE): rows at 70.1/78.4/86.7/95 %.
@6s cap app.open {"id":"memo"}
+3s cap memo.edit {}
+3s tap 23.5% 95%     # switch Chinese to English (中)
+1s tap 59.1% 78.4%   # h
+1s tap 26.6% 70.1%   # e
+1s tap 86.7% 78.4%   # l
+1s tap 86.7% 78.4%   # l
+1s tap 82.5% 70.1%   # o
+2s note memo_text_entered
+0 tap 89.6% 86.7%    # backspace
+1s tap 89.6% 86.7%
+1s tap 89.6% 86.7%
+1s tap 89.6% 86.7%
+1s tap 89.6% 86.7%
+2s note memo_text_erased
+0 key home           # fold keyboard
+2s key home           # leave memo
+3s end

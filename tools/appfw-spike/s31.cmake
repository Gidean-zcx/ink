set(spike "${CMAKE_CURRENT_LIST_DIR}")
set(spike_root "${spike}/../..")
if(NOT INK_SPIKE_CANDIDATE MATCHES "^(c|json|lua|mquickjs)$")
  message(FATAL_ERROR "Select c, json, lua or mquickjs for the measurement only")
endif()
target_sources(__idf_main PRIVATE "${spike}/bridge.c" "${spike}/candidate_${INK_SPIKE_CANDIDATE}.c")
target_include_directories(__idf_main PRIVATE "${spike}")
target_compile_definitions(__idf_main PRIVATE INK_SPIKE_S31=1)
# Retain the actual page lifecycle and touch callback; discard host-only tests.
target_link_options(__idf_main INTERFACE -Wl,--undefined=ink_spike_activity -Wl,--undefined=ink_spike_toggle)
set(page_source "")
if(INK_SPIKE_CANDIDATE STREQUAL "json")
  set(page_source "page.json")
elseif(INK_SPIKE_CANDIDATE STREQUAL "lua")
  set(page_source "page.lua")
elseif(INK_SPIKE_CANDIDATE STREQUAL "mquickjs")
  set(page_source "page.js")
endif()
set(page_bytes "")
if(page_source)
  file(READ "${spike}/${page_source}" page_bytes HEX)
  string(REGEX REPLACE "(..)" "0x\\1," page_bytes "${page_bytes}")
endif()
file(WRITE "${CMAKE_BINARY_DIR}/appfw-page.c"
  "static const char page[] = {${page_bytes}0};\nconst char *ink_spike_source(void) { return page; }\n")
target_sources(__idf_main PRIVATE "${CMAKE_BINARY_DIR}/appfw-page.c")
if(INK_SPIKE_CANDIDATE STREQUAL "lua")
  set(lua "${spike_root}/work/appfw-spike/lua-5.4.8/src")
  file(GLOB lua_sources "${lua}/*.c")
  list(FILTER lua_sources EXCLUDE REGEX "/(lua|luac)\\.c$")
  add_library(appfw_lua_vm STATIC ${lua_sources})
  target_include_directories(appfw_lua_vm SYSTEM PUBLIC "${lua}")
  target_link_libraries(__idf_main PRIVATE appfw_lua_vm)
  set(spike_vm appfw_lua_vm)
elseif(INK_SPIKE_CANDIDATE STREQUAL "mquickjs")
  include("${spike}/mquickjs.cmake")
  target_link_libraries(__idf_main PRIVATE appfw_mquickjs_vm)
  set(spike_vm appfw_mquickjs_vm)
endif()
if(spike_vm)
  # Plain libraries must receive the same IDF optimization and section flags.
  idf_build_get_property(spike_options COMPILE_OPTIONS GENERATOR_EXPRESSION)
  idf_build_get_property(spike_c_options C_COMPILE_OPTIONS GENERATOR_EXPRESSION)
  idf_build_get_property(spike_definitions COMPILE_DEFINITIONS GENERATOR_EXPRESSION)
  idf_build_get_property(spike_includes INCLUDE_DIRECTORIES GENERATOR_EXPRESSION)
  target_compile_options(${spike_vm} PRIVATE "${spike_options}" "${spike_c_options}" -w)
  target_compile_definitions(${spike_vm} PRIVATE "${spike_definitions}")
  target_include_directories(${spike_vm} SYSTEM PRIVATE "${spike_includes}")
endif()
